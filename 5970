                            if hNav and hNav.Position.Y < -200 and pos.Y > -200 then
                                exitInteriorIfInside()
                                _, hNav = getChar()
                            end
                            local resolvedIsl = GameClient.ResolveQuestIslandName(qName, info, questIslands)
                            local distToPos = hNav and (hNav.Position - pos).Magnitude or 0
                            if worldBossName and distToPos >= 1800 and hNav and not (LP.Character and LP.Character:GetAttribute("CarriedChest") ~= nil) then
                                local tpSettings = MainModules and MainModules.ConditionalSpawnsSettings and MainModules.ConditionalSpawnsSettings.Teleport
                                local minBossLv = (tpSettings and tpSettings.MinLevel) or 325
                                local bossTpCd = (tpSettings and tpSettings.Cooldown) or 30
                                if getLevel() >= minBossLv and (os.clock() - State.lastBossTp) >= (bossTpCd + 1) then
                                    local beforeBossTp = hNav.Position
                                    State.lastBossTp = os.clock()
                                    Status = ("%s: teleportando para %s..."):format(label, worldBossName)
                                    logSec(("BOSS_TP_FIRE q=%s boss=%s dist=%.1f"):format(tostring(qName), tostring(worldBossName), distToPos))
