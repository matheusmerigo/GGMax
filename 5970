function GameClient.UseNautiliaElevator(wantDown, aborted)
    local _, hrp0 = getChar()
    if not hrp0 then return false end
    local curDown = GameClient.IsNautiliaPos(hrp0.Position) or LP:GetAttribute("CurrentLocation") == "Nautilia" or hrp0.Position.Y < -2000
    if wantDown == curDown then return true end

    local upperLever = Vector3.new(7783.27, 48.09, -13602.54)
    local lowerLever = Vector3.new(13352.34, -5507.55, -11675.42)
    local leverPos = wantDown and upperLever or lowerLever

    if wantDown and Movement.TryMirrorKeeperTravel and (hrp0.Position - leverPos).Magnitude >= 3000 and hrp0.Position.Y > -200 then
        Movement.TryMirrorKeeperTravel(leverPos, "Nerúvia", aborted)
        _, hrp0 = getChar()
        if not hrp0 or (aborted and aborted()) then return false end
    end

    Status = wantDown and "Nautilia: indo ao elevador em Nerúvia..." or "Nautilia: indo ao elevador..."
    task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(leverPos) end) end)
    tweenTo(CFrame.new(leverPos + Vector3.new(0, 1.5, 0)), aborted)
    if aborted and aborted() then return false end

    local _, hNow = getChar()
    if not hNow then return false end
    if (hNow.Position - leverPos).Magnitude > 6 and (hNow.Position - leverPos).Magnitude < 45 then
        hNow.CFrame = CFrame.new(leverPos + Vector3.new(0, 1.5, 0))
        hNow.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.25)
    elseif (hNow.Position - leverPos).Magnitude > 25 then
        return false
    end

    local beforeY = hNow.Position.Y
    local ctxDead = os.clock() + 1.5
    while os.clock() < ctxDead and not (aborted and aborted()) do
        local ic = GameClient.getInteractionClient and GameClient.getInteractionClient()
        if ic and ic.Interaction and ic.Interaction.Contexts and ic.Interaction.Contexts["Use_NautiliaElevator_NE"] then
            break
        end
        task.wait(0.1)
    end
    if GameClient.fireInteractionContext then
        GameClient.fireInteractionContext("Use_NautiliaElevator_NE")
    end
    pcall(function() GameModules.Network:FireServer("QuestCustoms", "Neruvia_Elevator") end)

    local tWait = os.clock() + 4.5
    while os.clock() < tWait and not (aborted and aborted()) do
        local _, hChk = getChar()
        if hChk and math.abs(hChk.Position.Y - beforeY) > 1000 then
            task.wait(1.0)
            return true
        end
        task.wait(0.15)
    end
    return false
end

local function goNear(pos, aborted, opts)
    if typeof(pos) ~= "Vector3" or isDeadOrRespawning() then return false end
    local _, hrp0 = getChar()
    if hrp0 then
        local myY, tgtY = hrp0.Position.Y, pos.Y
        -- 0) Se estiver em Nautilia (Y ~ -5507) e o destino estiver fora, sobe primeiro pelo elevador
        if GameClient.IsNautiliaPos(hrp0.Position) and not GameClient.IsNautiliaPos(pos) then
            GameClient.UseNautiliaElevator(false, aborted)
            _, hrp0 = getChar()
            if not hrp0 or (aborted and aborted()) then return false end
            myY = hrp0.Position.Y
        end
        -- 1) Se estiver dentro de VolcanoBossRoom (Y ~ -4700) ou BlazeboundArena (Y ~ -11400) e o alvo estiver fora deles: sai primeiro para VolcanoInterior
        if not GameClient.IsNautiliaPos(hrp0.Position) and myY < -4000 and myY > -5500 and not (tgtY < -4000 and tgtY > -5500) then
            Movement.UseVolcanoPrivateDoor("VolcanoBossRoom", "Leave", aborted)
            _, hrp0 = getChar()
            myY = hrp0 and hrp0.Position.Y or myY
        elseif myY < -10500 and not (tgtY < -10500) then
            Movement.UseVolcanoPrivateDoor("BlazeboundArena", "Leave", aborted)
            _, hrp0 = getChar()
            myY = hrp0 and hrp0.Position.Y or myY
        end
        -- 2) Se estiver dentro de VolcanoInterior (Y ~ -9550) e o alvo for na superfície (Y > -200): sai por VolcanoInterior.Leave.Entrance
        if myY < -8000 and myY > -10500 and tgtY > -200 then
            Movement.UseVolcanoPrivateDoor("VolcanoInterior", "Leave", aborted)
            _, hrp0 = getChar()
            myY = hrp0 and hrp0.Position.Y or myY
        end
        -- 2.2) Se estiver dentro de outro interior genérico (ex: Pawnbroker, Banker, Quest, etc.) e o destino estiver fora: sai pela porta Leave/Entrance
        if Movement.TryLeaveGenericInterior and hrp0 then
            Movement.TryLeaveGenericInterior(pos, aborted)
            _, hrp0 = getChar()
            if not hrp0 or (aborted and aborted()) then return false end
            myY = hrp0.Position.Y
        end
        -- 2.5) Se o destino está em outra ilha (>= 3000 studs), usa o Mirror Keeper antes de voar/entrar em interior
        if not (opts and opts.noMirror) and Movement.TryMirrorKeeperTravel and hrp0 and (hrp0.Position - pos).Magnitude >= 3000 and hrp0.Position.Y > -200 then
            Movement.TryMirrorKeeperTravel(pos, nil, aborted)
            _, hrp0 = getChar()
            if not hrp0 or (aborted and aborted()) then return false end
            myY = hrp0.Position.Y
        end
        -- 2.8) Se está na superfície e o destino é em Nautilia, desce pelo elevador em Nerúvia
        if not GameClient.IsNautiliaPos(hrp0.Position) and GameClient.IsNautiliaPos(pos) then
            GameClient.UseNautiliaElevator(true, aborted)
            _, hrp0 = getChar()
            if not hrp0 or (aborted and aborted()) then return false end
            myY = hrp0.Position.Y
        end
        -- 3) Se estiver na superfície (Y > -200) e o alvo for no complexo subterrâneo de Volcano Island (Y < -4000): entra por VolcanoInterior.Enter.Entrance
        if not GameClient.IsNautiliaPos(pos) and myY > -200 and tgtY < -4000 then
            Movement.UseVolcanoPrivateDoor("VolcanoInterior", "Enter", aborted)
            _, hrp0 = getChar()
            myY = hrp0 and hrp0.Position.Y or myY
        end
        -- 4) Se já estiver em VolcanoInterior e o alvo for dentro de VolcanoBossRoom ou BlazeboundArena: entra na sub-porta correspondente
        if myY < -8000 and myY > -10500 then
            if tgtY < -4000 and tgtY > -5500 then
                Movement.UseVolcanoPrivateDoor("VolcanoBossRoom", "Enter", aborted)
            elseif tgtY < -10500 then
                Movement.UseVolcanoPrivateDoor("BlazeboundArena", "Enter", aborted)
            end
        end
        -- 4.5) Se o destino estiver dentro de um interior genérico (ex: Pawnbroker, Banker, Blacksmith, etc.): entra pela porta Entrance/QuestZone
        if Movement.TryEnterGenericInterior and hrp0 then
            Movement.TryEnterGenericInterior(pos, aborted)
            if aborted and aborted() then return false end
        end
    end
    task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(pos) end) end)
    return tweenTo(CFrame.new(pos + Vector3.new(0, 4, 0)), aborted)
end

function Features.TryAcceptQuest(name, info, aborted)
    local giver = info.Arguments.Giver
    local pos = giverPos(giver)
    if not pos then
        local rawIsland = giver:gsub("%s*Quest Giver$", "")
        local areaName = GameClient.ResolveAreaName(rawIsland) or GameClient.ResolveAreaName(name)
        local areasF = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Areas")
        local area = areaName and areasF and areasF:FindFirstChild(areaName)
        local center = area and area:GetAttribute("MapCenter")
        if typeof(center) == "Vector3" then
            local alt = area:GetAttribute("MapAltitude") or 14
            local islPos = center + Vector3.new(0, alt + 12, 0)
            Status = ("Indo à ilha de %s (%s)..."):format(giver, areaName)
            goNear(islPos, aborted)
            if aborted() then return false end
            pcall(function() LP:RequestStreamAroundAsync(islPos) end)
            local tStream = os.clock() + 3.0
            while os.clock() < tStream and not aborted() do
                pos = giverPos(giver)
                if pos then break end
                task.wait(0.25)
            end
        end
    end
    if not pos then Status = "NPC não encontrado: " .. giver; return false end
    Status = ("Indo ao NPC: %s"):format(giver)
    goNear(pos, aborted)
    if aborted() then return false end
    pos = giverPos(giver) or pos
    local _, hrpNow = getChar()
    if hrpNow and (hrpNow.Position - pos).Magnitude > 14 then
        tweenTo(CFrame.new(pos + Vector3.new(0, 2, 3)), aborted)
        if aborted() then return false end
    end
    for _ = 1, 3 do
        if aborted() then return false end
        Status = ("Aceitando quest: %s"):format(info.Title or name)
        pcall(function() GameModules.Network:FireServer("Quests", "AcceptGrinding", name) end)
        local t0 = os.clock()
        while os.clock() - t0 < 2 do
            if Features.ActiveQuest() == name then
                notify("Quest aceita", info.Title or name)
                return true
            end
            task.wait(0.2)
        end
    end
    return false
end

function Features.InitCombatCore()
    local function hasLineOfSight(fromPos, toPos, targetModel)
        local diff = toPos - fromPos
        if diff.Magnitude < 0.5 then return true end
        local ex = Combat.losExclude
        table.clear(ex)
        if LP.Character then ex[#ex + 1] = LP.Character end
        if targetModel then ex[#ex + 1] = targetModel end
        for _, name in ipairs({ "Enemys", "DroppedTools" }) do
            local f = playability(name)
            if f then ex[#ex + 1] = f end
        end
        local il = workspace:FindFirstChild("IgnoreList")
        if il then ex[#ex + 1] = il end
        Combat.losParams.FilterDescendantsInstances = ex
        local hit = workspace:Raycast(fromPos, diff, Combat.losParams)
        table.clear(ex)
        return hit == nil
    end

    local function bindTelegraphFolder(folder)
        if Combat.telegraphFolder == folder then return end
        for _, c in ipairs(Combat.telegraphConns) do pcall(function() c:Disconnect() end) end
        table.clear(Combat.telegraphConns)
        table.clear(Combat.telegraphParts)
        table.clear(Combat.telegraphAdornments)
        Combat.telegraphFolder = folder
        if not folder then return end
        local function addItem(item)
            if item:IsA("BasePart") then
                Combat.telegraphParts[item] = true
            elseif item:IsA("CylinderHandleAdornment") then
                Combat.telegraphAdornments[item] = true
            end
        end
        local function removeItem(item)
            Combat.telegraphParts[item] = nil
            Combat.telegraphAdornments[item] = nil
        end
        for _, item in ipairs(folder:GetDescendants()) do
            addItem(item)
        end
        Combat.telegraphConns[1] = SafeRuntime.Connect(folder.DescendantAdded, "TelegraphAdded", addItem)
        Combat.telegraphConns[2] = SafeRuntime.Connect(folder.DescendantRemoving, "TelegraphRemoved", removeItem)
    end

    local function inTelegraph(pos)
        if not CFG.BossDodge then return false end
        local cam = workspace.CurrentCamera
        local folder = cam and cam:FindFirstChild("BossTelegraphs")
        if folder ~= Combat.telegraphFolder then
            bindTelegraphFolder(folder)
        end
        if not folder then return false end
        local margin = 10
        for item in pairs(Combat.telegraphParts) do
            if item.Parent and item.Transparency < 1 then
                local p, sz = item.CFrame:PointToObjectSpace(pos), item.Size
                if item.Shape == Enum.PartType.Cylinder then
                    if math.abs(p.X) < sz.X / 2 + 45 and math.sqrt(p.Y * p.Y + p.Z * p.Z) < math.max(sz.Y, sz.Z) / 2 + margin then return true end
                elseif item.Shape == Enum.PartType.Ball then
                    if p.Magnitude < sz.X / 2 + margin then return true end
                elseif math.abs(p.X) < sz.X / 2 + margin and math.abs(p.Z) < sz.Z / 2 + margin and math.abs(p.Y) < sz.Y / 2 + 45 then
                    return true
                end
            end
        end
        for item in pairs(Combat.telegraphAdornments) do
            if item.Parent and item.Visible ~= false then
                local ad = item.Adornee
                local base = (ad and ad:IsA("BasePart")) and ad.CFrame or CFrame.identity
                local c = (base * item.CFrame).Position
                local flat = Vector3.new(pos.X - c.X, 0, pos.Z - c.Z).Magnitude
                if math.abs(pos.Y - c.Y) < 45 and flat < item.Radius + margin and flat > (item.InnerRadius or 0) - margin then return true end
            end
        end
        return false
    end

    local function findSafeDodgeSpot(target, mp, hrpPos, defaultPos)
        local now = os.clock()
        local memo = Combat.dodgeMemo[target]
        if memo and memo.Pos and (now - memo.At) < 0.25 and (memo.Pos - mp).Magnitude <= 120 and not inTelegraph(memo.Pos) then
            return memo.Pos
        end

        local flat = Vector3.new(hrpPos.X - mp.X, 0, hrpPos.Z - mp.Z)
        flat = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
        local yOff = math.clamp(defaultPos.Y - mp.Y, 3, 10)
        local chosen = nil

        for _, radius in ipairs(Combat.DODGE_RINGS) do
            for _, step in ipairs({ 0, 1, -1, 2, -2, 3, -3, 4 }) do
                local a = step * math.pi / 4
                local dir = Vector3.new(
                    flat.X * math.cos(a) - flat.Z * math.sin(a),
                    0,
                    flat.X * math.sin(a) + flat.Z * math.cos(a)
                )
                local cand = Vector3.new(mp.X + dir.X * radius, mp.Y + yOff, mp.Z + dir.Z * radius)
                if not inTelegraph(cand) and hasLineOfSight(cand, mp, target) then
                    chosen = cand
                    break
                end
            end
            if chosen then break end
        end

        if not chosen then
            for _, h in ipairs(Combat.DODGE_HEIGHTS) do
                local cand = mp + Vector3.new(0, h, 0)
                if not inTelegraph(cand) and hasLineOfSight(cand, mp, target) then
                    chosen = cand
                    break
                end
            end
        end

        chosen = chosen or (mp + flat * 48 + Vector3.new(0, 12, 0))
        Combat.dodgeMemo[target] = { At = now, Pos = chosen }
        return chosen
    end

    local function computeStand(target, hrp)
        local mr = target and target:FindFirstChild("HumanoidRootPart")
        if not (mr and hrp) then return nil end
        local mp = mr.Position
        if CFG.BossDodge then
            local _ = inTelegraph(hrp.Position)
            local hasActiveTelegraph = next(Combat.telegraphParts) ~= nil or next(Combat.telegraphAdornments) ~= nil
            local memo = Combat.dodgeMemo[target]
            if hasActiveTelegraph and memo and memo.Pos and (memo.Pos - mp).Magnitude <= 120 and not inTelegraph(memo.Pos) then
                return CFrame.lookAt(memo.Pos, mp)
            end
        end
        local tilt = true
        local goal
        if CFG.FarmMode == "Above" then
            local isBoss = target:GetAttribute("IsBoss") == true
            local height = CFG.AboveHeight
            local back = isBoss and 0.5 or 4

            local flat = Vector3.new(hrp.Position.X - mp.X, 0, hrp.Position.Z - mp.Z)
            flat = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
            local offset = flat * back + Vector3.new(0, height, 0)
            local memo = Combat.poseMemo[target]
            if not memo or not memo.Offset or (os.clock() - memo.At) > 0.5 then
                local chosen
                for _, pair in ipairs({ { height, back }, { math.min(7, height), 4 }, { 1.5, 6 } }) do
                    for turn = 0, 7 do
                        local a2 = turn * math.pi / 4
                        local dir = Vector3.new(
                            flat.X * math.cos(a2) - flat.Z * math.sin(a2),
                            0,
                            flat.X * math.sin(a2) + flat.Z * math.cos(a2)
                        )
                        local c2 = dir * pair[2] + Vector3.new(0, pair[1], 0)
                        if hasLineOfSight(mp + c2, mp, target) and not (CFG.BossDodge and inTelegraph(mp + c2)) then
                            chosen = c2
                            break
                        end
                    end
                    if chosen then break end
                end
                memo = { At = os.clock(), Offset = chosen or offset }
                Combat.poseMemo[target] = memo
            end
            local spot = mp + memo.Offset
            if CFG.BossDodge and inTelegraph(spot) then
                spot = findSafeDodgeSpot(target, mp, hrp.Position, spot)
            end
            return CFrame.lookAt(spot, mp)
        elseif CFG.FarmMode == "Below" then
            local ang = os.clock() * 2.4
            local pos = mp + Vector3.new(math.cos(ang) * 2.5, -CFG.BelowHeight, math.sin(ang) * 2.5)
            goal = CFrame.lookAt(pos, mp, Vector3.new(0, 0, 1))
        elseif CFG.FarmMode == "Orbit" then
            local lv = mr.CFrame.LookVector
            local flat = Vector3.new(lv.X, 0, lv.Z)
            flat = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)
            local pos = mp - flat * CFG.OrbitRadius
            goal = CFrame.lookAt(pos, Vector3.new(mp.X, pos.Y, mp.Z))
        else
            local dir = hrp.Position - mp
            dir = Vector3.new(dir.X, 0, dir.Z)
            dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
            local pos = mp + dir * CFG.FarmDistance + Vector3.new(0, CFG.FarmHeight, 0)
            goal = CFrame.lookAt(pos, Vector3.new(mp.X, pos.Y, mp.Z))
        end

        if CFG.BossDodge and inTelegraph(goal.Position) then
            local safePos = findSafeDodgeSpot(target, mp, hrp.Position, goal.Position)
            return CFrame.lookAt(safePos, mp)
        end
        return goal
    end

    -- Sistema único de combate (usado por Level Farm, Bosses e História/Secundárias)
    local function fightTarget(target, tAborted, statusPrefix, opts)
        opts = opts or {}
        local char, hrp, hum = getChar()
        if not (char and hrp and hum and target) then return end
        currentTarget = target
        local tool = Combat.EquipWeapon(char, hum)
        local tgtLabel = baseName(target)
        local tgtLv = tostring(Combat.MobLevel(target))

        Status = ("Indo: %s [Lv %s]"):format(tgtLabel, tgtLv)
        local initGoal = computeStand(target, hrp)
        if initGoal then
            local _, hFarm0 = getChar()
            if opts.allowGoNear and hFarm0 and ((hFarm0.Position.Y > -200) ~= (initGoal.Position.Y > -200) or math.abs(hFarm0.Position.Y - initGoal.Position.Y) > 1500) then
                goNear(initGoal.Position, tAborted)
            end
            local g0 = computeStand(target, hFarm0 or hrp)
            if g0 then
                tweenTo(g0, function()
                    if tAborted() then return true end
                    if CFG.BossDodge then
                        local _, hc = getChar()
                        if hc and inTelegraph(hc.Position) then return true end
                    end
                    return false
                end)
            end
        end

        local lastHp, maxHp = mobHP(target)
        local lastDmgAt = os.clock()
        local sawDamage = false
        local lastHit = 0
        while not tAborted() do
            currentTarget = target
            local c2, h2 = getChar()
            if not (c2 and h2) then break end
            local nowHp, nowMax = mobHP(target)
            if nowMax > 0 then maxHp = nowMax end
            if opts.checkStuck then
                if sawDamage and nowHp > lastHp and maxHp > 0 and nowHp >= maxHp * 0.95 and lastHp <= maxHp * 0.6 then
                    State.BadTargets[target] = os.clock() + 5
                    break
                end
                if nowHp < lastHp then
                    sawDamage = true
                    lastDmgAt = os.clock()
                elseif os.clock() - lastDmgAt >= ((target:GetAttribute("IsBoss") == true) and 10 or 3) then
                    State.BadTargets[target] = os.clock() + 15
                    break
                end
            end
            lastHp = nowHp
            Status = ("%s: %s [Lv %s]"):format(statusPrefix or "Atacando", tgtLabel, tgtLv)
            local goal = computeStand(target, h2)
            if not goal then break end
            local inDanger = CFG.BossDodge and inTelegraph(h2.Position)
            local dodgingNow = inDanger and not inTelegraph(goal.Position)
            local maxSnap = dodgingNow and 75 or ((CFG.AttackMode == "KillAura") and 16 or 12)
            if (h2.Position - goal.Position).Magnitude > maxSnap then
                attackGoal = nil
                lastDmgAt = os.clock()
                tweenTo(goal, function()
                    if tAborted() then return true end
                    if CFG.BossDodge then
                        local _, hc = getChar()
                        if hc and ((not inDanger and inTelegraph(hc.Position)) or inTelegraph(goal.Position)) then
                            return true
                        end
                    end
                    return false
                end)
            else
                if dodgingNow then cancelTween() end
                attackGoal = goal
                h2.CFrame = goal
                h2.AssemblyLinearVelocity = Vector3.zero
            end
            if (CFG.AttackMode == "M1" or Combat.ToolIsGun(tool)) and os.clock() - lastHit >= CFG.M1Interval then
                lastHit = os.clock()
                tool = (tool and tool.Parent == c2) and tool or Combat.EquipWeapon(c2, c2:FindFirstChildOfClass("Humanoid"))
                Combat.M1(tool)
            end
            RunService.Heartbeat:Wait()
        end
        attackGoal = nil
        if opts.checkStuck and not mobAlive(target) then
            State.BadTargets[target] = os.clock() + 5
        end
        currentTarget = nil
    end

    -- Disponibiliza o combate imediatamente; a inicialização restante registra
    -- eventos e não deve deixar os loops de boss sem esta função.
    Combat.FightTarget = fightTarget

    local function farmLoop()
        State.farmToken += 1
        local my = State.farmToken
        debugLog("farm_debug.txt", ("=== AutoFarm START lv=%d AutoQuest=%s ==="):format(getLevel(), tostring(CFG.AutoQuest)), true)
        task.spawn(function()
            local function aborted() return not CFG.AutoFarm or State.farmToken ~= my end
            local lastFarmLog, lastNoTargetT = "", 0
            local function logFarm(msg)
                if msg == lastFarmLog and (os.clock() - lastNoTargetT) < 5 then return end
                lastFarmLog, lastNoTargetT = msg, os.clock()
                debugLog("farm_debug.txt", msg)
            end
            SafeRuntime.RunResilientLoop("FarmLoop", function() return not aborted() end, function()
            while not aborted() do
                local continue_ = false
                local char, hrp, hum = getChar()
                if not char then
                    Status = "Aguardando personagem..."
                    logFarm("WAIT_CHAR (sem personagem/HRP)")
                    task.wait(1)
                else
                    local lvl = getLevel()
                    local nameSet, questName

                    -- 1) quests por nível
                    if CFG.AutoQuest and MainModules then
                        local aName, aInfo, aProg = Features.ActiveQuest()
                        local bName, bInfo = Features.BestQuest(lvl)
                        if aName then
                            local maxLv = aInfo and aInfo.Arguments and aInfo.Arguments.MaxLevel
                            if maxLv and lvl > maxLv and bName and bName ~= aName then
                                Status = "Trocando para quest de nível maior..."
                                logFarm(("QUEST_ABANDON %s -> %s (lv=%d > max=%d)"):format(tostring(aName), tostring(bName), lvl, maxLv))
                                pcall(function() GameModules.Network:FireServer("Quests", "Abandon", aName) end)
                                task.wait(0.6)
                                continue_ = true
                            else
                                local set, done = Features.PendingNames(aInfo, aProg)
                                if done then
                                    Status = "Quest concluída, aguardando..."
                                    logFarm(("QUEST_DONE %s"):format(tostring(aName)))
                                    local t0 = os.clock()
                                    while not aborted() and Features.ActiveQuest() == aName and os.clock() - t0 < 6 do task.wait(0.3) end
                                    if Features.ActiveQuest() == aName then
                                        pcall(function() GameModules.Network:FireServer("Quests", "Repeat") end)
                                    end
                                else
                                    nameSet, questName = set, aName
                                end
                            end
                        elseif bName and os.clock() >= State.questCooldown then
                            if os.clock() < State.repeatPendingUntil then
                                Status = "Repetindo quest..."
                                task.wait(0.25)
                                continue_ = true
                            else
                                if not Features.TryAcceptQuest(bName, bInfo, aborted) then
                                    State.questCooldown = os.clock() + 15 -- não spamma se o servidor recusar
                                    Status = "Não consegui aceitar a quest, farmando sem quest"
                                    logFarm(("QUEST_ACCEPT_FAIL %s (lv=%d)"):format(tostring(bName), lvl))
                                else
                                    logFarm(("QUEST_ACCEPT_OK %s (lv=%d)"):format(tostring(bName), lvl))
                                end
                                continue_ = true
                            end
                        end
                    end

                    if continue_ then
                        continue_ = false
                    else
                        local _, hrp2 = getChar()
                        local target = hrp2 and Combat.PickTarget(lvl, hrp2.Position, nameSet)

                        if continue_ then
                            continue_ = false
                        elseif not target and hrp2 then
                            -- nenhum inimigo carregado: vai até o ponto de spawn
                            local wantedName
                            if nameSet then
                                for n in pairs(nameSet) do wantedName = n; break end
                            else
                                for _, e in ipairs(Combat.MobNamesInRange(lvl)) do
                                    if Combat.SpawnMarker(e[1], hrp2.Position) then wantedName = e[1]; break end
                                end
                            end
                            local mk = wantedName and Combat.SpawnMarker(wantedName, hrp2.Position)
                            if mk then
                                Status = ("Indo ao spawn: %s"):format(wantedName)
                                logFarm(("GO_SPAWN %s @ (%.0f, %.0f, %.0f)"):format(tostring(wantedName), mk.Position.X, mk.Position.Y, mk.Position.Z))
                                goNear(mk.Position, function() return aborted() or Combat.PickTarget(lvl, mk.Position, nameSet) ~= nil end)
                                task.wait(0.5)
                            else
                                Status = ("Sem alvo (Lv %d)%s"):format(lvl, questName and " · quest sem spawn" or "")
                                logFarm(("NO_TARGET lv=%d quest=%s"):format(lvl, tostring(questName)))
                                task.wait(1)
                            end
                        elseif target then
                            logFarm(("FIGHT %s | lv=%d | quest=%s"):format(target.Name, lvl, tostring(questName)))
                            local function tAborted()
                                return aborted() or not mobAlive(target)
                            end
                            fightTarget(target, tAborted, questName and "Quest" or "Atacando", { checkStuck = true, allowGoNear = true })
                        end
                    end
                end
            end
            end, function(err) attackGoal = nil; currentTarget = nil; cancelTween() end)
            debugLog("farm_debug.txt", "=== AutoFarm STOP ===")
            attackGoal = nil
            cancelTween()
            Status = "Parado"
        end)
    end

    -- repetição automática de quest (o jogo oferece "RepeatOffered")
    pcall(function()
        local re = ReplicatedStorage:WaitForChild("NetworkInstances"):WaitForChild("RemoteEvents"):WaitForChild("Quests")
        track(SafeRuntime.Connect(re.OnClientEvent, "QuestRepeat", function(ev, offered)
            if ev ~= "RepeatOffered" then return end
            local matchFarm = CFG.AutoFarm and CFG.AutoQuest and offered == Features.BestQuest(getLevel())
            local matchMission = false
            if CFG.AutoMob and offered ~= nil then
                if CFG.TargetMission then
                    matchMission = (offered == CFG.TargetMission)
                else
                    for name, on in pairs(CFG.TargetMobs) do
                        local qe = on and State.Mobs.Quests[name]
                        if qe and qe.name == offered then
                            matchMission = true
                            break
                        end
                    end
                end
            end
            local matchCraftFarm = (CFG.AutoCraftRaidKey or CFG.AutoBlacksmith or CFG.AutoMobDrops)
                and offered ~= nil and State.activeFarmQuestName == offered
            if matchFarm or matchMission or matchCraftFarm then
                State.repeatPendingUntil = os.clock() + 3
                task.wait(0.15)
                pcall(function() GameModules.Network:FireServer("Quests", "Repeat") end)
            end
        end))
    end)

    -- Mantém a pose de ataque. No modo "Em cima" o personagem fica DEITADO (olhando p/ baixo):
    -- o Humanoid tenta se endireitar sozinho, então desligamos PlatformStand/AutoRotate e
    -- reaplicamos o CFrame antes da física e antes do render.
    local function needsTiltPose()
        return true
    end

    local function isInCutscene()
        if not GameModules then return false end
        local running = false
        pcall(function()
            if GameModules.Cutscene and type(GameModules.Cutscene.Running) == "table" and next(GameModules.Cutscene.Running) ~= nil then
                running = true
            elseif GameModules.States and GameModules.States.Player then
                local st = GameModules.States.Player()
                if st and st.IsActive and st:IsActive("Cutscene") then
                    running = true
                end
            end
        end)
        return running
    end

    local function isCombatActive()
        return attackGoal ~= nil and not isInCutscene()
    end

    local function applyPose()
        if attackGoal ~= nil and CFG.AttackMode == "KillAura" and not State.KillAuraRunning and GameClient.EnsureKillAuraLoop then
            GameClient.EnsureKillAuraLoop()
        end
        local c = LP.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local root = c and c:FindFirstChild("HumanoidRootPart")
        local active = isCombatActive() and root and hum and needsTiltPose()
        if active then
            if not Combat.posedHum then Combat.posedHum = hum end
            hum.PlatformStand = true
            hum.AutoRotate = false
            root.CFrame = attackGoal
            root.AssemblyAngularVelocity = Vector3.zero
            root.AssemblyLinearVelocity = Vector3.zero
        elseif isCombatActive() and root then
            if Combat.posedHum then
                pcall(function() Combat.posedHum.PlatformStand = false; Combat.posedHum.AutoRotate = true end)
                Combat.posedHum = nil
            end
            root.CFrame = attackGoal
            root.AssemblyAngularVelocity = Vector3.zero
            root.AssemblyLinearVelocity = Vector3.zero
        elseif Combat.posedHum then
            pcall(function() Combat.posedHum.PlatformStand = false; Combat.posedHum.AutoRotate = true end)
            Combat.posedHum = nil
        end
    end
    track(SafeRuntime.Connect(RunService.Stepped, "ApplyPoseStepped", applyPose))
    track(SafeRuntime.Connect(RunService.Heartbeat, "ApplyPoseHeartbeat", applyPose))
    track(SafeRuntime.Connect(RunService.RenderStepped, "CombatCFrame", function()
        if isCombatActive() then
            local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if r then
                r.CFrame = attackGoal
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end))

    -- Mantém pose neutra local em combate via Motor6D.Transform sem destruir Animator
    track(SafeRuntime.Connect(RunService.PreSimulation, "PoseReset", function()
        if attackGoal ~= nil and currentTarget ~= nil and not isInCutscene() then
            for joint in pairs(State.CharJoints) do
                if joint.Parent then
                    joint.Transform = CFrame.identity
                end
            end
        end
    end))

    -- Hook nativo de Hitbox (Elysium.Hitbox.SetBoxModifier) em < 25 studs sem redimensionar o inimigo
    pcall(function()
        local elysium = ReplicatedStorage:FindFirstChild("Elysium")
        local modScript = elysium and elysium:FindFirstChild("Modules")
        local em = modScript and require(modScript)
        local hb = em and em.Hitbox
        if hb and type(hb.SetBoxModifier) == "function" then
            Combat.hitboxModule = hb
            Combat.origBoxModifier = hb.BoxModifier
            local lastHbLog = 0
            debugLog("hitbox_debug.txt", "HOOK_OK SetBoxModifier", true)
            Combat.boxModifierFn = function(c, cf, size)
                if Combat.origBoxModifier then
                    cf, size = Combat.origBoxModifier(c, cf, size)
                end
                if CFG.NativeHitbox and c == LP.Character and attackGoal ~= nil and currentTarget and currentTarget.Parent then
                    local trp = currentTarget:FindFirstChild("HumanoidRootPart") or currentTarget.PrimaryPart
                    local _, r = getChar()
                    if trp and r and (r.Position - trp.Position).Magnitude < 25 then
                        local s = CFG.HitboxSize or 28
                        local now = os.clock()
                        if now - lastHbLog >= 2 then
                            lastHbLog = now
                            debugLog("hitbox_debug.txt", ("HITBOX_APPLIED target=%s size=%d dist=%.1f"):format(currentTarget.Name, s, (r.Position - trp.Position).Magnitude))
                        end
                        return CFrame.new(trp.Position), Vector3.new(s, s, s)
                    end
                end
                return cf, size
            end
            hb.SetBoxModifier(Combat.boxModifierFn)
        end
    end)

    -- Noclip
    track(SafeRuntime.Connect(RunService.Stepped, "Noclip", function()
        local userNoclip = (Toggles and Toggles.Noclip and Toggles.Noclip.Value == true)
        if not CFG.Noclip and not userNoclip then
            if State.noclipApplied then
                local c = LP.Character
                if c then
                    for _, name in ipairs({ "UpperTorso", "LowerTorso", "Torso", "Head" }) do
                        local pt = c:FindFirstChild(name)
                        if pt and pt:IsA("BasePart") and not pt.CanCollide then pt.CanCollide = true end
                    end
                end
                State.noclipApplied = false
            end
            return
        end
        local c = LP.Character
        if not c then return end
        local r = c:FindFirstChild("HumanoidRootPart")
        local movingOrCombat = (Movement.activeTween ~= nil or attackGoal ~= nil)
        local insideWall = false
        if not userNoclip and not movingOrCombat and r then
            local now = os.clock()
            if now - State.lastWallCheck >= 0.15 then
                State.lastWallCheck = now
                Movement.noclipOverlap.FilterDescendantsInstances = { c }
                local hits = workspace:GetPartsInPart(r, Movement.noclipOverlap)
                local found = false
                for _, h in ipairs(hits) do
                    if h.CanCollide then
                        found = true
                        break
                    end
                end
                State.insideWall = found
            end
            insideWall = State.insideWall == true
        else
            State.insideWall = false
        end
        if userNoclip or (CFG.Noclip and (movingOrCombat or insideWall)) then
            if r and movingOrCombat then
                r.AssemblyLinearVelocity = Vector3.zero
            end
            for p in pairs(State.CharParts) do
                if p.Parent and p.CanCollide then p.CanCollide = false end
            end
            State.noclipApplied = true
        elseif State.noclipApplied then
            -- Quando parado no chão (falando com NPC, quebrando pedra, cutscene), restaura colisão para não afundar no void!
            for _, name in ipairs({ "UpperTorso", "LowerTorso", "Torso", "Head" }) do
                local pt = c:FindFirstChild(name)
                if pt and pt:IsA("BasePart") and not pt.CanCollide then pt.CanCollide = true end
            end
            State.noclipApplied = false
        end
    end))

    Combat.HasLineOfSight = hasLineOfSight
    Combat.InTelegraph = inTelegraph
    Combat.ComputeStand = computeStand
    Combat.FightTarget = fightTarget
    Combat.FarmLoop = farmLoop
    Combat.IsInCutscene = isInCutscene
    Combat.ApplyPose = applyPose
end

-- Detector de frutas
local collecting = false
function Features.InitFruit()
local Fruits = {}   -- [instância] = { esp = {...}, t = os.clock() }

local function isFruit(inst)
    if not (inst:IsA("Tool") or inst:IsA("Model")) then return false end
    if MainModules and MainModules.ToolsInfo then
        local ok, info = pcall(function() return MainModules.ToolsInfo:Get(inst.Name) end)
        if ok and type(info) == "table" and info.ToolType == "Dropped Fruit" then
            return true
        end
    end
    return string.find(string.lower(inst.Name), "fruit", 1, true) ~= nil
end

local SkipFruits = setmetatable({}, { __mode = "k" })      -- [instância] = os.clock() + cooldown (frutas ignoradas temporariamente)

local function fruitPart(f)
    return f:FindFirstChild("Handle") or f.PrimaryPart or f:FindFirstChildWhichIsA("BasePart", true)
end

local RARITY_COLORS = {
    Common    = Color3.fromRGB(200, 210, 225),
    Uncommon  = Color3.fromRGB(74, 222, 128),
    Rare      = Color3.fromRGB(96, 165, 250),
    Epic      = Color3.fromRGB(192, 132, 252),
    Legendary = Color3.fromRGB(251, 191, 36),
    Mythical  = Color3.fromRGB(248, 113, 113),
}

local RARITY_PT = {
    Common    = "Comum",
    Uncommon  = "Incomum",
    Rare      = "Rara",
    Epic      = "Épica",
    Legendary = "Lendária",
    Mythical  = "Mítica",
}

local FRUIT_RARITY_FALLBACK = {
    ["Buddha Fruit"]   = "Mythical",
    ["Forest Fruit"]   = "Mythical",
    ["Gravity Fruit"]  = "Mythical",
    ["Operator Fruit"] = "Mythical",
    ["Venom Fruit"]    = "Mythical",
    ["Dark Fruit"]     = "Legendary",
    ["Ice Fruit"]      = "Legendary",
    ["Light Fruit"]    = "Legendary",
    ["Mirror Fruit"]   = "Legendary",
    ["Divide Fruit"]   = "Epic",
    ["Flame Fruit"]    = "Epic",
    ["Magma Fruit"]    = "Epic",
    ["Sand Fruit"]     = "Epic",
    ["Barrier Fruit"]  = "Rare",
    ["Bomb Fruit"]     = "Rare",
    ["Haze Fruit"]     = "Rare",
    ["Rubber Fruit"]   = "Rare",
    ["Kilo Fruit"]     = "Common",
    ["Thorn Fruit"]    = "Common",
}

local function fruitRarity(target)
    local isInst = typeof(target) == "Instance"
    if isInst then
        local attr = target:GetAttribute("Rarity")
        if type(attr) == "string" and attr ~= "" then return attr end
    end
    local name = isInst and (target:GetAttribute("OriginalName") or target.Name) or tostring(target)
    if MainModules and MainModules.ToolsInfo then
        local ok, info = pcall(function() return MainModules.ToolsInfo:Get(name) end)
        if ok and type(info) == "table" and type(info.Rarity) == "string" then
            return info.Rarity
        end
    end
    return FRUIT_RARITY_FALLBACK[name]
end

-- Um único filtro compartilhado pela coleta e pelo armazenamento.
-- Exige que ao menos uma raridade correspondente esteja marcada no dropdown.
function GameClient.FruitMatchesRarityFilter(target)
    local selected = CFG.TargetFruitRarities
    if not selected or next(selected) == nil then return false end
    local rarity = fruitRarity(target)
    return rarity ~= nil and selected[rarity] == true
end

local function purgeFruitESPOn(inst)
    if not inst then return end
    for _, desc in ipairs(inst:GetDescendants()) do
        if desc:IsA("Highlight") then
            if desc.Name == "MidgardFruitHL"
                or desc:GetAttribute("MidgardFruitESP") == true
                or (desc.Name == "Highlight" and desc.DepthMode == Enum.HighlightDepthMode.AlwaysOnTop and math.abs(desc.FillTransparency - 0.55) < 0.02)
            then
                pcall(function() desc:Destroy() end)
            end
        elseif desc:IsA("BillboardGui") then
            if desc.Name == "MidgardFruitBB"
                or desc:GetAttribute("MidgardFruitESP") == true
                or (desc.Name == "BillboardGui" and desc.AlwaysOnTop == true and desc.StudsOffset == Vector3.new(0, 3, 0))
            then
                pcall(function() desc:Destroy() end)
            end
        end
    end
end

local function clearFruitESP(f, d)
    if d then
        if d.hl then pcall(function() d.hl:Destroy() end) end
        if d.bb then pcall(function() d.bb:Destroy() end) end
        d.hl, d.bb, d.lbl = nil, nil, nil
    end
    if f then purgeFruitESPOn(f) end
end

local function attachFruitESP(f, d)
    if not (CFG.FruitESP and f and f.Parent and d) then return end
    local part = fruitPart(f)
    if not part then return end
    if d.hl and d.hl.Parent and d.bb and d.bb.Parent then
        pcall(function() d.hl.Enabled = true end)
        pcall(function() d.bb.Enabled = true; d.bb.Adornee = part end)
        return
    end
    clearFruitESP(f, d)

    local col = d.col or Color3.fromRGB(255, 200, 40)
    local hl = Instance.new("Highlight")
    hl.Name = "MidgardFruitHL"
    hl:SetAttribute("MidgardFruitESP", true)
    hl.FillColor, hl.OutlineColor = col, Color3.new(1, 1, 1)
    hl.FillTransparency = 0.55
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = f
    hl.Enabled = true
    hl.Parent = f

    local bb = Instance.new("BillboardGui")
    bb.Name = "MidgardFruitBB"
    bb:SetAttribute("MidgardFruitESP", true)
    bb.Size, bb.AlwaysOnTop, bb.StudsOffset = UDim2.fromOffset(200, 42), true, Vector3.new(0, 3, 0)
    bb.Adornee = part
    bb.Enabled = true
    local lbl = Instance.new("TextLabel", bb)
    lbl.Size, lbl.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    lbl.Font, lbl.TextSize = Enum.Font.GothamBold, 14
    lbl.TextColor3, lbl.TextStrokeTransparency = col, 0.25
    lbl.Text = ("[%s] %s"):format(d.rarityLabel or "?", f.Name)
    bb.Parent = part

    d.hl, d.bb, d.lbl = hl, bb, lbl
end

local function addFruit(f, retryCount)
    if Fruits[f] then
        if CFG.FruitESP then attachFruitESP(f, Fruits[f]) end
        return
    end
    if not isFruit(f) then return end
    local part = fruitPart(f)
    if not part then
        local tries = retryCount or 0
        if tries < 4 then
            task.delay(0.5, function() if f.Parent and CFG.FruitDetector then addFruit(f, tries + 1) end end)
        end
        return
    end
    local rarity = fruitRarity(f)
    local rarityLabel = RARITY_PT[rarity] or rarity or "?"
    local toolColors = MainModules and MainModules.ToolsUtils and MainModules.ToolsUtils.RarityColors
    local col = (toolColors and toolColors[rarity]) or RARITY_COLORS[rarity] or Color3.fromRGB(255, 200, 40)

    local d = { hl = nil, bb = nil, lbl = nil, col = col, rarity = rarity, rarityLabel = rarityLabel, t = os.clock() }
    Fruits[f] = d
    if CFG.FruitESP then
        attachFruitESP(f, d)
    else
        purgeFruitESPOn(f)
    end
    if CFG.FruitNotify then
        notify("🍎 Fruta detectada", ("[%s] %s"):format(rarityLabel, f.Name))
    end

    local cAnc
    cAnc = SafeRuntime.Connect(f.AncestryChanged, "FruitAncestry", function(_, parent)
        if not parent or not f:IsDescendantOf(workspace) then
            local cur = Fruits[f]
            clearFruitESP(nil, cur)
            Fruits[f] = nil
            SkipFruits[f] = nil
            if cAnc then
                cAnc:Disconnect()
                cAnc = nil
            end
        end
    end)
end

local hookedDroppedTools = nil
local function hookFruitFolder()
    local dt = playability("DroppedTools")
    if dt and hookedDroppedTools ~= dt then
        hookedDroppedTools = dt
        track(SafeRuntime.Connect(dt.ChildAdded, "FruitDroppedAdded", function(c) if CFG.FruitDetector then task.defer(addFruit, c) end end))
    end
    return dt
end

local function scanFruits()
    local dt = hookFruitFolder()
    if not dt then return end
    for _, c in ipairs(dt:GetChildren()) do addFruit(c) end
end
GameClient.ScanFruits = scanFruits
GameClient.SetFruitESP = function(on)
    CFG.FruitESP = (on == true)
    if not CFG.FruitESP then
        for f, d in pairs(Fruits) do
            clearFruitESP(f, d)
        end
        purgeFruitESPOn(playability("DroppedTools"))
    else
