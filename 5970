local giverCache = {}
local function giverPos(giverName)
    local cached = giverCache[giverName]
    if cached and (os.clock() - cached.t) < 8 then
        return cached.pos
    end
    local function tryFind(name)
        local officialPos = GameClient.ValuePosition(GameClient.GetInterestPoint("Character_" .. name))
        if officialPos then return officialPos end
        -- Fallback: search workspace for NPC model
        local chars = playability("Characters")
        if chars then
            for _, m in ipairs(chars:GetChildren()) do
                if m:IsA("Model") then
                    local orig = m:GetAttribute("OriginalName") or m.Name
                    if orig == name or m.Name == name then
                        local hrp = m:FindFirstChild("HumanoidRootPart")
                        if hrp then return hrp.Position end
                        return m:GetPivot().Position
                    end
                end
            end
        end
        -- Fallback: check IgnoreList.Int.NPCs (ex: NPCs.Quests.History["Golden Dunes"]["Defeated Narmer"])
        local ign = workspace:FindFirstChild("IgnoreList")
        local npcsF = ign and ign:FindFirstChild("Int") and ign.Int:FindFirstChild("NPCs")
        if npcsF then
            for _, d in ipairs(npcsF:GetDescendants()) do
                if d.Name == name then
                    if d:IsA("BasePart") then return d.Position end
                    if d:IsA("Model") then
                        local hr = d:FindFirstChild("HumanoidRootPart")
                        return hr and hr.Position or d:GetPivot().Position
                    end
                    if d:IsA("CFrameValue") then return d.Value.Position end
                    if d:IsA("Vector3Value") then return d.Value end
                end
            end
        end
        -- Fallback: check NPC anchors
        local anc = ReplicatedStorage:FindFirstChild("NpcAnchors")
        local v = anc and anc:FindFirstChild(name)
        if v and v:IsA("Vector3Value") then return v.Value end
        if v and v:IsA("CFrameValue") then return v.Value.Position end
        -- Last fallback: deep search workspace
        for _, m in ipairs(workspace:GetDescendants()) do
            if m:IsA("Model") and m.Name == name then return m:GetPivot().Position end
        end
        return nil
    end

    local pos = tryFind(giverName)
    if not pos then
        local spaced = giverName:gsub("(%l)(%u)", "%1 %2")
        if spaced ~= giverName then
            pos = tryFind(spaced)
        end
    end
    if pos then
        giverCache[giverName] = { pos = pos, t = os.clock() }
    end
    return pos
end

