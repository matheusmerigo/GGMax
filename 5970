local function findPrivateAreaDoor(interiorObj, wantLeave)
    if not interiorObj then return nil end
    local subName = wantLeave and "Leave" or "Enter"
    local directSub = interiorObj:FindFirstChild(subName)
    if directSub then
        local ent = directSub:FindFirstChild("Entrance")
        local v = ent and extractVec3(ent) or directSub:GetAttribute("Entrance")
        if v then return v end
    end
    local ign = workspace:FindFirstChild("IgnoreList")
    local intF = ign and ign:FindFirstChild("Int")
    local priv = intF and intF:FindFirstChild("PrivateAreas")
    local minV, maxV = getInteriorBounds(interiorObj)
    if priv then
        local normInt = tostring(interiorObj.Name):gsub("%s+", "")
        if normInt == "BlazeboundRoom" then normInt = "BlazeboundArena" end
        for _, islandF in ipairs(priv:GetChildren()) do
            for _, placeF in ipairs(islandF:GetChildren()) do
                local normPlace = tostring(placeF.Name):gsub("%s+", "")
                if normPlace == normInt then
                    local targetSub = placeF:FindFirstChild(subName)
                    local ent = targetSub and targetSub:FindFirstChild("Entrance")
                    local v = ent and extractVec3(ent) or (targetSub and targetSub:GetAttribute("Entrance"))
                    if v then return v end
                end
                local enterF = placeF:FindFirstChild("Enter")
                local dst = enterF and enterF:FindFirstChild("Destination")
                local dstPos = dst and extractVec3(dst) or (enterF and enterF:GetAttribute("Destination"))
                if dstPos and minV and maxV then
                    local m = 35
                    if dstPos.X >= minV.X - m and dstPos.X <= maxV.X + m
                        and dstPos.Y >= minV.Y - m and dstPos.Y <= maxV.Y + m
                        and dstPos.Z >= minV.Z - m and dstPos.Z <= maxV.Z + m then
                        local targetSub = placeF:FindFirstChild(subName)
                        local ent = targetSub and targetSub:FindFirstChild("Entrance")
                        local v = ent and extractVec3(ent) or (targetSub and targetSub:GetAttribute("Entrance"))
                        if v then return v end
                    end
                end
            end
        end
    end
    -- Fallback: interiores que usam QuestZones (Enter_* / Leave_*) em Frost Island, Rustfall, Shark Park, Windhaven
    local dataF = ign and ign:FindFirstChild("Data")
    local questsF = dataF and dataF:FindFirstChild("Quests")
    local zonesF = questsF and questsF:FindFirstChild("Zones")
    if zonesF then
        if wantLeave then
            local leaveZoneMap = {
                ["Lighthouse Interior"] = "Leave_Lighthouse_FI",
                ["Yeti Cave"] = "Leave_YetiCave_FI",
                ["Abandoned Laboratory"] = "Leave_Lab_SL",
                ["Iron Lotus Chamber"] = "Leave_IronLotus_SL",
                ["Tablatura"] = "Leave_Tablet_SL",
                ["Upper Archive"] = "Leave_Archive_SL",
                ["Storm Keeper's House"] = "Leave_KeeperHouse_FS",
                ["Submerged Cavern"] = "Leave_Cave_SP",
                ["Ancient Structure"] = "Leave_AncientStructure_SU",
                ["Coliseum Backstage"] = "Leave_Backstage_VAL",
                ["Prison Interior"] = "Leave_PrisonLift_PI",
                ["Black Market"] = "Leave_Hideout_GD",
            }
            local lzName = leaveZoneMap[interiorObj.Name]
            if lzName then
                local lzp = GameClient.findQuestZonePos(lzName) or (lzName == "Leave_Cave_SP" and GameClient.findQuestZonePos("Leave_Well_SP"))
                if lzp then return lzp, lzName end
            end
            if minV and maxV then
                local m = 35
                for _, isl in ipairs(zonesF:GetChildren()) do
                    for _, z in ipairs(isl:GetChildren()) do
                        if z.Name:sub(1, 6) == "Leave_" then
                            local zp = extractVec3(z)
                            if zp and zp.X >= minV.X - m and zp.X <= maxV.X + m
                                and zp.Y >= minV.Y - 160 and zp.Y <= maxV.Y + m
                                and zp.Z >= minV.Z - m and zp.Z <= maxV.Z + m then
                                return zp
                            end
                        end
                    end
                end
            end
        elseif not wantLeave then
            local enterZoneMap = {
                ["Lighthouse Interior"] = "Enter_Lighthouse_FI",
                ["Yeti Cave"] = "Enter_YetiCave_FI",
                ["Abandoned Laboratory"] = "Enter_Lab_SL",
                ["Iron Lotus Chamber"] = "Enter_IronLotus_SL",
                ["Tablatura"] = "Enter_Tablet_SL",
                ["Upper Archive"] = "Enter_Archive_SL",
                ["Storm Keeper's House"] = "Enter_KeeperHouse_FS",
                ["Submerged Cavern"] = "Enter_Well_SP",
                ["Ancient Structure"] = "Enter_AncientStructure_SU",
                ["Coliseum Backstage"] = "Enter_Backstage_VAL",
                ["Prison Interior"] = "Enter_PrisonLift_PI",
                ["Black Market"] = "Enter_Canals_GD",
            }
            local zName = enterZoneMap[interiorObj.Name]
            if zName then
                local zp = GameClient.findQuestZonePos(zName)
                if zp then return zp, zName end
            end
        end
    end
    return nil
end

local doorEnteredCooldownUntil = 0

function GameClient.ResolveWithInteriorRoutes(targetPos, objectiveId)
    local routes = MainModules and MainModules.InteriorRoutes
    local points = MainModules and MainModules.InterestPoints
    if not (targetPos and routes and points and type(points.Set) == "function" and type(routes.Resolve) == "function") then
        return nil, false
    end
    local ok, routed = pcall(function()
        local target = points.Set("VM_AutoTarget", CFrame.new(targetPos))
        local result = routes.Resolve(target)
        if type(routes.ResolveUnderground) == "function" then
            result = routes.ResolveUnderground(result)
        end
        return result, target
    end)
    if not ok or not routed then return nil, false end
    local routedPos = GameClient.ValuePosition(routed)
    if not routedPos then return nil, false end
    local routedName = typeof(routed) == "Instance" and routed.Name or ""
    local isDoor = routedName ~= "" and (routedName ~= "VM_AutoTarget" or routedName:sub(1, 5) == "Door_")
    if isDoor then
        debugLog("route_debug.txt", ("MODULE_ROUTE oid=%s via=%s target=%s"):format(
            tostring(objectiveId), tostring(routedName), tostring(targetPos)
        ))
        return routedPos, true
    end
    return routedPos, false
end

local function resolveObjectivePoint(obj)
    if not obj then return nil, false end
    disableQuestTrailMarkers()

    -- Objetivos que mudam o ponto dinamicamente via InterestPoint() (irmão caído, baú caído, carrinho de suprimentos)
    if (obj.ObjectiveID == "Escort_Brother" or obj.ObjectiveID == "Talk_OrangeTownTrainer_Treasure" or obj.ObjectiveID == "Deliver_SupplyCart_VAL") and obj.InterestPoint then
        local ok, pt = pcall(obj.InterestPoint)
        if ok and pt then
            local v = extractVec3(pt)
            if v then return v, false end
        end
    end

    local directPos = resolveDirectObjectivePoint(obj)
    local _, myHrp = getChar()
    -- Regra global: ignora marcadores de trilha intermediários (Trail/InterestPoints) e vai direto para a QuestZone real no mesmo andar e mesmo ambiente (interior vs exterior)
    if myHrp and obj.ObjectiveID then
        local ignZ = workspace:FindFirstChild("IgnoreList")
        local zRoot = ignZ and ignZ:FindFirstChild("Data") and ignZ.Data:FindFirstChild("Quests") and ignZ.Data.Quests:FindFirstChild("Zones")
        local zPart = nil
        if zRoot then
            for _, isl in ipairs(zRoot:GetChildren()) do
                local f = isl:FindFirstChild(obj.ObjectiveID)
                if f then zPart = extractVec3(f); break end
            end
        end
        if zPart and getInteriorContainer(myHrp.Position) == getInteriorContainer(zPart) then
            local sameFloor = (myHrp.Position.Y > 2500 and zPart.Y > 2500)
                or (myHrp.Position.Y > -200 and myHrp.Position.Y <= 2500 and zPart.Y > -200 and zPart.Y <= 2500 and (myHrp.Position - zPart).Magnitude < 2000)
            if sameFloor and (not directPos or (directPos - zPart).Magnitude > 15) then
                return zPart, false
            end
        end
    end
    -- Ponte automática Windhaven (Y > 2500) <-> Rustfall (Y <= 2500) via Zeppelin
    if myHrp and directPos then
        if myHrp.Position.Y > 2500 and directPos.Y < 2000 then
            return GameClient.findQuestZonePos("Board_LowerZeppelin_SL") or Vector3.new(6446, 3432, 10350), true
        elseif myHrp.Position.Y <= 2500 and directPos.Y > 2500 and not getInteriorContainer(myHrp.Position) then
            return GameClient.findQuestZonePos("Board_UpperZeppelin_SL") or Vector3.new(6600, 1432, 8933), true
        end
    end
    -- InteriorRoutes é a fonte oficial do jogo para portas Enter/Leave e rotas
    -- subterrâneas. A lógica manual abaixo fica apenas como fallback de streaming.
    if directPos then
        local routedPos, routedDoor = GameClient.ResolveWithInteriorRoutes(directPos, obj.ObjectiveID)
        if routedDoor then return routedPos, true end
    end
    local playerInterior = myHrp and getInteriorContainer(myHrp.Position) or nil
    local targetInterior = directPos and getInteriorContainer(directPos) or nil

    -- 1) Se ambos estão dentro do mesmo interior (ou na mesma sala subterrânea Y < -200 dentro de 700 studs),
    -- JÁ estamos no ambiente correto! Evita mismatch quando a sala só carregou parcialmente no streaming.
    if (playerInterior and targetInterior and playerInterior == targetInterior)
        or (myHrp and directPos and myHrp.Position.Y < -200 and directPos.Y < -200
            and (myHrp.Position - directPos).Magnitude < 700 and math.abs(myHrp.Position.Y - directPos.Y) < 180) then
        return directPos, false
    end

    -- 2) Se acabamos de entrar pela porta (cooldown) ou o objetivo é dentro deste Interior (ex: Talk_/Buy_),
    -- ficamos no ambiente atual e vamos direto ao alvo/NPC!
    local oidStr = obj.ObjectiveID or ""
    local isNpcObj = oidStr:sub(1, 5) == "Talk_" or oidStr:sub(1, 4) == "Buy_"
        or oidStr:sub(1, 8) == "Deliver_" or oidStr:sub(1, 7) == "Return_" or oidStr:sub(1, 7) == "Report_"
    if playerInterior and (not targetInterior or os.clock() < doorEnteredCooldownUntil) then
        if directPos and myHrp and (myHrp.Position - directPos).Magnitude < 700 and math.abs(myHrp.Position.Y - directPos.Y) < 180 then
            return directPos, false
        end
        if isNpcObj and myHrp then
            local nearNpc = findNpcNear(myHrp.Position, 120)
            if nearNpc then return nearNpc, false end
        end
    end

    -- 3) Checagem de proximidade direta (para NPCs externos ou salas sem pasta Interiors)
    if directPos and myHrp and (myHrp.Position - directPos).Magnitude < 120 and playerInterior == targetInterior then
        return directPos, false
    end

    -- 3.5) Se estamos DENTRO de um interior e o alvo está fora ou em OUTRO interior,
    -- antes de sair por Leave, verifica se InterestPoint já aponta para uma porta DENTRO do interior atual (ex: Enter_Arena_VAL dentro de Coliseum Backstage)!
    if playerInterior and playerInterior ~= targetInterior and (targetInterior ~= nil or (directPos and myHrp and ((myHrp.Position - directPos).Magnitude > 700 or math.abs(myHrp.Position.Y - directPos.Y) >= 180))) then
        if obj.InterestPoint then
            local okIp, ptIp = pcall(obj.InterestPoint)
            local ipV = okIp and ptIp and extractVec3(ptIp)
            local ipIsDoor = typeof(ptIp) == "Instance" and type(ptIp.Name) == "string"
                and (ptIp.Name:sub(1, 6) == "Enter_" or ptIp.Name:sub(1, 6) == "Leave_" or ptIp.Name == "Return_Backstage_VAL")
                and (ptIp.Name:sub(1, 6) == "Enter_" or ptIp.Name:sub(1, 6) == "Leave_" or ptIp.Name:sub(1, 6) == "Board_" or ptIp.Name == "Return_Backstage_VAL")
            if ipIsDoor and ipV and myHrp and math.abs(ipV.Y - myHrp.Position.Y) < 180 and (ipV - myHrp.Position).Magnitude < 650 then
                return ipV, true
            end
        end
        local leaveDoor = findPrivateAreaDoor(playerInterior, true)
        if leaveDoor then return leaveDoor, true end
    end

    -- 4) Try the InterestPoint function (uses InteriorRoutes.Resolve when outside)
    if obj.InterestPoint then
        local ok, pt = pcall(obj.InterestPoint)
        if ok and pt then
            local isDoor = typeof(pt) == "Instance" and (
                (type(pt.Name) == "string" and (pt.Name:sub(1, 5) == "Door_" or pt.Name == "Entrance" or pt.Name:sub(1, 6) == "Enter_" or pt.Name:sub(1, 6) == "Leave_" or pt.Name:sub(1, 6) == "Board_" or pt.Name == "Return_Backstage_VAL"))
                or pt:FindFirstAncestor("PrivateAreas") ~= nil
            )
            -- Se apontou para uma porta _Leave ou Enter_* mas já estamos no mesmo interior/andar que o alvo, ignora a porta!
            local isLeaveOrEnter = type(pt.Name) == "string" and (pt.Name:sub(-6) == "_Leave" or pt.Name:sub(1, 6) == "Enter_")
            if isDoor and isLeaveOrEnter and playerInterior and (playerInterior == targetInterior or (os.clock() < doorEnteredCooldownUntil and directPos and myHrp and math.abs(myHrp.Position.Y - directPos.Y) < 180)) then
                if directPos then return directPos, false end
            end
            local v = extractVec3(pt)
            if v then
                -- Regra obrigatória: se estamos na superfície (Y > -150) e InterestPoint retornou um ponto subterrâneo (Y < -200) sem ser porta,
                -- NÃO retorna direto! Deixa o passo 5 achar a porta Enter.
                if not isDoor and v.Y < -200 and (not myHrp or myHrp.Position.Y > -150) then
                    targetInterior = targetInterior or getInteriorContainer(v)
                else
                    return v, isDoor
                end
            end
        end
    end

    -- 5) Regra obrigatória para todos os interiores:
    -- Nunca dar tween direto para dentro ou para fora de um interior! Sempre usar a porta Enter/Leave.
    if playerInterior and playerInterior ~= targetInterior then
        local leaveDoor = findPrivateAreaDoor(playerInterior, true)
        if leaveDoor then return leaveDoor, true end
    elseif not playerInterior and targetInterior then
        local enterDoor = findPrivateAreaDoor(targetInterior, false)
        if enterDoor then return enterDoor, true end
    elseif not playerInterior and directPos and directPos.Y < -200 then
        -- Regra global: nunca retornar ponto subterrâneo (Y < -200) direto quando estamos na superfície!
        if (Vector3.new(directPos.X, 0, directPos.Z) - Vector3.new(10990.6, 0, 1000.4)).Magnitude < 4200 then
            return GameClient.findQuestZonePos("Enter_PrisonLift_PI") or Vector3.new(10992.0, 33.0, 995.0), true
        end
    end

    if directPos then return directPos, false end
    return nil, false
end

Movement.WaitAreaSettle = function(beforePos, destinationPos, targetInt, wantEnter, isAborted, getInteriorContainerFn)
    local tWait = os.clock() + 12.0
    while not (isAborted and isAborted()) and os.clock() < tWait do
        local _, h2, hum2 = getChar()
        if not h2 or not hum2 or hum2.Health <= 0 then return false end
        local moved = (typeof(destinationPos) == "Vector3" and (h2.Position - destinationPos).Magnitude < 45)
            or (h2.Position - beforePos).Magnitude >= 50
            or (wantEnter and targetInt and getInteriorContainerFn and getInteriorContainerFn(h2.Position) == targetInt)
        if moved then
            return Movement.WaitPostTeleport(Movement.POST_TELEPORT_WAIT, isAborted)
        end
        task.wait(0.15)
    end
    return false
end

Movement.WaitUniversalCooldown = function(abortFn, minWait)
    local rem = (Movement.lastInteractAt or 0) + (Movement.INTERACT_COOLDOWN or 5.0) - os.clock()
    local waitSec = math.max(rem, minWait or 0)
    if waitSec <= 0 then return true end
    local deadline = os.clock() + waitSec
    while os.clock() < deadline do
        if abortFn and abortFn() then return false end
        task.wait(0.15)
    end
    return not (abortFn and abortFn())
end

Movement.BeginInteract = function(abortFn, minWait)
    if not Movement.WaitUniversalCooldown(abortFn, minWait) then return false end
    Movement.lastInteractAt = os.clock()
    return true
end

local function useGenericDoor(doorPos, zDoorName, targetInt, wantEnter, aborted, doorSub)
    if typeof(doorPos) ~= "Vector3" then return false end
    local function isAborted() return aborted and aborted() end
    task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(doorPos) end) end)
    tweenTo(CFrame.new(doorPos + Vector3.new(0, 1.5, 0)), aborted)
    cancelTween()
    local _, hDrop = getChar()
    if hDrop then hDrop.AssemblyLinearVelocity = Vector3.zero end
    if isAborted() then return false end
    -- Regra universal de Entrance: solta na entrada e aguarda 3s antes de entrar/sair
    local twPre = os.clock() + 3.0
    while os.clock() < twPre do
        if isAborted() then return false end
        task.wait(0.15)
    end
    Movement.lastInteractAt = os.clock()
    local _, hChk = getChar()
    if not hChk then return false end
    local beforeP = hChk.Position

    if zDoorName then
        local icP = GameClient.getInteractionClient()
        if icP and icP.Interaction and icP.Interaction.Contexts and not icP.Interaction.Contexts[zDoorName] then
            local tCtx = os.clock() + 1.0
            while os.clock() < tCtx and not isAborted() do
                if icP.Interaction.Contexts[zDoorName] then break end
                task.wait(0.1)
            end
        end
        GameClient.fireInteractionContext(zDoorName)
        GameClient.pressInteract(0.35, zDoorName)
        task.wait(zDoorName == "Leave_PrisonLift_PI" and 1.6 or 0.8)
        pcall(function() GameModules.Network:FireServer("QuestZones", zDoorName, "Use") end)
    else
        pcall(function()
            local icP = GameClient.getInteractionClient()
            local areaSub = (icP and icP.PrivateAreas and icP.PrivateAreas.Current) or doorSub
            if areaSub then
                GameModules.Network:FireServer("PrivateAreas", "EnterArea", areaSub)
            end
        end)
        GameClient.pressInteract(0.35, "Enter Area")
    end

    local destInst = typeof(doorSub) == "Instance" and doorSub:FindFirstChild("Destination")
    local destPos = (destInst and extractVec3(destInst))
        or (typeof(doorSub) == "Instance" and doorSub:GetAttribute("Destination"))
        or nil
    return Movement.WaitAreaSettle(beforeP, destPos, targetInt, wantEnter, isAborted, getInteriorContainer)
end

local function findPrivateAreaByDestination(pos)
    local ign = workspace:FindFirstChild("IgnoreList")
    local priv = ign and ign:FindFirstChild("Int") and ign.Int:FindFirstChild("PrivateAreas")
    if not priv then return nil, nil end
    local bestEnt, bestSub, bestDist = nil, nil, 450
    for _, islandF in ipairs(priv:GetChildren()) do
        for _, placeF in ipairs(islandF:GetChildren()) do
            local enterF = placeF:FindFirstChild("Enter")
            if enterF then
                local dst = enterF:FindFirstChild("Destination")
                local dstPos = (dst and extractVec3(dst)) or enterF:GetAttribute("Destination")
                if typeof(dstPos) == "Vector3" and math.abs(dstPos.Y - pos.Y) < 180 then
                    local d = (Vector3.new(dstPos.X, 0, dstPos.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude
                    if d < bestDist then
                        local ent = enterF:FindFirstChild("Entrance")
                        local entPos = (ent and extractVec3(ent)) or enterF:GetAttribute("Entrance")
                        if typeof(entPos) == "Vector3" then
                            bestDist, bestEnt, bestSub = d, entPos, enterF
                        end
                    end
                end
            end
        end
    end
    return bestEnt, bestSub
end

Movement.TryLeaveGenericInterior = function(pos, aborted)
    local _, hrp = getChar()
    if not hrp then return false end
    local playerInt = getInteriorContainer(hrp.Position)
    local targetInt = getInteriorContainer(pos)
    if playerInt and playerInt ~= targetInt then
        local zd, zn = findPrivateAreaDoor(playerInt, true)
        if zd then
            return useGenericDoor(zd, zn, targetInt, false, aborted, nil)
        end
    end
    return false
end

Movement.TryEnterGenericInterior = function(pos, aborted)
    local _, hrp = getChar()
    if not hrp then return false end
    local playerInt = getInteriorContainer(hrp.Position)
    local targetInt = getInteriorContainer(pos)
    if targetInt and playerInt ~= targetInt then
        local zd, zn = findPrivateAreaDoor(targetInt, false)
        if zd then
            return useGenericDoor(zd, zn, targetInt, true, aborted, nil)
        end
