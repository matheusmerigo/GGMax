local function findQuestZonePos(zoneName)
    -- 0) Check AreaAssets.QuestZone directly (official game helper)
    if MainModules and MainModules.AreaAssets and MainModules.AreaAssets.QuestZone then
        local ok, qz = pcall(MainModules.AreaAssets.QuestZone, zoneName)
        local pos = ok and GameClient.ValuePosition(qz)
        if pos then return pos end
    end
    -- 1) Check InterestPoints
    local interestPos = GameClient.ValuePosition(GameClient.GetInterestPoint(zoneName))
    if interestPos then return interestPos end
    -- 2) Check workspace.IgnoreList.Data.Quests.Zones (game's AreaAssets.QuestZone)
    local il = workspace:FindFirstChild("IgnoreList")
    local data = il and il:FindFirstChild("Data")
    local quests = data and data:FindFirstChild("Quests")
    if quests then
        -- Search in Zones subfolder
        local zones = quests:FindFirstChild("Zones")
        if zones then
            for _, area in ipairs(zones:GetChildren()) do
                local part = area:FindFirstChild(zoneName)
                if part and part:IsA("BasePart") then return part.Position end
            end
        end
        -- Search in InterestPoints subfolder
        local ips = quests:FindFirstChild("InterestPoints")
        if ips then
            for _, area in ipairs(ips:GetChildren()) do
                local part = area:FindFirstChild(zoneName)
                if part and part:IsA("BasePart") then return part.Position end
            end
        end
    end
    -- 3) Deep search workspace (com cache de instância)
    Features._questZoneCache = Features._questZoneCache or setmetatable({}, { __mode = "v" })
    local cachedInst = Features._questZoneCache[zoneName]
    if cachedInst and cachedInst.Parent then
        if cachedInst:IsA("BasePart") then return cachedInst.Position end
        if cachedInst:IsA("Model") then return cachedInst:GetPivot().Position end
    end
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc.Name == zoneName then
            if desc:IsA("BasePart") then
                Features._questZoneCache[zoneName] = desc
                return desc.Position
            end
            if desc:IsA("Model") then
                Features._questZoneCache[zoneName] = desc
                return desc:GetPivot().Position
            end
        end
    end
    return nil
end

