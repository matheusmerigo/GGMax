                                        isDoor = false
                                    end
                                    distToPos = (hNav and pos) and (hNav.Position - pos).Magnitude or 0
                                end
                            end
                            -- 1.5) Viagem longa (>= 3000 studs): usa Mirror Keeper se a ilha estiver descoberta e tiver Gold suficiente
                            if distToPos >= 3000 and not (LP.Character and LP.Character:GetAttribute("CarriedChest") ~= nil) then
