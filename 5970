function GameClient.IsWorldBossName(name)
    if type(name) ~= "string" or name == "" then return false end
    if name:sub(1, 7) == "Wanted " then return true end
    if type(GameClient.BOSS_LIST) == "table" then
        for _, it in ipairs(GameClient.BOSS_LIST) do
            if it[1] == name then return true end
        end
    end
    local ign = workspace:FindFirstChild("IgnoreList")
    local dataF = ign and ign:FindFirstChild("Data")
    local beacons = dataF and dataF:FindFirstChild("BossBeacons")
    if beacons and beacons:FindFirstChild(name) ~= nil then return true end
    local respawns = dataF and dataF:FindFirstChild("BossRespawns")
    if respawns and respawns:FindFirstChild(name) ~= nil then return true end
    return false
