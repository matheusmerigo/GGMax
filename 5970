Movement.WaitPostTeleport = function(postWaitSec, abortFn, statusText)
    local waitSec = tonumber(postWaitSec) or Movement.POST_TELEPORT_WAIT or 3.0
    local loadDeadline = os.clock() + 10.0
    while os.clock() < loadDeadline do
        if abortFn and abortFn() then return false end
        local covered = false
        if MainModules and MainModules.ScreenTransition and MainModules.ScreenTransition.IsCovered then
            local okCov, isCov = pcall(function() return MainModules.ScreenTransition:IsCovered() == true end)
            if okCov and isCov then covered = true end
        end
        local tpAttr = LP and LP:GetAttribute("Elysium_Teleporting") ~= nil
        local _, h = getChar()
        local anchored = (h and h.Anchored == true) or false
        if not covered and not tpAttr and not anchored then
            break
        end
        task.wait(0.15)
    end
    if statusText then Status = statusText end
    local waitEnd = os.clock() + waitSec
    while os.clock() < waitEnd do
        if abortFn and abortFn() then return false end
        task.wait(0.15)
    end
    return not (abortFn and abortFn())
end

function Movement.UseVolcanoPrivateDoor(placeName, subName, aborted)
    local ign = workspace:FindFirstChild("IgnoreList")
    local paVolc = ign and ign:FindFirstChild("Int") and ign.Int:FindFirstChild("PrivateAreas") and ign.Int.PrivateAreas:FindFirstChild("Volcano Island")
    local place = paVolc and paVolc:FindFirstChild(placeName)
    local sub = place and place:FindFirstChild(subName)
    if not sub then return false end
    local ent = sub:FindFirstChild("Entrance")
    local dst = sub:FindFirstChild("Destination")
    local entPos = ent and (ent:IsA("BasePart") and ent.Position or (ent:IsA("Model") and ent:GetPivot().Position)) or sub:GetAttribute("Entrance")
    local dstPos = dst and (dst:IsA("BasePart") and dst.Position or (dst:IsA("Model") and dst:GetPivot().Position)) or sub:GetAttribute("Destination")
    if typeof(entPos) ~= "Vector3" then return false end
    Status = ("Volcano: usando porta %s (%s)..."):format(placeName, subName)
    task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(entPos) end) end)
    tweenTo(CFrame.new(entPos + Vector3.new(0, 2.5, 0)), aborted)
    -- Regra universal de Entrance: espera 3s ao chegar antes de entrar/sair
    local twPre = os.clock() + 3.0
    while os.clock() < twPre do
        if aborted and aborted() then return false end
        task.wait(0.15)
    end
    for _ = 1, 3 do
        if aborted and aborted() then return false end
        local _, h = getChar()
        if h and (h.Position - entPos).Magnitude > 5 and (h.Position - entPos).Magnitude < 60 then
            h.CFrame = CFrame.new(entPos + Vector3.new(0, 2.5, 0))
            h.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.15)
        end
        pcall(function()
            local ic = GameClient.GetInteractionClient()
            if ic and ic.Interaction and ic.Interaction.Interacted then
                ic.Interaction.Interacted:Fire("Enter Area")
            end
        end)
        pcall(function() GameModules.Network:FireServer("PrivateAreas", "EnterArea", sub) end)
        if VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.2)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end)
        end
        local t0 = os.clock()
        while os.clock() - t0 < 2.2 do
            if aborted and aborted() then return false end
            local _, hNow = getChar()
            if hNow and typeof(dstPos) == "Vector3" and ((hNow.Position - dstPos).Magnitude < 160 or math.abs(hNow.Position.Y - dstPos.Y) < 160) then
                return Movement.WaitPostTeleport(Movement.POST_TELEPORT_WAIT, aborted)
            end
            task.wait(0.15)
        end
    end
    return false
end

GameClient.ISLAND_ALIASES = {
    ["Bastion Reach"] = "MarineFord",
    ["Marine Ford"] = "MarineFord",
    ["MarineFord"] = "MarineFord",
    ["Kraken's Rest"] = "Kraken's rest",
    ["Prison Island"] = "Prison",
    ["Neruvia"] = "Nerúvia",
    ["Nautilia"] = "Nerúvia",
    ["Solmar Prologue"] = "Solmar Island",
}

function GameClient.ResolveAreaName(rawName)
    if type(rawName) ~= "string" or rawName == "" then return nil end
    local trimmed = rawName:gsub("^%s+", ""):gsub("%s+$", "")
    local areasF = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Areas")
    local function tryMatch(cand)
        if type(cand) ~= "string" or cand == "" then return nil end
        local mapped = GameClient.ISLAND_ALIASES[cand] or cand
        if not areasF then return mapped end
        if areasF:FindFirstChild(mapped) then return mapped end
        local lower = mapped:lower()
        for _, child in ipairs(areasF:GetChildren()) do
            if child.Name:lower() == lower then return child.Name end
        end
        return nil
    end
    local exact = tryMatch(trimmed)
    if exact then return exact end
    local stripped = trimmed:gsub("%s+%d+$", "")
    if stripped ~= trimmed then
        local byStrip = tryMatch(stripped)
        if byStrip then return byStrip end
    end
    return areasF and nil or (GameClient.ISLAND_ALIASES[trimmed] or trimmed)
end

