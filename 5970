                end
            elseif child:IsA("GuiObject") and child.Visible and child.Name ~= "Close" and child.Name ~= "Exit" then
                local subBtn = child:FindFirstChildWhichIsA("GuiButton", true)
                if subBtn and subBtn.Visible then
                    local t = btnText(subBtn):gsub("%s+", " "):lower()
                    if t ~= "x" and t ~= "leave" and t ~= "sair" and t ~= "close" then
                        buttons[#buttons + 1] = subBtn
                    end
                end
            end
        end
        if #buttons > 0 then
            table.sort(buttons, function(a, b) return (a.LayoutOrder or 0) < (b.LayoutOrder or 0) end)
            local targetBtn = buttons[1]
            local firedAny = false
            if getconnections and type(setthreadidentity) == "function" then
                local oldId = type(getthreadidentity) == "function" and getthreadidentity() or 8
                for _, sig in ipairs({ targetBtn.MouseButton1Click, targetBtn.MouseButton1Down, targetBtn.Activated }) do
                    local conns = getconnections(sig)
                    if #conns > 0 then
                        for _, conn in ipairs(conns) do
                            pcall(setthreadidentity, 2)
                            local okF = pcall(function() conn:Fire() end)
                            pcall(setthreadidentity, oldId)
                            if okF then firedAny = true end
                        end
                        if firedAny then break end
                    end
                end
            end
            if not firedAny and VirtualInputManager and targetBtn.AbsoluteSize.X > 0 and targetBtn.AbsoluteSize.Y > 0 then
                local sg = targetBtn:FindFirstAncestorOfClass("ScreenGui")
                local insetY = 0
                if sg and not sg.IgnoreGuiInset then
                    local okG, gi = pcall(function() return game:GetService("GuiService"):GetGuiInset() end)
                    if okG and gi then insetY = gi.Y end
                end
                local cx = targetBtn.AbsolutePosition.X + targetBtn.AbsoluteSize.X * 0.5
                local cy = targetBtn.AbsolutePosition.Y + targetBtn.AbsoluteSize.Y * 0.5 + insetY
                pcall(function()
                    VirtualInputManager:SendMouseMoveEvent(cx, cy, game)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    task.wait(0.03)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                end)
                firedAny = true
            end
            if not firedAny and type(firesignal) == "function" then
                pcall(firesignal, targetBtn.MouseButton1Click)
                pcall(firesignal, targetBtn.Activated)
            end
            return true
        end
    end
    if getconnections then
        for _, conn in ipairs(getconnections(conv.MouseButton1Click)) do
            pcall(function() conn:Fire() end)
        end
    end
    if VirtualInputManager then
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.08)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
        return true
    end
    return false
end

