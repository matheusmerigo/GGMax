    hopInitDone = true
    TeleportService = game:GetService("TeleportService")
    HttpService = game:GetService("HttpService")
    pcall(function() listApi = GameModules and GameModules.ServerList and GameModules.ServerList.IsClient end)
    pcall(function() joinData = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Addons"):WaitForChild("ServerList")).IsClient.Data end)
    if isfile and readfile and isfile(stateFile) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(stateFile)) end)
