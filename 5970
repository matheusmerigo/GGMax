function GameClient.EnsureFruitHopLoop()
    if not (CFG.AutoFruitHop or CFG.AutoUniversalHop) then
        State.Tokens.FruitHop += 1
        return
    end
    State.Tokens.FruitHop += 1
    local myTok = State.Tokens.FruitHop
    ensureFruitHopInit()
    local function hasPendingHopWork()
        if CFG.AutoFruitHop or (CFG.AutoUniversalHop and CFG.AutoFruit) then
            if collecting then return true end
            for f in pairs(Features.Fruit.Items) do
                if f.Parent and not Features.Fruit.Skip[f] and GameClient.FruitMatchesRarityFilter(f) then
                    return true
                end
            end
        end
        if CFG.AutoUniversalHop then
            if CFG.AutoBoss or CFG.AutoBoardBoss then
                if State.bossBusy then return true end
                local ign = workspace:FindFirstChild("IgnoreList")
                local dataF = ign and ign:FindFirstChild("Data")
                local beacons = dataF and dataF:FindFirstChild("BossBeacons")
                if CFG.AutoBoss and type(CFG.TargetBosses) == "table" then
                    for bName, on in pairs(CFG.TargetBosses) do
                        if on then
                            if (beacons and beacons:FindFirstChild(bName) ~= nil) or (GameClient.FindWorldBoss and GameClient.FindWorldBoss(bName) ~= nil) then
                                return true
                            end
                        end
                    end
                end
                if CFG.AutoBoardBoss and type(CFG.TargetBoardBosses) == "table" then
                    for bName, on in pairs(CFG.TargetBoardBosses) do
                        if on then
                            if (beacons and beacons:FindFirstChild(bName) ~= nil) or (GameClient.FindWorldBoss and GameClient.FindWorldBoss(bName) ~= nil) then
                                return true
                            end
                        end
                    end
                end
            end
            if CFG.AutoIslandBoss then
                if State.islandBossBusy then return true end
                local ign = workspace:FindFirstChild("IgnoreList")
                local dataF = ign and ign:FindFirstChild("Data")
                local beacons = dataF and dataF:FindFirstChild("BossBeacons")
                if type(CFG.TargetIslandBosses) == "table" then
                    for bName, on in pairs(CFG.TargetIslandBosses) do
                        if on and ((beacons and beacons:FindFirstChild(bName) ~= nil) or (GameClient.FindWorldBoss and GameClient.FindWorldBoss(bName) ~= nil)) then
                            return true
                        end
                    end
                end
            end
            if CFG.AutoSeaBeast then
                if State.seaBeastBusy then return true end
                local ef = playability("Enemys")
                if ef then
                    for _, m in ipairs(ef:GetChildren()) do
                        if m:IsA("Model") and mobAlive(m) then
                            local orig = m:GetAttribute("OriginalName") or baseName(m)
                            if orig == "Sea Beast" or orig == "Ancestral Sea Beast" then
                                return true
                            end
                        end
                    end
                end
            end
            if CFG.AutoFortRaid then
                if State.fortRaidBusy then return true end
                local ign = workspace:FindFirstChild("IgnoreList")
                local dataF = ign and ign:FindFirstChild("Data")
                local forts = dataF and dataF:FindFirstChild("FortRaids")
                if forts and #forts:GetChildren() > 0 then
                    return true
                end
            end
        end
        return false
    end
    task.spawn(function()
        SafeRuntime.RunResilientLoop("FruitHopLoop", function() return (CFG.AutoFruitHop or CFG.AutoUniversalHop) and State.Tokens.FruitHop == myTok end, function()
        while (CFG.AutoFruitHop or CFG.AutoUniversalHop) and State.Tokens.FruitHop == myTok do
            if LP:GetAttribute("InGame") ~= true then
                task.wait(0.5)
                continue
            end
            -- Aguarda janela curta para detectar eventos/frutas no servidor e terminar execução
            local t0 = os.clock()
            while (CFG.AutoFruitHop or CFG.AutoUniversalHop) and State.Tokens.FruitHop == myTok and os.clock() - t0 < 10 do
                if hasPendingHopWork() then
                    t0 = os.clock()
                end
                task.wait(0.5)
            end
            if not ((CFG.AutoFruitHop or CFG.AutoUniversalHop) and State.Tokens.FruitHop == myTok) then break end

            if os.clock() - lastJoin < 6 then task.wait(1); continue end
            visited[game.JobId] = os.time()
            saveVisited()

            local okList, list = pcall(function() return listApi and listApi:GetActiveServers() end)
            local pool = {}
            if okList and type(list) == "table" then
                for _, s in ipairs(list) do
                    if type(s) == "table" and type(s.JobId) == "string" and s.JobId ~= ""
                        and s.JobId ~= game.JobId and s.Current ~= true
                        and type(s.Players) == "number" and type(s.MaxPlayers) == "number" and s.Players < s.MaxPlayers
                        and (failCount[s.JobId] or 0) < 2 and not visited[s.JobId] then
                        pool[#pool + 1] = s
                    end
                end
                table.sort(pool, function(a, b) return a.Players < b.Players end)
            end

            local target = pool[1]
            pendingFail = nil
            lastJoin = os.clock()
            if target then
                visited[target.JobId] = os.time()
                saveVisited()
                pcall(function()
                    if joinData then joinData:JoinPublicServer(target.JobId)
                    elseif GameModules then GameModules.Network:SafeInvokeServer(10, "ServerList", "JoinPublicServer", target.JobId) end
                end)
            else
                pcall(function()
                    if joinData then joinData:QuickJoin()
                    elseif GameModules then GameModules.Network:SafeInvokeServer(10, "ServerList", "QuickJoin") end
                end)
            end
            task.wait(8)
            if pendingFail and target then
                failCount[target.JobId] = (failCount[target.JobId] or 0) + 1
            end
        end
        end)
    end)
end
end

