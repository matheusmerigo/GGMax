            local dPos = litPos or findQuestZonePos("RaijinDummies_FS") or giverPos("Rustfall Storm Keeper Field")
            if dPos then
                Status = "Eletric: acertando bonecos Raijin..."
                tweenTo(CFrame.new(dPos + Vector3.new(0, 2, 0)), aborted)
                local char, _, hum = getChar()
                if char and hum then
                    local eq = Combat.EquipWeapon(char, hum)
                    if GameModules and GameModules.CombatTools and eq then
                        pcall(function()
