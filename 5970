do
local hopInitDone = false
local TeleportService, HttpService
local stateFile = "MIDGARD_FRUIT_HOP.json"
local visited = {}
local failCount = {}
local lastJoin = -1e9
local pendingFail = nil
local listApi, joinData

local function saveVisited()
