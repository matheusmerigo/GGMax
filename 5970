                                end
                            end
                            if not sbAborted() and not findSeaBeast() then
                                local dbg = {}
                                findSeaBeast(dbg)
                                Status = "Sea Beast: aguardando emergir..."
                                logSBThrottled(("WAIT_SURFACE ev1=%s models=[%s]"):format(tostring(LP:GetAttribute("SeaBeastEvent")), table.concat(dbg, "; ")), 3)
                                task.wait(0.4)
                            end
                        end
                    end
                end
            end
        end
        end, function(err) State.seaBeastBusy = false; attackGoal = nil; currentTarget = nil; cancelTween() end)
        State.seaBeastBusy = false
        logSB(("=== AutoSeaBeast STOP (AutoSeaBeast=%s tok=%d/%d) ==="):format(tostring(CFG.AutoSeaBeast), myTok, State.seaBeastToken))
    end)
end
