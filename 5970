                mm = require(Services.ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MainModules"))
            end)
            if type(setthreadidentity) == "function" then pcall(setthreadidentity, 8) end
            local function fmtCondition(info)
                if type(info) ~= "table" then return "-" end
                if info.Persistent then return "Sempre ativo" end
                local c = info.Conditions
                if type(c) ~= "table" then return "-" end
                local parts = {}
                if type(c.Hours) == "table" and #c.Hours > 0 then
                    local hrs = {}
                    for _, h in ipairs(c.Hours) do
                        table.insert(hrs, string.format("%02d:00", tonumber(h) or 0))
                    end
                    table.insert(parts, table.concat(hrs, "/"))
                end
                if type(c.Periods) == "table" and #c.Periods > 0 then
                    table.insert(parts, table.concat(c.Periods, "/"))
                end
                if type(c.Weather) == "table" and #c.Weather > 0 then
                    table.insert(parts, table.concat(c.Weather, "/"))
                end
                return (#parts > 0) and table.concat(parts, " | ") or "-"
            end
            SafeRuntime.RunResilientLoop("BossStatusUILoop", function() return not (Library and Library.Unloaded) end, function()
            while not (Library and Library.Unloaded) do
                local okTick, errTick = pcall(function()
                    local lines = {}

                    local ign = workspace:FindFirstChild("IgnoreList")
                    local dataF = ign and ign:FindFirstChild("Data")
                    local beacons = dataF and dataF:FindFirstChild("BossBeacons")
                    local respawns = dataF and dataF:FindFirstChild("BossRespawns")
                    local nowSrv = workspace:GetServerTimeNow()

                    local cs = mm and mm.ConditionalSpawnsSettings
                    local bossList = (VoxCore and VoxCore.Client and VoxCore.Client.BOSS_LIST) or {}
                    for _, entry in ipairs(bossList) do
                        local bName = entry[1]
                        if bName and bName:sub(1, 7) == "Wanted " then
                            local cond = fmtCondition(cs and cs.Bosses and cs.Bosses[bName])
                            local isAlive = beacons and beacons:FindFirstChild(bName) ~= nil
                            local icon = isAlive and "[🟢]" or "[🔴]"
                            local extra = cond
                            if not isAlive and respawns then
                                local rNode = respawns:FindFirstChild(bName)
                                local rAt = rNode and rNode:GetAttribute("RespawnAt")
                                if type(rAt) == "number" and rAt > nowSrv then
                                    local rem = math.max(0, math.ceil(rAt - nowSrv))
                                    extra = string.format("%d:%02d | %s", math.floor(rem / 60), rem % 60, cond)
                                end
                            end
                            table.insert(lines, string.format("%s %s (%s)", icon, bName, extra))
                        end
                    end
                    local bm = mm and mm.BlackMarketUtils
                    if bm and bm.GetActivePoint then
                        local bmPt = bm.GetActivePoint()
                        if bmPt then
                            local remS = bm.GetSecondsUntilDawn and bm.GetSecondsUntilDawn() or 0
                            table.insert(lines, string.format("[🟢] Black Market: Aberto (%s)", bm.FormatTime and bm.FormatTime(remS) or "?"))
                        else
                            local remS = bm.GetSecondsUntilDusk and bm.GetSecondsUntilDusk() or 0
                            table.insert(lines, string.format("[🔴] Black Market: Noite em %s", bm.FormatTime and bm.FormatTime(remS) or "?"))
                        end
                    end
                    local nextText = table.concat(lines, "\n")
                    if nextText ~= lastRendered then
                        lastRendered = nextText
                        if type(setthreadidentity) == "function" then pcall(setthreadidentity, 8) end
                        pcall(function() bossStatusLabel:SetText(nextText) end)
                    end
                end)
                task.wait(1)
            end
            end)
        end)
