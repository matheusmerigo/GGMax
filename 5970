function GameClient.AutoDeleteMaterialStep()
    if not CFG.AutoDeleteInventory then return false end
    local keep = math.max(0, math.floor(tonumber(CFG.InventoryDeleteKeep) or 0))
    local rows = GameClient.GetContainerRows("Unequiped", "All")
    table.sort(rows, function(a, b) return a.Index > b.Index end)
    for _, row in ipairs(rows) do
        local before = GameClient.BankAmount("Unequiped", row.Name)
        local targeted = CFG.InventoryDeleteTargets and CFG.InventoryDeleteTargets[row.Category] and CFG.InventoryDeleteTargets[row.Category][row.Name]
        if targeted and not row.Locked and before > keep then
            local amount = math.min(row.Quantity, before - keep)
            debugLog("inventory_delete_debug.txt", ("AUTO_DELETE_REQUEST name=%s cat=%s index=%d amount=%d keep=%d before=%d"):format(
                row.Name, row.Category, row.Index, amount, keep, before
            ))
            GameModules.Network:FireServer("ToolsData", "Delete", false, row.Index, row.Name, amount)
            local deadline, after = os.clock() + 5, before
            repeat
                task.wait(0.15)
                after = GameClient.BankAmount("Unequiped", row.Name)
            until after <= before - amount or os.clock() >= deadline
            if after <= before - amount then
                debugLog("inventory_delete_debug.txt", ("AUTO_DELETE_CONFIRMED name=%s amount=%d after=%d"):format(row.Name, amount, after))
                Status = ("Auto excluir: %d × %s"):format(amount, row.Name)
            else
                debugLog("inventory_delete_debug.txt", ("AUTO_DELETE_REJECTED name=%s amount=%d before=%d after=%d"):format(row.Name, amount, before, after))
            end
            return true
        end
    end
    return false
end

function GameClient.AutoBankMaterialBatch()
    if not CFG.AutoBankMaterials or GameClient.CampfireActive then return false end
    local keep = math.max(0, math.floor(tonumber(CFG.BankKeep) or 0))
    local rows = GameClient.GetContainerRows("Unequiped", "All", { onlyBankable = true })
    table.sort(rows, function(a, b) return (a.Index or 0) > (b.Index or 0) end)

    local candidates, excessByName = {}, {}
    for _, row in ipairs(rows) do
        local targeted = CFG.BankTargets and CFG.BankTargets[row.Category] and CFG.BankTargets[row.Category][row.Name]
        if targeted then
            if excessByName[row.Name] == nil then
                excessByName[row.Name] = math.max(0, GameClient.BankAmount("Unequiped", row.Name) - keep)
            end
            local rem = excessByName[row.Name]
            local toSend = math.min(row.Quantity, rem)
            if toSend > 0 then
                excessByName[row.Name] = rem - toSend
                row.Quantity = toSend
                candidates[#candidates + 1] = row
            end
        end
    end
    if #candidates == 0 then return false end

    local data = getData()
    local fee = 0
    pcall(function() fee = MainModules.ToolsUtils.GetBankOpenFee(LP) end)
    local gold = data and data.Monetization and tonumber(data.Monetization.Gold) or 0
    if fee > math.max(0, tonumber(CFG.BankMaxFee) or 0) or fee > gold then
        Status = ("Auto Banco: taxa %d Gold bloqueada"):format(fee)
        debugLog("bank_debug.txt", ("AUTO_BANK_BLOCKED fee=%d max=%s gold=%d"):format(fee, tostring(CFG.BankMaxFee), gold))
        return false
    end

    local previousModes = Features.PauseForInterrupt and Features.PauseForInterrupt() or nil
    local active = true
    local function aborted() return not active or not CFG.AutoBankMaterials end
    local function logBank(message) debugLog("bank_debug.txt", message) end
    Status = ("Auto Banco: guardando %d pilha(s)..."):format(#candidates)
    local deposited = GameClient.TransferBankBatch("Deposit", candidates, aborted, logBank)
    GameClient.CloseBank()
    active = false
    if previousModes and Features.ResumeAfterInterrupt then Features.ResumeAfterInterrupt(previousModes) end
    debugLog("bank_debug.txt", ("AUTO_BANK_DONE stacks=%d"):format(deposited))
    if deposited > 0 then Status = ("Auto Banco: %d pilha(s) guardada(s)"):format(deposited) end
    return deposited > 0
end

function Features.HasCategoryTargets(targetsByCat)
    if type(targetsByCat) ~= "table" then return false end
    for _, catMap in pairs(targetsByCat) do
        if type(catMap) == "table" and next(catMap) ~= nil then
            return true
        end
    end
    return false
end

function GameClient.EnsureInventoryLoop()
    local wantsDelete = CFG.AutoDeleteInventory and Features.HasCategoryTargets(CFG.InventoryDeleteTargets)
    local wantsBank = CFG.AutoBankMaterials and Features.HasCategoryTargets(CFG.BankTargets)
    if not (wantsDelete or wantsBank) then
        State.Tokens.Inventory += 1
        return
    end
    State.Tokens.Inventory += 1
    local myTok = State.Tokens.Inventory
    task.spawn(function()
        SafeRuntime.RunResilientLoop("InventoryLoop", function() return (CFG.AutoDeleteInventory or CFG.AutoBankMaterials) and State.Tokens.Inventory == myTok end, function()
        while (CFG.AutoDeleteInventory or CFG.AutoBankMaterials) and State.Tokens.Inventory == myTok do
            local wDel = CFG.AutoDeleteInventory and Features.HasCategoryTargets(CFG.InventoryDeleteTargets)
            local wBank = CFG.AutoBankMaterials and Features.HasCategoryTargets(CFG.BankTargets)
            if not (wDel or wBank) then
                break
            end
            if not GameClient.InventoryAutomationBusy and os.clock() >= GameClient.InventoryAutomationNext and not collecting and not isDeadOrRespawning() then
                GameClient.InventoryAutomationBusy = true
                local acted = false
                if wDel then acted = GameClient.AutoDeleteMaterialStep() end
                local inCombatOrRaid = State.bossBusy or State.islandBossBusy or State.seaBeastBusy or State.fortRaidBusy or State.raidInArena or GameClient.CampfireActive or (GameClient.BossRoomsFight and GameClient.BossRoomsFight.Payload ~= nil)
                if not acted and wBank and not inCombatOrRaid then acted = GameClient.AutoBankMaterialBatch() end
                GameClient.InventoryAutomationNext = os.clock() + (acted and 2 or 5)
                GameClient.InventoryAutomationBusy = false
            end
            task.wait(1)
        end
        end, function(err) GameClient.InventoryAutomationBusy = false end)
    end)
end

do
local function logSB(msg)
    debugLog("seabeast_debug.txt", msg)
end

local function sbAlive(m)
    if not (m and m.Parent) then return false end
    if m:GetAttribute("Dead") == true or m:GetAttribute("Render") == false or m:GetAttribute("Ready") == false then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    if h and (h:GetState() == Enum.HumanoidStateType.Dead or mobHP(m) <= 0) then return false end
    return (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) ~= nil
end

local function findSeaBeast(debugInfo)
    local folder = playability("Enemys")
    if not folder then return nil end
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") then
            local bName = baseName(m)
            if bName == "Sea Beast" or bName == "Ancestral Sea Beast" or bName == "Abyssal Beast" or bName == "Ancestral Abyssal Beast" or tostring(m.Name):find("Sea Beast") then
                if sbAlive(m) then
                    return m
                elseif debugInfo then
                    local h = m:FindFirstChildOfClass("Humanoid")
                    local r = m:FindFirstChild("HumanoidRootPart")
                    table.insert(debugInfo, ("%s[D=%s,R=%s,H=%s,HRP=%s,PP=%s,hp=%.0f,q=%s]"):format(
                        tostring(m.Name), tostring(m:GetAttribute("Dead") == true), tostring(m:GetAttribute("Render")),
                        tostring(h ~= nil), tostring(r ~= nil), tostring(m.PrimaryPart ~= nil), mobHP(m), tostring(r and r.CanQuery)
                    ))
                end
            end
        end
    end
    return nil
end

local function isSeaBeastDodging()
    if not (CFG.BossDodge and State.seaBeastActiveSkills) then return false end
    local nowT = os.clock()
    for k, exp in pairs(State.seaBeastActiveSkills) do
        if nowT < exp then
            return true
        else
            State.seaBeastActiveSkills[k] = nil
        end
    end
    return false
end

local function fightSeaBeast(sb, sbAborted)
    local lastHit, lastLog, lastMirrorTry = 0, 0, 0
    local bNameSB = baseName(sb)
    local isAncestral = bNameSB:find("Ancestral", 1, true) ~= nil or sb:GetAttribute("Ancestral") == true
    local dodgeLift = isAncestral and 580 or 220
    local trp0 = sb:FindFirstChild("HumanoidRootPart") or sb.PrimaryPart
    local hp0, max0 = mobHP(sb)
    local sbHealing = false
    State.seaBeastActiveSkills = {}
    logSB(("FIGHT_START name=%s ancestral=%s hp=%.0f/%.0f trp=%s"):format(tostring(sb.Name), tostring(isAncestral), hp0, max0, trp0 and tostring(trp0.Position) or "nil"))
    while not sbAborted() and sbAlive(sb) do
        local c2, h2, hum2 = getChar()
        if not (c2 and h2 and hum2 and hum2.Health > 0) then break end
        if c2:FindFirstChild("SeaBeastMount") ~= nil then
            attackGoal = nil
            currentTarget = nil
            cancelTween()
            task.wait(0.15)
            continue
        end
        local trp = sb:FindFirstChild("HumanoidRootPart") or sb.PrimaryPart
        if not trp then break end
        local tool = Combat.EquipWeapon(c2, hum2)
        -- No Kill Aura, orbita acima da água (Y >= 10) e perto o bastante para o servidor aceitar o DefaultCombo
        local isM1 = (CFG.AttackMode == "M1" or Combat.ToolIsGun(tool))
        local goalPos
        if isM1 then
            local goalY = math.max(trp.Position.Y + 7, 10)
            goalPos = Vector3.new(trp.Position.X, goalY, trp.Position.Z)
        else
            local ang = os.clock() * 2.4
            local attackReach = math.max(8, CFG.KillAuraRadius - 1)
            local orbitR = math.min(3.5, attackReach * 0.25)
            local offX = math.cos(ang) * orbitR
            local offZ = math.sin(ang) * orbitR
            local vertical = math.sqrt(math.max(16, attackReach * attackReach - orbitR * orbitR))
            local goalY = math.max(trp.Position.Y + vertical, 10)
            goalPos = Vector3.new(trp.Position.X + offX, goalY, trp.Position.Z + offZ)
        end
        local hpPct = (hum2.MaxHealth > 0) and (hum2.Health / hum2.MaxHealth) or 1
        if not sbHealing and hpPct < 0.20 then
            sbHealing = true
            logSB(("HEAL_RETREAT hp=%.0f/%.0f (%.0f%%)"):format(hum2.Health, hum2.MaxHealth, hpPct * 100))
        elseif sbHealing and hpPct >= 0.80 then
            sbHealing = false
            logSB(("HEAL_DONE hp=%.0f/%.0f (%.0f%%)"):format(hum2.Health, hum2.MaxHealth, hpPct * 100))
        end
        local sbDodging = sbHealing or isSeaBeastDodging()
        if sbDodging then
            goalPos = Vector3.new(trp.Position.X, math.max(trp.Position.Y + dodgeLift, dodgeLift + 10), trp.Position.Z)
        end
        local goal = CFrame.lookAt(goalPos, trp.Position)
        local maxSnap = (CFG.AttackMode == "KillAura") and math.max(CFG.KillAuraRadius + 10, 24) or 16
        local dGoal = (h2.Position - goal.Position).Magnitude
        local function makeChaseAbort(moveThresh)
            return function()
                if sbAborted() or not sbAlive(sb) or isDeadOrRespawning() then return true end
                if not sbDodging and isSeaBeastDodging() then return true end
                local tNow = sb:FindFirstChild("HumanoidRootPart") or sb.PrimaryPart
                if not tNow then return true end
                if (tNow.Position - trp.Position).Magnitude > moveThresh then return true end
                local _, hNow = getChar()
                if not hNow then return true end
                if moveThresh < 100 and (hNow.Position - goal.Position).Magnitude <= (sbDodging and 8 or maxSnap) then return true end
                return false
            end
        end
        if h2.Position.Y < -200 and goalPos.Y > -200 then
            attackGoal = nil
            goNear(goal.Position, sbAborted)
        elseif dGoal >= 3000 then
            attackGoal = nil
            if Movement.TryLeaveGenericInterior then Movement.TryLeaveGenericInterior(goal.Position, sbAborted) end
            local usedMirror = false
            if Movement.TryMirrorKeeperTravel and (os.clock() - lastMirrorTry) >= 5 then
                lastMirrorTry = os.clock()
                usedMirror = Movement.TryMirrorKeeperTravel(goal.Position, nil, sbAborted)
            end
            if not usedMirror then
                tweenTo(goal, makeChaseAbort(120))
            end
        elseif dGoal > maxSnap then
            attackGoal = nil
            local returnThresh = (not sbDodging and (h2.Position.Y - goalPos.Y) > 40) and 120 or 35
            tweenTo(goal, makeChaseAbort(returnThresh))
        else
            attackGoal = goal
            currentTarget = sb
            h2.CFrame = goal
            h2.AssemblyLinearVelocity = Vector3.zero
        end
        local sbHp, sbMax = mobHP(sb)
        Status = sbHealing
            and ("Sea Beast: recuperando vida (%.0f%%)..."):format(hpPct * 100)
            or ("Sea Beast: %.0f / %.0f HP"):format(sbHp, sbMax)
        if os.clock() - lastLog >= 2 then
            lastLog = os.clock()
            local dTarget = (h2.Position - trp.Position).Magnitude
            logSB(("FIGHT_TICK hp=%.0f/%.0f dTarget=%.1f dGoal=%.1f auraR=%d mode=%s"):format(sbHp, sbMax, dTarget, dGoal, CFG.KillAuraRadius, tostring(CFG.AttackMode)))
        end
        if (CFG.AttackMode == "M1" or Combat.ToolIsGun(tool)) and os.clock() - lastHit >= CFG.M1Interval then
            lastHit = os.clock()
            tool = (tool and tool.Parent == c2) and tool or Combat.EquipWeapon(c2, hum2)
            Combat.M1(tool)
        end
        RunService.Heartbeat:Wait()
    end
    local hpEnd = mobHP(sb)
    logSB(("FIGHT_END alive=%s hp=%.0f aborted=%s"):format(tostring(sbAlive(sb)), hpEnd, tostring(sbAborted())))
    attackGoal = nil
    currentTarget = nil
end

Features.SeaBeastLoop = function()
    State.seaBeastToken += 1
    local myTok = State.seaBeastToken
    if not State.seaBeastCastHooked then
        State.seaBeastCastHooked = true
        local SEA_BEAST_DODGE_SKILLS = {
