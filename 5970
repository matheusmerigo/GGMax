                            local navThresh = (ctxPre ~= nil) and 12 or 4.5
                            local pullingCart = (oid == "Deliver_SupplyCart_VAL" and LP:GetAttribute("ValoriaCartState") == "Pulling") or ((oid == "Deliver_CargoInspection_SU" or oid == "Deliver_CargoDepot_SU") and LP:GetAttribute("SkylandsCartState") == "Pulling")
                            local isStealthTail = (oid:sub(1, 7) == "Follow_" or oid == "Capture_Officer_SU" or oid == "Watch_TransferDoor_SU" or oid == "Unload_CargoTools_SU" or oid == "Unload_CargoParts_SU" or oid == "Unload_CargoChest_SU" or oid == "Escort_ArchivistThrone_SU" or oid == "Escort_ArchivistAudience_SU" or oid == "Escort_ArchivistRest_SU" or oid:sub(1, 11) == "Talk_Raikan" or oid:sub(1, 12) == "Start_Raikan" or oid == "Escort_KaeldrosForge_VO" or oid == "Chase_MaskedMan_NA")
