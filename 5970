                                        for _, child in ipairs(hm:GetChildren()) do
                                            local num = tonumber(child.Name)
                                            if child:IsA("Model") and num then
                                                table.insert(cps, { num = num, model = child })
                                            end
                                        end
                                        table.sort(cps, function(a, b) return a.num < b.num end)
                                        for _, cp in ipairs(cps) do
                                            local key = "Parkour_" .. hm.Name .. "_" .. cp.num
                                            if not (d and d.Registry and d.Registry[key] == true) then
                                                foundPos = cp.model:GetPivot().Position
                                                break
                                            end
                                        end
                                    end
                                end)
                                return foundPos
                            end
                            pos = findNextHeavenstepPos()
                            if not pos then
                                local destPos = Vector3.new(103.7, 35, 531.9)
                                local areasF = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Areas")
                                local solmar = areasF and areasF:FindFirstChild("Solmar Island")
