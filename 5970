local function getQuestInfo(qName)
    local info = MainModules and MainModules.QuestsInfo and MainModules.QuestsInfo[qName]
    if type(info) == "table" and type(info.SubQuests) == "table" then
        return info
    end
    local qFolder = ReplicatedStorage:FindFirstChild("Shared")
        and ReplicatedStorage.Shared:FindFirstChild("MainModules")
        and ReplicatedStorage.Shared.MainModules:FindFirstChild("ProgressUtils")
        and ReplicatedStorage.Shared.MainModules.ProgressUtils:FindFirstChild("QuestsInfo")
    if qFolder then
        local mod = qFolder:FindFirstChild(qName, true)
        if mod and mod:IsA("ModuleScript") then
            local ok, res = pcall(require, mod)
            if ok and type(res) == "table" then
                return res
            end
        end
    end
    return info
end

