-- pcall sem observabilidade escondia mudanças de contrato dos remotes. Este
-- wrapper continua tolerante a falhas, mas deixa um diagnóstico acionável.
function GameClient.FireServerLogged(logFile, context, ...)
    if not (GameModules and GameModules.Network and GameModules.Network.FireServer) then
        debugLog(logFile or "network_debug.txt", ("REMOTE_FAIL context=%s error=Network indisponível"):format(tostring(context)))
        return false, "Network indisponível"
    end
    local args = table.pack(...)
    local rName = args[1]
    if (rName == "Elysium_Converse" or rName == "QuestZones" or rName == "PrivateAreas") and Movement.BeginInteract then
        Movement.BeginInteract(nil)
    end
    local ok, err = pcall(function()
        GameModules.Network:FireServer(table.unpack(args, 1, args.n))
    end)
    if not ok then
        debugLog(logFile or "network_debug.txt", ("REMOTE_FAIL context=%s error=%s"):format(tostring(context), tostring(err)))
    end
    return ok, err
end

-- Adaptador fino para APIs oficiais do cliente. Os fallbacks continuam locais
-- para tolerar streaming parcial, mas o caminho principal passa pelos módulos.
function GameClient.ValuePosition(value)
    if typeof(value) == "Vector3" then return value end
    if typeof(value) == "CFrame" then return value.Position end
    if typeof(value) == "Instance" then
        if value:IsA("BasePart") then return value.Position end
        if value:IsA("Model") then return value:GetPivot().Position end
        if value:IsA("Vector3Value") then return value.Value end
        if value:IsA("CFrameValue") then return value.Value.Position end
    end
    if type(value) == "table" then
        local pos = rawget(value, "Position")
        if typeof(pos) == "Vector3" then return pos end
        local cf = rawget(value, "CFrame")
        if typeof(cf) == "CFrame" then return cf.Position end
        return GameClient.ValuePosition(rawget(value, "Point")) or GameClient.ValuePosition(rawget(value, "Target"))
    end
    return nil
end

function GameClient.GetInterestPoint(key)
