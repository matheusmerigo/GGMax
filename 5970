local getInteractionClient = GameClient.GetInteractionClient

local function fireInteractionContext(contextName)
    local ic = getInteractionClient()
    if not (ic and ic.Interaction and ic.Interaction.Interacted) then return false end
    local fired = false
    local hasIdFn = type(setthreadidentity) == "function"
    local oldId = (hasIdFn and type(getthreadidentity) == "function") and getthreadidentity() or 8
    if contextName then
        pcall(function()
            if hasIdFn then setthreadidentity(2) end
            ic.Interaction.Interacted:Fire(contextName)
            fired = true
        end)
        if hasIdFn then pcall(setthreadidentity, oldId) end
    end
    local cur = ic.Interaction.CurrentContext
    if cur and cur ~= contextName and (contextName == "Enter Area" or cur ~= "Enter Area") then
        pcall(function()
            if hasIdFn then setthreadidentity(2) end
            ic.Interaction.Interacted:Fire(cur)
            fired = true
        end)
        if hasIdFn then pcall(setthreadidentity, oldId) end
    end
    return fired
end

