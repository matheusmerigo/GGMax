    function GameClient.GetUpgradableGearOptions(mode)
        local list, seen = {}, {}
        local data = getData()
        if not (data and data.Tools and MainModules and MainModules.ToolsInfo) then return list end
        local function scanList(arr)
            if type(arr) ~= "table" then return end
            for _, item in ipairs(arr) do
                if type(item) == "table" and type(item.Name) == "string" and not seen[item.Name] then
                    local info = MainModules.ToolsInfo:Get(item.Name)
                    if info then
                        local okMode = (mode == "Evolve")
                            and (info.Evolutions ~= nil)
                            or (MainModules.ToolsUtils and MainModules.ToolsUtils.CanUpgrade and MainModules.ToolsUtils.CanUpgrade(info))
                        if okMode then
                            seen[item.Name] = true
                            local lbl = (mode == "Evolve")
                                and string.format("%s [Lv.%d]", item.Name, tonumber(item.Level) or 0)
                                or string.format("%s [+%d]", item.Name, tonumber(item.Upgrade) or 0)
                            table.insert(list, { item.Name, lbl })
                        end
                    end
                end
            end
        end
        scanList(data.Tools.Equiped)
        scanList(data.Tools.Unequiped)
        table.sort(list, function(a, b) return a[1] < b[1] end)
        return list
    end

    local function findBestGearEntry(gearName, mode)
        local data = getData()
        if not (data and data.Tools) then return nil end
        local best = nil
        for _, loc in ipairs({ "Equiped", "Unequiped" }) do
            for idx, item in ipairs(data.Tools[loc] or {}) do
                if type(item) == "table" and item.Name == gearName then
                    if not best
                        or (mode == "Evolve" and (item.Level or 0) > (best.Level or 0))
                        or (mode ~= "Evolve" and (item.Upgrade or 0) > (best.Upgrade or 0)) then
                        best = { Name = item.Name, Upgrade = item.Upgrade or 0, Level = item.Level or 0, Location = loc, Index = idx }
                    end
                end
            end
        end
        return best
    end

    local function buildMatRows(matsMap)
        local missing = {}
        ensureKeyCatalog()
        for matName, needQty in pairs(matsMap or {}) do
            local have = (MainModules.ToolsUtils and MainModules.ToolsUtils.GetInventoryAmount(nil, matName)) or 0
            if have < needQty then
                local info = MainModules.ToolsInfo and MainModules.ToolsInfo:Get(matName)
                table.insert(missing, {
                    Name = matName,
                    Have = have,
                    Need = needQty,
                    Missing = needQty - have,
                    HasRecipe = (info and info.Recipe ~= nil) or false,
                    Sources = dropSources[matName] or {},
                })
            end
        end
        table.sort(missing, function(a, b) return a.Name < b.Name end)
        return missing
    end

