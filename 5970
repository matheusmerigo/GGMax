    end
    State.Tokens.Orbs += 1
    local myTok = State.Tokens.Orbs
    task.spawn(function()
        while CFG.AutoOrbs and State.Tokens.Orbs == myTok do
            pcall(autoOrbs)
            task.wait(0.35)
