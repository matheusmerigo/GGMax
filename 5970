local MidgardPruneGlobalConnections
local function MidgardDisconnectGlobalConnections()
    local globalConnections = GlobalEnv.Midgard_GlobalConnections
    if type(globalConnections) ~= "table" then return end
    local globalSet = type(GlobalEnv.Midgard_GlobalConnectionSet) == "table" and GlobalEnv.Midgard_GlobalConnectionSet or nil
    if type(Library) == "table" and type(Library.DisconnectConnectionArray) == "function" then
        Library:DisconnectConnectionArray(globalConnections, globalSet)
        return
    end
    for i = #globalConnections, 1, -1 do
        local conn = globalConnections[i]
        if typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        end
        globalConnections[i] = nil
    end
    if type(GlobalEnv.Midgard_GlobalConnectionSet) == "table" then
        table.clear(GlobalEnv.Midgard_GlobalConnectionSet)
    end
end

local function MidgardGetGlobalConnectionRegistry()
    local env = GlobalEnv
    if type(env.Midgard_GlobalConnections) ~= "table" then
        env.Midgard_GlobalConnections = {}
    end
    return env.Midgard_GlobalConnections
end

local function MidgardGetGlobalConnectionSet()
    local env = GlobalEnv
    if type(env.Midgard_GlobalConnectionSet) ~= "table" then
        env.Midgard_GlobalConnectionSet = {}
    end
    return env.Midgard_GlobalConnectionSet
end

local function MidgardTrackGlobalConnection(connection)
    if typeof(connection) ~= "RBXScriptConnection" then
        return connection
    end

    MidgardPruneGlobalConnections()
    local globalSet = MidgardGetGlobalConnectionSet()
    local globalConnections = MidgardGetGlobalConnectionRegistry()
    if type(Library) == "table" and type(Library.TrackConnection) == "function" then
        return Library:TrackConnection(globalConnections, connection, globalSet)
    end
    if globalSet[connection] then
        return connection
    end
    globalSet[connection] = true
    table.insert(globalConnections, connection)
    return connection
end

local function MidgardUntrackGlobalConnection(connection)
    if typeof(connection) ~= "RBXScriptConnection" then
        return
    end

    local globalConnections = GlobalEnv.Midgard_GlobalConnections
    if type(globalConnections) ~= "table" then
        return
    end
    local globalSet = MidgardGetGlobalConnectionSet()
    if type(Library) == "table" and type(Library.UntrackConnection) == "function" then
        Library:UntrackConnection(globalConnections, connection, globalSet)
    else
        globalSet[connection] = nil
        for index = #globalConnections, 1, -1 do
            if globalConnections[index] == connection then
                globalConnections[index] = globalConnections[#globalConnections]
                globalConnections[#globalConnections] = nil
            end
        end
    end
    MidgardPruneGlobalConnections()
end

MidgardPruneGlobalConnections = function()
    local globalConnections = GlobalEnv.Midgard_GlobalConnections
    if type(globalConnections) ~= "table" then
        return
    end
    local globalSet = MidgardGetGlobalConnectionSet()

    if type(Library) == "table" and type(Library.PruneConnectionArray) == "function" then
        Library:PruneConnectionArray(globalConnections, nil, globalSet, false)
        return
    end

    for index = #globalConnections, 1, -1 do
        local existing = globalConnections[index]
        if typeof(existing) ~= "RBXScriptConnection" or existing.Connected ~= true then
            globalSet[existing] = nil
            globalConnections[index] = globalConnections[#globalConnections]
            globalConnections[#globalConnections] = nil
        end
    end
end

