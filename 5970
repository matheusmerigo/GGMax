                                IsHaki = false,
                            })
                        end)
                    else
                        pcall(function() if eq then eq:Activate() end end)
                    end
                end
            end
            task.wait(0.35)
        elseif isObjActive(prog, "Talk_ThunderMasterReady_FS") then
            talkStyleNpc("Rustfall Storm Keeper Field", "Ready", aborted)
        elseif isObjActive(prog, "Defeat_Ansel the Storm Keeper") then
            fightStyleBoss("Ansel the Storm Keeper", aborted, findQuestZonePos("ThunderMasterDuelCircle_FS") or giverPos("Rustfall Storm Keeper Field"))
