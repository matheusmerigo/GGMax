end
function SafeRuntime.ReportError(scope, err)
    local msg = tostring(err)
    if type(SafeRuntime.Logger) == "function" then
        pcall(SafeRuntime.Logger, scope, msg)
    else
        pcall(warn, "[Midgard:ERR][" .. tostring(scope) .. "] " .. msg)
    end
end
function SafeRuntime.RunResilientLoop(label, condFn, bodyFn, onErr)
    local errCount = 0
    while condFn() do
        local ok, err = xpcall(bodyFn, SafeRuntime.Traceback)
        if ok then
            break
        end
        errCount += 1
        SafeRuntime.ReportError(label, ("LOOP_ERR #%d: %s"):format(errCount, tostring(err)))
        if type(onErr) == "function" then
            pcall(onErr, err)
        end
        if not condFn() then break end
        SafeRuntime.RawTask.wait(math.min(0.5 + math.min(errCount, 6) * 0.25, 2.0))
    end
end
function SafeRuntime.Connect(signal, label, fn)
    return signal:Connect(function(...)
        local args = table.pack(...)
        local ok, err = xpcall(function()
            return fn(table.unpack(args, 1, args.n))
        end, SafeRuntime.Traceback)
        if not ok then
            SafeRuntime.ReportError("Conn:" .. tostring(label), err)
        end
    end)
end
function SafeRuntime.Once(signal, label, fn)
    return signal:Once(function(...)
        local args = table.pack(...)
