    if not shopPos then
        local ign = workspace:FindFirstChild("IgnoreList")
        local pa = ign and ign:FindFirstChild("Int") and ign.Int:FindFirstChild("PrivateAreas")
        local solmarShop = pa and pa:FindFirstChild("Solmar Island") and pa["Solmar Island"]:FindFirstChild("SolmarBoatShop")
        local enterEnt = solmarShop and solmarShop:FindFirstChild("Enter") and extractVec3(solmarShop.Enter:FindFirstChild("Entrance"))
        if enterEnt then
            Status = "Barco: indo comprar barco..."
            tweenTo(CFrame.new(enterEnt + Vector3.new(0, 2, 0)), aborted)
