        if type(n) == "string" and n ~= "" and not seen[n] then
            seen[n] = true
            list[#list + 1] = n
        end
    end

    local points = MainModules and MainModules.InterestPoints and MainModules.InterestPoints.Points
    if type(points) == "table" then
        for key, point in pairs(points) do
            if type(key) == "string" and key:sub(1, 10) == "Character_" and GameClient.ValuePosition(point) then
                addName(key:sub(11))
            end
        end
    end

    local anchors = ReplicatedStorage:FindFirstChild("NpcAnchors")
    if anchors then
        for _, v in ipairs(anchors:GetChildren()) do
            if v:IsA("Vector3Value") or v:IsA("CFrameValue") then
                addName(v.Name)
            end
        end
    end

    for _, nf in ipairs(getNpcSearchRoots()) do
        if nf then
            for _, d in ipairs(nf:GetDescendants()) do
                if d:IsA("Model") and (d:FindFirstChildOfClass("Humanoid") or d:FindFirstChild("HumanoidRootPart") or d:FindFirstChild("Head")) then
                    addName(d.Name)
                end
            end
        end
    end

    local chars = playability("Characters")
    if chars then
        for _, m in ipairs(chars:GetChildren()) do
            if m:IsA("Model") and not Services.Players:GetPlayerFromCharacter(m) then
                addName(m:GetAttribute("OriginalName") or m.Name)
            end
        end
    end

    table.sort(list)
    return list
end

function GameClient.GetNPCPosition(name)
    if type(name) ~= "string" or name == "" then return nil end
    if giverPos then
        local p = giverPos(name)
        if typeof(p) == "Vector3" then return p end
    end
    for _, nf in ipairs(getNpcSearchRoots()) do
        if nf then
            for _, d in ipairs(nf:GetDescendants()) do
                if d:IsA("Model") and d.Name == name and (d:FindFirstChildOfClass("Humanoid") or d:FindFirstChild("HumanoidRootPart") or d:FindFirstChild("Head")) then
                    return d:GetPivot().Position
                end
            end
        end
    end
    return nil
end

function GameClient.TravelTo(kind, target, aborted)
    debugLog("travel_debug.txt", ("=== TRAVEL START kind=%s target=%s lv=%d ==="):format(tostring(kind), tostring(target), getLevel()), true)
    if isDeadOrRespawning() then
        debugLog("travel_debug.txt", "ABORT_DEAD_OR_NO_CHAR reason=dead_or_respawning")
        return false
    end
    local char, hrp = getChar()
    if not (char and hrp) then
        debugLog("travel_debug.txt", "ABORT_DEAD_OR_NO_CHAR reason=no_char")
        return false
    end

    local pos = (kind == "Island") and GameClient.GetIslandPosition(target) or GameClient.GetNPCPosition(target)
    if typeof(pos) ~= "Vector3" then
        debugLog("travel_debug.txt", ("FAIL_NO_POS kind=%s target=%s"):format(tostring(kind), tostring(target)))
        return false
    end

    local startPos = hrp.Position
    debugLog("travel_debug.txt", ("RESOLVED from=(%.1f,%.1f,%.1f) to=(%.1f,%.1f,%.1f) dist=%.1f"):format(
        startPos.X, startPos.Y, startPos.Z, pos.X, pos.Y, pos.Z, (startPos - pos).Magnitude
    ))

    local t0 = os.clock()
    local ok = false
    local via = "goNear"

    if kind == "Island" then
        local usedMirror = false
        if hrp.Position.Y > -200 and Movement.TryMirrorKeeperTravel then
            debugLog("travel_debug.txt", ("TRY_MIRROR island=%s"):format(tostring(target)))
            usedMirror = Movement.TryMirrorKeeperTravel(pos, target, aborted) == true
            debugLog("travel_debug.txt", ("MIRROR_RESULT used=%s"):format(tostring(usedMirror)))
        end
        if aborted and aborted() then
            debugLog("travel_debug.txt", ("ABORTED_AFTER_MIRROR elapsed=%.2fs"):format(os.clock() - t0))
            return false
        end
        if usedMirror then
            via = "MirrorKeeper"
            ok = true
        else
            debugLog("travel_debug.txt", ("FALLBACK_GONEAR island=%s"):format(tostring(target)))
            ok = goNear(pos, aborted, { noMirror = (hrp.Position.Y > -200) }) == true
        end
    else
        debugLog("travel_debug.txt", ("START_GONEAR target=%s"):format(tostring(target)))
        ok = goNear(pos, aborted) == true
        if not (aborted and aborted()) then
            local pos2 = GameClient.GetNPCPosition(target)
            local _, hrpNow = getChar()
            if typeof(pos2) == "Vector3" and hrpNow and (hrpNow.Position - pos2).Magnitude > 8 then
                debugLog("travel_debug.txt", ("REFINE_NPC_POS pos2=(%.1f,%.1f,%.1f) dist=%.1f"):format(
                    pos2.X, pos2.Y, pos2.Z, (hrpNow.Position - pos2).Magnitude
                ))
                pos = pos2
                ok = tweenTo(CFrame.new(pos2 + Vector3.new(0, 2, 3)), aborted) == true
            end
        end
    end

    local isAborted = (aborted and aborted()) == true
    local _, hrpEnd = getChar()
    local endPos = hrpEnd and hrpEnd.Position
    local endDist = endPos and (endPos - pos).Magnitude or -1
    debugLog("travel_debug.txt", ("%s via=%s ok=%s aborted=%s elapsed=%.2fs endPos=%s endDist=%.1f"):format(
        isAborted and "ABORTED" or "DONE",
        via,
        tostring(ok),
        tostring(isAborted),
        os.clock() - t0,
        endPos and ("(%.1f,%.1f,%.1f)"):format(endPos.X, endPos.Y, endPos.Z) or "nil",
        endDist
    ))
    return ok
end

Features.MissionLoop = function()
    State.mobToken += 1
    local myTok = State.mobToken
    local function logMob(msg)
        debugLog("mob_debug.txt", msg)
    end
    debugLog("mob_debug.txt", "=== MissionLoop START ===", true)
    local lastLogT, lastLogMsg = 0, ""
    local function logMobThrottled(msg)
        local now = os.clock()
        if msg ~= lastLogMsg or now - lastLogT >= 3 then
            lastLogMsg, lastLogT = msg, now
            logMob(msg)
        end
    end
    task.spawn(function()
        local hadActiveQuest = false
        SafeRuntime.RunResilientLoop("MissionLoop", function() return CFG.AutoMob and State.mobToken == myTok end, function()
        while CFG.AutoMob and State.mobToken == myTok do
            if isDeadOrRespawning() or collecting or State.bossBusy or State.islandBossBusy or State.seaBeastBusy or State.fortRaidBusy then
                attackGoal = nil
                currentTarget = nil
                if isDeadOrRespawning() then Status = "Aguardando respawn..." end
                logMobThrottled(("PAUSED dead=%s collecting=%s bossBusy=%s seaBeastBusy=%s fortRaidBusy=%s"):format(tostring(isDeadOrRespawning()), tostring(collecting), tostring(State.bossBusy or State.islandBossBusy), tostring(State.seaBeastBusy), tostring(State.fortRaidBusy)))
                task.wait(0.4)
            else
                local missionEntry = CFG.TargetMission and State.Mobs.MissionsByName[CFG.TargetMission]
                if not missionEntry then
                    Status = "Missão: selecione uma ilha e uma missão"
                    logMobThrottled("NO_MISSION_SELECTED")
                    task.wait(1)
                else
                    local myLv = getLevel()
                    if myLv < (missionEntry.minLv or 1) then
                        Status = ("Missão: requer Lv %d (atual %d)"):format(missionEntry.minLv or 1, myLv)
                        logMob(("LOW_LEVEL mission=%s req=%d lv=%d"):format(missionEntry.name, missionEntry.minLv or 1, myLv))
                        notify("Missão", Status)
                        CFG.AutoMob = false
                        if Shared.RefreshToggles then Shared.RefreshToggles() end
                        break
                    end

                    local function mAborted()
                        return not CFG.AutoMob or State.mobToken ~= myTok or collecting or State.bossBusy or State.islandBossBusy or State.seaBeastBusy or State.fortRaidBusy
                    end

                    local curQ, curInfo, curProg = Features.ActiveQuest()
                    local shouldContinue = false
                    local nameSet = nil

                    if curQ ~= nil and curQ ~= missionEntry.name then
                        Status = "Trocando para missão selecionada..."
                        logMob(("QUEST_ABANDON %s -> %s"):format(tostring(curQ), tostring(missionEntry.name)))
                        pcall(function() GameModules.Network:FireServer("Quests", "Abandon", curQ) end)
                        task.wait(0.6)
                        shouldContinue = true
                    elseif curQ == nil then
                        if os.clock() < State.repeatPendingUntil then
                            Status = "Repetindo missão..."
                            task.wait(0.25)
                            shouldContinue = true
                        elseif hadActiveQuest then
                            hadActiveQuest = false
                            Status = "Repetindo missão..."
                            local waitEnd = os.clock() + 0.8
                            local firedManual = false
                            while not mAborted() and os.clock() < waitEnd do
                                curQ, curInfo, curProg = Features.ActiveQuest()
                                if curQ == missionEntry.name then break end
                                if not firedManual and os.clock() >= State.repeatPendingUntil and (waitEnd - os.clock()) <= 0.45 then
                                    firedManual = true
                                    pcall(function() GameModules.Network:FireServer("Quests", "Repeat") end)
                                end
                                task.wait(0.15)
                            end
                            if curQ ~= missionEntry.name then
                                if os.clock() < State.repeatPendingUntil then
                                    shouldContinue = true
                                elseif os.clock() >= State.questCooldown then
                                    logMob(("ACCEPT_QUEST mission=%s"):format(missionEntry.name))
                                    if Features.TryAcceptQuest(missionEntry.name, missionEntry.info, mAborted) then
                                        task.wait(0.35)
                                    else
                                        State.questCooldown = os.clock() + 4
                                    end
                                    shouldContinue = true
                                else
                                    task.wait(0.3)
                                    shouldContinue = true
                                end
                            end
                        elseif os.clock() >= State.questCooldown then
                            logMob(("ACCEPT_QUEST mission=%s"):format(missionEntry.name))
                            if Features.TryAcceptQuest(missionEntry.name, missionEntry.info, mAborted) then
                                task.wait(0.35)
                            else
                                State.questCooldown = os.clock() + 4
                            end
                            shouldContinue = true
                        else
                            task.wait(0.3)
                            shouldContinue = true
                        end
                    end

                    if not shouldContinue and curQ == missionEntry.name then
                        hadActiveQuest = true
                        local pSet, done = Features.PendingNames(curInfo, curProg)
                        if done then
                            Status = "Missão concluída, aguardando..."
                            logMob(("QUEST_DONE %s"):format(tostring(curQ)))
                            local t0 = os.clock()
                            while not mAborted() and Features.ActiveQuest() == curQ and os.clock() - t0 < 6 do
                                task.wait(0.3)
                            end
                            if Features.ActiveQuest() == curQ then
                                pcall(function() GameModules.Network:FireServer("Quests", "Repeat") end)
                            end
                            shouldContinue = true
                        else
                            nameSet = pSet
                        end
                    end

                    if shouldContinue then continue end

                    local targetNameSet = {}
                    if nameSet and next(nameSet) ~= nil then
                        for n, v in pairs(nameSet) do
                            if v then targetNameSet[n] = true end
                        end
                    else
                        for _, n in ipairs(missionEntry.mobs or {}) do
                            targetNameSet[n] = true
                        end
                    end

                    local _, hrp = getChar()
                    local target = hrp and Combat.PickTarget(myLv, hrp.Position, targetNameSet)

                    if target then
                        local bOrig = baseName(target)
                        local function targetAborted()
                            if mAborted() or not mobAlive(target) then return true end
                            if curInfo then
                                local cQ2, cInfo2, cProg2 = Features.ActiveQuest()
                                if cQ2 == missionEntry.name and cInfo2 then
                                    local pSet2 = Features.PendingNames(cInfo2, cProg2)
                                    if pSet2 and not pSet2[bOrig] then return true end
                                end
                            end
                            return false
                        end
                        logMob(("FIGHT target=%s orig=%s mission=%s"):format(tostring(target.Name), tostring(bOrig), missionEntry.name))
                        Combat.FightTarget(target, targetAborted, "Mission", { checkStuck = true, allowGoNear = true })
                        logMob(("FIGHT_END target=%s alive=%s"):format(tostring(target.Name), tostring(mobAlive(target))))
                    elseif hrp then
                        local moved = false
                        for wantedName in pairs(targetNameSet) do
                            local mk = Combat.SpawnMarker(wantedName, hrp.Position)
                            if mk then
                                Status = ("Missão: indo ao spawn de %s..."):format(wantedName)
                                logMob(("TRAVEL_SPAWN mob=%s dist=%.1f"):format(wantedName, (mk.Position - hrp.Position).Magnitude))
                                goNear(mk.Position, function() return mAborted() or Combat.PickTarget(myLv, mk.Position, targetNameSet) ~= nil end)
                                task.wait(0.5)
                                moved = true
                                break
                            end
                        end
                        if not moved then
                            local areasF = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Areas")
                            local isl = missionEntry.island
                            local area = areasF and isl and areasF:FindFirstChild(isl)
                            local center = area and area:GetAttribute("MapCenter")
                            if typeof(center) == "Vector3" then
                                local alt = area:GetAttribute("MapAltitude") or 14
                                local destPos = center + Vector3.new(0, alt + 12, 0)
                                local dIsl = (hrp.Position - destPos).Magnitude
                                if dIsl > 450 then
                                    Status = ("Missão: indo para %s..."):format(isl)
                                    logMob(("TRAVEL isl=%s dist=%.1f mission=%s"):format(tostring(isl), dIsl, missionEntry.name))
                                    goNear(destPos, function() return mAborted() or Combat.PickTarget(myLv, hrp.Position, targetNameSet) ~= nil end)
                                    moved = true
                                end
                            end
                        end
                        if not moved then
                            Status = "Missão: aguardando respawn..."
                            logMobThrottled(("NONE_FOUND mission=%s hrpY=%.1f"):format(missionEntry.name, hrp.Position.Y))
                            task.wait(0.8)
                        end
                    else
                        task.wait(0.4)
                    end
                end
            end
        end
        end, function(err) attackGoal = nil; currentTarget = nil; cancelTween() end)
        logMob(("=== MissionLoop STOP (AutoMob=%s tok=%d/%d) ==="):format(tostring(CFG.AutoMob), myTok, State.mobToken))
    end)
end
GameClient.MissionLoop = Features.MissionLoop
end

function Features.StopAllMainModes(keepBoss, keepMob, keepRaid, keepFortRaid)
    if CFG.AutoCollectibles then debugLog("collectibles_debug.txt", "STOP reason=other_mode_started") end
    if CFG.AutoVoxTraining then
        debugLog(CFG.VoxTrainingType == "Armor" and "vox_armor_debug.txt" or "vox_sense_debug.txt", "STOP reason=other_mode_started")
    end
    CFG.AutoFarm = false
    State.farmToken += 1
    CFG.AutoHistory = false
    CFG.AutoSecondary = false
    CFG.AutoVoxTraining = false
    CFG.AutoCollectibles = false
    CFG.AutoSecretAchievements = false
    GameClient.CampfireActive = false
    GameClient.CollectibleMode = nil
    GameClient.CollectibleRequested = false
    GameClient.CollectibleToken = (GameClient.CollectibleToken or 0) + 1
    State.storyToken += 1
    if not keepBoss then
        CFG.AutoBoss = false
        CFG.AutoBoardBoss = false
        State.bossBusy = false
        State.bossToken += 1
    end
    if not keepMob then
        CFG.AutoMob = false
        State.mobToken += 1
    end
    CFG.AutoMobDrops = false
    State.Tokens.MobDrop = (State.Tokens.MobDrop or 0) + 1
    if not keepRaid then
        if CFG.AutoRaid then GameClient.LeaveBossRoom() end
        CFG.AutoRaid = false
        GameClient.RaidToken = (GameClient.RaidToken or 0) + 1
    end
    if not keepFortRaid then
        CFG.AutoFortRaid = false
        GameClient.FortRaidToken = (GameClient.FortRaidToken or 0) + 1
    end
    GameClient.stopFightingStyle()
    attackGoal = nil
    currentTarget = nil
    cancelTween()
end

