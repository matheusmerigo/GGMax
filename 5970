                                end
                                task.wait(0.1)
                            end
                            task.wait(0.35)
                        end

                        -- ActionGate: evita tentar usar porta ou interagir quando preso por BossTether / BossArenaLock
                        local gateBlocked = false
                        do
                            local cGate = LP.Character
                            if cGate then
                                if MainModules and MainModules.ActionGate and MainModules.ActionGate.GetBlockReason then
                                    local okG, reason = pcall(MainModules.ActionGate.GetBlockReason, cGate, isDoor and "Teleport" or "Interact")
