function GameClient.GetFortRaidFolder()
    local map = workspace:FindFirstChild("Map")
    local areas = map and map:FindFirstChild("Areas")
    return areas and areas:FindFirstChild("Marine Forts")
end

function GameClient.FindFortRaidEnemy(center)
    local enemies = playability("Enemys")
    if not (enemies and typeof(center) == "Vector3") then return nil end
    local best, bestDistance
    for _, enemy in ipairs(enemies:GetChildren()) do
        if enemy:IsA("Model") and GameClient.FortRaidEnemyAlive(enemy) then
            local original = enemy:GetAttribute("OriginalName") or baseName(enemy)
            if original:sub(1, 12) == "Fort Marine " or original == "Fort Commander Ironclad" or original == "Commodore Garrick" then
                local root = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
                local distance = root and (root.Position - center).Magnitude
                if distance and distance <= 900 and (not bestDistance or distance < bestDistance) then
                    best, bestDistance = enemy, distance
                end
            end
        end
    end
    return best, bestDistance
end

function GameClient.GetFortPoint(fortFolder, activeFort, name)
    local data = fortFolder and fortFolder:FindFirstChild("Data")
    local activeData = data and type(activeFort) == "string" and data:FindFirstChild(activeFort)
    return activeData and Features.ExtractVec3(activeData:FindFirstChild(name))
end

function GameClient.LootFortRaid(fortFolder, activeFort, aborted, logFort)
    local data = fortFolder and fortFolder:FindFirstChild("Data")
    local activeData = data and data:FindFirstChild(activeFort)
    local bankDoor = activeData and activeData:FindFirstChild("BankDoor")
    local doorPanel = bankDoor and MainModules and MainModules.FortVaultUtils and MainModules.FortVaultUtils.GetDoorPanel(bankDoor)
    local vaultPos = Features.ExtractVec3(doorPanel) or GameClient.GetFortPoint(fortFolder, activeFort, "BossSpawn")
    if vaultPos then
        Status = "Fort Raid: indo ao cofre..."
        goNear(vaultPos + Vector3.new(0, 2, 0), aborted, { noMirror = true })
    end
    if aborted() then return end

    if fortFolder:GetAttribute("VaultOpened") ~= true then
        logFort("VAULT_OPEN_REQUEST fort=" .. tostring(activeFort))
        GameClient.fireInteractionContext("MarineFortVault")
        GameClient.pressInteract(0.5, "MarineFortVault")
        pcall(function() GameModules.Network:FireServer("FortRaid", "OpenVault") end)
        local vaultDeadline = os.clock() + 12
        while not aborted() and os.clock() < vaultDeadline and fortFolder:GetAttribute("VaultOpened") ~= true do
            task.wait(0.25)
        end
    end
    if aborted() or fortFolder:GetAttribute("VaultOpened") ~= true then return end

    pcall(function() GameModules.Network:FireServer("FortRaid", "GetChests") end)
    local loadDeadline = os.clock() + 5
    while not aborted() and os.clock() < loadDeadline do
        local ignore = workspace:FindFirstChild("IgnoreList")
        if ignore and ignore:FindFirstChild("FortChest", true) then break end
        task.wait(0.2)
    end

    local function chestConfirmed(chest)
        if not chest or not chest.Parent then return true, "removed" end
        for _, descendant in ipairs(chest:GetDescendants()) do
            if descendant:IsA("Sound") and tostring(descendant.SoundId):find("110128783106056", 1, true) then
                return true, "server_animation"
            end
            if descendant:IsA("Animator") then
                local ok, tracks = pcall(function() return descendant:GetPlayingAnimationTracks() end)
                if ok then
                    for _, track in ipairs(tracks) do
                        local animation = track.Animation
                        if animation and tostring(animation.AnimationId):find("139773733041262", 1, true) then
                            return true, "open_track"
                        end
                    end
                end
            end
        end
        return false, "pending"
    end

    local opened, failed, emptyPasses = 0, 0, 0
    local confirmedModels, failedModels, attempts = {}, {}, {}
    while not aborted() and opened < 8 and emptyPasses < 5 do
        local ignore = workspace:FindFirstChild("IgnoreList")
        local _, hrp = getChar()
        local nearest, nearestDistance
        if ignore and hrp then
            for _, item in ipairs(ignore:GetDescendants()) do
                if item:IsA("Model") and item.Name == "FortChest" and not confirmedModels[item] and not failedModels[item] then
                    local distance = (item:GetPivot().Position - hrp.Position).Magnitude
                    if not nearestDistance or distance < nearestDistance then
                        nearest, nearestDistance = item, distance
                    end
                end
            end
        end
        if not nearest then
            emptyPasses += 1
            task.wait(1)
        else
            emptyPasses = 0
            local chestPos = nearest:GetPivot().Position
            attempts[nearest] = (attempts[nearest] or 0) + 1
            local attempt = attempts[nearest]
            Status = ("Fort Raid: abrindo baú %d/8 (tentativa %d)..."):format(opened + 1, attempt)
            goNear(chestPos + Vector3.new(0, 2, 0), aborted, { noMirror = true })
            local contextDeadline = os.clock() + 2.5
            while not aborted() and os.clock() < contextDeadline do
                local interaction = GameClient.getInteractionClient()
                if interaction and interaction.Interaction and interaction.Interaction.CurrentContext == "MarineFortChest" then
                    break
                end
                task.wait(0.1)
            end

            task.wait(1.0)
            if aborted() then break end
            local chestIdx = tonumber(
                nearest:GetAttribute("Index")
                or nearest:GetAttribute("ChestIndex")
                or nearest:GetAttribute("Id")
                or nearest:GetAttribute("Order")
                or nearest.Name:match("%d+")
                or (nearest.Parent and nearest.Parent.Name:match("%d+"))
            )
            local fired = false
            local currentContext = nil
            if chestIdx then
                local ni = ReplicatedStorage:FindFirstChild("NetworkInstances")
                local re = ni and ni:FindFirstChild("RemoteEvents")
                local ev = re and re:FindFirstChild("FortRaid")
                if ev then
                    ev:FireServer("OpenChest", chestIdx)
                    fired = true
                end
            end
            if not fired then
                local interaction = GameClient.getInteractionClient()
                currentContext = interaction and interaction.Interaction and interaction.Interaction.CurrentContext
                fired = currentContext == "MarineFortChest" and GameClient.fireInteractionContext("MarineFortChest")
            end
            logFort(("CHEST_REQUEST attempt=%d distance=%.2f idx=%s fired=%s"):format(
                attempt, tonumber(nearestDistance) or -1, tostring(chestIdx), tostring(fired)
            ))

            local confirmed, reason = chestConfirmed(nearest)
            local confirmDeadline = os.clock() + 3
            while not aborted() and not confirmed and os.clock() < confirmDeadline do
                task.wait(0.1)
                confirmed, reason = chestConfirmed(nearest)
            end
            if confirmed then
                if reason == "removed" then
                    failedModels[nearest] = true
                    logFort(("CHEST_REMOVED_SKIP attempt=%d opened=%d/8"):format(attempt, opened))
                else
                    confirmedModels[nearest] = true
                    opened += 1
                    logFort(("CHEST_CONFIRMED opened=%d/8 attempt=%d reason=%s"):format(opened, attempt, tostring(reason)))
                end
                task.wait(0.25)
            else
                logFort(("CHEST_REJECTED attempt=%d reason=%s context=%s"):format(attempt, tostring(reason), tostring(currentContext)))
                if attempt >= 3 then
                    failedModels[nearest] = true
                    failed += 1
                    logFort(("CHEST_FAILED failed=%d model=%s"):format(failed, tostring(nearest)))
                end
                task.wait(0.75)
            end
        end
    end
    logFort(("LOOT_DONE fort=%s confirmed=%d failed=%d"):format(tostring(activeFort), opened, failed))
end

function GameClient.StartFortRaidLoop()
    GameClient.FortRaidToken += 1
    local token = GameClient.FortRaidToken
    task.spawn(function()
        debugLog("fort_raid_debug.txt", ("=== FORT RAID START level=%s ==="):format(tostring(getLevel())), true)
        local lastState, lastWave, lootedAt
        local function aborted()
            return not CFG.AutoFortRaid or token ~= GameClient.FortRaidToken
        end
        local function fightAborted()
            return aborted() or State.seaBeastBusy
        end
        local function logFort(message)
            debugLog("fort_raid_debug.txt", message)
        end
        local function releaseFortPriority()
            if not State.fortRaidBusy then return end
            State.fortRaidBusy = false
            attackGoal = nil
            currentTarget = nil
            if not State.bossBusy and not State.seaBeastBusy then
                if CFG.MainModeActive and Features.ResumeMainMode then
                    Features.ResumeMainMode()
                elseif CFG.AutoMob and Features.MobLoop then
                    Features.MissionLoop()
                end
            end
        end
        SafeRuntime.RunResilientLoop("FortRaidLoop", function() return not aborted() end, function()
        while not aborted() do
            if getLevel() < 325 then
                Status = "Fort Raid: requer nível 325"
                notify("Fort Raid", Status)
                CFG.AutoFortRaid = false
                if Toggles and Toggles.MarineEvent and Toggles.MarineEvent.Value then
                    Toggles.MarineEvent:SetValue(false)
                end
                break
            end
            if isDeadOrRespawning() or State.seaBeastBusy then
                if State.fortRaidBusy then
                    State.fortRaidBusy = false
                    attackGoal = nil
                    currentTarget = nil
                end
                task.wait(0.5)
                continue
            end
            local fortFolder = GameClient.GetFortRaidFolder()
            if not fortFolder then
                releaseFortPriority()
                Status = "Fort Raid: aguardando módulo Marine Forts..."
                task.wait(1)
                continue
            end
            local state = fortFolder:GetAttribute("RaidState")
            local activeFort = fortFolder:GetAttribute("ActiveFort")
            local activePosition = fortFolder:GetAttribute("ActivePosition")
            local wave = fortFolder:GetAttribute("RaidWave")
            local waves = fortFolder:GetAttribute("RaidWaves")
            if state ~= lastState or wave ~= lastWave then
                logFort(("STATE state=%s fort=%s wave=%s/%s pos=%s"):format(
                    tostring(state), tostring(activeFort), tostring(wave), tostring(waves), tostring(activePosition)
                ))
                lastState, lastWave = state, wave
            end

            if state == "Open" and type(activeFort) == "string" and typeof(activePosition) == "Vector3" then
                if not State.fortRaidBusy then
                    while not aborted() and (State.bossBusy or State.islandBossBusy) do task.wait(0.5) end
                if aborted() then break end
                State.fortRaidBusy = true
                    GameClient.PauseMainModesForBoss()
                end
                lootedAt = nil
                local _, hrp = getChar()
                if hrp and (hrp.Position - activePosition).Magnitude > 650 then
                    Status = "Fort Raid: viajando para " .. activeFort
                    goNear(activePosition + Vector3.new(0, 20, 0), fightAborted)
                    task.wait(0.5)
                end
                if fightAborted() then continue end
                local fightCenter = GameClient.GetFortPoint(fortFolder, activeFort, "BossSpawn") or activePosition
                local enemy, distance = GameClient.FindFortRaidEnemy(fightCenter)
                if enemy then
                    local enemyName = enemy:GetAttribute("OriginalName") or baseName(enemy)
                    Status = ("Fort Raid %s/%s: %s"):format(tostring(wave), tostring(waves), enemyName)
                    logFort(("FIGHT_START enemy=%s hp=%s distance=%s"):format(enemyName, tostring(mobHP(enemy)), tostring(distance)))
                    Combat.FightTarget(enemy, function() return fightAborted() or not GameClient.FortRaidEnemyAlive(enemy) end, "Fort Raid", { checkStuck = false })
                    local stillAlive = GameClient.FortRaidEnemyAlive(enemy)
                    local hpAfter = select(1, mobHP(enemy))
                    local enemyRoot = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
                    logFort(("FIGHT_END enemy=%s alive=%s hp=%s aborted=%s render=%s canQuery=%s"):format(
                        enemyName,
                        tostring(stillAlive),
                        tostring(hpAfter),
                        tostring(fightAborted()),
                        tostring(enemy:GetAttribute("Render")),
                        tostring(enemyRoot and enemyRoot.CanQuery)
                    ))
                    task.wait(stillAlive and 0.15 or 0.35)
                else
                    local gatePos = GameClient.GetFortPoint(fortFolder, activeFort, "Gate") or fightCenter
                    local _, waitHrp = getChar()
                    if waitHrp and (waitHrp.Position - gatePos).Magnitude > 80 then
                        Status = ("Fort Raid: aguardando onda %s/%s..."):format(tostring(wave), tostring(waves))
                        goNear(gatePos + Vector3.new(0, 5, 0), fightAborted, { noMirror = true })
                    end
                    task.wait(0.5)
                end
            elseif state == "Completed" and type(activeFort) == "string" then
                local openedAt = fortFolder:GetAttribute("VaultOpenedAt") or "pending"
                if lootedAt ~= openedAt then
                    if not State.fortRaidBusy then
                        while not aborted() and (State.bossBusy or State.islandBossBusy) do task.wait(0.5) end
                if aborted() then break end
                State.fortRaidBusy = true
                        GameClient.PauseMainModesForBoss()
                    end
                    GameClient.LootFortRaid(fortFolder, activeFort, fightAborted, logFort)
                    lootedAt = fortFolder:GetAttribute("VaultOpenedAt") or openedAt
                else
                    releaseFortPriority()
                    if not (CFG.MainModeActive or CFG.AutoMob) then
                        Status = "Fort Raid: concluído e saqueado"
                    end
                    task.wait(1)
                end
            else
                lootedAt = nil
                releaseFortPriority()
                if not (CFG.MainModeActive or CFG.AutoMob) then
                    local nextAt = fortFolder:GetAttribute("NextOpenAt")
                    if type(nextAt) == "number" then
                        local remaining = math.max(0, math.ceil(nextAt - workspace:GetServerTimeNow()))
                        Status = ("Fort Raid: próximo em %d:%02d"):format(math.floor(remaining / 60), remaining % 60)
                    else
                        Status = "Fort Raid: aguardando próximo forte..."
                    end
                end
                task.wait(1)
            end
        end
        end, function(err) State.fortRaidBusy = false; attackGoal = nil; currentTarget = nil; cancelTween() end)
        State.fortRaidBusy = false
        attackGoal = nil
        currentTarget = nil
        logFort("=== FORT RAID STOP ===")
    end)
end

-- Auto Infinite Dungeon
do
    local dungeonHooked = false
    local function isInDungeonPlace()
        return MainModules and MainModules.PlaceProfile and MainModules.PlaceProfile:IsActive("DungeonSystem.InfiniteDungeon") == true
    end
    local function isInDungeonLobbyPlace()
        return not isInDungeonPlace()
    end
    local function ensureDungeonHook()
        if dungeonHooked or not (GameModules and GameModules.Network and GameModules.Network.OnClientEvent) then return end
        dungeonHooked = true
        pcall(function()
            GameModules.Network.OnClientEvent("DungeonSystem", function(ev, payload)
                if type(payload) ~= "table" then return end
                if ev == "Run" then
                    State.dungeonRun = payload
                elseif ev == "Cards" then
                    State.dungeonCards = payload
                elseif ev == "Eliminated" then
                    State.dungeonEliminated = true
                end
            end)
        end)
    end

    local CARD_WEIGHTS = {
        DungeonToken = 1000,
        SecondChance = 900,
        ExtraOption = 800,
        Damage = 700,
        SkillCooldown = 650,
        Defense = 600,
        HealthRegen = 550,
        Health = 500,
        RestoreInstinct = 460,
        InstinctRegen = 450,
        InstinctCharge = 440,
        MoveSpeed = 400,
        FlashStepCooldown = 350,
        StaminaRegen = 300,
        Stamina = 250,
        Reroll = 50,
    }
    local function pickBestDungeonCard(offers, run)
        if type(offers) ~= "table" or #offers == 0 then return 1 end
        local _, _, hum = getChar()
        local hpPct = (hum and hum.MaxHealth > 0) and (hum.Health / hum.MaxHealth) or 1
        local data = getData()
        local hasKen = data and data.Abilitys and (tonumber(data.Abilitys.Kenbushoku) or 0) >= 1
        local hasDeadAlly = false
        if type(run and run.Players) == "table" then
            for _, p in ipairs(run.Players) do
                if p.UserId ~= LP.UserId and p.Present and not p.Alive then
                    hasDeadAlly = true
                    break
                end
            end
        end
        local bestIdx, bestScore = 1, -1e9
        for i, card in ipairs(offers) do
            local id = type(card) == "table" and (card.Id or card.Name) or ""
            local score = CARD_WEIGHTS[id] or 100
            if id == "FullHeal" then
                score = (hpPct < 0.55) and 850 or 80
            elseif id == "ReviveAlly" then
                score = hasDeadAlly and 880 or 10
            elseif (id == "InstinctRegen" or id == "InstinctCharge" or id == "RestoreInstinct") and not hasKen then
                score = 20
            end
            if score > bestScore then
                bestScore, bestIdx = score, i
            end
        end
        return bestIdx
    end

    local function findDungeonEnemy()
        local enemies = playability("Enemys")
        if not enemies then return nil end
        local _, hrp = getChar()
        local best, bestD = nil, math.huge
        for _, m in ipairs(enemies:GetChildren()) do
            if m:IsA("Model") and mobAlive(m) then
                local mrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                local d = (mrp and hrp) and (mrp.Position - hrp.Position).Magnitude or 0
                if d < bestD then
                    best, bestD = m, d
                end
            end
        end
        return best
    end

    function GameClient.StopDungeonLoop()
        CFG.AutoDungeon = false
        State.Tokens.Dungeon = (State.Tokens.Dungeon or 0) + 1
        attackGoal = nil
        currentTarget = nil
        cancelTween()
        if Movement and Movement.Stop then Movement.Stop() end
        Status = "Parado"
    end

    function GameClient.StartDungeonLoop()
        ensureDungeonHook()
        State.Tokens.Dungeon = (State.Tokens.Dungeon or 0) + 1
        local myTok = State.Tokens.Dungeon
        task.spawn(function()
            local function aborted()
                return not CFG.AutoDungeon or State.Tokens.Dungeon ~= myTok
            end
            local lastRunPoll, lastSkippedWave, lastCardWave, lastCardRoll = 0, -1, -1, -1
            debugLog("dungeon_debug.txt", ("=== DUNGEON START inPlace=%s ==="):format(tostring(isInDungeonPlace())), true)
            SafeRuntime.RunResilientLoop("DungeonLoop", function() return not aborted() end, function()
            while not aborted() do
                if isInDungeonLobbyPlace() then
                    if isDeadOrRespawning() or State.bossBusy or State.islandBossBusy or State.seaBeastBusy or State.fortRaidBusy or collecting then
                        task.wait(0.8)
                    else
                        local okL, lobby = pcall(function()
                            return GameModules.Network:SafeInvokeServer(5, "DungeonSystem", "GetLobby")
                        end)
                        if okL and type(lobby) == "table" then
                            if lobby.Starting then
                                Status = "Dungeon: entrando na partida..."
                                task.wait(1.5)
                            elseif lobby.LeaderUserId == LP.UserId then
                                if lobby.CanStart then
                                    Status = "Dungeon: iniciando lobby..."
                                    local okS, resS = pcall(function()
                                        return GameModules.Network:SafeInvokeServer(5, "DungeonSystem", "StartLobby")
                                    end)
                                    debugLog("dungeon_debug.txt", ("START_LOBBY ok=%s res=%s"):format(tostring(okS), tostring(resS)))
                                    task.wait(resS == "Starting" and 6.0 or 2.0)
                                else
                                    Status = "Dungeon: aguardando jogadores/combate..."
                                    task.wait(1.5)
                                end
                            else
                                local myReady = false
                                for _, m in ipairs(lobby.Members or {}) do
                                    if m.UserId == LP.UserId then myReady = (m.Ready == true); break end
                                end
                                if not myReady then
                                    pcall(function() GameModules.Network:SafeInvokeServer(5, "DungeonSystem", "SetReady", true) end)
                                end
                                Status = "Dungeon: pronto, aguardando líder..."
                                task.wait(1.5)
                            end
                        else
                            task.wait(1.5)
                        end
                    end
                else
                    if not State.dungeonRun or (os.clock() - lastRunPoll) >= 5 then
                        lastRunPoll = os.clock()
                        local okR, runRes = pcall(function()
                            return GameModules.Network:SafeInvokeServer(5, "DungeonSystem", "GetRun")
                        end)
                        if okR and type(runRes) == "table" then
                            State.dungeonRun = runRes
                        end
                    end
                    local run = State.dungeonRun
                    if type(run) == "table" then
                        local maxW = tonumber(CFG.DungeonMaxWave) or 0
                        local meAlive, anyOtherAlive = false, false
                        for _, p in ipairs(run.Players or {}) do
                            if p.UserId == LP.UserId then
                                meAlive = (p.Alive == true and p.Present == true)
                            elseif p.Present and p.Alive then
                                anyOtherAlive = true
                            end
                        end
                        if (maxW > 0 and (tonumber(run.Wave) or 0) > maxW)
                            or run.Phase == "Finished"
                            or (not meAlive and not anyOtherAlive and run.Phase ~= "Waiting") then
                            Status = "Dungeon: saindo da partida..."
                            debugLog("dungeon_debug.txt", ("LEAVE_RUN phase=%s wave=%s meAlive=%s"):format(tostring(run.Phase), tostring(run.Wave), tostring(meAlive)))
                            task.wait(2.0)
                            if not aborted() then
                                pcall(function() GameModules.Network:SafeInvokeServer(5, "DungeonSystem", "LeaveRun") end)
                            end
                            task.wait(4.0)
                        elseif run.Phase == "Countdown" and lastSkippedWave ~= run.Wave then
                            lastSkippedWave = run.Wave
                            pcall(function() GameModules.Network:SafeInvokeServer(5, "DungeonSystem", "SkipCountdown") end)
                            task.wait(0.3)
                        elseif CFG.AutoDungeonCards and run.Phase == "Cards" then
                            local cards = State.dungeonCards
                            if not cards or cards.Wave ~= run.Wave then
                                local okC, cRes = pcall(function()
                                    return GameModules.Network:SafeInvokeServer(5, "DungeonSystem", "GetCards")
                                end)
                                if okC and type(cRes) == "table" then
                                    cards = cRes
                                    State.dungeonCards = cRes
                                end
                            end
                            if type(cards) == "table" and cards.Wave == run.Wave and (lastCardWave ~= cards.Wave or lastCardRoll ~= cards.Roll) and type(cards.Offers) == "table" and #cards.Offers > 0 then
                                lastCardWave, lastCardRoll = cards.Wave, cards.Roll
                                local bestIdx = pickBestDungeonCard(cards.Offers, run)
                                local chosen = cards.Offers[bestIdx]
                                Status = ("Dungeon: escolhendo carta (%s)..."):format(tostring(chosen and (chosen.Name or chosen.Id) or bestIdx))
                                debugLog("dungeon_debug.txt", ("SELECT_CARD wave=%s idx=%d id=%s"):format(tostring(cards.Wave), bestIdx, tostring(chosen and chosen.Id)))
                                pcall(function() GameModules.Network:SafeInvokeServer(5, "DungeonSystem", "SelectCard", bestIdx) end)
                                pcall(function()
                                    local dc = require(ReplicatedStorage.Modules.Modes.DungeonSystem["DungeonSystem Client"].InfiniteDungeon.Cards)
                                    if dc and dc.Hide then dc.Hide() end
                                end)
                            end
                            task.wait(0.35)
                        else
                            local tgt = findDungeonEnemy()
                            if tgt then
                                Combat.FightTarget(tgt, function()
                                    if aborted() or not mobAlive(tgt) then return true end
                                    local rNow = State.dungeonRun
                                    return rNow and (rNow.Phase == "Cards" or rNow.Phase == "Finished")
                                end, ("Dungeon [W%s]"):format(tostring(run.Wave or "?")), { checkStuck = false })
                            else
                                Status = ("Dungeon [W%s]: aguardando inimigos..."):format(tostring(run.Wave or "?"))
                                task.wait(0.35)
                            end
                        end
                    else
                        Status = "Dungeon: carregando run..."
                        task.wait(0.5)
                    end
                end
            end
            end, function(err) attackGoal = nil; currentTarget = nil; cancelTween() end)
            attackGoal = nil
            currentTarget = nil
            if Movement and Movement.Stop then Movement.Stop() end
            if State.Tokens.Dungeon == myTok and not CFG.AutoDungeon then
                Status = "Parado"
            end
            debugLog("dungeon_debug.txt", "=== DUNGEON STOP ===")
        end)
    end
end

