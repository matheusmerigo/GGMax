            if leapEv then
                track(SafeRuntime.Connect(leapEv.OnClientEvent, "SeaBeastLeap", function(model, _startTime, _baseCF, _lift)
                    if typeof(model) == "Instance" and model:IsA("Model") then
                        State.seaBeastActiveSkills = State.seaBeastActiveSkills or {}
                        State.seaBeastActiveSkills["Sea Beast:LeapGrab"] = os.clock() + 3.0
                        debugLog("seabeast_debug.txt", "DODGE_START key=SeaBeastLeap")
                    end
                end))
            end
        end)
    end
    debugLog("seabeast_debug.txt", ("=== AutoSeaBeast START lv=%d ==="):format(getLevel()), true)
    local lastLogT, lastLogMsg = 0, ""
    local function logSBThrottled(msg, interval)
        local now = os.clock()
        if msg ~= lastLogMsg or now - lastLogT >= (interval or 4) then
            lastLogMsg, lastLogT = msg, now
            logSB(msg)
        end
    end
    task.spawn(function()
        local warnedLv = false
        SafeRuntime.RunResilientLoop("SeaBeastLoop", function() return CFG.AutoSeaBeast and State.seaBeastToken == myTok end, function()
        while CFG.AutoSeaBeast and State.seaBeastToken == myTok do
            if isDeadOrRespawning() then
                attackGoal = nil
                currentTarget = nil
                logSBThrottled("PAUSED_DEAD_RESPAWN", 3)
                task.wait(0.5)
            else
                local sb = findSeaBeast()
                local ev1 = LP:GetAttribute("SeaBeastEvent")
                local ev2 = LP:GetAttribute("SeaBeastEventArea")
                local evPos = typeof(ev1) == "Vector3" and ev1 or (typeof(ev2) == "Vector3" and ev2 or nil)
                if not sb and typeof(evPos) ~= "Vector3" then
                    logSBThrottled(("NO_EVENT ev1=%s ev2=%s"):format(tostring(ev1), tostring(ev2)), 6)
                    if State.seaBeastBusy then
                        State.seaBeastBusy = false
                        attackGoal = nil
                        currentTarget = nil
                        if not State.fortRaidBusy and not State.bossBusy then
                            if CFG.MainModeActive and Features.ResumeMainMode then
                                Features.ResumeMainMode()
                            elseif CFG.AutoMob and Features.MobLoop then
                                Features.MissionLoop()
                            else
                                Status = "Parado"
                            end
                        end
                    end
                    task.wait(2)
                else
                    local lvl = getLevel()
                    if lvl < 325 then
                        if not warnedLv then
                            warnedLv = true
                            notify("🌊 Auto Sea Beast", ("Requer nível 325+ para o evento (atual: %d)."):format(lvl))
                        end
                        logSBThrottled(("LOW_LEVEL lv=%d"):format(lvl), 6)
                        task.wait(3)
                    else
                        if not State.seaBeastBusy then
                            while CFG.AutoSeaBeast and State.seaBeastToken == myTok and (State.bossBusy or State.islandBossBusy) do task.wait(0.5) end
            if not (CFG.AutoSeaBeast and State.seaBeastToken == myTok) then break end
            State.seaBeastBusy = true
                            GameClient.PauseMainModesForBoss()
                            State.mobToken += 1
                        end
                        local function sbAborted()
                            return not CFG.AutoSeaBeast or State.seaBeastToken ~= myTok
                        end
                        local function sbTravelAborted()
                            if sbAborted() then return true end
                            if findSeaBeast() ~= nil then return true end
                            local p1 = LP:GetAttribute("SeaBeastEvent")
                            local p2 = LP:GetAttribute("SeaBeastEventArea")
                            return typeof(p1) ~= "Vector3" and typeof(p2) ~= "Vector3"
                        end
                        if sb then
                            fightSeaBeast(sb, sbAborted)
                            task.wait(0.2)
                        elseif typeof(evPos) == "Vector3" then
                            local _, hrp = getChar()
                            if hrp then
                                local dest = Vector3.new(evPos.X, math.max(evPos.Y, 18), evPos.Z)
                                local dEv = (hrp.Position - dest).Magnitude
                                if dEv > 140 then
                                    Status = "Sea Beast: indo até o evento..."
                                    logSB(("TRAVEL_START dest=%s dist=%.1f ev1=%s ev2=%s"):format(tostring(dest), dEv, tostring(ev1), tostring(ev2)))
                                    goNear(dest, sbTravelAborted)
