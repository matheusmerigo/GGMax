-- NOCLIP RUNTIME
Shared.GetNoclipParts = LPH_NO_VIRTUALIZE(function(character)
    if not character then return {} end

    Shared._noclipPartCache = Shared._noclipPartCache or {
        Character = nil,
        Parts = {},
        Dirty = true,
    }

    local cache = Shared._noclipPartCache
    if cache.Character ~= character then
        cache.Character = character
        cache.Dirty = true
        Shared.DisconnectConnectionGroup("NoclipCache")
        Shared.ConnectSignalGroup("NoclipCache", character.DescendantAdded, function(descendant)
            if descendant:IsA("BasePart") then
                cache.Dirty = true
            end
        end)
        Shared.ConnectSignalGroup("NoclipCache", character.DescendantRemoving, function(descendant)
            if descendant:IsA("BasePart") then
                cache.Dirty = true
            end
        end)
    end

    if cache.Dirty then
        local parts = {}
        local partCount = 0
        for _, descendant in ipairs(character:GetDescendants()) do
            if descendant:IsA("BasePart") then
                partCount = partCount + 1
                parts[partCount] = descendant
            end
        end
        cache.Parts = parts
        cache.Dirty = false
    end

    return cache.Parts
end)

Shared.ApplyNoclip = LPH_NO_VIRTUALIZE(function(character)
    local char = character or Plr.Character
    if not char then return false end

    local applied = false
    for _, part in ipairs(Shared.GetNoclipParts(char)) do
        if part and part.Parent and part:IsA("BasePart") then
            part.CanCollide = false
            applied = true
        end
    end
    return applied
end)

Shared.IsNoclipRequested = function()
    if Toggles and Toggles.Noclip and Toggles.Noclip.Value then return true end
    return false
end

Shared.CreateNamedTaskLoop("NoclipRuntime", LPH_NO_VIRTUALIZE(function()
    while IsCurrentRuntimeActive() and not (Library and Library.Unloaded) do
        local ok, shouldApply = Shared.TryCall(Shared.IsNoclipRequested)
        if ok == true and shouldApply then
            local applyOk, applyErr = Shared.TryCall(Shared.ApplyNoclip)
            if applyOk ~= true then
                Shared.WarnThrottled("NoclipRuntime", 3, "ApplyNoclip failed: " .. tostring(applyErr))
            end
        elseif ok ~= true then
            Shared.WarnThrottled("NoclipRuntime", 3, "IsNoclipRequested failed: " .. tostring(shouldApply))
        end
        task.wait(0.05)
    end
end))

-- GRAPHICS OPTIMIZATION RUNTIME
local cachedAtmosphere = nil
local cachedSky = nil
local fullbrightBaseline = nil
local fullbrightApplied = false
local applyingFullbright = false

local function disconnectFullbrightConnections()
    Shared.DisconnectConnectionGroup("Fullbright")
end

local function captureLightingState(lighting)
    return {
        Brightness = lighting.Brightness,
        ClockTime = lighting.ClockTime,
        GlobalShadows = lighting.GlobalShadows,
        Ambient = lighting.Ambient,
        OutdoorAmbient = lighting.OutdoorAmbient,
        FogEnd = lighting.FogEnd,
    }
end

local function isFullbrightState(lighting)
    return lighting
        and lighting.Brightness == 2
        and lighting.ClockTime == 14
        and lighting.GlobalShadows == false
        and lighting.Ambient == Color3.new(1, 1, 1)
        and lighting.OutdoorAmbient == Color3.new(1, 1, 1)
end

local function applyFullbright()
    local lighting = Services.Lighting
    if not lighting or applyingFullbright then return end
    if not (Toggles.Fullbright and Toggles.Fullbright.Value) then return end
    if not (not isFullbrightState(lighting)) then return end

    applyingFullbright = true
    lighting.Brightness = 2
    lighting.ClockTime = 14
    lighting.GlobalShadows = false
    lighting.Ambient = Color3.new(1, 1, 1)
    lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    lighting.FogEnd = 9e9
    applyingFullbright = false
end

local function enableFullbright()
    local lighting = Services.Lighting
    if not lighting then return end

    if not fullbrightApplied and not isFullbrightState(lighting) then
        fullbrightBaseline = captureLightingState(lighting)
    elseif fullbrightBaseline == nil then
        fullbrightBaseline = captureLightingState(lighting)
    end

    disconnectFullbrightConnections()
    applyFullbright()
    fullbrightApplied = true

    Shared.ConnectSignalGroup("Fullbright", lighting:GetPropertyChangedSignal("Brightness"), applyFullbright)
    Shared.ConnectSignalGroup("Fullbright", lighting:GetPropertyChangedSignal("ClockTime"), applyFullbright)
    Shared.ConnectSignalGroup("Fullbright", lighting:GetPropertyChangedSignal("GlobalShadows"), applyFullbright)
    Shared.ConnectSignalGroup("Fullbright", lighting:GetPropertyChangedSignal("Ambient"), applyFullbright)
    Shared.ConnectSignalGroup("Fullbright", lighting:GetPropertyChangedSignal("OutdoorAmbient"), applyFullbright)
    Shared.ConnectSignalGroup("Fullbright", lighting:GetPropertyChangedSignal("FogEnd"), applyFullbright)
end

local function disableFullbright()
    local lighting = Services.Lighting
    if not lighting then return end

    disconnectFullbrightConnections()
    if fullbrightApplied and fullbrightBaseline then
        lighting.Brightness = fullbrightBaseline.Brightness
        lighting.ClockTime = fullbrightBaseline.ClockTime
        lighting.GlobalShadows = fullbrightBaseline.GlobalShadows
        lighting.Ambient = fullbrightBaseline.Ambient
        lighting.OutdoorAmbient = fullbrightBaseline.OutdoorAmbient
        lighting.FogEnd = fullbrightBaseline.FogEnd
    end
    fullbrightApplied = false
end

local function applyAtmosphereState(state)
    local lighting = Services.Lighting
    if state then
        local atm = lighting:FindFirstChildOfClass("Atmosphere")
        if atm then
            cachedAtmosphere = atm
            atm.Parent = nil
        end
        local sky = lighting:FindFirstChildOfClass("Sky")
        if sky then
            cachedSky = sky
            sky.Parent = nil
        end
    else
        if cachedAtmosphere then
            cachedAtmosphere.Parent = lighting
            cachedAtmosphere = nil
        end
        if cachedSky then
            cachedSky.Parent = lighting
            cachedSky = nil
        end
    end
end

function Shared.ApplyDisable3DRenderState(state)
    RunService:Set3dRenderingEnabled(state ~= true)
end

function Shared.ApplyFullbrightState(state)
    if state == true then
        enableFullbright()
    else
        disableFullbright()
    end
end

function Shared.ApplyRemoveAtmosphereState(state)
    applyAtmosphereState(state == true)
end

function Shared.InitializeOptimizationToggles()
    Toggles.Fullbright:OnChanged(function(state)
        Shared.ApplyFullbrightState(state)
    end)
    TaskDefer(function()
        Shared.ApplyFullbrightState(Toggles.Fullbright and Toggles.Fullbright.Value == true)
    end)

    Toggles.Disable3DRender:OnChanged(function(state)
        Shared.ApplyDisable3DRenderState(state)
    end)
    TaskDefer(function()
        Shared.ApplyDisable3DRenderState(Toggles.Disable3DRender and Toggles.Disable3DRender.Value)
    end)

    Shared._RestoreAtmosphereState = function()
        applyAtmosphereState(false)
    end

    Toggles.RemoveAtmosphere:OnChanged(function(state)
        Shared.ApplyRemoveAtmosphereState(state)
    end)
    TaskDefer(function()
        Shared.ApplyRemoveAtmosphereState(Toggles.RemoveAtmosphere and Toggles.RemoveAtmosphere.Value)
    end)
end

-- DISCORD WEBHOOK ALERTS RUNTIME
local function NormalizeAlertEntryName(name)
    if type(name) ~= "string" or name == "" then return nil end
    return name
end

local function IsAlertEntryEnabled(itemName)
    local normalizedName = NormalizeAlertEntryName(itemName)
    if not normalizedName then return false, nil end
    local selected = GetOptionTable(Options, "SelectedWebhookItems")
    if type(selected) == "table" and (selected[normalizedName] == true or table.find(selected, normalizedName)) then
        return true, normalizedName
    end
    return false, normalizedName
end

local function PostPlayerAlert(itemName)
    if not GetToggleValue(Toggles, "SendWebhook") then return false end

    local url = GetOptionString(Options, "WebhookURL")
    if url == "" or not url:find("discord.com/api/webhooks/") then return false end

    local shouldSend, normalizedName = IsAlertEntryEnabled(itemName)
    if itemName ~= nil and not shouldSend then return false end

    normalizedName = normalizedName or "Test Alert"
    local payload = {
        ["username"] = "Midgard Alerts",
        ["avatar_url"] = ClientPublicConfig.AvatarUrl,
        ["embeds"] = {{
            ["description"] = "**Triggered Event:** " .. normalizedName,
            ["color"] = 0x242424,
        }}
    }

    TaskSpawn(function()
        Shared.HttpRequest({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = Services.HttpService:JSONEncode(payload)
        })
    end)

    return true
end

Shared.PostToWebhook = PostPlayerAlert

