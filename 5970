function BoatSystem.SpawnOnWater(nearPos, aborted, destPos)
    local existing = BoatSystem.FindOwnedBoat()
    if existing and (existing:GetPivot().Position - nearPos).Magnitude < 1600 then
        return existing
    end
    if not BoatSystem.FindBoatTool() then
        BoatSystem.BuyBoatIfNeeded(aborted)
    end
    local tool = BoatSystem.FindBoatTool()
    if not tool or aborted() then return existing end
    local waterPos = BoatSystem.FindWaterSpot(nearPos, destPos)
    Status = "Barco: colocando barco na água..."
    local _, h0, hm0 = getChar()
    if h0 and (h0.Position - waterPos).Magnitude > 25 then
        tweenTo(CFrame.new(waterPos + Vector3.new(0, 8, 0)), aborted)
        task.wait(0.05)
    end
    if aborted() then return nil end
    if hm0 and tool.Parent ~= LP.Character then
        pcall(function() hm0:EquipTool(tool) end)
        task.wait(0.45)
    end
    pcall(function()
        local nav = require(ReplicatedStorage.Modules.Essentials.NavigationSystem).IsClient
        if nav and nav.SpawnBoatClient and nav.SpawnBoatClient.ConfirmPlacement then
            nav.SpawnBoatClient.ConfirmPlacement()
        end
    end)
    task.wait(0.6)
    if not BoatSystem.FindOwnedBoat() then
        local spawnCF = destPos and CFrame.lookAt(Vector3.new(waterPos.X, 1, waterPos.Z), Vector3.new(destPos.X, 1, destPos.Z)) or CFrame.new(waterPos.X, 1, waterPos.Z)
        pcall(function()
            if GameModules and GameModules.Network and GameModules.Network.SafeInvokeServer then
                GameModules.Network:SafeInvokeServer(10, "SpawnBoat", "Spawn", tool.Name, spawnCF)
            end
        end)
    end
    local t0 = os.clock()
    while os.clock() - t0 < 4.0 and not aborted() do
        local b = BoatSystem.FindOwnedBoat()
        if b then return b end
        task.wait(0.05)
    end
    return BoatSystem.FindOwnedBoat()
end

