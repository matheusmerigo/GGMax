function GameClient.GetItemCategory(definition)
    if type(definition) ~= "table" then return "Others" end
    local cat
    pcall(function()
        if MainModules and MainModules.ToolsUtils and MainModules.ToolsUtils.GetCategory then
            cat = MainModules.ToolsUtils.GetCategory(definition)
        end
    end)
    if cat == "Fruits" then return "Fruits" end
    if cat == "Swords" then return "Swords" end
    if cat == "Guns" then return "Guns" end
    if definition.ToolType == "Accessory" or cat == "Accessories" then return "Accessories" end
    if definition.ToolType == "Equipment" then return "Equipment" end
    if definition.ToolType == "Item" then
        local st = definition.SubType
        if st == "Material" then return "Materials" end
        if st == "Resources" then return "Resources" end
        if st == "Recipe" then return "Recipes" end
        if st == "Scroll" then return "Scrolls" end
    end
    return "Others"
end

function GameClient.GetContainerRows(containerName, categoryFilter, opts)
    local result = {}
    local data = getData()
    local isBank = (containerName == "Bank")
    for index, item in ipairs(data and data.Tools and data.Tools[containerName or "Unequiped"] or {}) do
        local definition
        pcall(function() definition = MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo:Get(item.Name) end)
        local category = GameClient.GetItemCategory(definition)
        local takesSpace = true
        pcall(function()
            if MainModules and MainModules.ToolsUtils and MainModules.ToolsUtils.TakesSpace then
                takesSpace = MainModules.ToolsUtils.TakesSpace(item)
            end
        end)
        local include = true
        if categoryFilter and categoryFilter ~= "All" and category ~= categoryFilter then
            include = false
        end
        if include and opts and opts.onlyBankable and not isBank and (item.Locked == true or not takesSpace) then
            include = false
        end
        if include and opts and opts.onlyDeletable and not takesSpace and category == "Others" then
            include = false
        end
        if include then
            result[#result + 1] = {
                Index = index,
                Name = item.Name,
                Quantity = math.max(1, tonumber(item.Quantity) or 1),
                Locked = item.Locked == true,
                SubType = (definition and (definition.SubType or definition.ToolType)) or "?",
                Category = category,
                CategoryLabel = GameClient.INVENTORY_CATEGORY_LABELS[category] or category,
                Rarity = (definition and definition.Rarity) or "?",
                TakesSpace = takesSpace,
            }
        end
    end
    table.sort(result, function(a, b)
        if a.Name == b.Name then return a.Index < b.Index end
        return a.Name < b.Name
    end)
    return result
end

function GameClient.GetCatalogItemsByCategory(category, opts)
    local names, seen = {}, {}
    local function addName(n)
        if type(n) == "string" and n ~= "" and not seen[n] then
            seen[n] = true
            names[#names + 1] = n
        end
    end

    for _, it in ipairs(GameClient.GetContainerRows("Unequiped", category, opts)) do
        addName(it.Name)
    end

    local infos = MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo.Infos
    local storable = MainModules and MainModules.ToolsUtils and MainModules.ToolsUtils.StorableTypes
    if type(infos) == "table" then
        for name, def in pairs(infos) do
            if type(def) == "table" and GameClient.GetItemCategory(def) == category then
                if not (opts and opts.onlyBankable and storable and def.ToolType and storable[def.ToolType] == false) then
                    addName(def.ToolName or def.Name or (type(name) == "string" and name))
                end
            end
        end
    end

    if category == "Fruits" then
        local filtered = {}
        for _, n in ipairs(names) do
            if n:find(" Fruit$") or not seen[n .. " Fruit"] then
                filtered[#filtered + 1] = n
            end
        end
        names = filtered
    end

    table.sort(names)
    return names
end

function GameClient.TransferBankBatch(mode, rowsToTransfer, aborted, logBank)
    if not rowsToTransfer or #rowsToTransfer == 0 then return 0, "empty" end
    local okOpen, openReason = GameClient.EnsureBankOpen(aborted, logBank)
    if not okOpen then return 0, openReason end

    local sourceName = mode == "Withdraw" and "Bank" or "Unequiped"
    local ordered = {}
    for _, r in ipairs(rowsToTransfer) do ordered[#ordered + 1] = r end
    -- Envia do maior Index para o menor (padrão do BankMenu.Controls) para não deslocar os índices anteriores
    table.sort(ordered, function(a, b) return (a.Index or 0) > (b.Index or 0) end)

    local sent, expectedTotal = 0, 0
    local beforeByName = {}
    for _, row in ipairs(ordered) do
        if aborted and aborted() then break end
        if not beforeByName[row.Name] then
            beforeByName[row.Name] = GameClient.BankAmount(sourceName, row.Name)
        end
        local amt = math.max(1, math.floor(tonumber(row.Quantity) or 1))
        expectedTotal += amt
        logBank(("BANK_BATCH_%s name=%s index=%d amount=%d"):format(string.upper(mode), row.Name, row.Index, amt))
        GameModules.Network:FireServer("BankData", mode, row.Index, row.Name, amt)
        sent += 1
        if sent < #ordered then task.wait(0.08) end
    end

    local deadline = os.clock() + 4.0
    local confirmed = 0
    while os.clock() < deadline do
        if aborted and aborted() then break end
        confirmed = 0
        for name, beforeAmt in pairs(beforeByName) do
            if GameClient.BankAmount(sourceName, name) < beforeAmt then
                confirmed += 1
            end
        end
        if confirmed > 0 and os.clock() > deadline - 3.2 then break end
        task.wait(0.15)
    end
    return sent, confirmed > 0 and "ok" or "sent"
end

GameClient.InventoryAutomationBusy = false
