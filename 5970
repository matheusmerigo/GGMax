local lastGachaAttempt = 0
local function gachaRemaining()
    local data = getData()
    if data and type(data.Registry) == "table" and MainModules and MainModules.FruitsUtils and MainModules.FruitsUtils.GachaSpinTime then
        local lastSpin = data.Registry.FruitSpinDeltaTime
        if type(lastSpin) == "number" then
            return math.max(0, lastSpin + MainModules.FruitsUtils.GachaSpinTime - os.time())
        end
        return 0
    end
    if not (MainModules and MainModules.FruitsUtils and MainModules.FruitsUtils.GachaRemaining) then return nil end
    local ok, rem = pcall(MainModules.FruitsUtils.GachaRemaining, LP)
    if not (ok and type(rem) == "number") then
        ok, rem = pcall(MainModules.FruitsUtils.GachaRemaining, nil)
    end
    return ok and type(rem) == "number" and rem or nil
end

local function resetRouletteAndMenu()
    pcall(function()
        local rm = require(ReplicatedStorage.Modules.Commerce.ShopSystem["ShopSystem Client"].RouletteMenu)
        if rm then
            if rm.Close then pcall(rm.Close) end
            if rm.ForceClose then pcall(rm.ForceClose) end
        end
        local uiMod = require(ReplicatedStorage.Modules.Essentials.InterfaceSystem).IsClient
        if uiMod and uiMod.MenusHandler then
            uiMod.MenusHandler.AnotherMenu = "None"
            uiMod.MenusHandler.IsOpen = false
        end
        if GameModules and GameModules.InterfaceUtils and GameModules.InterfaceUtils.ApplyInterfaceGroup then
            GameModules.InterfaceUtils.ApplyInterfaceGroup("Default")
        end
        local ic = GameClient.GetInteractionClient()
        if ic and ic.Interaction and ic.Interaction.SetEnabled then
            ic.Interaction.SetEnabled(true)
        end
    end)
end

local function spinGachaOnce()
    if Movement.BeginInteract and not Movement.BeginInteract(function() return not CFG.AutoGacha end) then return nil end
    local ok, res = pcall(function()
        if GameModules.Network.SafeInvokeServer then
            return GameModules.Network:SafeInvokeServer(10, "FruitGacha", "Spin")
        end
        return GameModules.Network:InvokeServer("FruitGacha", "Spin")
    end)
    resetRouletteAndMenu()
    -- Segunda limpeza atrasada caso o pacote OnClientEvent("Roulette") chegue após o InvokeServer
    task.delay(1.2, resetRouletteAndMenu)
    task.wait()
    return ok and res or nil
end

local function autoGacha()
    if not (CFG.AutoGacha and GameModules and MainModules) or collecting then return end
    if os.clock() - lastGachaAttempt < 20 then return end

    local rem = gachaRemaining()
    if not rem or rem > 0 then return end

    local data = getData()
    local mon = data and data.Monetization
    local gold = mon and mon.Gold
    if type(gold) ~= "number" then return end
    local cost = nil
    if MainModules.FruitsUtils then
        if MainModules.FruitsUtils.GachaCost then
            local okC, c = pcall(MainModules.FruitsUtils.GachaCost, LP)
            if not (okC and type(c) == "number") then
                okC, c = pcall(MainModules.FruitsUtils.GachaCost, nil)
            end
            if okC and type(c) == "number" then cost = c end
        end
        if type(cost) ~= "number" and MainModules.FruitsUtils.GachaMinPrice and MainModules.FruitsUtils.GachaPricePerLevel then
            cost = math.max(MainModules.FruitsUtils.GachaMinPrice, getLevel() * MainModules.FruitsUtils.GachaPricePerLevel)
        end
        if type(cost) ~= "number" or gold < cost then
            return
        end
    end

    if collecting or State.bossBusy or State.islandBossBusy or State.seaBeastBusy or State.fortRaidBusy or State.raidInArena or GameClient.CampfireActive or (GameClient.BossRoomsFight and GameClient.BossRoomsFight.Payload ~= nil) then return end
    local char, hrp = getChar()
    if char and (char:GetAttribute("BossTether") ~= nil or char:GetAttribute("BossArenaLock") ~= nil) then return end
    local gPos = giverPos("Vox Gacha")
    if not (hrp and gPos) then return end

    if type(cost) == "number" and Movement.GetMirrorPriceForPos and (hrp.Position - gPos).Magnitude >= 3000 then
        local mirrorGo = Movement.GetMirrorPriceForPos(gPos) or 0
        local mirrorBack = Movement.GetMirrorPriceForPos(hrp.Position) or 0
        if gold < (cost + mirrorGo + mirrorBack) then
            return
        end
    end

    lastGachaAttempt = os.clock()
    collecting = true
    local snap = Features.PauseForInterrupt and Features.PauseForInterrupt() or { farm = CFG.AutoFarm }
    local res
    pcall(function()
        if (hrp.Position - gPos).Magnitude > 15 then
            Status = "Indo ao Vox Gacha..."
            if not Features.PauseForInterrupt then
                State.farmToken += 1
                attackGoal = nil
                currentTarget = nil
            end
            goNear(gPos, function() return not CFG.AutoGacha end)
        end
        res = spinGachaOnce()
        if res then
            if CFG.FruitNotify then notify("🎲 Gacha", "Ganhou: " .. tostring(res)) end
            if CFG.AutoStoreFruit then
                task.wait(4)
                Features.Fruit.Store()
            end
        end
    end)
    collecting = false
    if Features.ResumeAfterInterrupt then
        Features.ResumeAfterInterrupt(snap)
    elseif snap.farm and CFG.AutoFarm then
        Combat.FarmLoop()
    end
end

local lastCheckpoint = ""
local function autoCheckpoint()
    if not GameModules then return end
    local _, hrp = getChar()
    if not hrp then return end
    local il = workspace:FindFirstChild("IgnoreList")
    local int = il and il:FindFirstChild("Int")
    local cps = int and int:FindFirstChild("SpawnCheckpoints")
