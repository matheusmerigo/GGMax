local function currentHistoryObjective(info, prog)
    if not (info and info.SubQuests) then return nil end
    local function pickObjective(pending)
        if #pending == 0 then return nil end
        local bossEntries, otherEntries = {}, {}
        for _, o in ipairs(pending) do
            local bName = GameClient.GetWorldBossObjectiveName(o)
            if bName then
                local liveModel, beaconPos, respawnAt = GameClient.GetWorldBossLiveState(bName)
                table.insert(bossEntries, {
                    obj = o,
                    bossName = bName,
                    liveModel = liveModel,
                    beaconPos = beaconPos,
                    respawnAt = respawnAt,
                })
            else
                table.insert(otherEntries, o)
            end
        end
        if #bossEntries == 0 then
            local pos, isDoor = resolveObjectivePoint(pending[1])
            return pending[1], pos, isDoor
        end
        local _, hrp = getChar()
        local myPos = hrp and hrp.Position or nil

        -- Prioridade 1: boss pendente ja vivo e carregado por perto
        local bestLive, bestLivePos, bestLiveDist = nil, nil, math.huge
        for _, entry in ipairs(bossEntries) do
            if entry.liveModel then
                local mrp = entry.liveModel:FindFirstChild("HumanoidRootPart") or entry.liveModel.PrimaryPart
                local mPos = (mrp and mrp.Position) or entry.beaconPos
                local d = (mPos and myPos) and (mPos - myPos).Magnitude or 0
                if not bestLive or d < bestLiveDist then
                    bestLive, bestLivePos, bestLiveDist = entry, mPos, d
                end
            end
        end
        if bestLive then
            if not bestLivePos then
                local resolved = resolveObjectivePoint(bestLive.obj)
                bestLivePos = resolved
            end
            return bestLive.obj, bestLivePos, false
        end

        -- Prioridade 2: boss pendente vivo em qualquer ilha (BossBeacons)
        local bestBeacon, bestBeaconDist = nil, math.huge
        for _, entry in ipairs(bossEntries) do
            if entry.beaconPos then
                local d = myPos and (entry.beaconPos - myPos).Magnitude or 0
                if not bestBeacon or d < bestBeaconDist then
                    bestBeacon, bestBeaconDist = entry, d
                end
            end
        end
        if bestBeacon then
            return bestBeacon.obj, bestBeacon.beaconPos, false
        end

        -- Prioridade 3: se houver outro objetivo pendente que nao seja World/Wanted Boss, segue para ele
        if #otherEntries > 0 then
            local pos, isDoor = resolveObjectivePoint(otherEntries[1])
            return otherEntries[1], pos, isDoor
        end

        -- Prioridade 4: todos os bosses pendentes estao mortos; escolhe o que nasce mais cedo
        local soonest = bossEntries[1]
        for _, entry in ipairs(bossEntries) do
            if type(entry.respawnAt) == "number" then
                if type(soonest.respawnAt) ~= "number" or entry.respawnAt < soonest.respawnAt then
                    soonest = entry
                end
            end
        end
        return soonest.obj, nil, false
    end

    -- Use QuestSystem.IsClient:GetProgress() to find active objectives
    local qp = GameClient.getQuestClientProgress()
    if qp then
        for _, sq in ipairs(info.SubQuests) do
            if sq.Objectives then
                local pending = {}
                for _, obj in ipairs(sq.Objectives) do
                    local ok, res = pcall(MainModules.QuestsUtils.IsObjectiveActive, qp, obj.ObjectiveID)
                    if ok and res == true then
                        table.insert(pending, obj)
                    end
                end
                if #pending > 0 then
                    return pickObjective(pending)
                end
            end
        end
    end
    -- Fallback: use GetCurrentSubQuestIndex with raw quest progress
    if prog and MainModules and MainModules.QuestsUtils and MainModules.QuestsUtils.GetCurrentSubQuestIndex then
        local ok, sqIdx = pcall(MainModules.QuestsUtils.GetCurrentSubQuestIndex, prog, info)
        local sq = ok and sqIdx and info.SubQuests[sqIdx]
        if sq and sq.Objectives then
            local sqProg = prog[sqIdx]
            local pending = {}
            for objIdx, obj in ipairs(sq.Objectives) do
                local val = type(sqProg) == "table" and (sqProg[objIdx] or 0) or 0
                if type(val) ~= "number" or val < (obj.Goal or 1) then
                    table.insert(pending, obj)
                end
            end
            if #pending > 0 then
                return pickObjective(pending)
            end
        end
    end
    -- Last fallback: incomplete objectives in SubQuests (using pairs/ipairs safely)
    for sqIdx, sq in ipairs(info.SubQuests) do
        if sq.Objectives then
            local sqProg = type(prog) == "table" and (prog[sqIdx] or prog[tostring(sqIdx)]) or nil
            local pending = {}
            for objIdx, obj in ipairs(sq.Objectives) do
                local val = type(sqProg) == "table" and (sqProg[objIdx] or sqProg[tostring(objIdx)] or 0) or 0
                if type(val) ~= "number" or val < (obj.Goal or 1) then
                    table.insert(pending, obj)
                end
            end
            if #pending > 0 then
                return pickObjective(pending)
            end
        end
    end
    return nil
end

function GameClient.ObjectiveProgressMarker(qName, oid)
    if oid == "Ask_KrakenLocals_KR" then
        local _, _, asked = GameClient.GetNextKrakenResident()
        return "asked:" .. tostring(asked)
    end
    local qp = GameClient.getQuestClientProgress()
    local remaining = qp and type(qp.ObjectiveIds) == "table" and qp.ObjectiveIds[oid]
    if remaining ~= nil then
        return "remaining:" .. tostring(remaining)
    end
    local active = GameClient.GetActiveQuests()
    return (active and active[qName] ~= nil) and "quest:active" or "quest:inactive"
end

function GameClient.DebugQuestSnapshot(fileName, mode)
    pcall(function()
        local data = getData()
        local _, hrp, hum = getChar()
        local abilities = data and data.Abilitys or {}
        local gold = data and data.Monetization and data.Monetization.Gold
        debugLog(fileName, ("SNAPSHOT mode=%s level=%s gold=%s hp=%s pos=%s location=%s sense=%s armor=%s"):format(
            tostring(mode), tostring(getLevel()), tostring(gold), tostring(hum and hum.Health),
            tostring(hrp and hrp.Position), tostring(LP:GetAttribute("CurrentLocation")),
            tostring(abilities.Kenbushoku), tostring(abilities.Busoshoku)
        ))

        local activeNames = {}
        for questName in pairs(GameClient.GetActiveQuests(data) or {}) do
            table.insert(activeNames, tostring(questName))
        end
        table.sort(activeNames)
        debugLog(fileName, "ACTIVE_QUESTS count=" .. tostring(#activeNames) .. " names=[" .. table.concat(activeNames, " | ") .. "]")

        local progress = GameClient.getQuestClientProgress()
        local objectiveRows = {}
        if progress and type(progress.ObjectiveIds) == "table" then
            for objectiveId, remaining in pairs(progress.ObjectiveIds) do
                table.insert(objectiveRows, tostring(objectiveId) .. "=" .. tostring(remaining))
            end
        end
        table.sort(objectiveRows)
        debugLog(fileName, "ACTIVE_OBJECTIVES count=" .. tostring(#objectiveRows) .. " values=[" .. table.concat(objectiveRows, " | ") .. "]")

        if mode == "Secondary" then
            local completed, available = 0, 0
            for _, questName in ipairs(GameClient.SECONDARY_QUEST_ORDER) do
                local result
                pcall(function() result = MainModules.QuestsUtils.QuestIsCompleted(LP, questName) end)
                if result == true or (type(result) == "number" and result > 0) then completed += 1 end
                local info = getQuestInfo(questName)
                if info and getLevel() >= (info.MinLevel or 0) then available += 1 end
            end
            debugLog(fileName, ("SECONDARY_QUEST_SUMMARY configured=%d completed=%d levelEligible=%d"):format(
                #GameClient.SECONDARY_QUEST_ORDER, completed, available
            ))
        end
    end)
end

function GameClient.ResolveQuestIslandName(qName, qInfo, questIslands)
    if questIslands and qName and questIslands[qName] then
        local resolved = GameClient.ResolveAreaName(questIslands[qName])
        if resolved then return resolved end
    end
    if qInfo and type(qInfo.SubTitle) == "string" then
        local resolved = GameClient.ResolveAreaName(qInfo.SubTitle)
        if resolved then return resolved end
    end
    if type(qName) == "string" then
        local resolved = GameClient.ResolveAreaName(qName)
        if resolved then return resolved end
    end
    return nil
end

local function storyLoop(mode)
    local isVox = (mode == "VoxTraining")
    local isSec = (mode == "Secondary" or isVox)
    local label = isVox and "Treino Vox" or (isSec and "Secundárias" or "História")
    local questGivers = isVox and GameClient.VoxQuestGivers or GameClient.SECONDARY_QUEST_GIVERS
    local questIslands = isVox and GameClient.VoxQuestIslands or GameClient.SECONDARY_QUEST_ISLANDS
    State.storyToken += 1
    local my = State.storyToken
    task.spawn(function()
        local function aborted()
            return (isVox and not CFG.AutoVoxTraining or isSec and not isVox and not CFG.AutoSecondary or not isSec and not CFG.AutoHistory) or State.storyToken ~= my
        end
        local lastStuckOid, stuckCount = nil, 0
        local lastBossWaitLogT, lastBossWaitMsg = 0, ""
        local objectiveRetryState = {}
        local MAX_INTERACTION_RETRIES = 6
        local skippedSec, acceptTries, noObjCount = {}, {}, 0
        local storyLogFile = isVox and (CFG.VoxTrainingType == "Armor" and "vox_armor_debug.txt" or "vox_sense_debug.txt")
            or (isSec and "secondary_quests_debug.txt" or "history_debug.txt")
        local function logSec(msg)
            debugLog(storyLogFile, msg)
        end
        local function exitInteriorIfInside()
            local _, hChk = getChar()
            if not (hChk and hChk.Position.Y < -200) then return end
            local ignP = workspace:FindFirstChild("IgnoreList")
            local privP = ignP and ignP:FindFirstChild("Int") and ignP.Int:FindFirstChild("PrivateAreas")
            local bestDoor, bestD = nil, 450
            local bestName = "Interior"
            if privP then
                for _, islF in ipairs(privP:GetChildren()) do
                    for _, placeF in ipairs(islF:GetChildren()) do
                        if placeF.Name ~= "SkyLift" then
                            local lve = placeF:FindFirstChild("Leave")
                            local lp = lve and extractVec3(lve:FindFirstChild("Entrance"))
                            if lp then
                                local d = (lp - hChk.Position).Magnitude
                                if d < bestD then
                                    bestD, bestDoor, bestName = d, lp, placeF.Name
                                end
                            end
                        end
                    end
                end
            end
            local zLeaveName = nil
            if not bestDoor then
                local intObj = getInteriorContainer(hChk.Position)
                if intObj then
                    local zd, zn = findPrivateAreaDoor(intObj, true)
                    if zd then
                        bestDoor, zLeaveName, bestName = zd, zn, intObj.Name or "Interior"
                    end
                end
            end
            if not bestDoor then
                local kh = GameClient.findQuestZonePos("Leave_KeeperHouse_FS")
                if kh and (kh - hChk.Position).Magnitude < 450 then
                    bestDoor, zLeaveName, bestName = kh, "Leave_KeeperHouse_FS", "KeeperHouse"
                end
            end
            if bestDoor then
                Status = ("%s: saindo (%s)..."):format(label, bestName)
                tweenTo(CFrame.new(bestDoor + Vector3.new(0, 1.5, 0)), aborted)
                if not aborted() then
                    -- Regra universal de Entrance: espera 3s ao chegar antes de sair
                    local twPre = os.clock() + 3.0
                    while os.clock() < twPre and not aborted() do task.wait(0.15) end
                end
                if not aborted() then
                    local beforeP = hChk.Position
                    if zLeaveName then
                        local icP = GameClient.getInteractionClient()
                        if icP and icP.Interaction and icP.Interaction.Contexts and not icP.Interaction.Contexts[zLeaveName] then
                            local tCtxP = os.clock() + 1.0
                            while os.clock() < tCtxP and not aborted() do
                                if icP.Interaction.Contexts[zLeaveName] then break end
                                task.wait(0.1)
                            end
                        end
                        local ctxP = icP and icP.Interaction and icP.Interaction.Contexts and icP.Interaction.Contexts[zLeaveName]
                        local hpP = ctxP and ctxP.HighlightParent
                        if hpP and (zLeaveName == "Leave_PrisonLift_PI" or tostring(hpP.Name):find("Alavanca") or tostring(hpP.Name):find("Lever")) then
                            local lpP = extractVec3(hpP)
                            local _, hhP = getChar()
                            if lpP and hhP and (hhP.Position - lpP).Magnitude > 4 and (hhP.Position - lpP).Magnitude < 45 then
                                tweenTo(CFrame.new(lpP + Vector3.new(0, 1.5, 0)), aborted)
                                task.wait(0.25)
                            end
                        end
                        GameClient.fireInteractionContext(zLeaveName)
                        GameClient.pressInteract(0.35, zLeaveName)
                        if zLeaveName == "Leave_PrisonLift_PI" then
                            task.wait(1.6)
                        else
                            task.wait(0.8)
                        end
                        pcall(function() GameModules.Network:FireServer("QuestZones", zLeaveName, "Use") end)
                    else
                        pcall(function()
                            local icP = GameClient.getInteractionClient()
                            if icP and icP.PrivateAreas and icP.PrivateAreas.Current then
                                GameModules.Network:FireServer("PrivateAreas", "EnterArea", icP.PrivateAreas.Current)
                            end
                        end)
                        GameClient.pressInteract(0.35, "Enter Area")
                    end
                    local tP = os.clock() + 3.0
                    while not aborted() and os.clock() < tP do
                        local _, h2 = getChar()
                        if h2 and (h2.Position - beforeP).Magnitude >= 50 then
                            Movement.WaitPostTeleport(Movement.POST_TELEPORT_WAIT, aborted)
                            break
                        end
                        task.wait(0.15)
                    end
                end
            end
        end
        debugLog(storyLogFile, ("=== LOOP START mode=%s voxType=%s level=%s ==="):format(
            tostring(mode), tostring(CFG.VoxTrainingType), tostring(getLevel())
        ), true)
        GameClient.DebugQuestSnapshot(storyLogFile, mode)
        -- Auto-solver dos minigames (DodgeMinigameGui [Normal/Blind/Spar] + StoneBreakGui)
        GameClient.startMinigameSolver(aborted)
        SafeRuntime.RunResilientLoop("StoryLoop:" .. tostring(mode), function() return not aborted() end, function()
        while not aborted() do
            local char, hrp, hum = getChar()
            local pgNow = LP:FindFirstChild("PlayerGui")
            if pgNow and (pgNow:FindFirstChild("DodgeMinigameGui") or pgNow:FindFirstChild("StoneBreakGui")) then
                attackGoal = nil
                currentTarget = nil
                cancelTween()
                Status = label .. ": completando treino..."
                task.wait(0.25)
            elseif Combat.IsInCutscene() then
                attackGoal = nil
                currentTarget = nil
                cancelTween()
                Status = label .. ": aguardando cutscene..."
                if GameClient.isConverseUIOpen() then
                    GameClient.advanceConverseUI()
                end
                task.wait(0.35)
            elseif not char or not hrp or not hum then
                Status = label .. ": aguardando personagem..."
                task.wait(1)
            else
                local qName, info, prog
                if isVox then
                    qName, info, prog = GameClient.ActiveVoxQuest(skippedSec)
                elseif isSec then
                    qName, info, prog = activeSecondaryQuest(skippedSec)
                else
                    qName, info, prog = activeHistoryQuest()
                end
                if not qName then
                    -- No active quest: try to accept the next one
                    local nextName, nextInfo
                    if isVox then
                        nextName, nextInfo = GameClient.NextAvailableVoxQuest(skippedSec)
                    elseif isSec then
                        nextName, nextInfo = nextAvailableSecondaryQuest(skippedSec)
                    else
                        nextName, nextInfo = nextAvailableHistoryQuest()
                    end
                    if not nextName then
                        logSec(("NO_AVAILABLE mode=%s level=%s voxType=%s"):format(tostring(mode), tostring(getLevel()), tostring(CFG.VoxTrainingType)))
                        exitInteriorIfInside()
                        Status = label .. ": nenhuma missão disponível"
                        if isVox then
                            notify("Treino Vox", "Nenhum treino de Vox disponível para seu nível, saldo ou estágio atual.")
                            CFG.AutoVoxTraining = false
                        elseif isSec then
                            notify("📜 Missões Secundárias", "Nenhuma missão secundária pendente ou disponível para seu nível.")
                            CFG.AutoSecondary = false
                            if CFG.MainMode == "Secondary" then CFG.MainModeActive = false end
                        else
                            notify("📖 Modo História", "Nenhuma missão de história pendente ou disponível para seu nível.")
                            CFG.AutoHistory = false
                            if CFG.MainMode == "History" then CFG.MainModeActive = false end
                        end
                        break
                    end

                    Status = ("%s: aceitando %s..."):format(label, nextName)
                    logSec(("ACCEPT_TRY quest=%s minLevel=%s island=%s"):format(
                        tostring(nextName), tostring(nextInfo and nextInfo.MinLevel), tostring(nextInfo and nextInfo.SubTitle)
                    ))

                    -- Os treinos Vox de Askard não são aceitos como quests comuns.
                    -- Mastery precisa escolher explicitamente a habilidade e pagar o estágio.
                    local usedVoxOffer = false
                    if isVox then
                        local askardPos = giverPos("Askard")
                        if askardPos then
                            goNear(askardPos, aborted)
                            task.wait(0.25)
                        end
                        if nextName == "Vox Armor Mastery" then
                            usedVoxOffer = true
                            logSec("VOX_OFFER action=AcceptMastery ability=Busoshoku")
                            pcall(function()
                                GameModules.Network:FireServer("Elysium_Converse", "Askard", "AcceptMastery", "Busoshoku")
                            end)
                        elseif nextName == "Vox Sense Mastery" then
                            usedVoxOffer = true
                            logSec("VOX_OFFER action=AcceptMastery ability=Kenbushoku")
                            pcall(function()
                                GameModules.Network:FireServer("Elysium_Converse", "Askard", "AcceptMastery", "Kenbushoku")
                            end)
                        elseif nextName == "Vox Armor Training" then
                            usedVoxOffer = true
                            logSec("VOX_OFFER action=AcceptArmor")
                            pcall(function()
                                GameModules.Network:FireServer("Elysium_Converse", "Askard", "AcceptArmor")
                            end)
                        elseif nextName == "Vox Sense Training" then
                            usedVoxOffer = true
                            logSec("VOX_OFFER action=AcceptSense")
                            pcall(function()
                                GameModules.Network:FireServer("Elysium_Converse", "Askard", "AcceptSense")
                            end)
                        end
                    end
                    if not usedVoxOffer then
                        pcall(function() GameModules.Network:FireServer("Quests", "Accept", nextName) end)
                    end
                    task.wait(0.8)

                    -- If quest not accepted yet, try talking to NPC quest giver
                    local checkProg
                    if isVox then
                        _, _, checkProg = GameClient.ActiveVoxQuest()
                    elseif isSec then
                        _, _, checkProg = activeSecondaryQuest()
                    else
                        _, _, checkProg = activeHistoryQuest()
                    end
                    if usedVoxOffer and not checkProg then
                        -- Não abra o resolvedor genérico: na tela de Mastery ele
                        -- escolheria a primeira opção (Sense) em vez de Armor.
                        logSec("VOX_OFFER pending=true; retrying_explicit_offer=true")
                        task.wait(0.8)
                        checkProg = true
                    end
                    if not checkProg then
                        local npcPos = nil
                        local firstNpc = nil
                        if isSec and nextName == "The Witch's Potion" then
                            npcPos = giverPos("Witch") or Vector3.new(6114.5, -571.6, -4641.4)
                        elseif isSec and questGivers[nextName] then
                            npcPos = giverPos(questGivers[nextName])
                        end
                        if not npcPos and nextInfo and nextInfo.SubQuests and nextInfo.SubQuests[1] then
                            for _, obj in ipairs(nextInfo.SubQuests[1].Objectives) do
                                if obj.ObjectiveID:sub(1, 5) == "Talk_" then
                                    firstNpc = obj
                                    break
                                end
                            end
                            firstNpc = firstNpc or nextInfo.SubQuests[1].Objectives[1]
                            if firstNpc then
                                npcPos = resolveObjectivePoint(firstNpc)
                            end
                        end

                        if not npcPos and isSec and questIslands[nextName] then
                            exitInteriorIfInside()
                            local islName = GameClient.ResolveQuestIslandName(nextName, nextInfo, questIslands) or questIslands[nextName]
                            local areasF = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Areas")
                            local area = areasF and areasF:FindFirstChild(islName)
                            local center = area and area:GetAttribute("MapCenter")
                            if typeof(center) == "Vector3" then
                                local alt = area:GetAttribute("MapAltitude") or 14
                                local destPos = center + Vector3.new(0, alt + 12, 0)
                                local rpIsl = RaycastParams.new()
                                rpIsl.FilterType = Enum.RaycastFilterType.Exclude
                                rpIsl.FilterDescendantsInstances = LP.Character and { LP.Character } or {}
                                local hitIsl = workspace:Raycast(Vector3.new(center.X, alt + 450, center.Z), Vector3.new(0, -600, 0), rpIsl)
                                if hitIsl and hitIsl.Position.Y > alt - 20 then
                                    destPos = hitIsl.Position + Vector3.new(0, 6, 0)
                                end
                                Status = ("%s: indo para %s (%s)..."):format(label, islName, nextName)
                                local _, hIsl = getChar()
                                if hIsl and (hIsl.Position - destPos).Magnitude >= 3000 then
                                    Movement.TryMirrorKeeperTravel(destPos, islName, aborted)
                                else
                                    pcall(function() LP:RequestStreamAroundAsync(destPos) end)
                                    tweenTo(CFrame.new(destPos), aborted)
                                end
                                task.wait(0.5)
                                if questGivers[nextName] then
                                    npcPos = giverPos(questGivers[nextName])
                                end
                                if not npcPos and firstNpc then
                                    npcPos = resolveObjectivePoint(firstNpc)
                                end
                                if not npcPos and nextName == "Frozen Catch" then
                                    npcPos = GameClient.findQuestZonePos("Break_FrozenFish_SQ_1") or Vector3.new(-18120.7, 97.4, -728.5)
                                elseif not npcPos and nextName == "The Witch's Potion" then
                                    npcPos = Vector3.new(6114.5, -571.6, -4641.4)
                                elseif not npcPos and nextName == "The Hidden Clock" then
                                    npcPos = GameClient.findQuestZonePos("Pull_ClockLever_SQ") or Vector3.new(6724.4, 3612.6, 9953.6)
                                elseif not npcPos and nextName == "The Broken Mill" then
                                    npcPos = GameClient.findQuestZonePos("Collect_MillGear_SQ_1") or Vector3.new(6955.7, 1516.5, 8737.1)
                                elseif not npcPos and nextName == "The Lost Key" then
                                    npcPos = GameClient.findQuestZonePos("Collect_LostKey_SQ") or Vector3.new(10720.1, 164.6, 847.1)
                                end
                            end
                        end

                        if npcPos then
                            if npcPos.Y > -200 then
                                exitInteriorIfInside()
                            end
                            local _, hNpc = getChar()
                            logSec(("next=%s npcPos=(%.1f,%.1f,%.1f) myPos=%s"):format(
                                tostring(nextName), npcPos.X, npcPos.Y, npcPos.Z,
                                hNpc and string.format("(%.1f,%.1f,%.1f)", hNpc.Position.X, hNpc.Position.Y, hNpc.Position.Z) or "nil"
                            ))
                            if hNpc and (hNpc.Position - npcPos).Magnitude >= 3000 then
                                local mkOk = Movement.TryMirrorKeeperTravel(npcPos, GameClient.ResolveQuestIslandName(nextName, nextInfo, questIslands), aborted)
                                logSec(("afterMK ok=%s"):format(tostring(mkOk)))
                            end
                            -- Se o NPC está em um interior (Y < -200) e estamos fora (ou vice-versa), usa o portal Enter/Leave de PrivateAreas
                            local _, hPort = getChar()
                            logSec(("prePortal hPort=%s"):format(hPort and string.format("(%.1f,%.1f,%.1f)", hPort.Position.X, hPort.Position.Y, hPort.Position.Z) or "nil"))
                            if hPort and ((hPort.Position.Y > -200 and npcPos.Y < -200) or (hPort.Position.Y < -200 and npcPos.Y > -200)) then
                                local wantEnter = (npcPos.Y < -200)
                                local ignP = workspace:FindFirstChild("IgnoreList")
                                local privP = ignP and ignP:FindFirstChild("Int") and ignP.Int:FindFirstChild("PrivateAreas")
                                local bestPortal, bestDist = nil, 450
                                if privP then
                                    for _, islF in ipairs(privP:GetChildren()) do
                                        for _, placeF in ipairs(islF:GetChildren()) do
                                            if placeF.Name ~= "SkyLift" then
                                                local ent = placeF:FindFirstChild("Enter")
                                                local lve = placeF:FindFirstChild("Leave")
                                                local portalFolder = wantEnter and ent or lve
                                                local portalPos = portalFolder and extractVec3(portalFolder:FindFirstChild("Entrance"))
                                                local refPos = wantEnter and (extractVec3(ent and ent:FindFirstChild("Destination")) or extractVec3(lve and lve:FindFirstChild("Entrance"))) or portalPos
                                                local cmpPos = wantEnter and npcPos or hPort.Position
                                                if portalPos and refPos then
                                                    local d = (refPos - cmpPos).Magnitude
                                                    if d < bestDist then
                                                        bestDist, bestPortal = d, placeF
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                                local doorPos = bestPortal and (function()
                                    local pf = wantEnter and bestPortal:FindFirstChild("Enter") or bestPortal:FindFirstChild("Leave")
                                    return pf and extractVec3(pf:FindFirstChild("Entrance"))
                                end)()
                                local zDoorName = nil
                                if not doorPos then
                                    local intObj = getInteriorContainer(wantEnter and npcPos or hPort.Position)
                                    if intObj then
                                        doorPos, zDoorName = findPrivateAreaDoor(intObj, not wantEnter)
                                    end
                                end
                                if not doorPos and wantEnter and nextName == "The Witch's Potion" then
                                    doorPos = Vector3.new(6282.3, 132.3, -5187.3)
                                end
                                logSec(("portal best=%s doorPos=%s"):format(tostring(bestPortal and bestPortal.Name or zDoorName), tostring(doorPos)))
                                if doorPos then
                                    Status = ("%s: %s (%s)..."):format(label, wantEnter and "entrando" or "saindo", (bestPortal and bestPortal.Name) or zDoorName or nextName)
                                    tweenTo(CFrame.new(doorPos + Vector3.new(0, 1.5, 0)), aborted)
                                    if not aborted() then
                                        -- Regra universal de Entrance: espera 3s ao chegar antes de entrar/sair
                                        local twPre = os.clock() + 3.0
                                        while os.clock() < twPre and not aborted() do task.wait(0.15) end
                                    end
                                    if not aborted() then
                                        local beforeP = hPort.Position
                                        if zDoorName then
                                            local icP = GameClient.getInteractionClient()
                                            if icP and icP.Interaction and icP.Interaction.Contexts and not icP.Interaction.Contexts[zDoorName] then
                                                local tCtxP = os.clock() + 1.0
                                                while os.clock() < tCtxP and not aborted() do
                                                    if icP.Interaction.Contexts[zDoorName] then break end
                                                    task.wait(0.1)
                                                end
                                            end
                                            local ctxP = icP and icP.Interaction and icP.Interaction.Contexts and icP.Interaction.Contexts[zDoorName]
                                            local hpP = ctxP and ctxP.HighlightParent
                                            if hpP and (zDoorName == "Enter_IronLotus_SL" or zDoorName == "Enter_PrisonLift_PI" or zDoorName == "Leave_PrisonLift_PI" or tostring(hpP.Name):find("Alavanca") or tostring(hpP.Name):find("Lever")) then
                                                local lpP = extractVec3(hpP)
                                                local _, hhP = getChar()
                                                if lpP and hhP and (hhP.Position - lpP).Magnitude > 4 and (hhP.Position - lpP).Magnitude < 45 then
                                                    tweenTo(CFrame.new(lpP + Vector3.new(0, 1.5, 0)), aborted)
                                                    task.wait(0.25)
                                                end
                                            end
                                            GameClient.fireInteractionContext(zDoorName)
                                            GameClient.pressInteract(0.35, zDoorName)
