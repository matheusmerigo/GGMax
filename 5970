local function isHistoryQuest(qName, qInfo)
    if not qInfo then return false end
    if qInfo.HistoryQuest == true then return true end
    if MainModules and MainModules.QuestsUtils and MainModules.QuestsUtils.MainQuests then
        return table.find(MainModules.QuestsUtils.MainQuests, qName) ~= nil
    end
    return false
end

local function activeHistoryQuest()
    local data = getData()
    local actives = GameClient.GetActiveQuests(data)
    if not (actives and MainModules and MainModules.QuestsInfo) then return nil end
    -- Skull Island 1 usa estas quests auxiliares para concluir Learn_VoxSense_HK/Learn_VoxArmor_HK.
    -- Elas continuam fora da categoria Secundárias na interface, mas são resolvidas como dependências da história.
    if actives["Skull Island 1"] then
        for _, trainingQuest in ipairs({ "Vox Sense Training", "Vox Armor Training" }) do
            if actives[trainingQuest] and MainModules.QuestsInfo[trainingQuest] then
                return trainingQuest, MainModules.QuestsInfo[trainingQuest], actives[trainingQuest]
            end
        end
    end
    for qName, prog in pairs(actives) do
        local info = MainModules.QuestsInfo[qName]
        if isHistoryQuest(qName, info) then
            return qName, info, prog
        end
    end
    return nil
end

local function nextAvailableHistoryQuest()
    if not (MainModules and MainModules.QuestsInfo and MainModules.QuestsUtils) then return nil end
    if MainModules.QuestsUtils.GetCurrentMainQuest then
        local ok, qName = pcall(MainModules.QuestsUtils.GetCurrentMainQuest, LP)
        if ok and qName and MainModules.QuestsInfo[qName] then
            local can = true
            pcall(function() can = MainModules.QuestsUtils.CanTake(LP, qName) ~= false end)
            if can then return qName, MainModules.QuestsInfo[qName] end
        end
    end
    local order = MainModules.QuestsUtils.MainQuests or {}
    for _, qName in ipairs(order) do
        local info = MainModules.QuestsInfo[qName]
        if info and isHistoryQuest(qName, info) then
            local done = false
            pcall(function()
                local r = MainModules.QuestsUtils.QuestIsCompleted(LP, qName)
                done = (r == true) or (type(r) == "number" and r > 0)
            end)
            local can = true
            pcall(function() can = MainModules.QuestsUtils.CanTake(LP, qName) ~= false end)
            if not done and can then
                return qName, info
            end
        end
    end
    return nil
end

