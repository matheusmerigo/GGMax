local function pruneOldestTickEntries(cache, maxEntries)
    if type(cache) ~= "table" then
        return
    end

    maxEntries = tonumber(maxEntries) or 0
    if maxEntries <= 0 then
        return
    end

    local count = 0
    for _ in pairs(cache) do
        count = count + 1
    end

    if count <= maxEntries then
        return
    end

    local entries = {}
    for key, tickValue in pairs(cache) do
        entries[#entries + 1] = {
            Key = key,
            Tick = tonumber(tickValue) or 0,
        }
    end

    table.sort(entries, function(a, b)
        return a.Tick < b.Tick
    end)

    local removeCount = count - maxEntries
    for index = 1, removeCount do
        local entry = entries[index]
        if entry then
            cache[entry.Key] = nil
        end
    end
end

