GenericInfra.Async.WarnThrottled = function(scopeName, err)
    local entries = AsyncInfra.LastErrorTick
    local key = tostring(scopeName or "async")
    local now = Now()
    local lastTick = entries[key] or 0
    if (now - lastTick) < AsyncInfra.ErrorCooldown then
        return
    end
    entries[key] = now
    if (now - (AsyncInfra.LastErrorPruneAt or 0)) >= 60 then
        AsyncInfra.LastErrorPruneAt = now
        local cutoff = now - 300
        for scope, tickValue in pairs(entries) do
            if type(tickValue) ~= "number" or tickValue < cutoff then
                entries[scope] = nil
            end
        end
    end
    pruneOldestTickEntries(entries, 256)
    warn("[Midgard] Async callback error [" .. key .. "]: " .. tostring(err))
end
