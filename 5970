function Features.InitWatchdogs()
    State.Tokens.Watchdogs += 1
    local myTok = State.Tokens.Watchdogs
    local sunkAt, clientStuckAt, discoveryAt = nil, nil, nil
    local presentSeenAt, presentClaimAt, presentLastClickAt = nil, nil, nil
    local respawningSince = nil
    local function anyAutoActive()
        return CFG.AutoFarm or CFG.AutoMob or CFG.AutoBoss or CFG.AutoBoardBoss or CFG.AutoIslandBoss or CFG.AutoRaid
            or CFG.AutoFortRaid or CFG.AutoSeaBeast or CFG.AutoHistory or CFG.AutoSecondary
            or CFG.AutoVoxTraining or CFG.AutoCollectibles or CFG.AutoFish
            or CFG.AutoVoxArmor or CFG.AutoVoxSense
            or CFG.AutoCraftRaidKey or CFG.AutoBlacksmith or CFG.AutoMobDrops or CFG.AutoGacha or CFG.AutoSecretAchievements
            or CFG.AutoDungeon or CFG.AutoForgeUpgrade or CFG.AutoBlackMarket or CFG.AutoFruitHop or CFG.AutoUniversalHop
    end
    local function getPresentFrame()
        if MainModules and MainModules.InterfaceUtils and MainModules.InterfaceUtils.UIComponents then
            local ok, ui = pcall(MainModules.InterfaceUtils.UIComponents)
            local ig = ok and type(ui) == "table" and ui.IgnoreGuiInsetUIS
            local pf = ig and ig:FindFirstChild("PresentFrame")
            if pf then return pf end
        end
        local pg = LP:FindFirstChild("PlayerGui")
        return pg and pg:FindFirstChild("PresentFrame", true) or nil
    end
    local function clickPresentSafe()
        if not VirtualInputManager then return end
        local cam = workspace.CurrentCamera
        local vs = cam and cam.ViewportSize
        local cx = (vs and vs.X > 12) and math.floor(vs.X - 6) or 4
        local cy = (vs and vs.Y > 12) and math.floor(vs.Y - 6) or 4
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
        end)
    end
    task.spawn(function()
        while State.Tokens.Watchdogs == myTok do
            task.wait(0.35)
            if State.Tokens.Watchdogs ~= myTok then break end
            pcall(function()
                local c, hrp, hum = getChar()
                if c and hrp and hum and not hrp.Anchored then
                    local st = hum:GetState()
                    if st == Enum.HumanoidStateType.GettingUp or st == Enum.HumanoidStateType.FallingDown then
                        sunkAt = sunkAt or os.clock()
                        if os.clock() - sunkAt > 1.5 then
                            sunkAt = nil
                            Movement.unsinkRay.FilterDescendantsInstances = { c }
                            local floor = workspace:Raycast(hrp.Position + Vector3.new(0, 4, 0), Vector3.new(0, -12, 0), Movement.unsinkRay)
                            local standY = floor and (floor.Position.Y + hum.HipHeight + hrp.Size.Y * 0.5)
                            if standY and hrp.Position.Y < standY - 0.5 then
                                hrp.CFrame = hrp.CFrame + Vector3.new(0, (standY + 0.2) - hrp.Position.Y, 0)
                                hrp.AssemblyLinearVelocity = Vector3.zero
                            end
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                        end
                    else
                        sunkAt = nil
                    end
                else
                    sunkAt = nil
                end

                local stPlayer = GameModules and GameModules.States and GameModules.States.Player and GameModules.States.Player()
                local clientLocked = stPlayer and stPlayer.IsActive and stPlayer:IsActive("Client")
                if clientLocked and os.clock() >= Combat.skillCastingUntil then
                    clientStuckAt = clientStuckAt or os.clock()
                    if os.clock() - clientStuckAt > 3 then
                        clientStuckAt = nil
                        if stPlayer.Set then pcall(stPlayer.Set, stPlayer, { "Client" }, false) end
                        pcall(function()
                            local sc = require(ReplicatedStorage.Modules.Combat.AbilitySystem["AbilitySystem Client"]["SkillsSystem Client"])
                            if sc and sc.CurrentSkill ~= nil and sc.Unequiped then
                                sc.Unequiped()
                            end
                        end)
                    end
                else
                    clientStuckAt = nil
                end

                if VirtualInputManager and anyAutoActive() then
                    local pg = LP:FindFirstChild("PlayerGui")
                    local sg = pg and pg:FindFirstChild("ScreenGuis")
                    local mui = sg and sg:FindFirstChild("MainUI")
                    local hud = mui and mui:FindFirstChild("PowerDiscoveryHUD")
                    if hud and hud.Visible then
                        discoveryAt = discoveryAt or os.clock()
                        if os.clock() - discoveryAt >= 1.5 then
                            discoveryAt = nil
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                            task.wait(0.05)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                        end
                    else
                        discoveryAt = nil
                    end
                    local presentFrame = getPresentFrame()
                    if presentFrame and presentFrame.Visible then
                        local now = os.clock()
                        local claim = presentFrame:FindFirstChild("Claim")
                        local claimVis = (claim and claim.Visible == true) or false
                        if not claimVis then
                            presentClaimAt = nil
                            presentSeenAt = presentSeenAt or now
                            if now - presentSeenAt >= 0.35 and (not presentLastClickAt or now - presentLastClickAt >= 0.60) then
                                presentLastClickAt = now
                                clickPresentSafe()
                            end
                        else
                            presentClaimAt = presentClaimAt or now
                            if now - presentClaimAt >= 1.45 and (not presentLastClickAt or now - presentLastClickAt >= 0.75) then
                                presentLastClickAt = now
                                clickPresentSafe()
                            end
                        end
                    else
                        presentSeenAt, presentClaimAt, presentLastClickAt = nil, nil, nil
                    end
                    if pg then
                        local sg2 = pg:FindFirstChild("ScreenGuis")
                        local srUi = sg2 and sg2:FindFirstChild("SeasonRewardsUI")
                        if srUi and srUi.Enabled then
                            pcall(function()
                                local srMenu = require(ReplicatedStorage.Modules.Essentials.SeasonSystem["SeasonSystem Client"].SeasonRewardsMenu)
                                if srMenu and srMenu.Opened and srMenu.RequestClose then
                                    srMenu.RequestClose()
                                end
                            end)
                        end
                    end
                else
                    discoveryAt = nil
                    presentSeenAt, presentClaimAt, presentLastClickAt = nil, nil, nil
                end
                if State.isRespawning then
                    respawningSince = respawningSince or os.clock()
                    if (os.clock() - respawningSince) > 10 and os.clock() >= (State.respawnReadyAt or 0) and getChar() ~= nil then
                        State.isRespawning = false
                        respawningSince = nil
                        SafeRuntime.ReportError("Watchdog", "Cleared stuck State.isRespawning")
                    end
                else
                    respawningSince = nil
                end
            end)
        end
    end)
end

function Features.InitKeyCraft()
    local initDone = false
    local keyCatalog, dropSources = {}, {}
    local TOOL_TYPE_FILTER = { Sword = "Swords", Gun = "Guns" }
    local SUB_TYPE_FILTER = {
        Material = "Materials",
        Hat = "Hats",
        Amulet = "Necklaces",
        Cape = "Capes",
        Ring = "Rings",
        Belt = "Belts",
        Boots = "Boots",
    }

    local function getBlacksmithFilter(info)
        if type(info) ~= "table" then return "Others" end
        return TOOL_TYPE_FILTER[info.ToolType]
            or (type(info.SubType) == "string" and SUB_TYPE_FILTER[info.SubType])
            or "Others"
    end

    local function getSpentMaterials(info)
        if type(info) ~= "table" or info.Unavailable == true or type(info.Recipe) ~= "table" then
            return nil
        end
        local rawMats = type(info.Recipe.Materials) == "table" and info.Recipe.Materials or nil
        if not rawMats then
            local hasDirect = false
            for _, v in pairs(info.Recipe) do
                if type(v) == "number" then hasDirect = true; break end
            end
            rawMats = hasDirect and info.Recipe or nil
        end
        if not rawMats or (next(rawMats) == nil and (info.Recipe.Gold or 0) <= 0) then
            return nil
        end
        local fu = MainModules and MainModules.ForgeUtils
        if fu and fu.GetSpentMaterials then
            local ok, spent = pcall(fu.GetSpentMaterials, rawMats)
            if ok and type(spent) == "table" then return spent end
        end
        local infos = MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo.Infos
        local out = {}
        for matName, needQty in pairs(rawMats) do
            local mInfo = type(infos) == "table" and infos[matName]
            if not (type(mInfo) == "table" and mInfo.SubType == "Recipe") then
                out[matName] = needQty
            end
        end
        return out
    end

    local function ensureKeyCatalog()
        if initDone then return end
        if not (MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo.Infos and MainModules.BossRoomsSettings and MainModules.BossRoomsSettings.Rooms) then
            return
        end
        initDone = true
        for name, info in pairs(MainModules.ToolsInfo.Infos) do
            local args = type(info) == "table" and info.Arguments
            if info.Recipe and type(args) == "table" and args.Boss and args.Difficulty and MainModules.BossRoomsSettings.Rooms[args.Boss] then
                keyCatalog[args.Boss .. "|" .. args.Difficulty] = {
                    Name = name,
                    Boss = args.Boss,
                    Difficulty = args.Difficulty,
                    Recipe = info.Recipe,
                    Level = info.Level or 0,
                }
            end
        end

        local coveredEnemy = {}
        local il = workspace:FindFirstChild("IgnoreList")
        local data = il and il:FindFirstChild("Data")
        local groups = data and data:FindFirstChild("EnemyGroups")
        local enemysInfo = MainModules.EnemysInfo
        if groups and enemysInfo then
            for _, grp in ipairs(groups:GetDescendants()) do
                if grp:IsA("BasePart") then
                    for enemy in tostring(grp:GetAttribute("Enemies") or ""):gmatch("[^,]+") do
                        coveredEnemy[enemy] = true
                        local eInfo = enemysInfo[enemy]
                        local drops = eInfo and eInfo.Rewards and eInfo.Rewards.Drops
                        if type(drops) == "table" then
                            local lv = (eInfo.EnemyArguments and eInfo.EnemyArguments.Level) or 0
                            local altName = eInfo.EnemyArguments and eInfo.EnemyArguments.AlternativeName
                            local qEntry = State.Mobs.Quests[enemy] or (altName and State.Mobs.Quests[altName]) or nil
                            for mat, drop in pairs(drops) do
                                dropSources[mat] = dropSources[mat] or {}
                                local chance = tonumber(tostring((type(drop) == "table" and drop.Chance) or "0"):match("[%d.]+")) or 0
                                table.insert(dropSources[mat], {
                                    Enemy = enemy,
                                    AltName = altName,
                                    Group = grp,
                                    Chance = chance,
                                    Quest = qEntry,
                                    Level = lv,
                                })
                            end
                        end
                    end
                end
            end
        end

        if enemysInfo then
            for enemy, eInfo in pairs(enemysInfo) do
                if not coveredEnemy[enemy] and type(eInfo) == "table" then
                    local drops = eInfo.Rewards and eInfo.Rewards.Drops
                    local altName = eInfo.EnemyArguments and eInfo.EnemyArguments.AlternativeName
                    local qEntry = State.Mobs.Quests[enemy] or (altName and State.Mobs.Quests[altName]) or nil
                    if type(drops) == "table" and qEntry then
                        local lv = (eInfo.EnemyArguments and eInfo.EnemyArguments.Level) or 0
                        for mat, drop in pairs(drops) do
                            dropSources[mat] = dropSources[mat] or {}
                            local chance = tonumber(tostring((type(drop) == "table" and drop.Chance) or "0"):match("[%d.]+")) or 0
                            table.insert(dropSources[mat], {
                                Enemy = enemy,
                                AltName = altName,
                                Group = nil,
                                Chance = chance,
                                Quest = qEntry,
                                Level = lv,
                            })
                        end
                    end
                end
            end
        end
    end

    local function getItemRequirements(itemName, qty)
        ensureKeyCatalog()
        local infos = MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo.Infos
        local tools = MainModules and MainModules.ToolsUtils
        local info = type(infos) == "table" and itemName and infos[itemName]
        local mats = getSpentMaterials(info)
        if not (info and mats and tools) then return nil end

        local fu = MainModules.ForgeUtils
        local isUnique = (fu and fu.IsUnique and fu.IsUnique(info)) == true
        local reqQty = isUnique and 1 or math.max(1, math.floor(tonumber(qty) or 1))

        local all, missing = {}, {}
        for mat, perCraft in pairs(mats) do
            local needAmt = (tonumber(perCraft) or 1) * reqQty
            local have = tools.GetInventoryAmount(nil, mat) or 0
            local subInfo = type(infos) == "table" and infos[mat]
            local row = {
                Name = mat,
                Have = have,
                Need = needAmt,
                Missing = math.max(0, needAmt - have),
                Sources = dropSources[mat] or {},
                HasRecipe = (getSpentMaterials(subInfo) ~= nil),
            }
            table.insert(all, row)
            if row.Missing > 0 then
                table.insert(missing, row)
            end
        end
        table.sort(all, function(a, b) return a.Name < b.Name end)
        table.sort(missing, function(a, b) return a.Name < b.Name end)

        local craftReason = nil
        if fu and fu.ValidateCraft then
            local okV, _, r = pcall(fu.ValidateCraft, nil, itemName, reqQty, nil)
            if okV then craftReason = r end
        end

        return {
            Name = itemName,
            Info = info,
            Level = info.Level or 0,
            Gold = (info.Recipe.Gold or 0) * reqQty,
            OutputAmount = info.Recipe.Amount or 1,
            Unique = isUnique,
            Count = tools.GetInventoryAmount(nil, itemName) or 0,
            All = all,
            Missing = missing,
            CraftReason = craftReason,
        }
    end

