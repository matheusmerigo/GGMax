                        elseif isDoor and oid ~= "Escort_KaeldrosForge_VO" and oid ~= "Chase_MaskedMan_NA" then
                            Status = ("História: entrando na porta (%s)..."):format(oid)
                            local _, hrpDoor = getChar()
                            local wasInsideDoor = (hrpDoor and getInteriorContainer(hrpDoor.Position) ~= nil) or false

                            -- Descobre QUAL PrivateArea é a porta para onde fomos (pela Entrance mais próxima de pos)
                            local paRoot = workspace:FindFirstChild("IgnoreList") and workspace.IgnoreList:FindFirstChild("Int")
                                and workspace.IgnoreList.Int:FindFirstChild("PrivateAreas")
                            local expectedArea = nil
                            if paRoot and pos then
                                local bestD = 45
                                for _, isl in ipairs(paRoot:GetChildren()) do
                                    for _, pl in ipairs(isl:GetChildren()) do
                                        for _, subName in ipairs({ "Enter", "Leave" }) do
                                            local sf = pl:FindFirstChild(subName)
                                            local e = sf and (extractVec3(sf:FindFirstChild("Entrance")) or sf:GetAttribute("Entrance"))
                                            if typeof(e) == "Vector3" and (e - pos).Magnitude < bestD then
                                                bestD = (e - pos).Magnitude
                                                expectedArea = pl
                                            end
                                        end
                                    end
                                end
                            end

                            -- O jogo usa PrivateAreas Client.Current (enviado pelo servidor) para saber QUAL porta abrir.
                            -- Se ainda estiver com a porta antiga (ex: Circus) e dispararmos, ele nos joga de volta no Circus!
                            local paClient = ic and ic.PrivateAreas or nil
                            if not paClient then
                                pcall(function()
                                    paClient = require(ReplicatedStorage.Modules.Essentials.InteractionSystem["InteractionSystem Client"]["PrivateAreas Client"])
                                end)
                            end
                            local function curAreaIs(areaObj)
                                local cur = paClient and paClient.Current
                                if cur == nil or not areaObj then return false end
                                if cur == areaObj then return true end
                                if typeof(cur) == "Instance" then
                                    return cur == areaObj or cur:IsDescendantOf(areaObj) or cur.Name == areaObj.Name
                                end
                                local cs = tostring(cur)
                                return cs == areaObj.Name or cs:find(areaObj.Name, 1, true) ~= nil
                            end
                            local function curIsOtherArea()
                                if not (paClient and paClient.Current ~= nil and paRoot and expectedArea) then return false end
                                for _, isl in ipairs(paRoot:GetChildren()) do
                                    for _, pl in ipairs(isl:GetChildren()) do
                                        if pl ~= expectedArea and curAreaIs(pl) and not curAreaIs(expectedArea) then
                                            return true
                                        end
                                    end
                                end
                                return false
                            end
                            local function fireDoorSafe()
                                -- Caso 1: Porta via QuestZone (ex: Leave_Lighthouse_FI, Enter_Lighthouse_FI, YetiCave, Lab_SL, Well_SP)
                                if not expectedArea then
                                    local ign = workspace:FindFirstChild("IgnoreList")
                                    local zonesF = ign and ign:FindFirstChild("Data") and ign.Data:FindFirstChild("Quests") and ign.Data.Quests:FindFirstChild("Zones")
                                    local bestZone, bestZD = nil, 45
                                    if zonesF and pos then
                                        for _, isl in ipairs(zonesF:GetChildren()) do
                                            for _, z in ipairs(isl:GetChildren()) do
                                                if z.Name:sub(1, 6) == "Enter_" or z.Name:sub(1, 6) == "Leave_" or z.Name:sub(1, 6) == "Board_" or z.Name == "Return_Backstage_VAL" then
                                                    local zp = extractVec3(z)
                                                    if zp then
                                                        local d = (zp - pos).Magnitude
                                                        if d < bestZD then bestZD, bestZone = d, z.Name end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                    if bestZone then
                                        logSec(("isDoor bestZone=%s pos=(%.1f,%.1f,%.1f)"):format(tostring(bestZone), pos.X, pos.Y, pos.Z))
                                        -- Aguarda o contexto da zona aparecer para achar a alavanca/porta real (ex: Enter_IronLotus_SL, Enter_PrisonLift_PI, Leave_PrisonLift_PI)
                                        if ic and ic.Interaction and ic.Interaction.Contexts and not ic.Interaction.Contexts[bestZone] then
                                            local tDoorCtx = os.clock() + 1.0
                                            while os.clock() < tDoorCtx and not aborted() do
                                                if ic.Interaction.Contexts[bestZone] then break end
                                                task.wait(0.1)
                                            end
                                        end
                                        local ctxDoor = ic and ic.Interaction and ic.Interaction.Contexts and ic.Interaction.Contexts[bestZone]
                                        local hpDoor = ctxDoor and ctxDoor.HighlightParent
                                        if hpDoor and (bestZone == "Enter_IronLotus_SL" or bestZone == "Enter_PrisonLift_PI" or bestZone == "Leave_PrisonLift_PI" or tostring(hpDoor.Name):find("Alavanca") or tostring(hpDoor.Name):find("Lever")) then
                                            local lp = extractVec3(hpDoor)
                                            local _, hhD = getChar()
                                            logSec(("isDoor hpDoor=%s lp=%s"):format(tostring(hpDoor.Name), lp and string.format("(%.1f,%.1f,%.1f)", lp.X, lp.Y, lp.Z) or "nil"))
                                            if lp and hhD and (hhD.Position - lp).Magnitude > 4 and (hhD.Position - lp).Magnitude < 45 then
                                                tweenTo(CFrame.new(lp + Vector3.new(0, 1.5, 0)), aborted)
                                                task.wait(0.25)
                                            end
                                        end
                                        GameClient.fireInteractionContext(bestZone)
                                        GameClient.pressInteract(0.35, bestZone)
                                        if bestZone == "Enter_IronLotus_SL" or bestZone == "Enter_PrisonLift_PI" or bestZone == "Leave_PrisonLift_PI" then
