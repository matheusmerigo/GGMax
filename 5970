local function hasVoidWalkerKey()
    local invAmt = 0
    pcall(function()
        if MainModules and MainModules.ToolsUtils and MainModules.ToolsUtils.GetInventoryAmount then
            invAmt = tonumber(MainModules.ToolsUtils.GetInventoryAmount(nil, "VoidWalker Key")) or 0
        end
    end)
    if invAmt > 0 then return true end
    local cNow = LP.Character
    local bp = LP:FindFirstChildOfClass("Backpack")
    for _, container in ipairs({ cNow, bp }) do
        if container then
            local tool = container:FindFirstChild("VoidWalker Key")
            if tool and tool:IsA("Tool") then return true end
        end
    end
    return false
end

local function getSelectedIslandBosses()
    local list = {}
    for _, it in ipairs(GameClient.ISLAND_BOSS_LIST) do
        if CFG.TargetIslandBosses and CFG.TargetIslandBosses[it[1]] then
            table.insert(list, it[1])
        end
    end
    return list
end

local function islandBossPos(bName, fromPos)
    local ign = workspace:FindFirstChild("IgnoreList")
    local dataF = ign and ign:FindFirstChild("Data")
    local beacons = dataF and dataF:FindFirstChild("BossBeacons")
    local bn = beacons and beacons:FindFirstChild(bName)
    local bp = bn and Features.ExtractVec3(bn)
    if bp then return bp end

    local mk = Combat.SpawnMarker(bName, fromPos)
    if mk then return mk.Position end

    local islName = ISLAND_BOSS_AREA[bName]
    local areasF = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Areas")
    local area = islName and areasF and areasF:FindFirstChild(islName)
    local mc = area and area:GetAttribute("MapCenter")
    if typeof(mc) == "Vector3" then
        local alt = tonumber(area:GetAttribute("MapAltitude")) or 20
        return mc + Vector3.new(0, alt + 10, 0)
    end
    return nil
end

function GameClient.IslandBossLoop()
    State.islandBossToken += 1
    local my = State.islandBossToken
    task.spawn(function()
        debugLog("boss_debug.txt", ("=== AutoIslandBoss START lv=%d ==="):format(getLevel()))
        local idx = 1
        local cooldownUntil = {}
        local function aborted()
            return not CFG.AutoIslandBoss or State.islandBossToken ~= my
        end
        local function actAborted()
            if State.islandBossBusy then
                return aborted() or isDeadOrRespawning()
            end
            return aborted() or isDeadOrRespawning() or State.seaBeastBusy or State.fortRaidBusy or State.bossBusy
        end
        SafeRuntime.RunResilientLoop("IslandBossLoop", function() return not aborted() end, function()
        while not aborted() do
            local char, hrp, hum = getChar()
            if isDeadOrRespawning() or (not State.islandBossBusy and (State.seaBeastBusy or State.fortRaidBusy or State.bossBusy)) or not (char and hrp and hum) then
                if State.islandBossBusy then State.islandBossBusy = false end
                attackGoal = nil
                currentTarget = nil
                task.wait(0.5)
            else
                local selected = getSelectedIslandBosses()
                if #selected == 0 then
                    if State.islandBossBusy then
                        State.islandBossBusy = false
                        if CFG.MainModeActive and Features.ResumeMainMode and not State.seaBeastBusy and not State.fortRaidBusy and not State.bossBusy then Features.ResumeMainMode() end
                    end
                    Status = "Boss Ilha: selecione pelo menos 1 boss"
                    task.wait(1)
                else
                    local bossName, target = nil, nil
                    for _, bName in ipairs(selected) do
                        local t = findWorldBoss(bName)
                        if t then
                            bossName, target = bName, t
                            break
                        end
                    end

                    if not target then
                        local now = os.clock()
                        local chosen = nil
                        local ign = workspace:FindFirstChild("IgnoreList")
                        local dataF = ign and ign:FindFirstChild("Data")
                        local respawns = dataF and dataF:FindFirstChild("BossRespawns")
                        local nowSrv = workspace:GetServerTimeNow()
                        for offset = 0, #selected - 1 do
                            local i2 = ((idx - 1 + offset) % #selected) + 1
                            local bName = selected[i2]
                            local rNode = respawns and respawns:FindFirstChild(bName)
                            local rAt = rNode and rNode:GetAttribute("RespawnAt")
                            local onRespawn = (type(rAt) == "number" and rAt > nowSrv)
                            if not onRespawn and now >= (cooldownUntil[bName] or 0) then
                                local skipRemote = false
                                if bName == "VoidWalker Mordrek" then
                                    local beacons = dataF and dataF:FindFirstChild("BossBeacons")
                                    local hasBeacon = beacons and beacons:FindFirstChild(bName) ~= nil
                                    local canSpawnWithKey = CFG.UseVoidWalkerKey and hasVoidWalkerKey()
                                    if not hasBeacon and not canSpawnWithKey then
                                        skipRemote = true
                                    end
                                end
                                if not skipRemote then
                                    chosen = bName
                                    idx = (i2 % #selected) + 1
                                    break
                                end
                            end
                        end

                        if not chosen then
                            if State.islandBossBusy then
                                State.islandBossBusy = false
                                if not State.seaBeastBusy and not State.fortRaidBusy and not State.bossBusy then
                                    if CFG.MainModeActive and Features.ResumeMainMode then Features.ResumeMainMode()
                                    elseif CFG.AutoMob and Features.MobLoop then Features.MissionLoop() end
                                end
                            end
                            task.wait(1.5)
                        else
                            if not State.islandBossBusy then
                                State.islandBossBusy = true
                                GameClient.PauseMainModesForBoss()
                            end
                            local beaconsNow = dataF and dataF:FindFirstChild("BossBeacons")
                            local hasBeaconNow = beaconsNow and beaconsNow:FindFirstChild(chosen) ~= nil
                            local dest
                            if chosen == "VoidWalker Mordrek" and not hasBeaconNow and CFG.UseVoidWalkerKey and hasVoidWalkerKey() then
                                dest = giverPos("Void Herald") or islandBossPos(chosen, hrp.Position)
                            else
                                dest = islandBossPos(chosen, hrp.Position)
                            end
                            if dest then
                                Status = ("Boss Ilha: indo até %s..."):format(chosen)
                                goNear(dest, function() return actAborted() or findWorldBoss(chosen) ~= nil end)
                                if chosen == "VoidWalker Mordrek" and CFG.UseVoidWalkerKey and hasVoidWalkerKey() and not actAborted() and not findWorldBoss(chosen) then
                                    task.wait(1)
                                    local ni = ReplicatedStorage:FindFirstChild("NetworkInstances")
                                    local re = ni and ni:FindFirstChild("RemoteEvents")
                                    local ev = re and re:FindFirstChild("Elysium_Converse")
                                    if ev then
                                        debugLog("island_boss_debug.txt", "SUMMON_VOIDWALKER Elysium_Converse('Void Herald', 'Summon')")
                                        ev:FireServer("Void Herald", "Summon")
                                    end
                                end
                                local waitUntil = os.clock() + ((chosen == "VoidWalker Mordrek" and CFG.UseVoidWalkerKey) and 4.0 or 1.5)
                                while os.clock() < waitUntil and not actAborted() and not findWorldBoss(chosen) do
                                    task.wait(0.2)
                                end
                            end
                            target = findWorldBoss(chosen)
                            if target then
                                bossName = chosen
                            else
                                cooldownUntil[chosen] = os.clock() + 15
                                if #selected == 1 then
                                    State.islandBossBusy = false
                                    if not State.seaBeastBusy and not State.fortRaidBusy and not State.bossBusy then
                                        if CFG.MainModeActive and Features.ResumeMainMode then Features.ResumeMainMode()
                                        elseif CFG.AutoMob and Features.MobLoop then Features.MissionLoop() end
                                    end
                                    task.wait(2)
                                end
                            end
                        end
                    end

                    if target and bossName and not actAborted() then
                        if not State.islandBossBusy then
                            State.islandBossBusy = true
                            GameClient.PauseMainModesForBoss()
                        end
                        Status = ("Boss Ilha: %s"):format(bossName)
                        debugLog("boss_debug.txt", ("ISLAND_BOSS_FIGHT %s hp=%.0f"):format(bossName, mobHP(target)))
                        Combat.FightTarget(target, function() return actAborted() or not mobAlive(target) end, "Boss Ilha", { checkStuck = false, allowGoNear = true })
                        if not mobAlive(target) then
                            cooldownUntil[bossName] = os.clock() + 20
                            debugLog("boss_debug.txt", ("ISLAND_BOSS_KILLED %s"):format(bossName))
                        end
                        attackGoal = nil
                        currentTarget = nil
                    end
                end
            end
        end
        end, function(err) State.islandBossBusy = false; attackGoal = nil; currentTarget = nil; cancelTween() end)
        State.islandBossBusy = false
        State.bossBusy = false
        attackGoal = nil
        currentTarget = nil
        if Movement and Movement.Stop then Movement.Stop() end
    end)
end
end)() -- fim Boss/IslandBoss scope

