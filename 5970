                                elseif cGate:GetAttribute("BossTether") ~= nil or cGate:GetAttribute("BossArenaLock") ~= nil then
                                    gateBlocked = true
                                end
                            end
                        end

                        -- Se apontou para uma porta (Door_ / PrivateArea / Enter_* / Leave_*), entra/sai pela porta e aguarda 3s
                        if gateBlocked and oid:sub(1, 7) ~= "Defeat_" and oid ~= "Finish_RaikanBattle_SU" then
                            Status = ("História: bloqueado por boss/arena (%s)..."):format(oid)
