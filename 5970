                    end

                    local ign = workspace:FindFirstChild("IgnoreList")
                    local dataF = ign and ign:FindFirstChild("Data")
                    local beacons = dataF and dataF:FindFirstChild("BossBeacons")
                    local respawns = dataF and dataF:FindFirstChild("BossRespawns")

                    if activeBossName then
                        local stillSelected = (CFG.AutoBoss and CFG.TargetBosses and CFG.TargetBosses[activeBossName])
                            or (CFG.AutoBoardBoss and CFG.TargetBoardBosses and CFG.TargetBoardBosses[activeBossName])
                        local stillAlive = (beacons and beacons:FindFirstChild(activeBossName) ~= nil) or (findWorldBoss(activeBossName) ~= nil)
                        if not stillSelected or not stillAlive then
                            activeBossName = nil
                        end
                    end

                    -- 1) Verifica se algum boss selecionado já está vivo por perto (priorizando activeBossName)
                    local bossName, target = nil, nil
                    if activeBossName then
                        local tActive = findWorldBoss(activeBossName)
                        if tActive then
                            bossName, target = activeBossName, tActive
                        end
                    end
                    if not target then
                        local bestNearD = math.huge
                        for _, bName in ipairs(selected) do
                            local t = findWorldBoss(bName)
                            if t then
                                local trp = t:FindFirstChild("HumanoidRootPart") or t.PrimaryPart
                                local d = (trp and hrp) and (trp.Position - hrp.Position).Magnitude or 0
                                if d < bestNearD then
                                    bestNearD = d
                                    bossName, target = bName, t
                                end
                            end
                        end
                    end

                    -- 2) Se nenhum está por perto, mantém activeBossName ou prioriza algum já na sua ilha (< 1800 studs); senão escolhe em rodízio (bossIdx)
                    if not target then
                        local chosenName = nil
                        if activeBossName and beacons and beacons:FindFirstChild(activeBossName) ~= nil then
                            chosenName = activeBossName
                        else
                            if beacons and hrp then
                                local bestBeaconD = 1800
                                for _, bName in ipairs(selected) do
                                    local bn = beacons:FindFirstChild(bName)
                                    local bp = bn and Features.ExtractVec3(bn)
                                    if bp then
                                        local d = (bp - hrp.Position).Magnitude
                                        if d < bestBeaconD then
                                            bestBeaconD = d
                                            chosenName = bName
                                        end
                                    end
                                end
                            end
                            if not chosenName then
                                for offset = 0, #selected - 1 do
                                    local idx = ((bossIdx - 1 + offset) % #selected) + 1
                                    local bName = selected[idx]
                                    if beacons and beacons:FindFirstChild(bName) ~= nil then
                                        chosenName = bName
                                        bossIdx = (idx % #selected) + 1
                                        break
                                    end
                                end
                            end
                            activeBossName = chosenName
                        end

                        if not chosenName then
                            if State.bossBusy then
                                State.bossBusy = false
                                if CFG.MainModeActive and Features.ResumeMainMode then
                                    Features.ResumeMainMode()
                                end
                            end
                            -- Nenhum selecionado está spawnado agora: se MainModeActive estiver rodando, espera em silêncio sem sobrescrever o Status
                            if not CFG.MainModeActive then
                                local soonestName, soonestRem = selected[1], math.huge
                                local nowSrv = workspace:GetServerTimeNow()
                                if respawns then
                                    for _, bName in ipairs(selected) do
                                        local rNode = respawns:FindFirstChild(bName)
                                        local rAt = rNode and rNode:GetAttribute("RespawnAt")
                                        if type(rAt) == "number" then
                                            local rem = math.max(0, math.ceil(rAt - nowSrv))
                                            if rem < soonestRem then
                                                soonestRem, soonestName = rem, bName
                                            end
                                        end
                                    end
                                end
                                if soonestRem < math.huge then
                                    Status = ("Boss (%s): respawn em %d:%02d..."):format(soonestName, math.floor(soonestRem / 60), soonestRem % 60)
                                else
                                    local clockStr = ""
                                    pcall(function()
                                        local wc = MainModules and MainModules.WorldClock
                                        if wc and wc.GetHour and wc.Format then
                                            clockStr = " | " .. tostring(wc.Format(wc.GetHour()))
                                        end
                                    end)
                                    Status = ("Boss: aguardando spawn (%d%s)..."):format(#selected, clockStr)
                                end
                            end
                            local bNames = {}
                            if beacons then
                                for _, ch in ipairs(beacons:GetChildren()) do table.insert(bNames, ch.Name) end
                            end
                            logBossThrottled(("NO_BEACON sel=[%s] beacons=[%s]"):format(table.concat(selected, ","), table.concat(bNames, ",")), 5)
                            task.wait(1.5)
                        else
                            if not State.bossBusy then
                                State.bossBusy = true
                                GameClient.PauseMainModesForBoss()
                            end
                            local beaconNode = beacons and beacons:FindFirstChild(chosenName)
                            local beaconPos = beaconNode and Features.ExtractVec3(beaconNode)
                            if beaconPos and (hrp.Position - beaconPos).Magnitude < 1800 then
                                -- Já está perto da ilha do boss: sai de eventual interior e vai até o beacon para carregar o modelo
                                tryAcceptBossQuest(chosenName, lvl)
                                Status = ("Boss: indo até %s..."):format(chosenName)
                                logBoss(("BEACON_NEAR boss=%s dist=%.1f"):format(chosenName, (hrp.Position - beaconPos).Magnitude))
                                goNear(beaconPos, function()
                                    return bossActionAborted() or findWorldBoss(chosenName) ~= nil
                                end)
                                task.wait(0.4)
                            else
                                local cd = (MainModules and MainModules.ConditionalSpawnsSettings and MainModules.ConditionalSpawnsSettings.Teleport and MainModules.ConditionalSpawnsSettings.Teleport.Cooldown) or 30
                                local elapsed = os.clock() - State.lastBossTp
                                if elapsed < cd + 1 then
                                    local rem = math.ceil((cd + 1) - elapsed)
                                    Status = ("Boss (%s): cooldown TP (%ds)..."):format(chosenName, rem)
                                    logBossThrottled(("TP_COOLDOWN boss=%s rem=%ds"):format(chosenName, rem), 4)
                                    task.wait(0.8)
                                else
                                    tryAcceptBossQuest(chosenName, lvl)
                                    Status = ("Boss: teleportando para %s..."):format(chosenName)
                                    local distBefore = beaconPos and (hrp.Position - beaconPos).Magnitude or -1
                                    logBoss(("TP_FIRE boss=%s distBefore=%.1f"):format(chosenName, distBefore))
                                    State.lastBossTp = os.clock()
                                    pcall(function() GameModules.Network:FireServer("BossTeleport", chosenName) end)
                                    task.wait(2.5)
                                    local _, hAfterTp = getChar()
                                    local bAfter = beacons and beacons:FindFirstChild(chosenName)
                                    local bPosAfter = bAfter and Features.ExtractVec3(bAfter)
                                    local distAfter = (hAfterTp and bPosAfter) and (hAfterTp.Position - bPosAfter).Magnitude or -1
                                    logBoss(("TP_AFTER boss=%s distAfter=%.1f model=%s"):format(chosenName, distAfter, tostring(findWorldBoss(chosenName) ~= nil)))
                                    if distAfter >= 1800 and not findWorldBoss(chosenName) then
                                        activeBossName = nil
                                    end
                                    if hAfterTp and bPosAfter and distAfter < 1800 and not findWorldBoss(chosenName) then
                                        pcall(function() LP:RequestStreamAroundAsync(bPosAfter) end)
                                        tweenTo(CFrame.new(bPosAfter + Vector3.new(0, 12, 0)), function()
                                            return bossActionAborted() or findWorldBoss(chosenName) ~= nil
                                        end)
                                        task.wait(0.4)
                                    end
                                end
                            end
                        end
                    else
                        if not State.bossBusy then
                            State.bossBusy = true
                            GameClient.PauseMainModesForBoss()
                        end
                        local trpB = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
                        local dB = trpB and (trpB.Position - hrp.Position).Magnitude or 0
                        if dB >= 1800 then
                            local cd = (MainModules and MainModules.ConditionalSpawnsSettings and MainModules.ConditionalSpawnsSettings.Teleport and MainModules.ConditionalSpawnsSettings.Teleport.Cooldown) or 30
                            local elapsed = os.clock() - State.lastBossTp
                            if elapsed < cd + 1 then
                                local rem = math.ceil((cd + 1) - elapsed)
                                Status = ("Boss (%s): cooldown TP (%ds)..."):format(bossName, rem)
                                logBossThrottled(("TP_COOLDOWN_FAR boss=%s dist=%.1f rem=%ds"):format(bossName, dB, rem), 4)
                                task.wait(0.8)
                            else
                                tryAcceptBossQuest(bossName, lvl)
                                Status = ("Boss: teleportando para %s..."):format(bossName)
                                logBoss(("TP_FIRE_FAR boss=%s dist=%.1f"):format(bossName, dB))
                                State.lastBossTp = os.clock()
                                pcall(function() GameModules.Network:FireServer("BossTeleport", bossName) end)
                                task.wait(2.5)
                            end
                        else
                            activeBossName = bossName
                            tryAcceptBossQuest(bossName, lvl)
                            logBoss(("FIGHT_START boss=%s hp=%.0f dist=%.1f"):format(bossName, mobHP(target), dB))
                            Combat.FightTarget(target, function() return bossActionAborted() or not mobAlive(target) end, "Boss", { checkStuck = false })
                            logBoss(("FIGHT_END boss=%s alive=%s"):format(bossName, tostring(mobAlive(target))))
                            if not mobAlive(target) then
                                activeBossName = nil
                            end
                            if not bossActionAborted() then
                                Status = ("Boss (%s): derrotado!"):format(bossName)
                                task.wait(1.5)
                            end
                        end
                    end
                end
            end
        end
        end, function(err) State.bossBusy = false; attackGoal = nil; currentTarget = nil; cancelTween() end)
        State.bossBusy = false
        attackGoal = nil
        currentTarget = nil
        if Movement and Movement.Stop then Movement.Stop() end
    end)
end

