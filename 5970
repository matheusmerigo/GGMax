    function GameClient.StartStandaloneKeyCraftLoop()
        State.Tokens.KeyCraft = (State.Tokens.KeyCraft or 0) + 1
        local myTok = State.Tokens.KeyCraft
        task.spawn(function()
            local function logKey(msg) debugLog("keycraft_debug.txt", msg) end
            local function aborted()
                return not CFG.AutoCraftRaidKey or CFG.AutoRaid or State.Tokens.KeyCraft ~= myTok
            end
            local bossName, diff = CFG.CraftKeyBoss, CFG.CraftKeyDiff
            local wantQty = math.clamp(math.floor(tonumber(CFG.CraftKeyAmount) or 1), 1, 99)
            debugLog("keycraft_debug.txt", ("=== KEY_CRAFT START boss=%s diff=%s wantQty=%d lv=%d ==="):format(tostring(bossName), tostring(diff), wantQty, getLevel()), true)
            if not (bossName and diff) then
                logKey("ABORT reason=missing_selection")
                CFG.AutoCraftRaidKey = false
                if Shared.RefreshToggles then Shared.RefreshToggles() end
                notify("Craft Key", "Selecione uma ilha, dificuldade e chave antes.")
                return
            end
            ensureKeyCatalog()
            local entry = keyCatalog[tostring(bossName) .. "|" .. tostring(diff)]
            if not entry then
                logKey(("ABORT reason=no_recipe boss=%s diff=%s"):format(tostring(bossName), tostring(diff)))
                CFG.AutoCraftRaidKey = false
                if Shared.RefreshToggles then Shared.RefreshToggles() end
                notify("Craft Key", "Essa chave não possui receita na forja.")
                return
            end
            local baseReq = getItemRequirements(entry.Name, 1)
            local startCnt = (MainModules and MainModules.ToolsUtils and MainModules.ToolsUtils.GetInventoryAmount(nil, entry.Name)) or 0
            local outPerCraft = math.max(1, tonumber(baseReq and baseReq.OutputAmount) or 1)
            local goalCnt = startCnt + wantQty * outPerCraft
            logKey(("GOAL key=%s startCnt=%d outPerCraft=%d wantQty=%d goalCnt=%d"):format(tostring(entry.Name), startCnt, outPerCraft, wantQty, goalCnt))
            SafeRuntime.RunResilientLoop("KeyCraftLoop", function() return not aborted() end, function()
            while not aborted() do
                local curCnt = (MainModules and MainModules.ToolsUtils and MainModules.ToolsUtils.GetInventoryAmount(nil, entry.Name)) or 0
