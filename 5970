local function talkToNPC(npcName, pos, aborted)
    if not pos then pos = giverPos(npcName) end
    if not pos then return false end
    Status = ("NPC: indo até %s..."):format((npcName and npcName ~= "") and npcName or "NPC")
    local _, hrp, hum = getChar()
    local hasChest = LP.Character and LP.Character:GetAttribute("CarriedChest") ~= nil
    if hrp and (hrp.Position - pos).Magnitude > (hasChest and 8 or 6) then
        task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(pos) end) end)
        if hasChest and hum then
            local t0 = os.clock()
            while (not aborted or not aborted()) and os.clock() - t0 < 15 do
                local _, h1, hm1 = getChar()
                if not (h1 and hm1) or (h1.Position - pos).Magnitude <= 7 then break end
                pcall(function() hm1:MoveTo(pos) end)
                task.wait(0.2)
            end
        else
            goNear(pos, aborted)
            if aborted and aborted() then return false end
            task.wait(0.2)
        end
    end
    for attempt = 1, 5 do
        if aborted and aborted() then return false end
        pressInteract(0.25, "Dialogue")
        task.wait(0.35)
        if isConverseUIOpen() then break end
        local _, h2 = getChar()
        if h2 and pos and (h2.Position - pos).Magnitude > 6 then
            tweenTo(CFrame.new(pos + Vector3.new(0, 2, 3)), aborted)
            task.wait(0.2)
        end
    end
    drainConverseUI(aborted, 20)
    return true
end

