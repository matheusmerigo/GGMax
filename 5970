local function startMinigameSolver(aborted)
    task.spawn(function()
        local lastDodgeHit = 0
        local firedStones = setmetatable({}, { __mode = "k" })
        local solvedCards = setmetatable({}, { __mode = "k" })
        local function pressMinigameKey(ch, gui)
            local firedBtn = false
            local padName = (ch == "A" and "LeftTouch") or (ch == "D" and "RightTouch") or (ch .. "Pad")
            local btn = gui:FindFirstChild(padName, true)
            if btn and btn:IsA("GuiButton") and type(firesignal) == "function" then
                firedBtn = pcall(firesignal, btn.MouseButton1Down)
            end
            if not firedBtn and VirtualInputManager then
                local kc = Enum.KeyCode[ch]
                if kc then
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, kc, false, game)
                        task.wait(0.03)
                        VirtualInputManager:SendKeyEvent(false, kc, false, game)
                    end)
                end
            end
        end
        SafeRuntime.RunResilientLoop("MinigameSolver", function() return not aborted() end, function()
        while not aborted() do
            local pg = LP:FindFirstChild("PlayerGui")
            local dGui = pg and pg:FindFirstChild("DodgeMinigameGui")
            local sGui = pg and pg:FindFirstChild("StoneBreakGui")
            if dGui then
                local keyHint = dGui:FindFirstChild("KeyHint", true)
                local letterLbl = keyHint and keyHint:FindFirstChild("Letter")
                local timingFrm = keyHint and keyHint:FindFirstChild("Timing")
                local fillFrm = timingFrm and timingFrm:FindFirstChild("Fill")
                local chHint = letterLbl and letterLbl:IsA("TextLabel") and tostring(letterLbl.Text):upper():match("^%s*([A-Z])%s*$")
                if chHint and fillFrm and fillFrm:IsA("GuiObject") then
                    if (os.clock() - lastDodgeHit) >= 0.12
                        and letterLbl.TextTransparency < 0.85 and fillFrm.Size.X.Scale >= 0.88 then
                        lastDodgeHit = os.clock()
                        pressMinigameKey(chHint, dGui)
                    end
                elseif fillFrm and fillFrm:IsA("GuiObject") and fillFrm.Size.X.Scale > 0.02 then
                    local rail = keyHint and keyHint.Parent
                    local focus = rail and rail:FindFirstChild("Focus")
                    local focusX = focus and focus:IsA("GuiObject") and focus.Position.X.Scale or 0.30
                    if rail and (os.clock() - lastDodgeHit) >= 0.08 then
                        local bestCard, bestDist = nil, 0.09
                        for _, child in ipairs(rail:GetChildren()) do
                            if child:IsA("GuiObject") and child.Name:sub(1, 4) == "Card" and not solvedCards[child] then
                                local dist = math.abs(child.Position.X.Scale - focusX)
                                if dist < bestDist then
                                    bestDist = dist
                                    bestCard = child
                                end
                            end
                        end
                        if bestCard then
                            local lbl = bestCard:FindFirstChildWhichIsA("TextLabel", true)
                            local ch = lbl and tostring(lbl.Text):upper():match("^%s*([A-Z])%s*$")
                            if ch then
                                solvedCards[bestCard] = true
                                lastDodgeHit = os.clock()
                                pressMinigameKey(ch, dGui)
                            end
                        end
                    end
                end
                RunService.RenderStepped:Wait()
            elseif sGui then
                for _, desc in ipairs(sGui:GetDescendants()) do
                    if desc.Name == "Hit" and desc:IsA("GuiButton") and not firedStones[desc] then
                        local holder = desc.Parent
                        local app = holder and holder:FindFirstChild("Approach")
                        if app and app.Visible and app.Size.X.Scale <= 1.25 then
                            local fired = false
                            if type(firesignal) == "function" then
                                fired = pcall(firesignal, desc.MouseButton1Down)
                            end
                            if not fired and VirtualInputManager and desc.AbsoluteSize.X > 0 and desc.AbsoluteSize.Y > 0 then
                                local cx = desc.AbsolutePosition.X + desc.AbsoluteSize.X * 0.5
                                local cy = desc.AbsolutePosition.Y + desc.AbsoluteSize.Y * 0.5
                                fired = pcall(function()
                                    VirtualInputManager:SendMouseMoveEvent(cx, cy, game)
                                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                                    task.wait(0.02)
                                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                                end)
                            end
                            if fired then firedStones[desc] = true end
                        end
                    end
                end
                RunService.RenderStepped:Wait()
            else
                task.wait(0.15)
            end
        end
        end)
    end)
end

