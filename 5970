function BoatSystem.SailTo(boat, destPos, aborted)
    if not boat or not destPos or aborted() then return false end
    local seat = boat:FindFirstChild("DriverSeat") or boat:FindFirstChildWhichIsA("VehicleSeat", true)
    if not seat then return false end
    Status = "Barco: sentando para navegar..."
    for _ = 1, 8 do
        if aborted() then break end
        local _, hrp, hum = getChar()
        if hum then
            pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
            if hum.SeatPart == seat then break end
            if hrp then
                hrp.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
            end
            pcall(function() seat:Sit(hum) end)
        end
        task.wait(0.2)
    end
    if boat:GetAttribute("Anchored") == true or boat:GetAttribute("IsAnchored") == true then
        pcall(function() GameModules.Network:FireServer("KinematicBoatAnchorRequest", boat, false) end)
        task.wait(0.05)
    end
    local keysDown = { W = false, A = false, D = false }
    local function setKey(k, down)
        if keysDown[k] ~= down and VirtualInputManager then
            keysDown[k] = down
            pcall(function() VirtualInputManager:SendKeyEvent(down, Enum.KeyCode[k], false, game) end)
        end
    end
    local bestDist, lastProgressT, inputSeq = math.huge, os.clock(), 1
    while not aborted() and boat.Parent do
        local bPos = boat:GetPivot().Position
        local flatDist = Vector3.new(destPos.X - bPos.X, 0, destPos.Z - bPos.Z).Magnitude
        if flatDist <= 350 then break end
        if flatDist < bestDist - 8 then
            bestDist = flatDist
            lastProgressT = os.clock()
        elseif flatDist < 1500 and (os.clock() - lastProgressT) > 2.0 then
            -- Encostou na borda/costa da ilha de destino
            break
        end
        Status = ("Barco: navegando (%.0f studs)..."):format(flatDist)
        local _, hNow, hmNow = getChar()
        if hmNow and hmNow.SeatPart ~= seat and seat then
            pcall(function() hmNow:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
            if hNow then hNow.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0) end
            pcall(function() seat:Sit(hmNow) end)
        end
        local dir = Vector3.new(destPos.X - bPos.X, 0, destPos.Z - bPos.Z).Unit
        local look = boat:GetPivot().LookVector
        local fwd = Vector3.new(look.X, 0, look.Z)
        local steerVal = 0
        if fwd.Magnitude > 0.01 then
            fwd = fwd.Unit
            local crossY = fwd.X * dir.Z - fwd.Z * dir.X
            local dot = fwd:Dot(dir)
            setKey("W", true)
            if dot < 0.92 or math.abs(crossY) > 0.12 then
                steerVal = (crossY > 0) and 1 or -1
                setKey("A", crossY < 0)
                setKey("D", crossY > 0)
            else
                setKey("A", false)
                setKey("D", false)
            end
        end
        inputSeq += 1
        pcall(function() GameModules.Network:FireServer("KinematicBoatPilotInput", boat, 1, steerVal, inputSeq) end)
        task.wait(0.1)
    end
    setKey("W", false)
    setKey("A", false)
    setKey("D", false)
    pcall(function() GameModules.Network:FireServer("KinematicBoatPilotInput", boat, 0, 0, inputSeq + 1) end)
    pcall(function() GameModules.Network:FireServer("KinematicBoatAnchorRequest", boat, true) end)
    -- Levanta do DriverSeat de forma garantida (Space + Jump + Sit=false)
    for _ = 1, 6 do
        local _, _, hmEnd = getChar()
        if not hmEnd or (not hmEnd.Sit and not hmEnd.SeatPart) then break end
        hmEnd.Sit = false
        hmEnd.Jump = true
        pcall(function() hmEnd:ChangeState(Enum.HumanoidStateType.Jumping) end)
        if VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                task.wait(0.15)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            end)
        end
        task.wait(0.05)
    end
    return true
end

function BoatSystem.WalkTo(targetPos, aborted, stopDist)
    stopDist = stopDist or 7
    local started = os.clock()
    local lastPos, stuckT = nil, os.clock()
    while not aborted() and (os.clock() - started) < 45 do
        local ch, hrp, hum = getChar()
        if not (ch and hrp and hum and hum.Health > 0) then break end
        if (hrp.Position - targetPos).Magnitude <= stopDist then return true end
        -- Garante colisão normal ao andar com o baú (sem noclip)
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and not p.CanCollide and p.Name ~= "HumanoidRootPart" then
                p.CanCollide = true
            end
        end
        pcall(function() hum:MoveTo(targetPos) end)
        if lastPos and (hrp.Position - lastPos).Magnitude < 1.0 then
            if os.clock() - stuckT > 0.7 then
                hum.Jump = true
                stuckT = os.clock()
            end
        else
            lastPos = hrp.Position
            stuckT = os.clock()
        end
        task.wait(0.2)
    end
    return false
end

