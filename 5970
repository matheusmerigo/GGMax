                                or oid:sub(8):gsub("_OTFinal$",""):gsub("_Harbor$",""):gsub("_SOL$",""):gsub("_GD$",""):gsub("_SP$",""):gsub("_SU$",""):gsub("_SL$",""):gsub("_VAL$",""):gsub("_WB$",""):gsub("_FI$",""):gsub("_PI$",""):gsub("_CT$",""):gsub("_SK$",""):gsub("_HI$",""):gsub("_FR$",""):gsub("_FS$",""):gsub("_OT$",""):gsub("_KR$",""):gsub("_HK$",""):gsub("_VO$",""):gsub("_NE$",""):gsub("_NA$",""):gsub("_MF$","")
