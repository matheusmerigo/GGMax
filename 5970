    function GameClient.StartForgeUpgradeLoop()
        State.Tokens.ForgeUpgrade = (State.Tokens.ForgeUpgrade or 0) + 1
        local myTok = State.Tokens.ForgeUpgrade
        task.spawn(function()
            local function logUp(msg) debugLog("forge_upgrade_debug.txt", msg) end
            local function aborted()
                return not CFG.AutoForgeUpgrade or State.Tokens.ForgeUpgrade ~= myTok
            end
            local mode = CFG.ForgeActionMode == "Evolve" and "Evolve" or "Upgrade"
            local gearName = CFG.ForgeGearTarget
            local targetPlus = math.clamp(math.floor(tonumber(CFG.ForgeTargetPlus) or 9), 1, 9)
            local useCharm = CFG.ForgeUseCharm == true
            debugLog("forge_upgrade_debug.txt", ("=== FORGE_%s START gear=%s targetPlus=%d charm=%s ==="):format(
                mode:upper(), tostring(gearName), targetPlus, tostring(useCharm)
            ), true)
            if type(gearName) ~= "string" or gearName == "" then
                CFG.AutoForgeUpgrade = false
                if Shared.RefreshToggles then Shared.RefreshToggles() end
                notify("Blacksmith", "Selecione um equipamento válido primeiro.")
                return
            end
            SafeRuntime.RunResilientLoop("ForgeUpgradeLoop", function() return not aborted() end, function()
            while not aborted() do
                local entry = findBestGearEntry(gearName, mode)
                local info = MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo:Get(gearName)
                if not (entry and info) then
                    notify("Blacksmith", "Equipamento não encontrado: " .. tostring(gearName))
                    break
                end
                local minForgeLv = 0
                local matsMap = nil
                local needGold = 0
                if mode == "Upgrade" then
                    local maxUp = (MainModules.ToolsUtils and MainModules.ToolsUtils.MaxUpgrade) or 9
                    local goalUp = math.min(targetPlus, maxUp)
                    if entry.Upgrade >= goalUp then
                        notify("Blacksmith", ("%s atingiu +%d!"):format(gearName, entry.Upgrade))
                        break
                    end
                    local step = MainModules.ForgeUtils and MainModules.ForgeUtils.GetStep(entry.Upgrade + 1)
                    if not step then break end
                    needGold = step.Gold or 0
                    matsMap = MainModules.ForgeUtils.GetStepMaterials(step, info)
                else
                    local nextEvo = MainModules.ToolsUtils and MainModules.ToolsUtils.GetNextEvolution(info, { Name = gearName, Level = entry.Level })
                    if not nextEvo then
                        notify("Blacksmith", ("%s já está na evolução máxima!"):format(gearName))
                        break
                    end
                    minForgeLv = nextEvo.Level or 0
                    needGold = nextEvo.Gold or 0
                    matsMap = nextEvo.Materials
                end

                local dataNow = getData()
                local curGold = dataNow and dataNow.Monetization and dataNow.Monetization.Gold or 0
                if curGold < needGold then
                    notify("Blacksmith", ("Gold insuficiente (%d/%d)."):format(curGold, needGold))
                    break
                end

                local missing = buildMatRows(matsMap)
                if #missing > 0 then
                    local handled = false
                    for _, row in ipairs(missing) do
                        if row.HasRecipe then
                            handled = true
                            local okSub, errSub = craftItemRecursiveStep(row.Name, row.Missing, aborted, logUp, {})
                            if not okSub and errSub ~= "aborted" then
                                notify("Blacksmith", tostring(errSub))
                            end
                            break
                        end
                    end
                    if not handled then
                        local okF, errF = farmMissingMaterialsStep(missing, gearName, aborted, logUp)
                        if not okF then
                            if errF ~= "aborted" then notify("Blacksmith", tostring(errF)) end
                            break
                        end
                    end
                    task.wait(0.25)
                    continue
                end

                local smith = findForgeNpc(minForgeLv)
                if not smith then
                    for _, fbName in ipairs({ "Kraken's Rest Blacksmith", "Volcano Island Blacksmith", "Valoria Island Blacksmith", "Windhaven Blacksmith", "Blacksmith" }) do
                        local fbPos = giverPos(fbName)
                        if fbPos then
                            goNear(fbPos, aborted)
                            if aborted() then break end
                            task.wait(0.5)
                            smith = findForgeNpc(minForgeLv)
                            if smith then break end
                        end
                    end
                end
                local smithPos = smith and smith:GetPivot().Position or giverPos("Blacksmith")
                if not smithPos then
                    notify("Blacksmith", "Blacksmith com nível suficiente não encontrado.")
                    break
                end
                Status = ("Blacksmith: indo %s (%s)..."):format(mode, gearName)
                goNear(smithPos, aborted)
                if aborted() then break end

                local okForge, forgeMenu, forgeData = pcall(function()
                    local fc = ReplicatedStorage.Modules.Addons.ForgeSystem["ForgeSystem Client"]
                    return require(fc.ForgeMenu), require(fc.ForgeMenu.Data)
                end)
                if not (okForge and forgeMenu and forgeData) then break end
                local convName = (smith and smith.Name == "Valoria Island Blacksmith") and "ValoriaBlacksmith" or "Blacksmith"
                if not (forgeMenu.Opened == true and forgeData.ForgeLevel ~= nil) then
                    for _ = 1, 3 do
                        if aborted() then break end
                        local _, hRe = getChar()
                        if hRe and (hRe.Position - smithPos).Magnitude > 14 then
                            tweenTo(CFrame.new(smithPos + Vector3.new(0, 2, 3)), aborted)
                            cancelTween()
                        end
                        pcall(function()
                            local dialogue = GameModules.Converse and GameModules.Converse.IsClient and GameModules.Converse.IsClient:Talk(convName)
                            if dialogue then dialogue:End(); dialogue:FireServer() end
                        end)
                        local dl = os.clock() + 2.5
                        while not aborted() and os.clock() < dl and not (forgeMenu.Opened == true and forgeData.ForgeLevel ~= nil) do
                            task.wait(0.15)
                        end
                        if forgeMenu.Opened == true and forgeData.ForgeLevel ~= nil then break end
                    end
                end
                if aborted() or not (forgeMenu.Opened == true and forgeData.ForgeLevel ~= nil) then
                    Features.RestoreHud()
                    break
                end

                local _, hNow = getChar()
                if hNow and (hNow.Position - smithPos).Magnitude > 16 then
                    tweenTo(CFrame.new(smithPos + Vector3.new(0, 2, 3)), aborted)
                    cancelTween()
                end

                local gearObj = nil
                for _, g in ipairs(forgeData.GetGearList(mode) or {}) do
                    if g.GearId == gearName then
                        if not gearObj
                            or (mode == "Evolve" and (g.Evolution or 0) > (gearObj.Evolution or 0))
                            or (mode ~= "Evolve" and (g.Level or 0) > (gearObj.Level or 0)) then
                            gearObj = g
                        end
                    end
                end
                if not gearObj then
                    if forgeMenu.Opened and forgeMenu.RequestClose then pcall(forgeMenu.RequestClose) end
                    Features.RestoreHud()
                    break
                end

                if mode == "Upgrade" then
                    local charmId = nil
                    if useCharm then
                        if (forgeData.GetCount("Untradable Protection Charm") or 0) > 0 then
                            charmId = "Untradable Protection Charm"
                        elseif (forgeData.GetCount("Protection Charm") or 0) > 0 then
                            charmId = "Protection Charm"
                        end
                    end
                    local blk = forgeData.GetUpgradeBlock(gearObj, charmId)
                    if blk then
                        if forgeMenu.Opened and forgeMenu.RequestClose then pcall(forgeMenu.RequestClose) end
                        Features.RestoreHud()
                        notify("Blacksmith", tostring(blk))
                        break
                    end
                    Status = ("Upgrading %s (+%d -> +%d)..."):format(gearName, gearObj.Level or 0, (gearObj.Level or 0) + 1)
                    logUp(("UPGRADE gear=%s lv=%d charm=%s"):format(gearName, gearObj.Level or 0, tostring(charmId)))
                    pcall(forgeData.Upgrade, gearObj, charmId)
                    task.wait(1.3)
                else
                    local blk = forgeData.GetEvolveBlock(gearObj)
                    if blk then
                        if forgeMenu.Opened and forgeMenu.RequestClose then pcall(forgeMenu.RequestClose) end
                        Features.RestoreHud()
                        notify("Blacksmith", tostring(blk))
                        break
                    end
                    Status = ("Evolving %s..."):format(gearName)
                    logUp(("EVOLVE gear=%s evo=%d"):format(gearName, gearObj.Evolution or 0))
                    pcall(forgeData.Evolve, gearObj)
                    task.wait(1.6)
                end
                if forgeMenu.Opened and forgeMenu.RequestClose then pcall(forgeMenu.RequestClose) end
                Features.RestoreHud()
                task.wait(0.35)
            end
            end, function(err) cancelTween() end)
            if State.Tokens.ForgeUpgrade == myTok then
                State.activeFarmQuestName = nil
                CFG.AutoForgeUpgrade = false
                if Shared.RefreshToggles then Shared.RefreshToggles() end
                Status = "Parado"
                logUp("=== FORGE_UPGRADE STOP ===")
            end
        end)
    end

