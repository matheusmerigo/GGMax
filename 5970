function Shared.RefreshToggles()
    local secLog = VoxCore and VoxCore.Client and VoxCore.Client.SecretDebugLog
    if Shared.RefreshingToggles then
        if secLog and Toggles and Toggles.SecretMissionsActive and (Toggles.SecretMissionsActive.Value or (VoxCore and VoxCore.CFG and VoxCore.CFG.AutoSecretAchievements)) then
            secLog(("REFRESH_SKIPPED_BUSY togVal=%s cfgAuto=%s"):format(tostring(Toggles.SecretMissionsActive.Value), tostring(VoxCore and VoxCore.CFG and VoxCore.CFG.AutoSecretAchievements)))
        end
        return
    end
    if not (Toggles and VoxCore and VoxCore.CFG) then return end
    local hasIdFn = type(setthreadidentity) == "function"
    local prevId = (hasIdFn and type(getthreadidentity) == "function") and getthreadidentity() or nil
    if hasIdFn and (not prevId or prevId < 8) then pcall(setthreadidentity, 8) end
    Shared.RefreshingToggles = true
    local cfg = VoxCore.CFG
    local map = {
        { Toggles.MainFarmActive, cfg.MainModeActive == true },
        { Toggles.VoxTrainingActive, cfg.AutoVoxTraining == true },
        { Toggles.SecretMissionsActive, cfg.AutoSecretAchievements == true },
        { Toggles.CollectCollectiblesActive, cfg.AutoCollectibles == true },
        { Toggles.Mission, cfg.AutoMob == true },
        { Toggles.MobDropFarmActive, cfg.AutoMobDrops == true },
        { Toggles.WantedBoss, cfg.AutoBoss == true },
        { Toggles.BoardBoss, cfg.AutoBoardBoss == true },
        { Toggles.IslandBoss, cfg.AutoIslandBoss == true },
        { Toggles.MarineEvent, (cfg.AutoSeaBeast == true or cfg.AutoFortRaid == true) },
        { Toggles.RaidActive, cfg.AutoRaid == true },
        { Toggles.DungeonActive, cfg.AutoDungeon == true },
        { Toggles.AutoCraftRaidKeyActive, cfg.AutoCraftRaidKey == true },
        { Toggles.BlacksmithCraftActive, cfg.AutoBlacksmith == true },
        { Toggles.ForgeUpgradeActive, cfg.AutoForgeUpgrade == true },
        { Toggles.BlackMarketActive, cfg.AutoBlackMarket == true },
        { Toggles.FishingActive, cfg.AutoFish == true },
    }
    for _, pair in ipairs(map) do
        local tog, want = pair[1], pair[2]
        if tog then
            local isSecret = (tog == Toggles.SecretMissionsActive)
            if tog.Value ~= want and type(tog.SetValue) == "function" then
                local okSet, errSet = pcall(function() tog:SetValue(want) end)
                if type(tog.Display) == "function" then pcall(function() tog:Display() end) end
                if isSecret and secLog then
                    secLog(("REFRESH_SECRET_SET want=%s ok=%s err=%s disabled=%s unloaded=%s after=%s"):format(
                        tostring(want), tostring(okSet), tostring(errSet),
                        tostring(tog.Disabled), tostring(Library and Library.Unloaded), tostring(tog.Value)
                    ))
                end
            else
                if type(tog.Display) == "function" then
                    pcall(function() tog:Display() end)
                end
                if isSecret and secLog and (tog.Value == true or want == true) then
                    secLog(("REFRESH_SECRET_SYNCED val=%s disabled=%s unloaded=%s"):format(
                        tostring(tog.Value), tostring(tog.Disabled), tostring(Library and Library.Unloaded)
                    ))
                end
            end
        end
    end
    Shared.RefreshingToggles = false
    if hasIdFn and prevId and prevId < 8 then pcall(setthreadidentity, prevId) end
end

