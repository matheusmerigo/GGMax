                return CFrame.new(part.Position), workspace.CurrentCamera.CFrame
            end
            return Combat.origMouseAim(...)
        end
    end
end)

local function logSkill(msg)
    debugLog("skill_debug.txt", msg)
end

local function isSkillReady(toolName, keyStr, isEquipped)
    if not skillsClient then
        pcall(function()
            local ab = ReplicatedStorage.Modules.Combat.AbilitySystem["AbilitySystem Client"]
            skillsClient = require(ab["SkillsSystem Client"])
            skillsRegistry = require(ReplicatedStorage.Modules.Skills)
            castingClient = require(ReplicatedStorage.Elysium.Modules.Library.Casting).IsClient
            local sui = ab["SkillsSystem Client"]:FindFirstChild("SkillsUI")
            if sui then
                desktopSkillsMod = sui:FindFirstChild("DesktopSkills") and require(sui.DesktopSkills)
                mobileSkillsMod = sui:FindFirstChild("MobileSkills") and require(sui.MobileSkills)
            end
        end)
    end
    if not (skillsClient and skillsRegistry) then return true, "noMod" end
    if os.clock() < (skillNext[toolName .. ":" .. keyStr] or 0) then
        return false, "nextCd"
    end
    local okBk, byKey = pcall(skillsRegistry.GetByKey, skillsRegistry, toolName, keyStr)
    if not (okBk and byKey) then return false, "noByKey" end
    local act = skillsClient.SkillUI and skillsClient.SkillUI.Actives and skillsClient.SkillUI.Actives[byKey.SkillName]
    if act and act.StartTime and act.StartTime > 0 then
        local el = os.clock() - act.StartTime
        local cd = act.Cooldown or 0
        if el < cd then
            return false, ("cd:%.1f/%.1f"):format(el, cd)
        end
    end
    local stPlayer = GameModules and GameModules.States and GameModules.States.Player and GameModules.States.Player()
    if stPlayer and byKey.Id then
        local okCd, onCd = pcall(function() return stPlayer:IsActive(byKey.Id .. "_Cooldown") end)
        if okCd and onCd then
            return false, "stateCd"
        end
    end
    if MainModules and MainModules.SkillUtils then
        if MainModules.SkillUtils.ValidateSkill then
            local okVal, valid = pcall(MainModules.SkillUtils.ValidateSkill, LP, byKey)
            if okVal and not valid then return false, "invalid" end
        end
        if MainModules.SkillUtils.UsageRequeriments then
            local okReq, canUse = pcall(MainModules.SkillUtils.UsageRequeriments, LP, byKey)
            if okReq and not canUse then return false, "req" end
        end
    end
    if keyStr == "G" and skillsClient.Transformations and skillsClient.Transformations.Has then
        local okTr, hasTr = pcall(skillsClient.Transformations.Has, skillsClient.Transformations, toolName)
        if okTr and hasTr and skillsClient.Transformations.Bars then
            local okB, bars = pcall(skillsClient.Transformations.Bars, toolName)
            local charNow = LP.Character
            local alreadyTransformed = charNow and charNow:GetAttribute("Transformed") == true
            if okB and type(bars) == "number" and bars < 1 and not alreadyTransformed then
                return false, "noFuryBar"
            end
        end
    end
    if isEquipped then
        local items = (desktopSkillsMod and desktopSkillsMod.Items) or (mobileSkillsMod and mobileSkillsMod.Items)
        local btn = items and items[keyStr]
        if btn and btn.Locked == true then
            return false, "locked"
        end
    end
    return true, ("ok(%s)"):format(tostring(byKey.SkillName))
end

local skillBindFn = nil
local function getSkillBindFn()
    if skillBindFn then return skillBindFn end
    pcall(function()
        local getup = (debug and debug.getupvalue) or getupvalue
        if getup and GameModules and GameModules.Context and GameModules.Context.BindFunction then
            local u2 = getup(GameModules.Context.BindFunction, 1)
            local ctx = type(u2) == "table" and u2["Skills"]
            local fn = ctx and ctx.Functions and ctx.Functions["Default"]
            if type(fn) == "function" then
                skillBindFn = fn
            end
        end
    end)
    return skillBindFn
end

local function fillReadySkills(toolName, isEq)
    local out = Combat.skillReady
    table.clear(out)
    for _, k in ipairs(SKILL_ORDER) do
        if CFG.SkillKeys[k] and isSkillReady(toolName, k, isEq) then
            out[#out + 1] = k
        end
    end
    return out
end

local function hasLiveSkillTarget()
    if not (attackGoal and currentTarget and currentTarget.Parent) then return false end
    if mobAlive(currentTarget) then return true end
    if CFG.AutoFortRaid and GameClient.FortRaidEnemyAlive(currentTarget) then return true end
    if CFG.AutoRaid and currentTarget:GetAttribute("Dead") ~= true then return true end
    if baseName(currentTarget):find("Sea Beast") then return true end
    return false
end

function GameClient.EnsureSkillsLoop()
    if not CFG.AutoSkills then
        State.Tokens.Skills += 1
        return
    end
    State.Tokens.Skills += 1
    local myTok = State.Tokens.Skills
    logSkill("=== AutoSkills START ===", true)
    task.spawn(function()
        local lastBlockLog = 0
        SafeRuntime.RunResilientLoop("AutoSkills", function() return CFG.AutoSkills and State.Tokens.Skills == myTok end, function()
        while CFG.AutoSkills and State.Tokens.Skills == myTok do
            if not (hasLiveSkillTarget() and not collecting and not State.storing and not Combat.IsInCutscene()) then
                local now = os.clock()
                if now - lastBlockLog >= 2 then
                    lastBlockLog = now
                    logSkill(("LOOP_BLOCK hasTgt=%s atkGoal=%s tgt=%s alive=%s collect=%s store=%s cut=%s"):format(
                        tostring(hasLiveSkillTarget()), tostring(attackGoal ~= nil), tostring(currentTarget and currentTarget.Name or "nil"),
                        tostring(currentTarget and mobAlive(currentTarget) or false),
                        tostring(collecting), tostring(State.storing), tostring(Combat.IsInCutscene())
                    ))
                end
                task.wait(0.25)
                continue
            end
            task.wait(0.05)
            if not (CFG.AutoSkills and State.Tokens.Skills == myTok) then
                break
            end
            if hasLiveSkillTarget() and not collecting and not State.storing and not Combat.IsInCutscene() then
                local cSk = LP.Character
                local hSk = cSk and cSk:FindFirstChildOfClass("Humanoid")
                local tSk = cSk and cSk:FindFirstChildOfClass("Tool")
                local ready = Combat.skillReady
                if tSk and Combat.MatchesWeaponType(tSk) then
                    fillReadySkills(tSk.Name, true)
                else
                    table.clear(ready)
                end
                -- Se a arma atual não tiver skill pronta (ou não combinar), procura outra marcada na mochila com skill pronta!
                if #ready == 0 and cSk and hSk then
                    local bp = LP:FindFirstChildOfClass("Backpack")
                    if bp then
                        for _, bpTool in ipairs(bp:GetChildren()) do
                            if bpTool ~= tSk and Combat.MatchesWeaponType(bpTool) then
                                if #fillReadySkills(bpTool.Name, false) > 0 then
                                    pcall(function() hSk:EquipTool(bpTool) end)
                                    task.wait(0.15)
                                    tSk = cSk:FindFirstChildOfClass("Tool")
                                    if tSk and Combat.MatchesWeaponType(tSk) then
                                        fillReadySkills(tSk.Name, true)
                                    else
                                        table.clear(ready)
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
                if #ready > 0 then
                    local stPlayer = GameModules and GameModules.States and GameModules.States.Player and GameModules.States.Player()
                    local defStates = MainModules and MainModules.StateUtils and MainModules.StateUtils.DefaultStates
                    local checkStates = (MainModules and MainModules.StateUtils and MainModules.StateUtils.CombineStates and defStates)
                        and MainModules.StateUtils.CombineStates(defStates, { "ArenaFrozen", "JumpOnly" })
                        or defStates
                    if skillsClient and skillsClient.CurrentSkill ~= nil then
                        table.clear(ready)
                        task.wait(0.05)
                        continue
                    end
                    if stPlayer and checkStates then
                        local tSt = os.clock() + 0.45
                        while os.clock() < tSt and not stPlayer:IsAllInactive(checkStates) do
                            task.wait(0.03)
                        end
                        if not stPlayer:IsAllInactive(checkStates) then
                            table.clear(ready)
                            continue
                        end
                    end
                    local startPos = 1
                    if lastSkillKey then
                        local lastOrd = table.find(SKILL_ORDER, lastSkillKey) or 0
                        for i, k in ipairs(ready) do
                            if (table.find(SKILL_ORDER, k) or 0) > lastOrd then
                                startPos = i
                                break
                            end
                        end
                    end
                    local keyName = ready[startPos]
                    table.clear(ready)
                    lastSkillKey = keyName
                    local skillObj = skillsRegistry and select(2, pcall(skillsRegistry.GetByKey, skillsRegistry, tSk.Name, keyName))
                    if CFG.AutoSkills and not (hasLiveSkillTarget() and not collecting and not State.storing and not Combat.IsInCutscene() and not isDeadOrRespawning()) then
                        logSkill(("SKIP_CAST hasTgt=%s collect=%s store=%s cut=%s dead=%s"):format(
                            tostring(hasLiveSkillTarget()), tostring(collecting), tostring(State.storing),
                            tostring(Combat.IsInCutscene()), tostring(isDeadOrRespawning())
                        ))
                    end
                    if CFG.AutoSkills and hasLiveSkillTarget() and not collecting and not State.storing and not Combat.IsInCutscene() and not isDeadOrRespawning() then
                        if skillObj and skillObj.Id and GameModules and GameModules.Network then
                            -- Sequência nativa Call -> Begin -> MinTime -> End -> Release (independente de foco de teclado) + mira no alvo
                            local tgt = currentTarget
                            skillAimTarget = tgt
                            skillAimUntil = os.clock() + 1.5
                            Combat.skillCastingUntil = os.clock() + 0.35
                            skillNext[tSk.Name .. ":" .. keyName] = os.clock() + ((skillObj.Settings and skillObj.Settings.Cooldown) or 2) + 0.25
                            local callRes = nil
                            if skillObj.Client and skillObj.Client.Call then
                                local okC, cr = pcall(skillObj.Client.Call)
                                if okC then callRes = cr end
                            end
                            pcall(function() GameModules.Network:FireServer("Elysium_Casting", "Begin", "Skill", skillObj.Id, callRes) end)
                            logSkill(("CAST_BEGIN tool=%s key=%s skill=%s target=%s"):format(
                                tostring(tSk.Name), tostring(keyName), tostring(skillObj.Id), tostring(tgt and baseName(tgt) or "nil")
                            ))
                            local holdT = math.max(0.1, (skillObj.Settings and skillObj.Settings.MinTime) or 0.1) + 0.12
                            task.wait(holdT)
                            if not CFG.AutoSkills or not hasLiveSkillTarget() or collecting or Combat.IsInCutscene() or isDeadOrRespawning() then
                                pcall(function() GameModules.Network:FireServer("Elysium_Casting", "Cancel", "Skill", skillObj.Id) end)
                                logSkill(("CAST_CANCEL tool=%s key=%s skill=%s attackGoal=%s"):format(
                                    tostring(tSk.Name), tostring(keyName), tostring(skillObj.Id), tostring(attackGoal ~= nil)
                                ))
                            else
                                local cast = castingClient and castingClient.GetActive and castingClient.GetActive(cSk, "Skill", skillObj.Id) or nil
                                local endRes = {}
                                if skillObj.Client and skillObj.Client.End then
                                    local okE, er = pcall(skillObj.Client.End, cast)
                                    if okE and er ~= nil then endRes = er end
                                end
                                pcall(function() GameModules.Network:FireServer("Elysium_Casting", "Release", "Skill", skillObj.Id, endRes) end)
                                logSkill(("CAST_RELEASE tool=%s key=%s skill=%s target=%s"):format(
                                    tostring(tSk.Name), tostring(keyName), tostring(skillObj.Id), tostring(tgt and baseName(tgt) or "nil")
                                ))
                            end
                        else
                            local key = Enum.KeyCode[keyName]
                            Combat.skillCastingUntil = os.clock() + 0.30
                            local fn = getSkillBindFn()
                            if fn then
                                logSkill(("PRESS tool=%s key=%s via=context"):format(tostring(tSk and tSk.Name), tostring(keyName)))
                                pcall(fn, { KeyCode = key, State = Enum.UserInputState.Begin, GameProcessedEvent = false })
                                task.wait(0.15)
                                pcall(fn, { KeyCode = key, State = Enum.UserInputState.End, GameProcessedEvent = false })
                            elseif VirtualInputManager then
                                logSkill(("PRESS tool=%s key=%s via=virtual_input"):format(tostring(tSk and tSk.Name), tostring(keyName)))
                                pcall(function()
                                    VirtualInputManager:SendKeyEvent(true, key, false, game)
                                    task.wait(0.15)
                                    VirtualInputManager:SendKeyEvent(false, key, false, game)
                                end)
                            end
                        end
                    end
                    task.wait(CFG.SkillInterval)
                else
                    task.wait(0.25)
                end
            end
        end
        end)
        table.clear(Combat.skillReady)
    end)
end
end
end

-- Auto pesca
do
    local fishHud, fishMS, swimUtils
    local pulling, lastControlY = false, nil

    local function getFishMS()
        if fishMS ~= nil then return fishMS end
        local ok, m = pcall(function() return require(ReplicatedStorage.Modules.Addons.MinigamesSystem).IsClient end)
        fishMS = ok and m or false
        return fishMS
    end

    local function setPull(on)
        if on == pulling or not VirtualInputManager then return end
        pulling = on
        pcall(function() VirtualInputManager:SendKeyEvent(on, Enum.KeyCode.ButtonR2, false, game) end)
    end

    local fishRenderConn = nil
    local function stopFishRender()
        if fishRenderConn then
            pcall(function() fishRenderConn:Disconnect() end)
            fishRenderConn = nil
        end
        lastControlY = nil
        setPull(false)
    end
    local function startFishRender()
        if fishRenderConn then return end
        fishRenderConn = track(SafeRuntime.Connect(RunService.RenderStepped, "FishRender", function()
            if not CFG.AutoFish then
                stopFishRender()
                return
            end
            local ms = getFishMS()
            local active = ms and ms.Active
            if not active or active.Name ~= "Fishing" then
                lastControlY = nil
                setPull(false)
                return
            end
            if not fishHud or not fishHud.Parent then
                local pg = LP:FindFirstChildOfClass("PlayerGui")
                local mh = pg and pg:FindFirstChild("MinigamesHUD", true)
                fishHud = mh and mh:FindFirstChild("Fishing") or nil
                if not fishHud then return end
            end
            local elems = fishHud:FindFirstChild("GameplayElements")
            local fish = elems and elems:FindFirstChild("Fish")
            local ctrl = elems and elems:FindFirstChild("Control")
            if not (fish and ctrl) then return end
            local fishY, ctrlY = fish.Position.Y.Scale, ctrl.Position.Y.Scale
            local speed = ctrlY - (lastControlY or ctrlY)
            lastControlY = ctrlY
            setPull(ctrlY + speed * 8 > fishY)
        end))
    end

    local function getSwimUtils()
        if swimUtils ~= nil then return swimUtils end
        local ok, u = pcall(function()
            return require(ReplicatedStorage.Modules.Essentials.NavigationSystem["NavigationSystem Client"]["SwimSystem Client"].Utils)
        end)
        swimUtils = ok and u or false
        return swimUtils
    end

    local function fishCastParams()
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Include
        local inc = {}
        for _, name in ipairs({ "Map", "Terrain" }) do
            local obj = workspace:FindFirstChild(name)
            if obj then inc[#inc + 1] = obj end
        end
        local boats = playability("Boats")
        if boats then inc[#inc + 1] = boats end
        rp.FilterDescendantsInstances = inc
        rp.IgnoreWater, rp.RespectCanCollide = true, false
        return rp
    end

    local function canCastAt(stand, dir, rp, su)
        local tip = stand + dir * 35
        local drop = stand.Y - su.GetOceanHeight(CFrame.new(tip))
        if drop < 0.5 or drop > 45 then return false end
        if workspace:Raycast(stand + Vector3.new(0, 1.5, 0), dir * 35, rp) then return false end
        return workspace:Raycast(Vector3.new(tip.X, stand.Y, tip.Z), Vector3.new(0, -drop, 0), rp) == nil
    end

    local function findShoreSpot(center, radius)
        local su = getSwimUtils()
        if not su then return nil end
        local rp = fishCastParams()
        for ring = 0, radius or 450, 8 do
            local steps = math.max(1, math.floor(2 * math.pi * ring / 8))
            for step = 0, steps - 1 do
                if not CFG.AutoFish then return nil end
                local ang = step / steps * math.pi * 2
                local pt = center + Vector3.new(math.cos(ang) * ring, 0, math.sin(ang) * ring)
                local hit = workspace:Raycast(pt + Vector3.new(0, 80, 0), Vector3.new(0, -160, 0), rp)
                if hit and hit.Position.Y > su.GetOceanHeight(CFrame.new(hit.Position)) + 0.6 then
                    local stand = hit.Position + Vector3.new(0, 3, 0)
                    for i = 0, 15 do
                        local dir = Vector3.new(math.cos(i / 16 * math.pi * 2), 0, math.sin(i / 16 * math.pi * 2))
                        if canCastAt(stand, dir, rp, su) then
                            return stand, dir
                        end
                    end
                end
            end
            task.wait()
        end
    end

    Features.GetFishingRod = function()
        local char = LP.Character
        local bp = LP:FindFirstChildOfClass("Backpack")
        local rod = (char and char:FindFirstChild("Fishing Road")) or (bp and bp:FindFirstChild("Fishing Road"))
        if rod then return rod end
        local d = getData()
        if d and d.Tools and d.Tools.Unequiped and GameModules then
            for idx, item in ipairs(d.Tools.Unequiped) do
                if item.Name == "Fishing Road" then
                    pcall(function() GameModules.Network:FireServer("ToolsData", "Equip", idx, item.Name) end)
                    task.wait(1)
                    bp = LP:FindFirstChildOfClass("Backpack")
                    return (char and char:FindFirstChild("Fishing Road")) or (bp and bp:FindFirstChild("Fishing Road"))
                end
            end
        end
    end

    local function getIslandCenter(islandName)
        local map = workspace:FindFirstChild("Map")
        local areas = map and map:FindFirstChild("Areas")
        local area = areas and areas:FindFirstChild(islandName)
        local center = area and area:GetAttribute("MapCenter")
        return typeof(center) == "Vector3" and center or nil
    end

    local SHIPWRIGHTS = { "Solmar Shipwright", "Shipwright", "Kraken's Rest Shipwright" }
    local function nearestShipwright(fromPos)
        local bestName, bestPos, bestDist = nil, nil, math.huge
        for _, name in ipairs(SHIPWRIGHTS) do
            local pos = giverPos(name)
            if pos then
                local d = (pos - fromPos).Magnitude
                if d < bestDist then
                    bestName, bestPos, bestDist = name, pos, d
                end
            end
        end
        return bestName, bestPos, bestDist
    end

    local function countSellableFish(fishSet)
        local data = GameModules.DataStore.IsClient:Get()
        local tools = data and data.Tools and data.Tools.Unequiped
        local cnt, gold = 0, 0
        if not tools then return 0, 0 end
        for _, st in ipairs(tools) do
            if st and st.Name and st.Locked ~= true then
                local info = MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo:Get(st.Name)
                if fishSet[st.Name] or (info and info.Fishing ~= nil) then
                    local rar = (info and info.Rarity) or "Common"
                    if CFG.FishSellRarities[rar] == true then
                        local amt = tonumber(st.Quantity) or tonumber(st.Amount) or 1
                        cnt += amt
                        gold += amt * ((info and info.SellValue) or 0)
                    end
                end
            end
        end
        return cnt, gold
    end

    local cachedStand, cachedDir, lastSpotKey
    local sellingFish = false
    Features.SellFish = function(silent)
        if sellingFish then return 0, 0 end
        sellingFish = true
        local soldCount, soldGold = 0, 0
        local ok, err = pcall(function()
            if not (GameModules and GameModules.Network and GameModules.DataStore and GameModules.DataStore.IsClient) then return end
            local _, hrp = getChar()
            if not hrp then return end
            local data = GameModules.DataStore.IsClient:Get()
            local tools = data and data.Tools and data.Tools.Unequiped
            if not tools then return end

            local fishSet = {}
            if MainModules and MainModules.FishingUtils and MainModules.FishingUtils.FishNames then
                for _, name in ipairs(MainModules.FishingUtils.FishNames) do
                    fishSet[name] = true
                end
            end

            local beforeCount, beforeGold = countSellableFish(fishSet)
            if beforeCount == 0 then
                if not silent then
                    notify("🎣 Venda de Peixes", "Nenhum peixe desbloqueado das raridades marcadas.")
                end
                return
            end

            local npcName, npcPos, npcDist = nearestShipwright(hrp.Position)
            if not npcName then
                if not silent then
                    notify("⚠️ Venda de Peixes", "Nenhum Shipwright encontrado no mapa.")
                end
                return
            end

            local prevCF = npcDist > 12 and hrp.CFrame or nil
            if npcDist > 12 then
                Status = "Pesca: indo até " .. npcName .. "..."
                goNear(npcPos)
                local _, h2 = getChar()
                local postDist = h2 and (h2.Position - npcPos).Magnitude or math.huge
                if h2 and postDist > 10 and postDist <= 40 then
                    tweenTo(CFrame.new(npcPos + Vector3.new(0, 2, 3)))
                    _, h2 = getChar()
                    postDist = h2 and (h2.Position - npcPos).Magnitude or math.huge
                end
                if not h2 or postDist > 20 then
                    if not silent then
                        notify("⚠️ Venda de Peixes", "Não foi possível chegar perto de " .. npcName)
                    end
                    return
                end
                task.wait(0.25)
            end

            -- Re-lê inventário caso algo tenha mudado durante o tween e tranca as raridades a manter
            data = GameModules.DataStore.IsClient:Get()
            tools = data and data.Tools and data.Tools.Unequiped
            local toTempLock = {}
            if tools then
                for i, st in ipairs(tools) do
                    if st and st.Name and st.Locked ~= true then
                        local info = MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo:Get(st.Name)
                        if fishSet[st.Name] or (info and info.Fishing ~= nil) then
                            local rar = (info and info.Rarity) or "Common"
                            if CFG.FishSellRarities[rar] ~= true then
                                toTempLock[#toTempLock + 1] = { idx = i, name = st.Name }
                            end
                        end
                    end
                end
            end

            local tempLockedNames = {}
            for _, item in ipairs(toTempLock) do
                pcall(function()
                    GameModules.Network:FireServer("ToolsData", "Lock", false, item.idx, item.name)
                end)
                tempLockedNames[item.name] = (tempLockedNames[item.name] or 0) + 1
                task.wait(0.05)
            end
            if #toTempLock > 0 then task.wait(0.25) end

            local haggleAccepted = false
            if CFG.FishHaggle and MainModules and MainModules.HaggleUtils then
                local cooling = true
                pcall(function() cooling = MainModules.HaggleUtils.IsCoolingDown(nil, "Shipwright") end)
                if not cooling then
                    local okH, resH = pcall(function()
                        return GameModules.Network:SafeInvokeServer(5, "Elysium_Converse", npcName, "HaggleFish")
                    end)
                    if okH and resH == "Accepted" then
                        haggleAccepted = true
                        task.wait(0.35)
                    end
                end
            end

            local stillLeft = haggleAccepted and countSellableFish(fishSet) or beforeCount
            if stillLeft > 0 then
                pcall(function()
                    GameModules.Network:FireServer("Elysium_Converse", npcName, "SellFish")
                end)
            end

            task.wait(0.55)
            local afterCount, afterGold = countSellableFish(fishSet)
            soldCount = math.max(0, beforeCount - afterCount)
            soldGold = math.max(0, beforeGold - afterGold)

            if #toTempLock > 0 then
                local d2 = GameModules.DataStore.IsClient:Get()
                local t2 = d2 and d2.Tools and d2.Tools.Unequiped
                if t2 then
                    for i, st in ipairs(t2) do
                        if st and st.Name and (tempLockedNames[st.Name] or 0) > 0 and st.Locked == true then
                            tempLockedNames[st.Name] -= 1
                            pcall(function()
                                GameModules.Network:FireServer("ToolsData", "Lock", false, i, st.Name)
                            end)
                            task.wait(0.05)
                        end
                    end
                end
            end

            if soldCount > 0 then
                notify("💰 Peixes Vendidos", string.format("%dx vendidos em %s (+%d Gold)", soldCount, npcName, soldGold))
            elseif not silent then
                notify("⚠️ Venda não confirmada", "O servidor não vendeu os peixes perto de " .. npcName)
            end

            if prevCF and CFG.AutoFish then
                Status = "Pesca: voltando ao ponto..."
                goNear(prevCF.Position, function() return not CFG.AutoFish end)
                tweenTo(prevCF, function() return not CFG.AutoFish end)
            end
        end)
        sellingFish = false
        if not ok and not silent then
            notify("⚠️ Erro ao Vender", tostring(err))
        end
        return soldCount, soldGold
    end

    function GameClient.EnsureFishLoop()
        if not CFG.AutoFish then
            State.Tokens.Fish += 1
            stopFishRender()
            cachedStand, cachedDir, lastSpotKey = nil, nil, nil
            return
        end
        State.Tokens.Fish += 1
        local myTok = State.Tokens.Fish
        startFishRender()
        local function fishAborted()
            return not CFG.AutoFish or State.Tokens.Fish ~= myTok
        end
        task.spawn(function()
            SafeRuntime.RunResilientLoop("AutoFish", function() return CFG.AutoFish and State.Tokens.Fish == myTok end, function()
            while CFG.AutoFish and State.Tokens.Fish == myTok do
                if not CFG.AutoFarm and not collecting then
                    local char, hrp, hum = getChar()
                    if char and hrp and hum then
                        local rod = Features.GetFishingRod()
                        if not rod then
                            Status = "Pesca: sem Fishing Road"
                            notify("⚠️ Auto Pesca", "Compre a Fishing Road em Solmar Island")
                            CFG.AutoFish = false
                            if Shared.RefreshToggles then Shared.RefreshToggles() end
                            break
                        else
                            local spotKey = CFG.FishSpot
                            if spotKey ~= lastSpotKey then
                                cachedStand, cachedDir, lastSpotKey = nil, nil, spotKey
                            end
                            if spotKey == "Saved" and CFG.SavedFishSpot then
                                cachedStand, cachedDir = CFG.SavedFishSpot.stand, CFG.SavedFishSpot.dir
                            elseif not cachedStand or (spotKey == "Nearest" and (hrp.Position - cachedStand).Magnitude > 120) then
                                local searchCenter = (spotKey ~= "Nearest" and spotKey ~= "Saved") and getIslandCenter(spotKey) or hrp.Position
                                if searchCenter then
                                    if (hrp.Position - searchCenter).Magnitude > 180 then
                                        Status = "Pesca: indo para " .. spotKey
                                        goNear(searchCenter, fishAborted)
                                    end
                                    Status = "Pesca: procurando costa..."
                                    cachedStand, cachedDir = findShoreSpot(searchCenter, 450)
                                end
                            end
                            if not cachedStand then
                                Status = "Pesca: sem água por perto"
                                task.wait(2)
                            else
                                local playerNear = false
                                if CFG.FishPausePlayers then
                                    for _, other in ipairs(Services.Players:GetPlayers()) do
                                        local orp = other ~= LP and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
                                        if orp and (orp.Position - cachedStand).Magnitude < 60 then
                                            playerNear = true
                                            break
                                        end
                                    end
                                end
                                if playerNear then
                                    Status = "Pesca: player por perto"
                                    task.wait(2)
                                else
                                    if (hrp.Position - cachedStand).Magnitude > 4 then
                                        Status = "Pesca: indo até a água..."
                                        if (hrp.Position - cachedStand).Magnitude > 60 or hrp.Position.Y < -200 then
                                            goNear(cachedStand, fishAborted)
                                        end
                                        if not fishAborted() then
                                            tweenTo(CFrame.lookAt(cachedStand, cachedStand + cachedDir), fishAborted)
                                        end
                                    end
                                    if not fishAborted() then
                                        local c2, h2, hum2 = getChar()
                                        rod = Features.GetFishingRod()
                                        if c2 and h2 and hum2 and rod then
                                            h2.CFrame = CFrame.lookAt(cachedStand, cachedStand + cachedDir)
                                            h2.AssemblyLinearVelocity = Vector3.zero
                                            if rod.Parent ~= c2 then hum2:EquipTool(rod); task.wait(0.5) end
                                            local cam = workspace.CurrentCamera
                                            if cam then
                                                cam.CFrame = CFrame.lookAt(cachedStand + Vector3.new(0, 4, 0) - cachedDir * 10, cachedStand + cachedDir * 20)
                                            end
                                            Status = "Pesca: lançando vara..."
                                            pcall(function() rod:Activate() end)
                                            local ms = getFishMS()
                                            local t0 = os.clock()
                                            repeat task.wait(0.1) until (ms and ms.Active) or os.clock() - t0 > 12 or fishAborted()
                                            if ms and ms.Active and not fishAborted() then
                                                Status = "Pesca: puxando peixe..."
                                                local t1 = os.clock()
                                                repeat task.wait(0.1) until not ms.Active or os.clock() - t1 > 60 or fishAborted()
                                                task.wait(2.5)
                                                if CFG.AutoSellFish and not fishAborted() then
                                                    pcall(Features.SellFish, true)
                                                end
                                            else
                                                task.wait(1)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                else
                    cachedStand, cachedDir, lastSpotKey = nil, nil, nil
                end
                task.wait(0.5)
            end
            end, function(err) cancelTween() end)
            if State.Tokens.Fish == myTok then
                stopFishRender()
            end
            cachedStand, cachedDir, lastSpotKey = nil, nil, nil
        end)
    end
end

