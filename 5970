local function fightStyleBoss(enemyName, aborted, waitPos)
    Status = ("Estilo: procurando %s..."):format(enemyName)
    local altName = enemyName:gsub("%s*History$", "")
    local spacedName = altName:gsub("(%l)(%u)", "%1 %2")
    local forceStyleOnly = (enemyName:find("GiantBoar", 1, true) ~= nil or spacedName == "Giant Boar")
    local savedWeaponTypes = CFG.WeaponTypes
    if forceStyleOnly then CFG.WeaponTypes = { Style = true } end

    local tWait = os.clock()
    local target
    while not aborted() and os.clock() - tWait < 12 do
        if GameClient.FindWorldBoss then
            target = GameClient.FindWorldBoss(enemyName)
        end
        local ef = not target and playability("Enemys") or nil
        if ef then
            local _, myHrp = getChar()
            local myPos = myHrp and myHrp.Position or waitPos
            local bestDist = math.huge
            for _, m in ipairs(ef:GetChildren()) do
                if m:IsA("Model") and mobAlive(m) then
                    local orig = m:GetAttribute("OriginalName") or baseName(m)
                    if orig == enemyName or orig == altName or orig == spacedName
                        or m.Name:find(enemyName, 1, true)
                        or (altName ~= "" and m.Name:find(altName, 1, true))
                        or (spacedName ~= "" and m.Name:find(spacedName, 1, true)) then
                        local mrp = m:FindFirstChild("HumanoidRootPart")
                        local d = (mrp and myPos) and (mrp.Position - myPos).Magnitude or 0
                        if d < bestDist then
                            target, bestDist = m, d
                        end
                    end
                end
            end
        end
        if target then break end
        if GameClient.IsWorldBossName and GameClient.IsWorldBossName(enemyName) and GameClient.GetWorldBossLiveState then
            local liveM, beaconP = GameClient.GetWorldBossLiveState(enemyName)
            if not liveM and not beaconP then
                break
            end
        end
        if waitPos then
            local _, hrp = getChar()
            if hrp and (hrp.Position - waitPos).Magnitude > 25 then
                pcall(function() LP:RequestStreamAroundAsync(waitPos) end)
                tweenTo(CFrame.new(waitPos + Vector3.new(0, 4, 0)), aborted)
            end
        end
        task.wait(0.4)
    end
    if not target then
        if forceStyleOnly then CFG.WeaponTypes = savedWeaponTypes end
        return false
    end

    currentTarget = target
    Status = ("Atacando: %s"):format(baseName(target))
    local char0, _, hum0 = getChar()
    local tool = char0 and hum0 and Combat.EquipWeapon(char0, hum0) or nil
    local lastHit = 0

    local function getGoal(hrp, mr)
        local mp = mr.Position
        local tilt = (CFG.AttackMode == "M1" or CFG.AutoSkills)
        local flat = Vector3.new(hrp.Position.X - mp.X, 0, hrp.Position.Z - mp.Z)
        flat = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
        local spot = mp + flat * 2 + Vector3.new(0, CFG.AboveHeight, 0)
        return tilt and CFrame.lookAt(spot, mp) or CFrame.lookAt(spot, Vector3.new(mp.X, spot.Y, mp.Z))
    end

    local function tAborted()
        return aborted() or not mobAlive(target)
    end

    local _, hrpInit = getChar()
    local mrInit = target:FindFirstChild("HumanoidRootPart")
    if hrpInit and mrInit then
        local gInit = (Combat.ComputeStand and Combat.ComputeStand(target, hrpInit)) or getGoal(hrpInit, mrInit)
        if gInit then
            tweenTo(gInit, function()
                if tAborted() then return true end
                if CFG.BossDodge and Combat.InTelegraph then
                    local _, hc = getChar()
                    if hc and Combat.InTelegraph(hc.Position) then return true end
                end
                return false
            end)
        end
    end

    while not tAborted() do
        local pgB = LP:FindFirstChild("PlayerGui")
        if pgB and (pgB:FindFirstChild("DodgeMinigameGui") or pgB:FindFirstChild("StoneBreakGui")) then
            attackGoal = nil
            cancelTween()
            Status = "História: completando minigame do duelo..."
            task.wait(0.2)
        else
            local char, hrp, hum = getChar()
            if not char or not hrp or not hum or hum.Health <= 0 then
                task.wait(0.5)
            else
                local mr = target:FindFirstChild("HumanoidRootPart")
                if mr then
                    local goal = (Combat.ComputeStand and Combat.ComputeStand(target, hrp)) or getGoal(hrp, mr)
                    local inDanger = CFG.BossDodge and Combat.InTelegraph and Combat.InTelegraph(hrp.Position)
                    local dodgingNow = inDanger and not Combat.InTelegraph(goal.Position)
                    local maxSnap = dodgingNow and 75 or ((CFG.AttackMode == "KillAura") and 16 or 12)
                    if (hrp.Position - goal.Position).Magnitude > maxSnap then
                        attackGoal = nil
                        tweenTo(goal, function()
                            if tAborted() then return true end
                            if CFG.BossDodge and Combat.InTelegraph then
                                local _, hc = getChar()
                                if hc and ((not inDanger and Combat.InTelegraph(hc.Position)) or Combat.InTelegraph(goal.Position)) then
                                    return true
                                end
                            end
                            return false
                        end)
                    else
                        if dodgingNow then cancelTween() end
                        attackGoal = goal
                        hrp.CFrame = goal
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end
                    if (CFG.AttackMode == "M1" or Combat.ToolIsGun(tool)) and os.clock() - lastHit >= CFG.M1Interval then
                        lastHit = os.clock()
                        tool = (tool and tool.Parent == char and not forceStyleOnly) and tool or Combat.EquipWeapon(char, hum)
                        Combat.M1(tool)
                    end
                end
                RunService.Heartbeat:Wait()
            end
        end
    end
    if forceStyleOnly then CFG.WeaponTypes = savedWeaponTypes end
    attackGoal = nil
    currentTarget = nil
    return true
end

