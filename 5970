function GameClient.RunCampfireSecret()
    GameClient.CollectibleToken += 1
    local myToken = GameClient.CollectibleToken
    GameClient.CollectibleMode = "Secret"
    GameClient.CollectibleRequested = false
    GameClient.CampfireActive = true
    task.spawn(function()
        local function logSecret(msg)
            debugLog("secret_debug.txt", msg)
        end
        local function aborted()
            return not CFG.AutoSecretAchievements or GameClient.CollectibleToken ~= myToken
        end
        local okCamp, errCamp = xpcall(function()
            logSecret(("CAMPFIRE_START token=%s lv=%d"):format(tostring(myToken), getLevel()))
            Status = "Secretas: procurando uma fogueira..."
            local firePos = giverPos("Suspicious Man_Campfire")
            local fireSourceName = nil
            if firePos then
                logSecret("CAMPFIRE_FOUND source=giver pos=" .. tostring(firePos))
            else
                for _, item in ipairs(workspace:GetDescendants()) do
                    if aborted() then
                        if GameClient.CollectibleToken == myToken then GameClient.CampfireActive = false end
                        logSecret("CAMPFIRE_ABORTED_SEARCH")
                        return
                    end
                    local lowerName = item.Name:lower()
                    if (lowerName:find("campfire", 1, true) or lowerName == "fire") then
                        local pos = GameClient.ValuePosition(item)
                        if pos then
                            firePos = pos
                            fireSourceName = item:GetFullName()
                        end
                    end
                end
                if firePos then
                    logSecret(("CAMPFIRE_FOUND source=workspace name=%s pos=%s"):format(tostring(fireSourceName), tostring(firePos)))
                end
            end
            if not firePos or aborted() then
                if GameClient.CollectibleToken == myToken then
                    GameClient.CampfireActive = false
                    if not firePos then
                        logSecret("CAMPFIRE_NOT_FOUND")
                        GameClient.CollectibleMode = nil
                        CFG.AutoSecretAchievements = false
                        if Shared.RefreshToggles then Shared.RefreshToggles() end
                        Status = "Secretas: fogueira não encontrada"
                        notify("Secretas", "Nenhuma fogueira encontrada no mapa.")
                    else
                        logSecret("CAMPFIRE_ABORTED_BEFORE_TRAVEL")
                    end
                end
                return
            end
            local _, startHrp = getChar()
            logSecret(("CAMPFIRE_TRAVEL_START dist=%s"):format(tostring(startHrp and (startHrp.Position - firePos).Magnitude)))
            Status = "Secretas: indo até a fogueira..."
            goNear(firePos, aborted)
            if aborted() then
                if GameClient.CollectibleToken == myToken then GameClient.CampfireActive = false end
                logSecret("CAMPFIRE_ABORTED_TRAVEL")
                return
            end
            local _, arrHrp = getChar()
            logSecret(("CAMPFIRE_ARRIVED player=%s dist=%s"):format(
                tostring(arrHrp and arrHrp.Position),
                tostring(arrHrp and (arrHrp.Position - firePos).Magnitude)
            ))
            Status = "Secretas: queimando na fogueira..."
            local burnStart = os.clock()
            local waitUntil = burnStart + 30
            while not aborted() and os.clock() < waitUntil do
                local _, hrp, hum = getChar()
                if not hum or hum.Health <= 0 then break end
                if hrp then
                    hrp.CFrame = CFrame.new(firePos + Vector3.new(0, 1.5, 0))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
                task.wait(0.2)
            end
            local _, _, endHum = getChar()
            local died = (not endHum or endHum.Health <= 0)
            logSecret(("CAMPFIRE_DONE died=%s aborted=%s hp=%s elapsed=%.1fs"):format(
                tostring(died), tostring(aborted()), tostring(endHum and endHum.Health), os.clock() - burnStart
            ))
            if GameClient.CollectibleToken == myToken then
                GameClient.CampfireActive = false
                GameClient.CollectibleMode = nil
                CFG.AutoSecretAchievements = false
                if Shared.RefreshToggles then Shared.RefreshToggles() end
                Status = "Parado"
            end
        end, debug.traceback)
        if not okCamp then
            logSecret("CAMPFIRE_CRASH " .. tostring(errCamp))
            if GameClient.CollectibleToken == myToken then
                GameClient.CampfireActive = false
                GameClient.CollectibleMode = nil
                CFG.AutoSecretAchievements = false
                if Shared.RefreshToggles then Shared.RefreshToggles() end
                cancelTween()
                Status = "Erro nas secretas"
                notify("Secretas", "Erro na conquista da fogueira. Consulte secret_debug.txt.")
            end
        end
    end)
end

