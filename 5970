function GameClient.IsCollectionWanted(collectionInfo, collectibleMode)
    if type(collectionInfo) ~= "table" then return false end
    if collectibleMode == "Secret" then
        local selected = CFG.SecretAchievements or {}
        if selected.AllCollectibles == true then return true end
        return type(collectionInfo.Achievement) == "string" and selected[collectionInfo.Achievement] == true
    end
    return true
end

function GameClient.GetCollectibleIslands(collectibleMode)
    local found, seen = {}, {}
    local utils = MainModules and MainModules.CollectiblesUtils
    local hasCollections = type(utils and utils.Collections) == "table" and next(utils.Collections) ~= nil
    for _, collectionInfo in pairs(utils and utils.Collections or {}) do
        if GameClient.IsCollectionWanted(collectionInfo, collectibleMode) then
            local islandName = type(collectionInfo) == "table" and collectionInfo.Island
            if type(islandName) == "string" and islandName ~= "" and not seen[islandName] then
                seen[islandName] = true
                table.insert(found, { islandName, islandName })
            end
        end
    end
    if #found == 0 and not hasCollections then
        for _, island in ipairs(GameClient.CollectibleIslandsFallback) do
            table.insert(found, island)
        end
    end
    return found
end

function GameClient.ApplyCollectibles(on, continueQueue, requestedMode)
    local collectibleMode = (continueQueue and (GameClient.CollectibleMode or requestedMode)) or (requestedMode or "All")
    local flagKey = collectibleMode == "Secret" and "AutoSecretAchievements" or "AutoCollectibles"
    local debugFile = collectibleMode == "Secret" and "secret_debug.txt" or "collectibles_debug.txt"
    if not on then
        CFG[flagKey] = false
        if requestedMode and GameClient.CollectibleMode ~= nil and GameClient.CollectibleMode ~= requestedMode then
            if Shared.RefreshToggles then Shared.RefreshToggles() end
            return
        end
        GameClient.CollectibleMode = nil
        GameClient.CollectibleToken += 1
        GameClient.CollectibleRequested = false
        cancelTween()
        if not (CFG.MainModeActive or CFG.AutoVoxTraining or CFG.AutoCollectibles or CFG.AutoSecretAchievements) then
            Status = "Parado"
        end
        if Shared.RefreshToggles then Shared.RefreshToggles() end
        debugLog(debugFile, "STOP_REQUEST user_or_mode_change=true mode=" .. tostring(collectibleMode))
        return
    end
    if continueQueue and not GameClient.CollectibleRequested then
        CFG[flagKey] = false
        if Shared.RefreshToggles then Shared.RefreshToggles() end
        return
    end
    if not continueQueue then
        GameClient.CollectibleRequested = true
        GameClient.CollectibleQueue = {}
        local allLevelsKnown = true
        for index, island in ipairs(GameClient.GetCollectibleIslands(collectibleMode)) do
            local area
            pcall(function() area = MainModules and MainModules.TravelUtils and MainModules.TravelUtils.GetIsland(island[1]) end)
            local islandLevel = tonumber(area and area:GetAttribute("Level"))
            if not islandLevel then allLevelsKnown = false end
            table.insert(GameClient.CollectibleQueue, {
                Name = island[1],
                DisplayName = island[2],
                Level = islandLevel,
                OriginalIndex = index,
            })
        end
        if allLevelsKnown then
            table.sort(GameClient.CollectibleQueue, function(a, b)
                if a.Level == b.Level then return a.OriginalIndex < b.OriginalIndex end
                return a.Level < b.Level
            end)
        end
        GameClient.CollectibleQueueIndex = 1
    end
    local queueEntry = GameClient.CollectibleQueue and GameClient.CollectibleQueue[GameClient.CollectibleQueueIndex or 1]
    local islandName = queueEntry and queueEntry.Name
    if not islandName then
        debugLog(debugFile, "NO_ISLAND_FOUND mode=" .. tostring(collectibleMode))
        GameClient.CollectibleMode = nil
        GameClient.CollectibleRequested = false
        CFG[flagKey] = false
        if Shared.RefreshToggles then Shared.RefreshToggles() end
        task.defer(function() if Shared.RefreshToggles then Shared.RefreshToggles() end end)
        if collectibleMode == "Secret" then
            notify("Secretas", "Nenhuma ilha correspondente foi encontrada para as conquistas selecionadas.")
        end
        return
    end
    CFG.CollectibleIsland = islandName

    CFG.MainModeActive = false
    Features.StopAllMainModes(true)
    GameClient.CollectibleMode = collectibleMode
    GameClient.CollectibleRequested = true
    CFG[flagKey] = true
    GameClient.CollectibleToken += 1
    local myToken = GameClient.CollectibleToken
    local debugData = getData()
    local debugGold = debugData and debugData.Monetization and debugData.Monetization.Gold
    debugLog(debugFile, ("=== %s island=%s requiredLevel=%s playerLevel=%s gold=%s token=%s queue=%s/%s ==="):format(
        continueQueue and "NEXT" or "START", tostring(islandName), tostring(queueEntry.Level), tostring(getLevel()),
        tostring(debugGold), tostring(myToken), tostring(GameClient.CollectibleQueueIndex), tostring(#GameClient.CollectibleQueue)
    ), not continueQueue and collectibleMode ~= "Secret")
    if not continueQueue then
        local route = {}
        for _, entry in ipairs(GameClient.CollectibleQueue) do
            table.insert(route, ("%s(Lv.%s)"):format(entry.Name, entry.Level and tostring(entry.Level) or "?"))
        end
        debugLog(debugFile, "ROUTE " .. table.concat(route, " -> "))
    end
    if Shared.RefreshToggles then Shared.RefreshToggles() end

    task.spawn(function()
        -- Devolve o controle ao clique da interface antes de iniciar qualquer
        -- leitura, viagem ou varredura. Assim o toggle continua responsivo.
        task.wait(0.2)
        local function logCollectibles(message)
            debugLog(debugFile, message)
        end
        local function aborted()
            return not GameClient.CollectibleRequested or not CFG[flagKey] or GameClient.CollectibleToken ~= myToken
        end
        local function advanceQueue(reason, collectedNow, failedNow)
            if aborted() then return end
            GameClient.CollectibleCollectedTotal = (GameClient.CollectibleCollectedTotal or 0) + (collectedNow or 0)
            GameClient.CollectibleFailedTotal = (GameClient.CollectibleFailedTotal or 0) + (failedNow or 0)
            logCollectibles(("ISLAND_DONE island=%s reason=%s collected=%d failed=%d"):format(
                tostring(islandName), tostring(reason), collectedNow or 0, failedNow or 0
            ))
            GameClient.CollectibleQueueIndex = (GameClient.CollectibleQueueIndex or 1) + 1
            local nextEntry = GameClient.CollectibleQueue and GameClient.CollectibleQueue[GameClient.CollectibleQueueIndex]
            if nextEntry then
                logCollectibles(("QUEUE_NEXT index=%d/%d island=%s level=%s"):format(
                    GameClient.CollectibleQueueIndex, #GameClient.CollectibleQueue, nextEntry.Name, tostring(nextEntry.Level)
                ))
                task.defer(function()
                    if GameClient.CollectibleRequested and CFG[flagKey] and GameClient.CollectibleToken == myToken then
                        GameClient.ApplyCollectibles(true, true, collectibleMode)
                    end
                end)
                return
            end
            if collectibleMode == "Secret" and CFG.SecretAchievements and CFG.SecretAchievements.CampfireDeath then
                GameClient.CollectibleRequested = false
                cancelTween()
                logCollectibles("QUEUE_NEXT secret_action=CampfireDeath")
                task.defer(function()
                    if CFG.AutoSecretAchievements then GameClient.RunCampfireSecret() end
                end)
                return
            end
            GameClient.CollectibleMode = nil
            GameClient.CollectibleRequested = false
            CFG[flagKey] = false
            if Shared.RefreshToggles then Shared.RefreshToggles() end
            task.defer(function() if Shared.RefreshToggles then Shared.RefreshToggles() end end)
            cancelTween()
            Status = "Colecionáveis: todas as ilhas concluídas"
            logCollectibles(("=== ALL_FINISHED collected=%d failed=%d islands=%d ==="):format(
                GameClient.CollectibleCollectedTotal or 0, GameClient.CollectibleFailedTotal or 0,
                #(GameClient.CollectibleQueue or {})
            ))
            notify("Colecionáveis", ("Rota concluída. %d coletados e %d sem confirmação."):format(
                GameClient.CollectibleCollectedTotal or 0, GameClient.CollectibleFailedTotal or 0
            ))
        end

        if aborted() then
            logCollectibles("STOPPED before_worker_start=true")
            return
        end

        local okCollect, errCollect = xpcall(function()
        local utils = MainModules and MainModules.CollectiblesUtils
        local travel = MainModules and MainModules.TravelUtils
        if not (utils and travel) then
            logCollectibles("ERROR missing CollectiblesUtils/TravelUtils")
            GameClient.CollectibleMode = nil
            GameClient.CollectibleRequested = false
            CFG[flagKey] = false
            if Shared.RefreshToggles then Shared.RefreshToggles() end
            notify("Colecionáveis", "CollectiblesUtils ou TravelUtils não está disponível.")
            return
        end

        if not continueQueue then
            GameClient.CollectibleCollectedTotal = 0
            GameClient.CollectibleFailedTotal = 0
        end

        local expectedOnIsland = 0
        for _, collectionInfo in pairs(utils.Collections or {}) do
            if collectionInfo.Island == islandName and GameClient.IsCollectionWanted(collectionInfo, collectibleMode) then
                local achievement = MainModules.AchievementsInfo[collectionInfo.Achievement]
                expectedOnIsland += achievement and MainModules.AchievementsUtils.GetGoal(achievement) or 0
            end
        end
        local alreadyCollected = utils.GetCollected()
        local collectedOnIsland = 0
        for collectibleId in pairs(alreadyCollected) do
            local idStr = tostring(collectibleId)
            local slashPos = idStr:find("/", 1, true)
            if slashPos and idStr:sub(1, slashPos - 1) == islandName then
                local itemName = idStr:sub(slashPos + 1)
                local cKey = utils.GetCollectionKey(itemName)
                local cInfo = cKey and utils.Collections and utils.Collections[cKey]
                if cInfo and GameClient.IsCollectionWanted(cInfo, collectibleMode) then
                    collectedOnIsland += 1
                end
            end
        end
        logCollectibles(("PROGRESS island=%s saved=%d expected=%d mode=%s"):format(islandName, collectedOnIsland, expectedOnIsland, tostring(collectibleMode)))
        if expectedOnIsland > 0 and collectedOnIsland >= expectedOnIsland then
            logCollectibles("SKIP already_complete island=" .. islandName)
            advanceQueue("already_complete", 0, 0)
            return
        end

        local area
        pcall(function() area = travel.GetIsland(islandName) end)
        local center = area and area:GetAttribute("MapCenter")
        if typeof(center) ~= "Vector3" then
            logCollectibles("ERROR island_center_missing island=" .. tostring(islandName))
            advanceQueue("center_missing", 0, 1)
            return
        end

        local altitude = area:GetAttribute("MapAltitude") or 14
        local centerPos = center + Vector3.new(0, altitude + 12, 0)
        logCollectibles(("TRAVEL center=%s altitude=%s"):format(tostring(centerPos), tostring(altitude)))
        Status = "Colecionáveis: viajando para " .. islandName .. "..."
        local usedMirror = Movement.TryMirrorKeeperTravel and Movement.TryMirrorKeeperTravel(centerPos, islandName, aborted)
        logCollectibles("TRAVEL mirror=" .. tostring(usedMirror))
        if aborted() then return end

        Status = "Colecionáveis: indo ao centro de " .. islandName .. "..."
        goNear(centerPos, aborted, { noMirror = usedMirror == true })
        local _, centerHrp = getChar()
        logCollectibles("TRAVEL center_arrival=" .. tostring(centerHrp and centerHrp.Position))
        if aborted() then return end
        cancelTween()

        Status = "Colecionáveis: carregando itens por 3s..."
        pcall(function() LP:RequestStreamAroundAsync(centerPos) end)
        local loadUntil = os.clock() + 3
        while os.clock() < loadUntil and not aborted() do task.wait(0.1) end
        logCollectibles("STREAM wait_complete=3s")
        if aborted() then return end

        local root = utils.GetRoot()
        local islandFolder = root and root:FindFirstChild(islandName)
        if not islandFolder then
            logCollectibles("ERROR collectible_folder_missing root=" .. tostring(root))
            advanceQueue("folder_missing", 0, 1)
            return
        end

        local collectedCount = 0
        local failed = {}
        local loadedNames = {}
        for _, loadedItem in ipairs(islandFolder:GetChildren()) do
            table.insert(loadedNames, loadedItem.Name)
        end
        table.sort(loadedNames)
        local savedCollectibles = utils.GetCollected()
        local savedTotal, savedOnIsland = 0, 0
        for savedId in pairs(savedCollectibles) do
            savedTotal += 1
            if tostring(savedId):sub(1, #islandName + 1) == islandName .. "/" then savedOnIsland += 1 end
        end
        logCollectibles(("SCAN root=%s folder=%s loaded=%d savedTotal=%d savedIsland=%d names=[%s]"):format(
            tostring(root), tostring(islandFolder), #loadedNames, savedTotal, savedOnIsland, table.concat(loadedNames, " | ")
        ))
        SafeRuntime.RunResilientLoop("CollectiblesLoop", function() return not aborted() end, function()
        while not aborted() do
            local _, hrp = getChar()
            if not hrp then task.wait(0.5); continue end

            local currentCollected = utils.GetCollected()
            local target, targetPos, bestDistance
            for _, item in ipairs(islandFolder:GetChildren()) do
                local itemId = utils.GetId(islandFolder.Name, item.Name)
                local collectionKey = utils.GetCollectionKey(item.Name)
                local collectionInfo = collectionKey and utils.Collections and utils.Collections[collectionKey]
                local wanted = collectionInfo and GameClient.IsCollectionWanted(collectionInfo, collectibleMode)
                local alreadyDone = currentCollected and currentCollected[itemId] == true
                local pos = (wanted and not alreadyDone) and utils.GetItemPosition(item) or nil
                if pos and (failed[item] or 0) < 2 then
                    local distance = (hrp.Position - pos).Magnitude
                    if not bestDistance or distance < bestDistance then
                        target, targetPos, bestDistance = item, pos, distance
                    end
                end
            end
            if not target then break end

            local itemId = utils.GetId(islandFolder.Name, target.Name)
            logCollectibles(("TARGET id=%s distance=%.1f pos=%s attempt=%d"):format(
                tostring(itemId), tonumber(bestDistance) or -1, tostring(targetPos), (failed[target] or 0) + 1
            ))
            Status = ("Colecionáveis: %s (%d coletados)"):format(target.Name, collectedCount)
            goNear(targetPos, aborted, { noMirror = true })
            if aborted() then return end
            local _, arrivalHrp = getChar()
            logCollectibles(("ARRIVAL id=%s player=%s distance=%s parent=%s"):format(
                tostring(itemId), tostring(arrivalHrp and arrivalHrp.Position),
                tostring(arrivalHrp and (arrivalHrp.Position - targetPos).Magnitude), tostring(target.Parent)
            ))

            local waitUntil = os.clock() + 1.0
            while os.clock() < waitUntil and not aborted() do
                task.wait(0.1)
            end
            if aborted() then return end

            local contextUntil = os.clock() + 1.5
            while os.clock() < contextUntil and not aborted() do
                local interaction = GameClient.getInteractionClient()
                local contexts = interaction and interaction.Interaction and interaction.Interaction.Contexts
                if contexts and contexts["Collect Trophy"] then break end
                task.wait(0.1)
            end
            if aborted() then return end

            local interaction = GameClient.getInteractionClient()
            local contexts = interaction and interaction.Interaction and interaction.Interaction.Contexts
            local hasContext = contexts and contexts["Collect Trophy"] ~= nil
            local firedContext = GameClient.fireInteractionContext("Collect Trophy")
            logCollectibles(("INTERACT id=%s contextPresent=%s fired=%s current=%s"):format(
                tostring(itemId), tostring(hasContext), tostring(firedContext),
                tostring(interaction and interaction.Interaction and interaction.Interaction.CurrentContext)
            ))
            local confirmUntil = os.clock() + 5.2
            local confirmed = false
            while os.clock() < confirmUntil and not aborted() do
                local collected = utils.GetCollected()
                if collected[itemId] then confirmed = true; break end
                task.wait(0.1)
            end
            if not confirmed and not aborted() then
                logCollectibles("FALLBACK remote=AchievementSystem action=Collect id=" .. tostring(itemId))
                local remoteOk, remoteError = pcall(function()
                    GameModules.Network:FireServer("AchievementSystem", "Collect", itemId)
                end)
                logCollectibles(("FALLBACK_RESULT ok=%s error=%s"):format(tostring(remoteOk), tostring(remoteError)))
                confirmUntil = os.clock() + 3.8
                while os.clock() < confirmUntil and not aborted() do
                    local collected = utils.GetCollected()
                    if collected[itemId] then confirmed = true; break end
                    task.wait(0.15)
                end
            end

            if confirmed then
                collectedCount += 1
                failed[target] = nil
                logCollectibles(("CONFIRMED id=%s total=%d"):format(tostring(itemId), collectedCount))
            else
                failed[target] = (failed[target] or 0) + 1
                logCollectibles(("FAILED id=%s attempts=%d"):format(tostring(itemId), failed[target]))
            end
            task.wait(0.15)
        end
        end, function(err) logCollectibles("LOOP_ERR " .. tostring(err)); cancelTween() end)

        if not aborted() then
            cancelTween()
            local failedCount = 0
            for _, attempts in pairs(failed) do
                if attempts >= 2 then failedCount += 1 end
            end
            if failedCount > 0 then
                logCollectibles(("=== FINISH island=%s collected=%d failed=%d ==="):format(islandName, collectedCount, failedCount))
                Status = "Colecionáveis: concluído com falhas em " .. islandName
            else
                logCollectibles(("=== FINISH island=%s collected=%d failed=0 ==="):format(islandName, collectedCount))
                Status = "Colecionáveis: concluído em " .. islandName
            end
            advanceQueue(failedCount > 0 and "completed_with_failures" or "completed", collectedCount, failedCount)
        end
        end, debug.traceback)
        if not okCollect then
            GameClient.CollectibleMode = nil
            GameClient.CollectibleRequested = false
            CFG[flagKey] = false
            if Shared.RefreshToggles then Shared.RefreshToggles() end
            cancelTween()
            Status = "Erro nos colecionáveis"
            logCollectibles("CRASH " .. tostring(errCollect))
            notify(collectibleMode == "Secret" and "Secretas" or "Colecionáveis", "A automação encontrou um erro. Consulte " .. debugFile .. ".")
        end
    end)
end

