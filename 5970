    local ok, a, b = pcall(GameClient.BossRoomsUtils.Invoke, action, ...)
    if not ok then return nil, tostring(a) end
    return a, b
end

function GameClient.LeaveBossRoom()
    pcall(function()
        if GameModules and GameModules.Party and GameModules.Party.IsClient then
            GameModules.Party.IsClient:Leave("BossRoom")
        end
