function Combat.EquipWeapon(char, hum)
    if State.storing or not (char and hum) then return nil end
    for _, t in ipairs(char:GetChildren()) do
        if Combat.MatchesWeaponType(t) then return t end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        local fallback
        for _, t in ipairs(bp:GetChildren()) do
            if Combat.MatchesWeaponType(t) then
                hum:EquipTool(t)
                task.wait(0.15)
                return t
            elseif t:IsA("Tool") and t.Name == CFG.WeaponName then
                fallback = t
            end
        end
        if not char:FindFirstChildOfClass("Tool") and fallback then
