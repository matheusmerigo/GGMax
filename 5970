-- Bind utility functions
function Shared.TryCall(fn, ...)
    if Library and type(Library.TryCall) == "function" then
        return Library:TryCall(fn, ...)
    end
    if type(fn) ~= "function" then return false, "invalid function" end
    return pcall(fn, ...)
end

function Shared.TryWarn(label, fn, ...)
    if Library and type(Library.TryWarn) == "function" then
        return Library:TryWarn(label, fn, ...)
    end
    local unpackFn = RuntimeRefInfra.SafeRefs.unpack or table.unpack or unpack
    local results = PackArgs(Shared.TryCall(fn, ...))
    if results[1] ~= true then
        warn("[Midgard] " .. tostring(label or "Operation") .. " error: " .. tostring(results[2]))
    end
    return unpackFn(results, 1, results.n)
end

function Shared.ThrottleReady(key, cooldown)
    if type(key) ~= "string" or key == "" then return true end
    local now = Now()
    local cd = tonumber(cooldown) or 0
    local lastUsed = Shared.Throttles and Shared.Throttles[key] or 0
    return (now - lastUsed) >= cd
end

function Shared.PruneThrottleCache(now)
    now = tonumber(now) or Now()
    if (now - (Shared._LastThrottlePrune or 0)) < 60 then return false end
    Shared._LastThrottlePrune = now
    
    local cutoff = now - 300
    if type(Shared.Throttles) == "table" then
        for k, v in pairs(Shared.Throttles) do
            if type(v) ~= "number" or v < cutoff then
                Shared.Throttles[k] = nil
            end
        end
    end
    pruneOldestTickEntries(Shared.Throttles, 512)
    return true
end

function Shared.UseThrottle(key)
    if type(key) ~= "string" or key == "" then return end
    Shared.Throttles = Shared.Throttles or {}
    local now = Now()
    local pruned = Shared.PruneThrottleCache(now)
    Shared.Throttles[key] = now
    Shared._ThrottleWriteCount = ((tonumber(Shared._ThrottleWriteCount) or 0) + 1) % 64
    if not pruned and Shared._ThrottleWriteCount == 0 then
        pruneOldestTickEntries(Shared.Throttles, 512)
    end
end

function Shared.GetDebugName(value)
    if typeof(value) == "Instance" then
        local ok, fullName = pcall(value.GetFullName, value)
        if ok and type(fullName) == "string" and fullName ~= "" then
            return fullName
        end
        return value.Name
    end
    return tostring(value)
end

function Shared.WarnThrottled(key, cooldown, ...)
    if not Shared.ThrottleReady(key, cooldown) then return end
    Shared.UseThrottle(key)
    warn(...)
end

function Shared.ExecuteProtectedCallback(scopeName, callback, ...)
    if type(callback) ~= "function" then return false, "invalid callback" end
    local packed = PackArgs(...)
    return executeProtectedPacked(callback, packed)
end

local function IsManagedTaskAlive(handle)
    return typeof(handle) == "thread" and coroutine.status(handle) ~= "dead"
end

local function StartManagedTask(container, key, label, fn, ...)
    if type(container) ~= "table" or type(key) ~= "string" or key == "" or type(fn) ~= "function" then
        return nil
    end

    local active = container[key]
    if IsManagedTaskAlive(active) then
        task.cancel(active)
        container[key] = nil
    end

    local placeholder = {}
    container[key] = placeholder

    local args = PackArgs(...)
    local handle
    handle = TaskSpawn(label or key, function()
        local ok, err = executeProtectedPacked(fn, args)
        if not ok then
            WarnAsyncThrottled(label or key, err)
        end
        if container[key] == handle or container[key] == placeholder then
            container[key] = nil
        end
    end)

    if container[key] == placeholder then
        container[key] = handle
    end
    return handle
end

local function StopManagedTask(container, key)
    if type(container) ~= "table" or type(key) ~= "string" or key == "" then return end
    local active = container[key]
    if IsManagedTaskAlive(active) then
        local currentRunning = coroutine.running()
        if active ~= currentRunning then
            task.cancel(active)
        end
    end
    container[key] = nil
end

function Shared.CreateNamedTaskLoop(name, fn)
    if type(name) ~= "string" or name == "" or type(fn) ~= "function" then return nil end
    return StartManagedTask(Shared.ActiveLoops, name, name, fn)
end

function Shared.DestroyNamedTaskLoop(name)
    if type(name) ~= "string" or name == "" then return end
    StopManagedTask(Shared.ActiveLoops, name)
end

function Shared.DestroyAllNamedTaskLoops()
    for name in pairs(Shared.ActiveLoops) do
        Shared.DestroyNamedTaskLoop(name)
    end
end

function Thread(featurePath, featureFunc, isEnabled, ...)
    if isEnabled then
        return StartManagedTask(Shared.ActiveLoops, featurePath, featurePath, featureFunc, ...)
    else
        StopManagedTask(Shared.ActiveLoops, featurePath)
    end
    return nil
end

function Shared.DisconnectConnectionGroup(groupName)
    if Library and type(Library.DisconnectSignalGroup) == "function" then
        Library:DisconnectSignalGroup(groupName)
    end

    if type(Shared.Connections) ~= "table" then return end
    local group = Shared.Connections[groupName]
    if type(group) == "table" then
        for _, connection in ipairs(group) do
            if typeof(connection) == "RBXScriptConnection" then
                connection:Disconnect()
                MidgardUntrackGlobalConnection(connection)
            end
        end
        table.clear(group)
        Shared.Connections[groupName] = nil
    elseif typeof(group) == "RBXScriptConnection" then
        group:Disconnect()
        MidgardUntrackGlobalConnection(group)
        Shared.Connections[groupName] = nil
    end
end

function Shared.ConnectSignalGroup(groupName, signal, callback)
    if not (type(groupName) == "string" and groupName ~= "" and signal and type(callback) == "function") then
        return nil
    end

    if Library and type(Library.ConnectSignalGroup) == "function" then
        local connection = Library:ConnectSignalGroup(groupName, signal, callback)
        if not connection then return nil end

        if type(Shared.Connections) ~= "table" then Shared.Connections = {} end
        if type(Shared.Connections[groupName]) ~= "table" then Shared.Connections[groupName] = {} end
        table.insert(Shared.Connections[groupName], connection)
        return connection
    end

    if type(Shared.Connections) ~= "table" then Shared.Connections = {} end
    if type(Shared.Connections[groupName]) ~= "table" then Shared.Connections[groupName] = {} end

    local signalName = Shared.GetDebugName(signal)
    local connection = MidgardTrackGlobalConnection(signal:Connect(function(...)
        local ok, err = Shared.ExecuteProtectedCallback("Signal:" .. tostring(groupName) .. ":" .. tostring(signalName), callback, ...)
        if not ok then
            Shared.WarnThrottled(
                "SignalHandlerError:" .. tostring(groupName) .. ":" .. tostring(signalName),
                2,
                "[Midgard] Signal handler error [" .. tostring(groupName) .. " | " .. tostring(signalName) .. "]: " .. tostring(err)
            )
        end
    end))

    table.insert(Shared.Connections[groupName], connection)
    return connection
end

function Shared.HttpRequest(options)
    local requestFn = HttpRequestFn
    if type(requestFn) ~= "function" then
        requestFn = RuntimeRefInfra.GetSafeHttpRequestFunction()
        HttpRequestFn = requestFn
    end
    if type(requestFn) ~= "function" then
        return false, "Missing HTTP request function"
    end
    return pcall(requestFn, options)
end

-- Perform Unload
function Shared.PerformUnload()
    if Shared._Unloading then return end
    Shared._Unloading = true

    local function unloadStep(label, callback)
        local ok, err = pcall(callback)
        if not ok then
            warn("[Midgard:Unload] " .. tostring(label) .. ": " .. tostring(err))
        end
        return ok
    end

    GlobalEnv[BootstrapStateInfra.RunningKey] = false
    GlobalEnv[BootstrapStateInfra.BootingKey] = nil
    if GlobalEnv[BootstrapStateInfra.RuntimeTokenKey] == MidgardRuntimeToken then
        GlobalEnv[BootstrapStateInfra.RuntimeTokenKey] = nil
    end
    GlobalEnv.Midgard_Library = nil

    unloadStep("DestroyAllNamedTaskLoops", function()
        Shared.DestroyAllNamedTaskLoops()
    end)

    unloadStep("Connections", function()
        local connections = Shared.Connections
        if type(connections) ~= "table" then return end
        local keys = {}
        for key in pairs(connections) do keys[#keys + 1] = key end
        for _, key in ipairs(keys) do
            local value = connections[key]
            if typeof(value) == "RBXScriptConnection" then
                value:Disconnect()
                MidgardUntrackGlobalConnection(value)
                connections[key] = nil
            elseif typeof(value) == "thread" then
                pcall(task.cancel, value)
                connections[key] = nil
            elseif type(value) == "table" then
                for subKey, subValue in pairs(value) do
                    if typeof(subValue) == "RBXScriptConnection" then
                        subValue:Disconnect()
                        MidgardUntrackGlobalConnection(subValue)
                    elseif typeof(subValue) == "thread" then
                        pcall(task.cancel, subValue)
                    end
                end
                table.clear(value)
                connections[key] = nil
            end
        end
    end)

    unloadStep("GlobalConnections", function()
        if type(GlobalEnv.Midgard_DisconnectGlobalConnections) == "function" then
            GlobalEnv.Midgard_DisconnectGlobalConnections()
        end
    end)

    unloadStep("AtmosphereState", function()
        if type(Shared._RestoreAtmosphereState) == "function" then
            Shared._RestoreAtmosphereState()
            Shared._RestoreAtmosphereState = nil
        end
    end)

    unloadStep("LibraryRuntime", function()
        if Library and type(Library.StopAntiAFK) == "function" then
            Library:StopAntiAFK()
        end
        if Library and type(Library.StopPauseBypass) == "function" then
            Library:StopPauseBypass()
        end
    end)

    unloadStep("VoxCoreDestroy", function() if Shared.VoxCore and Shared.VoxCore.Destroy then Shared.VoxCore.Destroy() end end)
    GlobalEnv._MIDGARD_UI_LOADED = nil
    GlobalEnv.Midgard_Unload = nil

    if Library and Library.Unloaded ~= true then
        unloadStep("LibraryUnload", function()
            Library:Unload()
        end)
    end
end

GlobalEnv.Midgard_Unload = function()
    Shared.PerformUnload()
end

