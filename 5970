function GameClient.ApplySecretAchievements(on)
    if not on then
        debugLog("secret_debug.txt", ("STOP_REQUEST user=true prevMode=%s campfire=%s"):format(
            tostring(GameClient.CollectibleMode), tostring(GameClient.CampfireActive)
        ))
        CFG.AutoSecretAchievements = false
        GameClient.CampfireActive = false
        if GameClient.CollectibleMode == "Secret" then
            GameClient.CollectibleMode = nil
            GameClient.CollectibleToken += 1
            GameClient.CollectibleRequested = false
            cancelTween()
        end
        if not (CFG.MainModeActive or CFG.AutoVoxTraining or CFG.AutoCollectibles) then
            Status = "Parado"
        end
        if Shared.RefreshToggles then Shared.RefreshToggles() end
        return
    end
    local selected = CFG.SecretAchievements or {}
    local hasSelection, wantsTrophies = false, false
    local selectedKeys = {}
    for k, v in pairs(selected) do
        if v then
            hasSelection = true
            table.insert(selectedKeys, tostring(k))
            if k ~= "CampfireDeath" then
                wantsTrophies = true
            end
        end
    end
    table.sort(selectedKeys)
    debugLog("secret_debug.txt", ("=== SECRET_START lv=%d selected=[%s] wantsTrophies=%s campfire=%s ==="):format(
        getLevel(), table.concat(selectedKeys, ", "), tostring(wantsTrophies), tostring(selected.CampfireDeath == true)
    ), true)
    if not hasSelection then
        debugLog("secret_debug.txt", "ABORT no_selection=true")
        CFG.AutoSecretAchievements = false
        if Shared.RefreshToggles then Shared.RefreshToggles() end
        task.defer(function() if Shared.RefreshToggles then Shared.RefreshToggles() end end)
        notify("Secretas", "Selecione pelo menos uma conquista secreta.")
        return
    end
    if wantsTrophies then
        debugLog("secret_debug.txt", "DISPATCH mode=trophies")
        GameClient.ApplyCollectibles(true, false, "Secret")
    elseif selected.CampfireDeath then
        debugLog("secret_debug.txt", "DISPATCH mode=campfire_only")
        CFG.MainModeActive = false
        Features.StopAllMainModes(true)
        CFG.AutoSecretAchievements = true
        if Shared.RefreshToggles then Shared.RefreshToggles() end
        GameClient.RunCampfireSecret()
    end
end

function Features.ApplyMainMode(on)
    Features.StopAllMainModes(true)
    if on then
        CFG.AutoFish = false
        if Shared.RefreshToggles then Shared.RefreshToggles() end
        if State.bossBusy or State.islandBossBusy or State.seaBeastBusy or State.fortRaidBusy then return end
        local m = CFG.MainMode
        if m == "FarmLevel" then
            CFG.AutoFarm = true
            Combat.FarmLoop()
        elseif m == "History" then
            CFG.AutoHistory = true
            Features.StoryLoop("History")
        elseif m == "Secondary" then
            CFG.AutoSecondary = true
            Features.StoryLoop("Secondary")
        elseif m == "DarkStep" then
            CFG.AutoDarkStep = true
            GameClient.fightingStyleLoop()
        elseif m == "WaterKungFu" then
            CFG.AutoWaterKungFu = true
            GameClient.fightingStyleLoop()
        elseif m == "Eletric" then
            CFG.AutoEletric = true
            GameClient.fightingStyleLoop()
        end
        if GameClient.EnsureUtilityLoop then GameClient.EnsureUtilityLoop() end
    else
        Status = "Parado"
        if Shared.RefreshToggles then Shared.RefreshToggles() end
    end
end
Features.ResumeMainMode = function()
    if CFG.MainModeActive and not State.bossBusy and not State.islandBossBusy and not State.seaBeastBusy and not State.fortRaidBusy then
        Features.ApplyMainMode(true)
    end
end

