                                or (CFG.AutoFortRaid and GameClient.FortRaidEnemyAlive(currentTarget))
                                or (CFG.AutoRaid and currentTarget.Parent and currentTarget:GetAttribute("Dead") ~= true)
                                or baseName(currentTarget):find("Sea Beast")
                            )
                            if currentTarget and currentTarget.Parent and currentTarget:GetAttribute("Dead") ~= true and targetAlive then
                                local trp = currentTarget:FindFirstChild("HumanoidRootPart") or currentTarget.PrimaryPart
                                local isSB = baseName(currentTarget):find("Sea Beast") ~= nil
                                local maxD = isSB and math.max(CFG.KillAuraRadius, 65) or (CFG.AutoRaid and math.max(CFG.KillAuraRadius, 35) or CFG.KillAuraRadius)
                                local dSB = trp and (trp.Position - hrp.Position).Magnitude or 9999
                                if trp and dSB <= maxD then
                                    candidates[1] = { m = currentTarget, d = -1 } -- prioridade absoluta no alvo atual
                                    hasMain = true
                                    mainDist = dSB
                                    if isSB then sbDistLog = dSB end
                                elseif isSB and trp then
                                    sbDistLog = -dSB
                                end
                            end
                            for _, m in ipairs(folder:GetChildren()) do
                                if m ~= currentTarget and m:IsA("Model") and mobAlive(m) and (not State.BadTargets[m] or now >= State.BadTargets[m]) then
                                    local mrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                                    if mrp then
                                        local d = (mrp.Position - hrp.Position).Magnitude
                                        if d <= CFG.KillAuraRadius then
                                            candidates[#candidates + 1] = { m = m, d = d }
                                        end
                                    end
                                end
                            end
                            if #candidates > 0 then
                                if #candidates > 1 then
                                    table.sort(candidates, function(a, b) return a.d < b.d end)
                                end
                                local hits = Combat.kaHits
                                table.clear(hits)
                                for i = 1, math.min(#candidates, 8) do
                                    hits[i] = candidates[i].m
                                end
                                -- usa apenas Combo 1..3 para evitar o 4º golpe (Final) que aplica knockback/launch no NPC
                                Combat.auraCombo = (Combat.auraCombo % 3) + 1
                                local ct = workspace:GetServerTimeNow()
                                pcall(function()
                                    if GameModules.TimeSync and GameModules.TimeSync.Get then
                                        ct = GameModules.TimeSync:Get()
                                    end
                                end)
                                pcall(function()
                                    GameModules.Network:FireServer("CombatTools", "ActivatedEffects", {
                                        Class = "Default",
                                        Action = "Activated",
                                        ComboType = "Default",
                                        Combo = Combat.auraCombo,
                                        CallTime = ct,
                                        DelayTime = 0
                                    })
                                    GameModules.Network:FireServer("CombatTools", "DefaultCombo", {
                                        Results = hits,
                                        Combo = Combat.auraCombo,
                                        CallTime = ct,
                                        DelayTime = 0.1
                                    })
                                end)
                                do
                                    local firstT = hits[1]
                                    local fTrp = firstT and (firstT:FindFirstChild("HumanoidRootPart") or firstT.PrimaryPart)
                                    local dHit = fTrp and (fTrp.Position - hrp.Position).Magnitude or (mainDist or -1)
                                    local hpNow = firstT and mobHP(firstT) or 0
                                    logKA(("KA_HIT target=%s d=%.1f hits=%d hp=%.0f combo=%d tool=%s auraR=%d trp=(%.0f,%.0f,%.0f) hrp=(%.0f,%.0f,%.0f)"):format(
                                        tostring(firstT and firstT.Name), dHit, #hits, hpNow, Combat.auraCombo, tostring(equipped.Name), CFG.KillAuraRadius,
                                        fTrp and fTrp.Position.X or 0, fTrp and fTrp.Position.Y or 0, fTrp and fTrp.Position.Z or 0,
                                        hrp.Position.X, hrp.Position.Y, hrp.Position.Z
                                    ))
                                end
                                if sbDistLog then
                                    local hpNow = mobHP(currentTarget)
                                    debugLog("seabeast_debug.txt", ("KA_FIRE d=%.1f hp=%.0f combo=%d tool=%s"):format(sbDistLog, hpNow, Combat.auraCombo, tostring(equipped.Name)))
                                end
                                table.clear(candidates)
                                table.clear(hits)
                                task.wait(math.max(0.12, CFG.M1Interval))
                                continue
                            end
                            table.clear(candidates)
                        end
                    end
                end
            end
            RunService.Heartbeat:Wait()
        end
        end)
        if State.Tokens.KillAura == myTok then
            State.KillAuraRunning = false
        end
    end)
end

do
local SKILL_ORDER = { "Z", "X", "C", "V", "F", "G" }
local lastSkillKey = nil
local skillNext = {}
local skillAimTarget, skillAimUntil = nil, 0
local skillsClient, skillsRegistry, desktopSkillsMod, mobileSkillsMod, castingClient

pcall(function()
    local ps = require(ReplicatedStorage.Modules.Essentials.PlayerSystem)
    local fnTbl = ps and ps.IsClient and ps.IsClient.Utils and ps.IsClient.Utils.Functions
    if fnTbl and type(fnTbl.Mouse) == "function" then
