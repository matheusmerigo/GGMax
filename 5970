local function findNpcNear(centerPos, maxRadius)
    if not centerPos then return nil end
    maxRadius = maxRadius or 120
    local bestPos, bestDist = nil, maxRadius
    local chars = playability("Characters")
    if chars then
        for _, m in ipairs(chars:GetChildren()) do
            -- Ignora jogadores reais! Só considera NPCs (que não pertencem a nenhum Player)
            if m:IsA("Model") and m ~= LP.Character and not Services.Players:GetPlayerFromCharacter(m) then
                local r = m:FindFirstChild("HumanoidRootPart")
                local p = r and r.Position or (m:GetPivot().Position)
                local d = (p - centerPos).Magnitude
                if d < bestDist then
                    bestPos, bestDist = p, d
                end
            end
        end
    end
    return bestPos
end

local function disableQuestTrailMarkers()
    pcall(function()
        local ipFolder = workspace:FindFirstChild("IgnoreList")
            and workspace.IgnoreList:FindFirstChild("Data")
            and workspace.IgnoreList.Data:FindFirstChild("Quests")
            and workspace.IgnoreList.Data.Quests:FindFirstChild("InterestPoints")
        if not ipFolder then return end
        for _, d in ipairs(ipFolder:GetDescendants()) do
            if d:IsA("BasePart") then
                local tr = d:GetAttribute("Trail")
                if tr ~= nil then
                    d:SetAttribute("_SavedTrail", tr)
                    d:SetAttribute("Trail", nil)
                end
            end
        end
    end)
end

