GenericInfra.Bootstrap.ResetPreviousRuntime = function()
    local unloadFn = PreviousRuntimeState.Unload
    if type(unloadFn) == "function" then
        local ok, err = pcall(unloadFn)
        if not ok then
            warn("[Midgard] Previous runtime unload failed: " .. tostring(err))
        end
    else
        local previousLibrary = PreviousRuntimeState.Library
        if type(previousLibrary) == "table" and previousLibrary.Unloaded ~= true and type(previousLibrary.Unload) == "function" then
            local ok, err = pcall(function()
                previousLibrary:Unload()
            end)
            if not ok then
                warn("[Midgard] Previous library unload failed: " .. tostring(err))
            end
        end
    end

    local okDisconnect, errDisconnect = pcall(MidgardDisconnectGlobalConnections)
    if not okDisconnect then
        warn("[Midgard] Global connection cleanup failed: " .. tostring(errDisconnect))
    end
    GlobalEnv[BootstrapStateInfra.RunningKey] = false
    GlobalEnv[BootstrapStateInfra.BootingKey] = nil
    GlobalEnv[BootstrapStateInfra.RuntimeTokenKey] = nil
    if GlobalEnv.Midgard_Library == PreviousRuntimeState.Library then
        GlobalEnv.Midgard_Library = nil
    end
    if GlobalEnv.Midgard_Unload == PreviousRuntimeState.Unload then
        GlobalEnv.Midgard_Unload = nil
    end
end

