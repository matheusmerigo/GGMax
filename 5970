GameClient.RaidToken = 0
GameClient.RaidBossOptions = {}
GameClient.BossRoomsUtils = nil
GameClient.BossRoomsFight = nil
pcall(function()
    local br = ReplicatedStorage.Modules.Combat.BossSystem["BossSystem Client"].BossRooms
    GameClient.BossRoomsUtils = require(br.BossRoomsMenu.Utils)
    GameClient.BossRoomsFight = require(br.Fight)
end)

function GameClient.RefreshRaidBossOptions()
    GameClient.RaidBossOptions = {}
    local settings = MainModules and MainModules.BossRoomsSettings
    for bossName, roomInfo in pairs(settings and settings.Rooms or {}) do
        if roomInfo.Disabled ~= true and settings.IsEnabled(bossName, LP) then
            table.insert(GameClient.RaidBossOptions, { bossName, bossName })
        end
    end
    table.sort(GameClient.RaidBossOptions, function(a, b) return a[1] < b[1] end)
    return GameClient.RaidBossOptions
end

function GameClient.GetRaidIsland(bossName)
    local settings = MainModules and MainModules.BossRoomsSettings
    local room = settings and settings.Rooms and settings.Rooms[bossName]
    if type(room) == "table" then
        local direct = room.Island or room.Area or room.Map
        if type(direct) == "string" and direct ~= "" then return direct end
    end
    local pos = nil
    if type(room) == "table" and type(room.Npc) == "string" and room.Npc ~= "" and GameClient.GetInterestPoint then
        local pt = GameClient.GetInterestPoint("Character_" .. room.Npc)
        local p = pt and GameClient.ValuePosition and GameClient.ValuePosition(pt)
        if typeof(p) == "Vector3" then pos = p end
    end
    if not pos and GameClient.FindRaidKeeper then
        local ok, _, kp = pcall(GameClient.FindRaidKeeper, bossName)
        if ok and typeof(kp) == "Vector3" then pos = kp end
    end
    if not pos and MainModules and MainModules.InterestPoints and MainModules.InterestPoints.Points then
        local bLow = tostring(bossName):lower()
        for key, pt in pairs(MainModules.InterestPoints.Points) do
            if type(key) == "string" and key:lower():find(bLow, 1, true) then
                local p = GameClient.ValuePosition and GameClient.ValuePosition(pt)
                if typeof(p) == "Vector3" then pos = p; break end
            end
        end
    end
    if typeof(pos) == "Vector3" then
        local areasF = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Areas")
        if areasF then
            local bestName, bestD = nil, math.huge
            for _, a in ipairs(areasF:GetChildren()) do
                local mc = a:GetAttribute("MapCenter")
                if typeof(mc) == "Vector3" then
                    local d = (Vector3.new(mc.X, 0, mc.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude
                    if d < bestD then bestD, bestName = d, a.Name end
                end
            end
            if bestName then return bestName end
        end
    end
    return "Other"
end

function GameClient.GetRaidDifficulties()
    local list = {}
    local settings = MainModules and MainModules.BossRoomsSettings
    if settings and type(settings.Difficulties) == "table" then
        for _, d in ipairs(settings.Difficulties) do
            if type(d) == "table" and type(d.Name) == "string" then
                list[#list + 1] = d.Name
            end
        end
    end
    if #list == 0 then
        list = { "Normal", "Medium", "Hard", "Insane", "Nightmare" }
    end
    return list
end

function GameClient.GetRaidKeyAmount(bossName, difficulty)
    local keys = MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo.BossKeys
    local tools = MainModules and MainModules.ToolsUtils
    if not (keys and keys.GetKeyName and tools and tools.GetInventoryAmount) then return 0, nil end
    local keyName = keys.GetKeyName(bossName, difficulty)
    local ok, amount = pcall(tools.GetInventoryAmount, nil, keyName)
    return ok and (tonumber(amount) or 0) or 0, keyName
end

function GameClient.GetRaidPayment(bossName, difficulty)
    if CFG.RaidPayment == "Key" then
        local amount = GameClient.GetRaidKeyAmount(bossName, difficulty)
        return amount > 0 and "Key" or nil
    end
    local settings = MainModules and MainModules.BossRoomsSettings
    local freeAvailable = false
    if settings and getLevel() >= settings.FreeEntry.UnlockLevel then
        local usedAt
        pcall(function() usedAt = MainModules.Registry:Get(nil, settings.FreeEntry.RegistryKey) end)
        freeAvailable = not settings.WasFreeEntryUsedToday(usedAt)
    end
    if CFG.RaidPayment == "Free" then return freeAvailable and "Free" or nil end
    if freeAvailable then return "Free" end
    local amount = GameClient.GetRaidKeyAmount(bossName, difficulty)
    return amount > 0 and "Key" or nil
end

function GameClient.InvokeBossRoom(action, ...)
