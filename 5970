                                else
                                    pcall(function() LP:RequestStreamAroundAsync(destPos) end)
                                    tweenTo(CFrame.new(destPos), aborted)
                                end
                                task.wait(0.8)
                                pos = findNextHeavenstepPos()
                            end
                        end

                        local worldBossName = GameClient.GetWorldBossObjectiveName(obj)
                        if worldBossName then
                            local liveModel, beaconPos, respawnAt = GameClient.GetWorldBossLiveState(worldBossName)
                            if not liveModel and not beaconPos then
                                local dispName = worldBossName
                                pcall(function()
                                    local ei = MainModules and MainModules.EnemysInfo and MainModules.EnemysInfo[worldBossName]
                                    local altN = ei and ei.EnemyArguments and ei.EnemyArguments.AlternativeName
                                    if type(altN) == "string" and altN ~= "" then dispName = altN end
                                end)
                                if type(respawnAt) == "number" then
                                    local rem = math.max(0, math.ceil(respawnAt - workspace:GetServerTimeNow()))
                                    Status = ("%s: aguardando %s (%d:%02d)..."):format(label, dispName, math.floor(rem / 60), rem % 60)
