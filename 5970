Features.ResumeAfterInterrupt = function(snap)
    if not snap then return end
    if (snap.boss and CFG.AutoBoss) or (snap.boardBoss and CFG.AutoBoardBoss) then
        GameClient.BossLoop()
    end
    if snap.iboss and CFG.AutoIslandBoss then
        GameClient.IslandBossLoop()
    end
    if snap.sb and CFG.AutoSeaBeast and Features.SeaBeastLoop then
        Features.SeaBeastLoop()
    end
    if snap.fort and CFG.AutoFortRaid then
        GameClient.StartFortRaidLoop()
    end
    if snap.main and CFG.MainModeActive and not State.bossBusy and not State.islandBossBusy and not State.seaBeastBusy and not State.fortRaidBusy then
        Features.ApplyMainMode(true)
    elseif snap.vox and CFG.AutoVoxTraining and not State.bossBusy and not State.islandBossBusy and not State.seaBeastBusy and not State.fortRaidBusy then
        Features.StoryLoop("VoxTraining")
    elseif snap.collectibles and CFG.AutoCollectibles and not State.bossBusy and not State.islandBossBusy and not State.seaBeastBusy and not State.fortRaidBusy then
        GameClient.ApplyCollectibles(true, true, "All")
    elseif snap.secret and CFG.AutoSecretAchievements and not State.bossBusy and not State.islandBossBusy and not State.seaBeastBusy and not State.fortRaidBusy then
        if snap.collectibleReq then
            GameClient.ApplyCollectibles(true, true, "Secret")
        else
            GameClient.RunCampfireSecret()
        end
    elseif snap.mob and CFG.AutoMob and not State.bossBusy and not State.islandBossBusy and not State.seaBeastBusy and not State.fortRaidBusy then
        Features.MissionLoop()
    elseif not (CFG.AutoBoss or CFG.AutoIslandBoss or CFG.AutoSeaBeast or CFG.AutoFortRaid or CFG.MainModeActive or CFG.AutoVoxTraining or CFG.AutoCollectibles or CFG.AutoSecretAchievements or CFG.AutoMob or CFG.AutoRaid) then
        Status = "Parado"
    end
end

-- Respawn e encerramento
function Features.HookDeath(char)
    for _, c in ipairs(State.DeathConns) do pcall(function() c:Disconnect() end) end
    table.clear(State.DeathConns)
    if not char then return end
    task.spawn(function()
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
        if hum and LP.Character == char then
            local downed = false
            local reviveToken = 0
            local cDied = SafeRuntime.Once(hum.Died, "HumDied", function()
                downed = true
                reviveToken += 1
                State.isRespawning = true
                attackGoal = nil
                currentTarget = nil
                cancelTween()
                Status = "Morreu, aguardando renascer..."
            end)
            table.insert(State.DeathConns, cDied)
            -- Morte "customizada" do jogo: a vida vai a 0 e o MESMO personagem é revivido/teleportado (sem CharacterAdded)
            local cHp = SafeRuntime.Connect(hum.HealthChanged, "HumHealthChanged", function(hp)
                if hp <= 0 then
                    if not downed then
                        downed = true
                        reviveToken += 1
                        State.isRespawning = true
                        attackGoal = nil
                        currentTarget = nil
                        cancelTween()
                        Status = "Morreu, aguardando renascer..."
                        if CFG.AutoSeaBeast then
                            debugLog("seabeast_debug.txt", "DEATH_DETECTED (HealthChanged=0)")
                        end
                    end
                elseif downed and LP.Character == char and hum:GetState() ~= Enum.HumanoidStateType.Dead and hum.MaxHealth > 0 and hp >= hum.MaxHealth * 0.5 then
                    downed = false
                    reviveToken += 1
                    local myRev = reviveToken
                    State.respawnReadyAt = os.clock() + 3
                    Status = "Renasceu, aguardando 3s..."
                    if CFG.AutoSeaBeast then
                        debugLog("seabeast_debug.txt", ("REVIVE_DETECTED hp=%.0f/%.0f (aguardando 3s)"):format(hp, hum.MaxHealth))
                    end
                    task.delay(3, function()
                        if LP.Character == char and reviveToken == myRev and not downed then
                            State.isRespawning = false
                        end
                    end)
                end
            end)
            table.insert(State.DeathConns, cHp)
        end
    end)
end

if LP.Character then
