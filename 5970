                            local isChestQuest = (oid == "Find_TreasureX" or oid == "Talk_OrangeTownTrainer_Treasure")
                            local hasChest = LP.Character and LP.Character:GetAttribute("CarriedChest") ~= nil
                            -- 1) ANTES de pegar/escavar o baú: já coloca o barco na água aberta perto da ilha (com ferramentas destravadas!)
                            if isChestQuest and not hasChest then
