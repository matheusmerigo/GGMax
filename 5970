    local function LoadRequired(name, url)
        local maxAttempts = 3
        local lastReason = nil

        for attempt = 1, maxAttempts do
            local httpOk, source = pcall(game.HttpGet, game, url)
            if httpOk and type(source) == "string" then
                local loadOk, result = pcall(tryLoadSource, name, source)
                if loadOk and result ~= nil then
                    return result
                end
                lastReason = loadOk and (name .. " returned nil") or tostring(result)
            else
                lastReason = tostring(source)
            end

            if attempt < maxAttempts then
                task.wait(1.5)
            end
        end

        error(("[Midgard] Failed to load %s from repo after %d attempts: %s | reason: %s"):format(
            tostring(name),
            tostring(url),
            tostring(lastReason)
        ))
    end

    Library = LoadRequired("Library", libraryUrl .. cacheBust)
    SaveManager = LoadRequired("SaveManager", saveManagerUrl .. cacheBust)
end

