function GameClient.EnsureBankOpen(aborted, logBank)
    local menu = GameClient.GetBankMenu()
    if not menu then return false, "bank_module_missing" end
    if menu.Opened then return true end
    local anchor = GameClient.GetBankAnchor()
    if not anchor then return false, "banker_anchor_missing" end
    local _, hrp0 = getChar()
    logBank(("BANK_TRAVEL_START anchor=(%.1f,%.1f,%.1f) myPos=%s dist=%.1f"):format(
        anchor.Position.X, anchor.Position.Y, anchor.Position.Z,
        hrp0 and ("(%.1f,%.1f,%.1f)"):format(hrp0.Position.X, hrp0.Position.Y, hrp0.Position.Z) or "nil",
        hrp0 and (hrp0.Position - anchor.Position).Magnitude or -1
    ))
    Status = "Banco: indo ao Banker..."
    task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(anchor.Position) end) end)
    goNear((anchor * CFrame.new(0, 2, 4)).Position, aborted, { noMirror = false })
    if aborted and aborted() then return false, "aborted" end

    local _, hrpNow = getChar()
    if hrpNow and (hrpNow.Position - anchor.Position).Magnitude > 12 and math.abs(hrpNow.Position.Y - anchor.Position.Y) < 100 then
        tweenTo(anchor * CFrame.new(0, 2, 4), aborted)
        _, hrpNow = getChar()
    end

    local canOpen = true
    pcall(function()
        local ifs = require(ReplicatedStorage.Modules.Essentials.InterfaceSystem).IsClient
        if ifs and ifs.MenusHandler then
            if not ifs.MenusHandler:CanOpen() then
                ifs.MenusHandler:Close(true)
                task.wait(0.25)
            end
            canOpen = ifs.MenusHandler:CanOpen()
        end
    end)

    local distNow = hrpNow and (hrpNow.Position - anchor.Position).Magnitude or -1
    logBank(("BANK_OPEN_REQUEST dist=%.1f canOpen=%s myPos=%s"):format(
        distNow, tostring(canOpen),
        hrpNow and ("(%.1f,%.1f,%.1f)"):format(hrpNow.Position.X, hrpNow.Position.Y, hrpNow.Position.Z) or "nil"
    ))
    pcall(menu.RequestOpen)
    local deadline = os.clock() + 12
    local retriedConverse = false
    while os.clock() < deadline and not menu.Opened do
        if aborted and aborted() then return false, "aborted" end
        if not retriedConverse and os.clock() > deadline - 9.5 then
            retriedConverse = true
            logBank("BANK_OPEN_RETRY_CONVERSE")
            if Movement.BeginInteract and not Movement.BeginInteract(aborted) then return false, "aborted" end
            pcall(function() GameModules.Network:FireServer("Elysium_Converse", "Banker") end)
            task.wait(0.25)
            pcall(menu.RequestOpen)
        end
        task.wait(0.15)
    end
    if not menu.Opened then
        logBank(("BANK_OPEN_TIMEOUT dist=%.1f canOpen=%s"):format(distNow, tostring(canOpen)))
    else
        logBank("BANK_OPENED")
    end
    return menu.Opened == true, menu.Opened and "opened" or "open_timeout"
end

function GameClient.CloseBank()
    local menu = GameClient.GetBankMenu()
    if menu and menu.Opened then pcall(menu.RequestClose) end
end

