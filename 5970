local function getAreasFolder()
    local mp = workspace:FindFirstChild("Map")
    return (mp and mp:FindFirstChild("Areas")) or workspace:FindFirstChild("Areas")
end

GameClient.ISLAND_LEVEL_ALIASES = {
    ["marine ford"] = "MarineFord",
    ["bastion reach"] = "MarineFord",
    ["kraken's rest"] = "Kraken's rest",
}

function GameClient.GetIslandLevel(name)
    if type(name) ~= "string" or name == "" then return nil end
    local low = name:lower()
    local canonical = GameClient.ISLAND_LEVEL_ALIASES[low] or name
    local af = getAreasFolder()
    if af then
        local area = af:FindFirstChild(name) or (canonical ~= name and af:FindFirstChild(canonical)) or nil
        if not area then
            for _, child in ipairs(af:GetChildren()) do
                local cName = type(child.Name) == "string" and child.Name:lower() or ""
                local disp = child:GetAttribute("DisplayName")
                local dLow = type(disp) == "string" and disp:lower() or ""
                if cName == low or dLow == low then
                    area = child
                    break
                end
            end
        end
        if area then
            local lv = tonumber(area:GetAttribute("Level"))
            if lv then return lv end
        end
    end
    local mByIsl = State and State.Mobs and State.Mobs.MissionsByIsland
    if type(mByIsl) == "table" then
        local mList = mByIsl[name] or (canonical ~= name and mByIsl[canonical]) or nil
        if not mList then
            for k, v in pairs(mByIsl) do
                if type(k) == "string" and k:lower() == low then
                    mList = v
                    break
                end
            end
        end
        if type(mList) == "table" and mList[1] and type(mList[1].minLv) == "number" then
            return mList[1].minLv
        end
    end
    return nil
end

function GameClient.SortIslandsByLevel(list)
    if type(list) ~= "table" or #list <= 1 then return list end
    local lvCache = {}
    for _, item in ipairs(list) do
        local key = tostring(item or "")
        if lvCache[key] == nil then
            local lv = GameClient.GetIslandLevel(key)
            lvCache[key] = lv ~= nil and lv or false
        end
    end
    table.sort(list, function(a, b)
        local sa, sb = tostring(a or ""), tostring(b or "")
        local oa, ob = (sa == "Other"), (sb == "Other")
        if oa ~= ob then return not oa end
        local la, lb = lvCache[sa], lvCache[sb]
        local hasA, hasB = (type(la) == "number"), (type(lb) == "number")
        if hasA and hasB then
            if la ~= lb then return la < lb end
            return sa < sb
        end
        if hasA ~= hasB then return hasA end
        return sa < sb
    end)
    return list
end

function GameClient.GetIslandNames()
    local list, seen = {}, {}
    local af = getAreasFolder()
    if af then
        for _, area in ipairs(af:GetChildren()) do
            if type(area.Name) == "string" and area.Name ~= "" and not seen[area.Name] then
                seen[area.Name] = true
                list[#list + 1] = area.Name
            end
        end
    end
    return GameClient.SortIslandsByLevel(list)
end

function GameClient.GetIslandPosition(name)
    if type(name) ~= "string" or name == "" then return nil end
    local af = getAreasFolder()
    local area = af and af:FindFirstChild(name)
    if not area then return nil end
    local center = area:GetAttribute("MapCenter")
    if typeof(center) == "Vector3" then
        local alt = tonumber(area:GetAttribute("MapAltitude")) or 14
        return center + Vector3.new(0, alt, 0)
    end
    if area:IsA("BasePart") then return area.Position + Vector3.new(0, 14, 0) end
    if area:IsA("Model") then return area:GetPivot().Position + Vector3.new(0, 14, 0) end
    local part = area:FindFirstChildWhichIsA("BasePart", true)
    return part and (part.Position + Vector3.new(0, 14, 0)) or nil
end

