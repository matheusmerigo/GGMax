-- Nível, ilhas e inimigos
function Features.InitMobCatalog()
    local mobs = State.Mobs
    table.clear(mobs.MissionIslands)
    table.clear(mobs.MissionsByIsland)
    table.clear(mobs.MissionsByName)
    local shared = ReplicatedStorage:FindFirstChild("Shared")
    local mmFolder = shared and shared:FindFirstChild("MainModules")
    local eGrind = mmFolder and mmFolder:FindFirstChild("EnemysUtils") and mmFolder.EnemysUtils:FindFirstChild("EnemysInfo") and mmFolder.EnemysUtils.EnemysInfo:FindFirstChild("Grinding")
    if eGrind then
        for _, islFolder in ipairs(eGrind:GetChildren()) do
            for _, eMod in ipairs(islFolder:GetChildren()) do
                if eMod:IsA("ModuleScript") then
                    local ok, info = pcall(require, eMod)
                    local lv = ok and type(info) == "table" and info.EnemyArguments and info.EnemyArguments.Level
                    if type(lv) == "number" then
                        mobs.Levels[eMod.Name] = lv
                        mobs.Islands[eMod.Name] = islFolder.Name
                    end
                end
            end
        end
    end

    local qGrind = mmFolder and mmFolder:FindFirstChild("ProgressUtils") and mmFolder.ProgressUtils:FindFirstChild("QuestsInfo") and mmFolder.ProgressUtils.QuestsInfo:FindFirstChild("Grinding")
    if qGrind then
        for _, islFolder in ipairs(qGrind:GetChildren()) do
            for _, qMod in ipairs(islFolder:GetChildren()) do
                if qMod:IsA("ModuleScript") then
                    local ok, qInfo = pcall(require, qMod)
                    if ok and type(qInfo) == "table" and qInfo.GrindingQuest and type(qInfo.SubQuests) == "table" then
                        local objMobs, seenObj = {}, {}
                        local sq1 = qInfo.SubQuests[1]
                        if sq1 and type(sq1.Objectives) == "table" then
                            for _, obj in ipairs(sq1.Objectives) do
                                if type(obj) == "table" then
                                    local oName = (type(obj.ObjectiveID) == "string" and obj.ObjectiveID:gsub("^Defeat_", "")) or obj.DisplayName or obj.Name
                                    if type(oName) == "string" and oName ~= "" and not seenObj[oName] then
                                        seenObj[oName] = true
                                        table.insert(objMobs, oName)
                                    end
                                end
                            end
                        end
                        if #objMobs > 0 and type(qInfo.Arguments) == "table" and type(qInfo.Arguments.Giver) == "string" and not qInfo.Arguments.IsBoss then
                            if not mobs.MissionsByName[qMod.Name] then
                                local minLv = tonumber(qInfo.MinLevel) or 1
                                local rawTitle = (type(qInfo.Title) == "string" and qInfo.Title ~= "" and qInfo.Title)
                                    or (type(qInfo.Name) == "string" and qInfo.Name ~= "" and qInfo.Name)
                                    or qMod.Name
                                local entry = {
                                    name = qMod.Name,
                                    title = rawTitle,
                                    label = string.format("[Lv %d] %s", minLv, rawTitle),
                                    minLv = minLv,
                                    island = islFolder.Name,
                                    info = qInfo,
                                    mobs = objMobs,
                                }
                                mobs.MissionsByName[qMod.Name] = entry
                                mobs.MissionsByIsland[islFolder.Name] = mobs.MissionsByIsland[islFolder.Name] or {}
                                table.insert(mobs.MissionsByIsland[islFolder.Name], entry)
                            end
                        end
                        for _, sq in ipairs(qInfo.SubQuests) do
                            if type(sq.Objectives) == "table" then
                                for _, obj in ipairs(sq.Objectives) do
                                    local mobName = type(obj) == "table" and (obj.DisplayName or obj.Name or (type(obj.ObjectiveID) == "string" and obj.ObjectiveID:match("^Defeat_(.+)$")))
                                    if type(mobName) == "string" and mobName ~= "" then
                                        local jesterAlias = mobName:match("^Bugg ") and ("Jester " .. mobName:sub(6)) or nil
                                        local displayMob = (jesterAlias and mobs.Levels[jesterAlias]) and jesterAlias or mobName
                                        mobs.RealGrinding[displayMob] = true
                                        mobs.Islands[displayMob] = islFolder.Name
                                        mobs.Quests[displayMob] = mobs.Quests[displayMob] or { name = qMod.Name, info = qInfo }
                                        if not mobs.Levels[displayMob] and type(qInfo.MinLevel) == "number" then
                                            mobs.Levels[displayMob] = qInfo.MinLevel
                                        end
                                        if displayMob ~= mobName then
                                            mobs.Levels[mobName] = mobs.Levels[displayMob]
                                            mobs.Islands[mobName] = islFolder.Name
                                            mobs.Quests[mobName] = mobs.Quests[displayMob]
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    local islandSort = {}
    for islName, list in pairs(mobs.MissionsByIsland) do
        if #list > 0 then
            table.sort(list, function(a, b)
                if a.minLv ~= b.minLv then return a.minLv < b.minLv end
                if a.title ~= b.title then return a.title < b.title end
                return a.name < b.name
            end)
            local labelCounts = {}
            for _, entry in ipairs(list) do
                labelCounts[entry.label] = (labelCounts[entry.label] or 0) + 1
            end
            for _, entry in ipairs(list) do
                if (labelCounts[entry.label] or 0) > 1 then
                    entry.label = string.format("%s (%s)", entry.label, entry.name)
                end
            end
            table.insert(islandSort, { name = islName, minLv = list[1].minLv })
        end
    end
    table.sort(islandSort, function(a, b)
        if a.minLv ~= b.minLv then return a.minLv < b.minLv end
        return a.name < b.name
    end)
    for _, it in ipairs(islandSort) do
        table.insert(mobs.MissionIslands, it.name)
    end

    local tmp = {}
    for name, _ in pairs(mobs.RealGrinding) do
        local lv = mobs.Levels[name] or 1
        local isl = mobs.Islands[name]
        local label = isl and string.format("[Lv %d] %s - %s", lv, name, isl) or string.format("[Lv %d] %s", lv, name)
        table.insert(tmp, { name = name, lv = lv, label = label })
    end
    table.sort(tmp, function(a, b)
        if a.lv ~= b.lv then return a.lv < b.lv end
        return a.name < b.name
    end)
    for _, item in ipairs(tmp) do
        table.insert(mobs.DropdownList, { item.name, item.label })
    end
end

