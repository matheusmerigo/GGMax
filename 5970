                    local visitKey = (pt and bm.GetVisitKey) and bm.GetVisitKey(pt, nightIdx or 0) or nil
                    if pt and pt.CFrame and visitKey and not visitedNights[visitKey] and next(CFG.BlackMarketTargets or {}) ~= nil then
                        local data = getData()
                        local mon = data and data.Monetization
                        local frag = mon and mon.Fragment or 0
                        local gold = mon and mon.Gold or 0
                        local buyPlan = {}
                        for _, entry in ipairs(GameClient.GetBlackMarketItems()) do
                            local toolName, _, idx, info = entry[1], entry[2], entry[3], entry[4]
                            if CFG.BlackMarketTargets[toolName] then
                                local maxQty = math.clamp(math.floor(tonumber(CFG.BlackMarketAmount) or 1), 1, 10)
                                local owned, maxOwned = 0, 999
                                pcall(function()
                                    local tInfo = MainModules.ToolsInfo:Get(toolName)
                                    if tInfo and MainModules.ToolsUtils then
                                        owned = MainModules.ToolsUtils.GetOwnedAmount(nil, toolName) or 0
                                        maxOwned = MainModules.ToolsUtils.GetMaxOwned(tInfo) or 999
                                    end
                                end)
                                local room = math.max(0, maxOwned - owned)
                                local bal = (info.Currency == "Fragment") and frag or gold
                                local afford = (info.Price > 0) and math.floor(bal / info.Price) or maxQty
                                local qty = math.min(maxQty, room, afford)
                                if qty >= 1 then
                                    table.insert(buyPlan, { idx = idx, name = toolName, qty = qty, cost = qty * (info.Price or 0), currency = info.Currency })
                                    if info.Currency == "Fragment" then frag -= qty * (info.Price or 0) else gold -= qty * (info.Price or 0) end
                                end
                            end
                        end
                        if #buyPlan > 0 then
                            local snap = Features.PauseForInterrupt and Features.PauseForInterrupt() or nil
                            pcall(function()
                                local dest = pt.CFrame.Position + Vector3.new(0, 2, 3)
                                Status = "Black Market: indo comprar..."
                                goNear(dest, function() return not CFG.AutoBlackMarket or State.Tokens.BlackMarket ~= myTok end)
                                local _, hrpNow = getChar()
                                if hrpNow and (hrpNow.Position - dest).Magnitude > 25 then
                                    tweenTo(CFrame.new(dest), function() return not CFG.AutoBlackMarket or State.Tokens.BlackMarket ~= myTok end)
                                    cancelTween()
                                end
                                local bmMenu = require(ReplicatedStorage.Modules.Commerce.ShopSystem["ShopSystem Client"].BlackMarketMenu)
                                pcall(function()
                                    local dlg = GameModules.Converse and GameModules.Converse.IsClient and GameModules.Converse.IsClient:Talk("Black Market Merchant")
                                    if dlg then dlg:End(); dlg:FireServer() end
                                end)
                                local dl = os.clock() + 2.5
                                while os.clock() < dl and not bmMenu.Opened do task.wait(0.1) end
                                if bmMenu.Opened then
                                    for _, b in ipairs(buyPlan) do
                                        if not CFG.AutoBlackMarket or State.Tokens.BlackMarket ~= myTok then break end
                                        pcall(function() GameModules.Network:FireServer("ShopSystem", "Purchase", b.idx, b.qty) end)
                                        notify("Black Market", ("Comprou %dx %s"):format(b.qty, b.name))
                                        task.wait(1.0)
                                    end
                                    if bmMenu.RequestClose then pcall(bmMenu.RequestClose) end
                                    pcall(function() GameModules.Network:FireServer("ShopSystem", "Close") end)
                                    visitedNights[visitKey] = true
                                end
                            end)
                            if Features.ResumeAfterInterrupt and snap then
                                Features.ResumeAfterInterrupt(snap)
                            else
                                Status = "Parado"
                            end
                        end
                    end
                end
            end
            end, function(err) cancelTween() end)
        end)
    end
end

