function GameClient.FindWorldBoss(bossName, maxDist)
    local folder = playability("Enemys")
    if not folder then return nil end
    local enemyKey, altName = bossName, nil
    pcall(function()
        local bi = MainModules and MainModules.BossesInfo and MainModules.BossesInfo.Get and MainModules.BossesInfo.Get(bossName)
        if bi and type(bi.EnemyInfo) == "string" and bi.EnemyInfo ~= "" then
            enemyKey = bi.EnemyInfo
        end
        local ei = MainModules and MainModules.EnemysInfo and (MainModules.EnemysInfo[enemyKey] or MainModules.EnemysInfo[bossName])
        altName = ei and ei.EnemyArguments and ei.EnemyArguments.AlternativeName
    end)
    local _, hrp = getChar()
    local best, bestD = nil, maxDist or math.huge
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and mobAlive(m) then
            local orig = m:GetAttribute("OriginalName") or m.Name
            if orig == bossName or m.Name == bossName or m.Name:sub(1, #bossName + 1) == (bossName .. "_")
                or orig == enemyKey or m.Name == enemyKey or m.Name:sub(1, #enemyKey + 1) == (enemyKey .. "_")
                or (altName and (orig == altName or m.Name == altName or m.Name:sub(1, #altName + 1) == (altName .. "_"))) then
                if not hrp then return m end
                local mrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                local d = mrp and (mrp.Position - hrp.Position).Magnitude or math.huge
                if d <= bestD then
                    best, bestD = m, d
                end
            end
        end
    end
    return best
end
