-- Auto stats, haki, milestones e skills
function Features.InitUtility()
local STAT_ORDER = { "Strength", "Endurance", "Sword", "DevilFruit", "Gun" }

local function autoStats()
    if not (CFG.AutoStats and GameModules and MainModules) then return end
    local data = getData()
    if not (data and data.Statistics) then return end

    local ok, avail = pcall(function()
        local bf = MainModules.BalancingFeatures
        return bf.CalculateStatPoints(data.Statistics.Level, bf:GetDistributedPoints(LP))
    end)
    if not ok or type(avail) ~= "number" or avail < 1 then return end
    avail = math.floor(avail)

    local maxLv = (MainModules.BalancingFeatures and MainModules.BalancingFeatures.MaxLevel) or 9999
    local chosen = {}
    for _, stat in ipairs(STAT_ORDER) do
        if CFG.StatTargets[stat] and (data.Statistics[stat] or 1) < maxLv then
            chosen[#chosen + 1] = stat
        end
    end
    if #chosen == 0 then return end

    local payload, left = {}, avail
    local per = math.floor(avail / #chosen)
    if per > 0 then
        for _, stat in ipairs(chosen) do
            local room = math.max(0, maxLv - (data.Statistics[stat] or 1))
            local add = math.min(left, room, per)
            if add > 0 then
                payload[stat] = add
                left -= add
            end
        end
    end
    if left > 0 then
        for _, stat in ipairs(chosen) do
            local cur = (data.Statistics[stat] or 1) + (payload[stat] or 0)
            local room = math.max(0, maxLv - cur)
            local add = math.min(left, room)
            if add > 0 then
                payload[stat] = (payload[stat] or 0) + add
                left -= add
                if left <= 0 then break end
            end
        end
    end

    if next(payload) then
        pcall(function() GameModules.Network:FireServer("StatisticsData", "UpgradeStats", payload) end)
    end
end

local lastAbilityToggle = {}
local function autoHaki()
    if not ((CFG.AutoVoxArmor or CFG.AutoVoxSense) and GameModules) then return end
    local char, _, hum = getChar()
    if not (char and hum and hum.Health > 0) then return end
    local data = getData()
    local ab = data and data.Abilitys
    if not ab then return end

    local now = os.clock()
    for ability, cfgKey in pairs({ Busoshoku = "AutoVoxArmor", Kenbushoku = "AutoVoxSense" }) do
        if CFG[cfgKey] and (tonumber(ab[ability]) or 0) >= 1 and char:GetAttribute(ability) == nil then
            local waitSec = char:GetAttribute("Break" .. ability) ~= nil and 15 or 4
            if now - (lastAbilityToggle[ability] or 0) >= waitSec then
                lastAbilityToggle[ability] = now
                pcall(function() GameModules.Network:FireServer(ability, "Toggle") end)
            end
        end
    end
end

