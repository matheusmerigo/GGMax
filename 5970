end

function GameClient.StartRaidLoop()
    if not GameClient.BossRoomsUtils then
        CFG.AutoRaid = false
        notify("Raid", "Módulo oficial BossRoomsMenu.Utils não foi encontrado.")
        return
    end
    GameClient.RaidToken += 1
    local token = GameClient.RaidToken
    task.spawn(function()
        debugLog("raid_debug.txt", ("=== RAID START difficulty=%s payment=%s level=%s ==="):format(
            tostring(CFG.RaidDifficulty), tostring(CFG.RaidPayment), tostring(getLevel())
        ), true)
        local raidIndex = 1
        local RAID_INTERVAL = 10
        local nextRaidAt = os.clock() + RAID_INTERVAL
        State.raidInArena = false
        local function aborted()
            return not CFG.AutoRaid or token ~= GameClient.RaidToken
        end
        local function raidLog(msg)
            debugLog("raid_debug.txt", msg)
        end
        local function resolveKeeperPos(settings, bName)
            if type(bName) ~= "string" or bName == "" then return nil, nil end
            local room = settings and settings.Rooms and settings.Rooms[bName]
            local keeperName = room and room.Npc
            local keeperPos = GameClient.BossRoomsUtils and GameClient.BossRoomsUtils.GetNpcPosition(bName)
            keeperPos = keeperPos or (keeperName and giverPos(keeperName))
            return keeperPos, keeperName
        end
        local function identifyArenaBoss(settings, payload)
            local rooms = settings and settings.Rooms
            if type(payload) == "table" and rooms then
                for _, key in ipairs({ "Room", "Boss", "BossName", "Name" }) do
                    local val = payload[key]
                    if type(val) == "string" and rooms[val] then
                        return val
                    end
                end
                for _, val in pairs(payload) do
                    if type(val) == "string" and rooms[val] then
                        return val
                    end
                end
            end
            return nil
        end
        local function findActiveArenaTarget(settings, preferredBoss)
            local seen, list = {}, {}
            local function push(bName)
                if type(bName) == "string" and bName ~= "" and not seen[bName] then
                    seen[bName] = true
                    table.insert(list, bName)
                end
            end
            push(preferredBoss)
            for _, item in ipairs(GameClient.RefreshRaidBossOptions()) do
                if CFG.TargetRaidBosses[item[1]] then push(item[1]) end
            end
            for bName in pairs(settings and settings.Rooms or {}) do
                push(bName)
            end
            for _, bName in ipairs(list) do
                local t = GameClient.FindWorldBoss(bName, 600)
                if t then return t, bName end
            end
            return nil, preferredBoss
        end
        local function fightAndReturn(settings, bossLabel, keeperPos, target)
            local label = bossLabel or "Chefe da Raid"
            if target and not aborted() then
                raidLog(("FIGHT_START boss=%s hp=%s"):format(label, tostring(mobHP(target))))
                Combat.FightTarget(target, function() return aborted() or not mobAlive(target) end, "Raid", { checkStuck = false })
                attackGoal = nil
                currentTarget = nil
                raidLog(("FIGHT_END boss=%s alive=%s"):format(label, tostring(mobAlive(target))))
            else
                raidLog("SPAWN_TIMEOUT boss=" .. label)
            end
            if aborted() then return false end

            Status = "Raid: aguardando retorno da arena..."
            local returnDeadline = os.clock() + 35
            local leaveDist = (settings and settings.LeaveDistance or 100) + 80
            while not aborted() and os.clock() < returnDeadline do
                local _, returnHrp = getChar()
                local payloadNow = GameClient.BossRoomsFight and GameClient.BossRoomsFight.Payload
                local payloadCleared = (not GameClient.BossRoomsFight) or (payloadNow == nil)
                local nearKeeper = (not keeperPos) or (returnHrp and (returnHrp.Position - keeperPos).Magnitude < leaveDist)
                if payloadCleared and nearKeeper then
                    task.wait(1.0)
                    break
                end
                task.wait(0.4)
            end
            State.raidInArena = false
            raidLog("CYCLE_DONE boss=" .. label)
            nextRaidAt = os.clock() + RAID_INTERVAL
            return true
        end
        SafeRuntime.RunResilientLoop("RaidLoop", function() return not aborted() end, function()
        while not aborted() do
            local settings = MainModules and MainModules.BossRoomsSettings
            local activePayload = GameClient.BossRoomsFight and GameClient.BossRoomsFight.Payload
            if activePayload ~= nil then
                State.raidInArena = true
                local activeBoss = identifyArenaBoss(settings, activePayload)
                Status = activeBoss and ("Raid: entrando na luta contra " .. activeBoss) or "Raid: procurando chefe na arena..."
                raidLog("ACTIVE_ARENA_DETECTED boss=" .. tostring(activeBoss))
                local target, foundBoss
                local spawnDeadline = os.clock() + 25
                while not aborted() and os.clock() < spawnDeadline do
                    local payloadNow = GameClient.BossRoomsFight and GameClient.BossRoomsFight.Payload
                    if payloadNow == nil then break end
                    target, foundBoss = findActiveArenaTarget(settings, activeBoss)
                    if target then break end
                    task.wait(0.25)
                end
                if aborted() then break end
                if not target and (not GameClient.BossRoomsFight or GameClient.BossRoomsFight.Payload == nil) then
                    State.raidInArena = false
                    raidLog("ACTIVE_ARENA_EXITED")
                    nextRaidAt = os.clock() + RAID_INTERVAL
                    continue
                end
                local arenaBoss = foundBoss or activeBoss
                local arenaKeeperPos = resolveKeeperPos(settings, arenaBoss)
                fightAndReturn(settings, arenaBoss, arenaKeeperPos, target)
                continue
            end
            State.raidInArena = false

            local difficultyInfo = settings and settings.GetDifficulty(CFG.RaidDifficulty)
            if not difficultyInfo then
                Status = "Raid: dificuldade inválida"
                CFG.AutoRaid = false
                if Shared.RefreshToggles then Shared.RefreshToggles() end
                break
            end
            if getLevel() < difficultyInfo.Level then
                Status = ("Raid: %s exige nível %d"):format(CFG.RaidDifficulty, difficultyInfo.Level)
                notify("Raid", Status)
                CFG.AutoRaid = false
                if Shared.RefreshToggles then Shared.RefreshToggles() end
                break
            end

            local candidates = {}
            for _, item in ipairs(GameClient.RefreshRaidBossOptions()) do
                if CFG.TargetRaidBosses[item[1]] then table.insert(candidates, item[1]) end
            end
            if #candidates == 0 then
                Status = "Raid: selecione pelo menos um chefe"
                task.wait(0.8)
                continue
            end

            local bossName, payment, keyAmount, keyName
            for offset = 0, #candidates - 1 do
                local idx = ((raidIndex - 1 + offset) % #candidates) + 1
                local candidate = candidates[idx]
                local candidatePayment = GameClient.GetRaidPayment(candidate, CFG.RaidDifficulty)
                local amount, candidateKey = GameClient.GetRaidKeyAmount(candidate, CFG.RaidDifficulty)
                if candidatePayment then
                    bossName, payment, keyAmount, keyName = candidate, candidatePayment, amount, candidateKey
                    raidIndex = (idx % #candidates) + 1
                    break
                end
            end
            if not bossName then
                if CFG.AutoCraftRaidKey and CFG.RaidPayment ~= "Free" and #candidates > 0 and GameClient.CraftRaidKeyStep then
                    local handled = GameClient.CraftRaidKeyStep(candidates[1], CFG.RaidDifficulty, aborted, raidLog)
                    if handled then continue end
                end
                Status = (CFG.RaidPayment == "Free") and "Raid: entrada grátis já utilizada hoje" or ("Raid: nenhuma chave %s disponível"):format(CFG.RaidDifficulty)
                raidLog("WAIT_NO_PAYMENT " .. Status)
                task.wait(2)
                continue
            end

            local keeperPos, keeperName = resolveKeeperPos(settings, bossName)
            if not keeperPos then
                Status = "Raid: carregando localização de " .. tostring(keeperName)
                raidLog(("KEEPER_MISSING boss=%s npc=%s"):format(bossName, tostring(keeperName)))
                task.wait(1.5)
                continue
            end

            if os.clock() < nextRaidAt then
                raidLog(("INTERVAL_WAIT remaining=%.1fs"):format(math.max(0, nextRaidAt - os.clock())))
                while not aborted() and os.clock() < nextRaidAt do
                    if not collecting then
                        local remaining = math.max(1, math.ceil(nextRaidAt - os.clock()))
                        Status = ("Raid: aguardando intervalo (%ds)..."):format(remaining)
                    end
                    task.wait(0.25)
                end
                if aborted() then break end
            end

            if collecting then
                raidLog("WAIT_FRUIT_COLLECT_START")
                while collecting and not aborted() do
                    Status = "Raid: aguardando coleta de fruta..."
                    task.wait(0.25)
                end
                raidLog("WAIT_FRUIT_COLLECT_END")
                if aborted() then break end
            end

            local _, raidHrp = getChar()
            if raidHrp and (raidHrp.Position - keeperPos).Magnitude > settings.NpcDistance then
                Status = "Raid: indo até " .. keeperName
                raidLog(("TRAVEL boss=%s keeper=%s pos=%s"):format(bossName, keeperName, tostring(keeperPos)))
                goNear(keeperPos + Vector3.new(0, 2, 3), function() return aborted() or collecting end)
            end
            if cancelTween then pcall(cancelTween) end
            if aborted() then break end
            if collecting then
                raidLog("WAIT_FRUIT_AFTER_TRAVEL")
                while collecting and not aborted() do
                    Status = "Raid: aguardando coleta de fruta..."
                    task.wait(0.25)
                end
                continue
            end
            local _, nearHrp = getChar()
            if not nearHrp or (nearHrp.Position - keeperPos).Magnitude > settings.NpcDistance then
                raidLog(("KEEPER_TOO_FAR boss=%s distance=%s"):format(bossName, tostring(nearHrp and (nearHrp.Position - keeperPos).Magnitude)))
                task.wait(0.8)
                continue
            end

            Status = ("Raid: criando %s (%s, %s)"):format(bossName, CFG.RaidDifficulty, payment == "Key" and "chave" or "grátis")
            raidLog(("CREATE boss=%s difficulty=%s payment=%s key=%s amount=%s"):format(
                bossName, CFG.RaidDifficulty, payment, tostring(keyName), tostring(keyAmount)
            ))
            local createResult, createDetail = GameClient.InvokeBossRoom("CreateRoom", bossName, CFG.RaidDifficulty, "Private", 1, payment)
            raidLog(("CREATE_RESULT result=%s detail=%s"):format(tostring(createResult), tostring(createDetail)))
            if createResult ~= "Created" and createResult ~= "Saved" and createResult ~= "AlreadyInRoom" then
                Status = "Raid: falha ao criar sala — " .. tostring(createResult or createDetail)
                task.wait(1.5)
                continue
            end

            -- CreateRoom e StartRoom compartilham o ActionCooldown oficial. Quando já estamos
            -- na sala, não recriamos: repetimos somente StartRoom com o intervalo do módulo.
            local startResult, startDetail
            for attempt = 1, 4 do
                local cooldown = (settings.ActionCooldown or 1) + 0.25
                local waitUntil = os.clock() + cooldown
                Status = ("Raid: aguardando início (%s, tentativa %d)..."):format(bossName, attempt)
                while os.clock() < waitUntil and not aborted() do
                    if collecting then break end
                    task.wait(0.1)
                end
                if aborted() or collecting then break end
                startResult, startDetail = GameClient.InvokeBossRoom("StartRoom")
                raidLog(("START_RESULT attempt=%d result=%s detail=%s"):format(
                    attempt, tostring(startResult), tostring(startDetail)
                ))
                if startResult == "Started" then
                    State.raidInArena = true
                    break
                end
                if startResult ~= "RateLimited" then break end
            end
            if aborted() then break end
            if collecting then
                raidLog("WAIT_FRUIT_BEFORE_START")
                while collecting and not aborted() do
                    Status = "Raid: aguardando coleta de fruta..."
                    task.wait(0.25)
                end
                continue
            end
            if startResult ~= "Started" then
                if createResult == "AlreadyInRoom" and startResult == "NoFreeEntry" then
                    raidLog("LEAVE_STALE_ROOM reason=AlreadyInRoom+NoFreeEntry")
                    pcall(GameClient.LeaveBossRoom)
                    task.wait((settings.ActionCooldown or 1) + 0.35)
                    continue
                end
                State.raidInArena = false
                Status = "Raid: não iniciou — " .. tostring(startResult or startDetail)
                raidLog("START_ABORT result=" .. tostring(startResult or startDetail))
                notify("Raid", Status)
                CFG.AutoRaid = false
                if Shared.RefreshToggles then Shared.RefreshToggles() end
                break
            end

            Status = "Raid: entrando na arena de " .. bossName
            local target
            local spawnDeadline = os.clock() + 25
            while not aborted() and os.clock() < spawnDeadline do
                local _, rNow = getChar()
                if rNow and (rNow.Position - keeperPos).Magnitude > 500 then
                    target = GameClient.FindWorldBoss(bossName, 600)
                end
                if target then break end
                task.wait(0.25)
            end
            fightAndReturn(settings, bossName, keeperPos, target)
        end
        end, function(err) attackGoal = nil; currentTarget = nil; cancelTween() end)
        if token == GameClient.RaidToken then
            State.raidInArena = false
        end
        attackGoal = nil
        currentTarget = nil
        if token == GameClient.RaidToken and not CFG.AutoRaid then Status = "Parado" end
        raidLog("=== RAID STOP ===")
    end)
end

