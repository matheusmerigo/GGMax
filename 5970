            talkStyleNpc("Rustfall Storm Keeper Field", "Learn", aborted)
        else
            Status = "Eletric: aguardando próxima etapa..."
            task.wait(0.5)
        end
        end -- if not prog / else
        task.wait(0.05)
    end
    if ownsStyle("Eletric") then
        notify("⚡ Eletric", "Eletric desbloqueado com sucesso!")
        return true
    end
    return false
end

local function fightingStyleLoop()
    State.styleToken += 1
    local my = State.styleToken
    State.styleLoopRunning = true
    CFG.AutoFarm = false
    State.farmToken += 1
    CFG.AutoHistory = false
    State.storyToken += 1
    CFG.AutoFish = false
    attackGoal = nil
    currentTarget = nil

    local function aborted()
        return State.styleToken ~= my or not (CFG.AutoDarkStep or CFG.AutoWaterKungFu or CFG.AutoEletric)
    end
    startMinigameSolver(aborted)

    task.spawn(function()
        local styles = {
            { cfg = "AutoDarkStep",    name = "Dark Step",     fn = unlockDarkStep },
            { cfg = "AutoWaterKungFu", name = "Water Kung-Fu", fn = unlockWaterKungFu },
            { cfg = "AutoEletric",     name = "Eletric",       fn = unlockEletric },
        }

        SafeRuntime.RunResilientLoop("FightingStyle", function() return not aborted() end, function()
        while not aborted() do
            local ranAny = false
            for _, st in ipairs(styles) do
                if aborted() then break end
                if CFG[st.cfg] then
                    ranAny = true
                    local function styleAborted()
                        return aborted() or not CFG[st.cfg]
                    end
                    local ok, err = pcall(st.fn, styleAborted)
                    if not ok and err then
                        notify("⚠️ Erro Estilo (" .. st.name .. ")", tostring(err))
                    end
                    -- Desativa automaticamente este toggle ao concluir ou se falhou requisito (nível/história)
                    if State.styleToken == my then
                        CFG[st.cfg] = false
                    end
                end
            end
            if not ranAny then break end
            task.wait(0.2)
        end
        end, function(err) attackGoal = nil; currentTarget = nil; cancelTween() end)

        if State.styleToken == my then
            State.styleLoopRunning = false
            if CFG.MainMode == "DarkStep" or CFG.MainMode == "WaterKungFu" or CFG.MainMode == "Eletric" then
                CFG.MainModeActive = false
            end
            attackGoal = nil
            currentTarget = nil
            cancelTween()
            Status = "Parado"
        end
    end)
end

