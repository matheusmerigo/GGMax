    local function findForgeNpc(minForgeLevel)
        local _, hrp = getChar()
        if not hrp then return nil end
        local il = workspace:FindFirstChild("IgnoreList")
        local npcs = il and il:FindFirstChild("Int") and il.Int:FindFirstChild("NPCs")
        local shops = npcs and npcs:FindFirstChild("Shops")
        local best, bestD
        if shops then
            for _, m in ipairs(shops:GetDescendants()) do
                if m:IsA("Model") then
                    local flv = m:GetAttribute("ForgeLevel")
                    if type(flv) == "number" and flv >= (minForgeLevel or 0) then
                        local d = (m:GetPivot().Position - hrp.Position).Magnitude
                        if not bestD or d < bestD then
                            best, bestD = m, d
                        end
                    end
                end
            end
        end
        return best
    end

    local function ensureMobQuest(questEntry, aborted, logFn)
        local qName = questEntry and (questEntry.name or questEntry.Name)
        local qInfo = questEntry and questEntry.info
        if not (qName and qInfo) then return false end
        local myLv = getLevel()
        local minLv = tonumber(qInfo.MinLevel) or 0
        if myLv < minLv then
            if logFn then logFn(("QUEST_SKIP_LEVEL quest=%s myLv=%d minLv=%d"):format(tostring(qName), myLv, minLv)) end
            return false
        end
        local d = getData()
        local actives = (d and GameClient.GetActiveQuests(d)) or {}
        if actives[qName] ~= nil then return true end
        if os.clock() < State.questCooldown then
            if logFn then logFn(("QUEST_COOLDOWN quest=%s wait=%.1fs"):format(tostring(qName), math.max(0, State.questCooldown - os.clock()))) end
            return false
        end
        for activeName in pairs(actives) do
            local activeInfo = MainModules.QuestsInfo and MainModules.QuestsInfo[activeName]
            if activeName ~= qName and activeInfo and activeInfo.GrindingQuest then
                if logFn then logFn(("QUEST_ABANDON quest=%s for=%s"):format(tostring(activeName), tostring(qName))) end
                pcall(function() GameModules.Network:FireServer("Quests", "Abandon", activeName) end)
                task.wait(0.35)
            end
        end
        local okAcc = Features.TryAcceptQuest(qName, qInfo, aborted)
        if logFn then
            logFn(("QUEST_ACCEPT quest=%s giver=%s ok=%s"):format(tostring(qName), tostring(qInfo.Arguments and qInfo.Arguments.Giver), tostring(okAcc)))
        end
        if not okAcc then
            State.questCooldown = os.clock() + 4
            return false
        end
        return true
    end

    local function farmMissingMaterialsStep(missingList, statusLabel, aborted, logFn)
        local _, hrp = getChar()
        if not hrp then return false, "Sem personagem" end
        local myLv = getLevel()
        local bestSrc, bestScore = nil, nil
        local enemysInfo = MainModules and MainModules.EnemysInfo
        local d = getData()
        local actives = (d and GameClient.GetActiveQuests(d)) or {}
        for _, row in ipairs(missingList) do
            for _, src in ipairs(row.Sources) do
                local giverName = src.Quest and src.Quest.info and src.Quest.info.Arguments and src.Quest.info.Arguments.Giver
                local fallbackPos = giverName and giverPos(giverName) or nil
                local refPos = (src.Group and src.Group.Parent and src.Group.Position) or fallbackPos
                if refPos then
                    local coverage = 0
                    local drops = enemysInfo and enemysInfo[src.Enemy] and enemysInfo[src.Enemy].Rewards and enemysInfo[src.Enemy].Rewards.Drops
                    if drops then
                        for _, needed in ipairs(missingList) do
                            if drops[needed.Name] then coverage += math.min(needed.Missing, 8) end
                        end
                    end
                    local dist = (hrp.Position - refPos).Magnitude
                    local qKey = src.Quest and (src.Quest.name or src.Quest.Name)
                    local hasActiveQ = qKey and actives[qKey] ~= nil
                    local qMinLv = (src.Quest and src.Quest.info and src.Quest.info.MinLevel) or 0
                    local canQuest = (src.Quest ~= nil and myLv >= qMinLv)
                    local qBonus = hasActiveQ and 100 or (canQuest and 50 or (src.Quest ~= nil and -500 or 0))
                    local score = coverage * 10 + (src.Chance or 0) - dist / 1500 - (src.Level or 0) / 1000 + qBonus
                    if not bestScore or score > bestScore then
                        bestSrc, bestScore = src, score
                    end
                end
            end
        end
        if not bestSrc then
            local missName = missingList[1] and missingList[1].Name or "?"
            if logFn then logFn(("FARM_NO_SOURCE item=%s"):format(tostring(missName))) end
            return false, "Sem mob/drop mapeado para: " .. tostring(missName)
        end

        if logFn then
            logFn(("FARM_PICK label=%s mob=%s lv=%d chance=%.1f quest=%s minLv=%d score=%.1f"):format(
                tostring(statusLabel), tostring(bestSrc.Enemy), tonumber(bestSrc.Level) or 0, tonumber(bestSrc.Chance) or 0,
                tostring(bestSrc.Quest and (bestSrc.Quest.name or bestSrc.Quest.Name) or "none"),
                tonumber(bestSrc.Quest and bestSrc.Quest.info and bestSrc.Quest.info.MinLevel) or 0, tonumber(bestScore) or 0
            ))
        end
        local targetQName = bestSrc.Quest and (bestSrc.Quest.name or bestSrc.Quest.Name) or nil
        State.activeFarmQuestName = targetQName
        if bestSrc.Quest then
            ensureMobQuest(bestSrc.Quest, aborted, logFn)
        end
        if aborted and aborted() then return false, "aborted" end

        local lv = getLevel()
        local wantSet = nil
        local curQ, curInfo, curProg = Features.ActiveQuest()
        if targetQName and curQ == targetQName and curInfo then
            local pendingSet, qDone = Features.PendingNames(curInfo, curProg)
            if qDone then
                Status = ("%s: concluindo missão..."):format(tostring(statusLabel))
                if logFn then logFn(("QUEST_DONE quest=%s"):format(tostring(curQ))) end
                local t0 = os.clock()
                while not (aborted and aborted()) and Features.ActiveQuest() == curQ and os.clock() - t0 < 4 do
                    task.wait(0.25)
                end
                if Features.ActiveQuest() == curQ then
                    pcall(function() GameModules.Network:FireServer("Quests", "Repeat") end)
                end
                return true, "quest_done"
            elseif pendingSet and next(pendingSet) ~= nil then
                wantSet = {}
                local pendList = {}
                for pName, on in pairs(pendingSet) do
                    if on then
                        wantSet[pName] = true
                        pendList[#pendList + 1] = pName
                        local eI = enemysInfo and enemysInfo[pName]
                        local aName = eI and eI.EnemyArguments and eI.EnemyArguments.AlternativeName
                        if type(aName) == "string" and aName ~= "" then
                            wantSet[aName] = true
                        end
                    end
                end
                if logFn and (not pendingSet[bestSrc.Enemy] or #pendList > 1) then
                    table.sort(pendList)
                    logFn(("FARM_QUEST_PENDING quest=%s mobs=[%s]"):format(tostring(curQ), table.concat(pendList, ", ")))
                end
            end
        end
        if not wantSet then
            wantSet = { [bestSrc.Enemy] = true }
            if bestSrc.AltName and bestSrc.AltName ~= "" then
                wantSet[bestSrc.AltName] = true
            end
        end
        local _, h2 = getChar()
        local target = h2 and Combat.PickTarget(lv, h2.Position, wantSet)
        if target then
            local bOrig = baseName(target)
            local function targetAborted()
                if (aborted and aborted()) or not mobAlive(target) then return true end
                if targetQName then
                    local cQ2, cInfo2, cProg2 = Features.ActiveQuest()
                    if cQ2 == targetQName and cInfo2 then
                        local pSet2 = Features.PendingNames(cInfo2, cProg2)
                        if pSet2 and not pSet2[bOrig] then return true end
                    end
                end
                return false
            end
            Status = ("%s: farmando %s (%s)"):format(tostring(statusLabel), tostring(bOrig), tostring(missingList[1] and missingList[1].Name))
            if logFn then logFn(("FARM_FIGHT label=%s mob=%s"):format(tostring(statusLabel), tostring(bOrig))) end
            Combat.FightTarget(target, targetAborted, tostring(statusLabel), { checkStuck = true, allowGoNear = true })
        elseif h2 then
            local spawnPos, travelMob = nil, nil
            for wantedName in pairs(wantSet) do
                local mk = Combat.SpawnMarker(wantedName, h2.Position)
                if mk then
                    spawnPos = mk
                    travelMob = wantedName
                    break
                end
            end
            if not spawnPos and wantSet[bestSrc.Enemy] and bestSrc.Group and bestSrc.Group.Parent then
                spawnPos = bestSrc.Group.Position
                travelMob = bestSrc.Enemy
            end
            if not spawnPos then
                local giverName = bestSrc.Quest and bestSrc.Quest.info and bestSrc.Quest.info.Arguments and bestSrc.Quest.info.Arguments.Giver
                spawnPos = giverName and giverPos(giverName) or nil
                travelMob = travelMob or bestSrc.Enemy
            end
            if not spawnPos then return false, "Spawn não encontrado para " .. tostring(travelMob or bestSrc.Enemy) end
            Status = ("%s: indo para %s..."):format(tostring(statusLabel), tostring(travelMob or bestSrc.Enemy))
            if logFn then logFn(("FARM_TRAVEL label=%s mob=%s pos=(%.0f,%.0f,%.0f)"):format(tostring(statusLabel), tostring(travelMob or bestSrc.Enemy), spawnPos.X, spawnPos.Y, spawnPos.Z)) end
            goNear(spawnPos, function()
                return (aborted and aborted()) or Combat.PickTarget(lv, spawnPos, wantSet) ~= nil
            end)
            task.wait(0.4)
        end
        return true, "farming"
    end

    local function forgeItemAtBlacksmith(itemName, qty, minForgeLevel, aborted, logFn)
        State.activeFarmQuestName = nil
        local smith = findForgeNpc(minForgeLevel)
        if logFn then logFn(("FORGE_NPC item=%s minForgeLv=%d found=%s"):format(tostring(itemName), tonumber(minForgeLevel) or 0, tostring(smith and smith.Name or "nil"))) end
        if not smith then
            for _, fbName in ipairs({ "Kraken's Rest Blacksmith", "Volcano Island Blacksmith", "Valoria Island Blacksmith", "Windhaven Blacksmith", "Blacksmith" }) do
                local fbPos = giverPos(fbName)
                if fbPos then
                    Status = ("Blacksmith: indo para %s..."):format(fbName)
                    goNear(fbPos, aborted)
                    if aborted and aborted() then return false, "aborted" end
                    task.wait(0.6)
                    smith = findForgeNpc(minForgeLevel)
                    if smith then
                        if logFn then logFn(("FORGE_FALLBACK npc=%s"):format(tostring(smith.Name))) end
                        break
                    end
                end
            end
        end
        local smithPos = smith and smith:GetPivot().Position or giverPos("Blacksmith")
        if not smithPos then return false, "Blacksmith não encontrado" end

        Status = ("Blacksmith: indo até o ferreiro (%s)..."):format(tostring(itemName))
        goNear(smithPos, aborted)
        if aborted and aborted() then return false, "aborted" end

        local function restoreThreadId()
            if type(setthreadidentity) == "function" then
                local curId = type(getthreadidentity) == "function" and getthreadidentity() or 0
                if curId < 8 then pcall(setthreadidentity, 8) end
            end
        end

        local freshSmith = findForgeNpc(minForgeLevel)
        smith = freshSmith or smith
        smithPos = (smith and smith.Parent and smith:GetPivot().Position) or smithPos
        local _, hSmith = getChar()
        if hSmith and (hSmith.Position - smithPos).Magnitude > 6 then
            tweenTo(CFrame.new(smithPos + Vector3.new(0, 2, 3)), aborted)
            if aborted and aborted() then return false, "aborted" end
        end
        cancelTween()
        local _, hSettle = getChar()
        if hSettle then hSettle.AssemblyLinearVelocity = Vector3.zero end
        task.wait(0.35)

        local okForge, forgeMenu, forgeData = pcall(function()
            local addons = ReplicatedStorage.Modules.Addons
            local fc = addons.ForgeSystem["ForgeSystem Client"]
            return require(fc.ForgeMenu), require(fc.ForgeMenu.Data)
        end)
        if not (okForge and forgeMenu and forgeData) then return false, "ForgeMenu indisponível" end

        local convName = (smith and smith.Name == "Valoria Island Blacksmith") and "ValoriaBlacksmith" or "Blacksmith"
        local wasOpen = (forgeMenu.Opened == true and forgeData.ForgeLevel ~= nil)
        if logFn then
            logFn(("FORGE_OPEN npc=%s conv=%s alreadyOpen=%s forgeLv=%s"):format(tostring(smith and smith.Name or "nil"), tostring(convName), tostring(wasOpen), tostring(forgeData.ForgeLevel)))
        end
        if not wasOpen then
            pcall(function()
                local ic = require(ReplicatedStorage.Modules.Essentials.InterfaceSystem).IsClient
                if ic and ic.MenusHandler then ic.MenusHandler:Close(true) end
            end)
            for attempt = 1, 3 do
                if aborted and aborted() then return false, "aborted" end
                if attempt == 1 then
                    if Movement.BeginInteract and not Movement.BeginInteract(aborted) then return false, "aborted" end
                else
                    local _, hRe = getChar()
                    smithPos = (smith and smith.Parent and smith:GetPivot().Position) or smithPos
                    if hRe and (hRe.Position - smithPos).Magnitude > 8 then
                        tweenTo(CFrame.new(smithPos + Vector3.new(0, 2, 3)), aborted)
                        cancelTween()
                        if aborted and aborted() then return false, "aborted" end
                    end
                    task.wait(0.4)
                end
                pcall(function()
                    local ic = require(ReplicatedStorage.Modules.Essentials.InterfaceSystem).IsClient
                    if ic and ic.MenusHandler then ic.MenusHandler:Close(true) end
                end)
                pcall(function()
                    local dialogue = GameModules.Converse and GameModules.Converse.IsClient and GameModules.Converse.IsClient:Talk(convName)
                    if dialogue then
                        dialogue:End()
                        dialogue:FireServer()
                    end
                    if attempt >= 2 and GameModules.Network then
                        GameModules.Network:FireServer("Elysium_Converse", convName)
                    end
                end)
                local openDeadline = os.clock() + 2.5
                while not (aborted and aborted()) and os.clock() < openDeadline do
                    if forgeMenu.Opened == true and forgeData.ForgeLevel ~= nil then break end
                    task.wait(0.15)
                end
                local _, hNow = getChar()
                local dNow = hNow and (hNow.Position - smithPos).Magnitude or -1
                if logFn then
                    logFn(("FORGE_AFTER_OPEN attempt=%d dist=%.1f opened=%s forgeLv=%s"):format(attempt, dNow, tostring(forgeMenu.Opened), tostring(forgeData.ForgeLevel)))
                end
                if forgeMenu.Opened == true and forgeData.ForgeLevel ~= nil then break end
            end
        end
        if aborted and aborted() then return false, "aborted" end
        if not (forgeMenu.Opened == true and forgeData.ForgeLevel ~= nil) then
            Features.RestoreHud()
            restoreThreadId()
            return false, "Forja não abriu no ferreiro"
        end

        local recipe = forgeData.GetRecipe and forgeData.GetRecipe(itemName)
        local blockReason = recipe and forgeData.GetCraftBlock and forgeData.GetCraftBlock(recipe, qty)
        if not recipe or blockReason then
            if logFn then logFn(("FORGE_BLOCKED item=%s qty=%d hasRecipe=%s reason=%s"):format(tostring(itemName), qty, tostring(recipe ~= nil), tostring(blockReason))) end
            if forgeMenu.Opened and forgeMenu.RequestClose then pcall(forgeMenu.RequestClose) end
            Features.RestoreHud()
            restoreThreadId()
            return false, tostring(blockReason or "Receita indisponível na forja")
        end

        local _, hCraft = getChar()
        if hCraft and (hCraft.Position - smithPos).Magnitude > 16 then
            tweenTo(CFrame.new(smithPos + Vector3.new(0, 2, 3)), aborted)
            cancelTween()
            if aborted and aborted() then
                if forgeMenu.Opened and forgeMenu.RequestClose then pcall(forgeMenu.RequestClose) end
                Features.RestoreHud()
                restoreThreadId()
                return false, "aborted"
            end
        end

        local beforeCnt = MainModules.ToolsUtils.GetInventoryAmount(nil, itemName) or 0
        Status = ("Craftando %dx %s..."):format(qty, tostring(itemName))
        if logFn then logFn(("FORGE_CRAFT item=%s qty=%d before=%d forgeLv=%s"):format(tostring(itemName), qty, beforeCnt, tostring(forgeData.ForgeLevel))) end
        local okCall, craftRet = pcall(function() return forgeData.Craft(recipe, qty) end)
        local craftedOk = (okCall and craftRet ~= false)
        if logFn and not craftedOk then
            logFn(("FORGE_CALL_FAIL item=%s okCall=%s ret=%s"):format(tostring(itemName), tostring(okCall), tostring(craftRet)))
        end
        if craftedOk then
            local dead = os.clock() + 8
            while not (aborted and aborted()) and os.clock() < dead do
                if (MainModules.ToolsUtils.GetInventoryAmount(nil, itemName) or 0) > beforeCnt then
                    break
                end
                task.wait(0.25)
            end
        end
        if forgeMenu.Opened and forgeMenu.RequestClose then pcall(forgeMenu.RequestClose) end
        Features.RestoreHud()
        if type(setthreadidentity) == "function" then
            local curId = type(getthreadidentity) == "function" and getthreadidentity() or 0
            if curId < 8 then pcall(setthreadidentity, 8) end
        end
        task.wait(0.35)
        local afterCnt = MainModules.ToolsUtils.GetInventoryAmount(nil, itemName) or 0
        local gained = afterCnt > beforeCnt
        if logFn then logFn(("FORGE_RESULT item=%s before=%d after=%d gained=%s"):format(tostring(itemName), beforeCnt, afterCnt, tostring(gained))) end
        return gained, gained and "crafted" or "Craft não confirmado"
    end

    local function craftItemRecursiveStep(itemName, targetQty, aborted, logFn, visited)
        visited = visited or {}
        if visited[itemName] then return false, "Ciclo na receita: " .. tostring(itemName) end
        visited[itemName] = true

        local req = getItemRequirements(itemName, targetQty)
        if not req then return false, "Sem receita para " .. tostring(itemName) end
        if logFn then
            local matParts = {}
            for _, r in ipairs(req.All) do
                matParts[#matParts + 1] = ("%s:%d/%d"):format(tostring(r.Name), tonumber(r.Have) or 0, tonumber(r.Need) or 0)
            end
            logFn(("STEP item=%s qty=%d missing=%d reason=%s mats=[%s]"):format(tostring(itemName), tonumber(targetQty) or 1, #req.Missing, tostring(req.CraftReason), table.concat(matParts, ", ")))
        end

        if #req.Missing > 0 then
            for _, row in ipairs(req.Missing) do
                if row.HasRecipe and not visited[row.Name] then
                    local infos = MainModules and MainModules.ToolsInfo and MainModules.ToolsInfo.Infos
                    local subInfo = type(infos) == "table" and infos[row.Name]
                    local subOut = (type(subInfo) == "table" and type(subInfo.Recipe) == "table" and tonumber(subInfo.Recipe.Amount)) or 1
                    local subCrafts = math.max(1, math.ceil(row.Missing / math.max(1, subOut)))
                    if logFn then logFn(("SUB_RECIPE parent=%s -> child=%s subCrafts=%d missing=%d out=%d"):format(tostring(itemName), tostring(row.Name), subCrafts, tonumber(row.Missing) or 0, subOut)) end
                    return craftItemRecursiveStep(row.Name, subCrafts, aborted, logFn, visited)
                end
            end
            return farmMissingMaterialsStep(req.Missing, itemName, aborted, logFn)
        end

        if req.CraftReason and req.CraftReason ~= "MissingMaterials" then
            if logFn then logFn(("STEP_BLOCKED item=%s reason=%s"):format(tostring(itemName), tostring(req.CraftReason))) end
            return false, tostring(req.CraftReason)
        end
        return forgeItemAtBlacksmith(itemName, req.Unique and 1 or math.max(1, math.floor(targetQty or 1)), req.Level, aborted, logFn)
    end

