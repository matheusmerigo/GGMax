            end
        end
    end
    return nil
end

local function extractVec3(pt)
    if not pt then return nil end
    local direct = GameClient.ValuePosition(pt)
    if direct then return direct end
    -- Try calling it if it's a function (some InterestPoint fields return closures)
    if type(pt) == "function" then
        local ok, result = pcall(pt)
        if ok and result then return extractVec3(result) end
    end
    return nil
end

local interiorBoundsCache = setmetatable({}, { __mode = "k" })

local function getInteriorBounds(interiorObj)
    local cached = interiorBoundsCache[interiorObj]
    if cached then return cached[1], cached[2] end
    local minV, maxV
    local targetRoot = interiorObj:FindFirstChild("Instances") or interiorObj
    if targetRoot:IsA("Model") then
        local ok, cf, size = pcall(targetRoot.GetBoundingBox, targetRoot)
        if ok and cf and size then
            local half = size / 2
            minV = cf.Position - half
            maxV = cf.Position + half
        end
    end
    if not minV then
        for _, desc in ipairs(targetRoot:GetDescendants()) do
            if desc:IsA("BasePart") then
                local p, s = desc.Position, desc.Size / 2
                local lo, hi = p - s, p + s
                minV = minV and minV:Min(lo) or lo
                maxV = maxV and maxV:Max(hi) or hi
            end
        end
    end
    if minV and maxV then
        interiorBoundsCache[interiorObj] = { minV, maxV }
    end
    return minV, maxV
end

local function getInteriorContainer(worldPos)
    if typeof(worldPos) ~= "Vector3" then return nil end
    local map = workspace:FindFirstChild("Map")
    local areas = map and map:FindFirstChild("Areas")
    if not areas then return nil end
    local bestInterior, bestVol = nil, math.huge
    for _, area in ipairs(areas:GetChildren()) do
        local interiors = area:FindFirstChild("Interiors")
        if interiors then
            for _, interior in ipairs(interiors:GetChildren()) do
                local minV, maxV = getInteriorBounds(interior)
                if minV and maxV then
                    local m = 20
                    if worldPos.X >= minV.X - m and worldPos.X <= maxV.X + m
                        and worldPos.Y >= minV.Y - m and worldPos.Y <= maxV.Y + m
                        and worldPos.Z >= minV.Z - m and worldPos.Z <= maxV.Z + m then
                        local sz = maxV - minV
                        local vol = sz.X * sz.Y * sz.Z
                        if vol < bestVol then
                            bestInterior, bestVol = interior, vol
                        end
                    end
                end
            end
        end
    end
    if bestInterior then return bestInterior end
    local ign = workspace:FindFirstChild("IgnoreList")
    local intF = ign and ign:FindFirstChild("Int")
    local priv = intF and intF:FindFirstChild("PrivateAreas")
    if priv then
        local bestPriv, bestDist = nil, 700
        for _, islandF in ipairs(priv:GetChildren()) do
            for _, placeF in ipairs(islandF:GetChildren()) do
                if placeF.Name ~= "SkyLift" then
                    local enterF = placeF:FindFirstChild("Enter")
                    local leaveF = placeF:FindFirstChild("Leave")
                    local destP = (enterF and extractVec3(enterF:FindFirstChild("Destination")))
                        or (leaveF and extractVec3(leaveF:FindFirstChild("Entrance")))
                    local outP = enterF and extractVec3(enterF:FindFirstChild("Entrance"))
                    local maxYDiff = (placeF.Name == "VolcanoInterior") and 450 or 180
                    local maxRad = (placeF.Name == "VolcanoInterior") and 1600 or bestDist
                    if destP and math.abs(worldPos.Y - destP.Y) < maxYDiff then
                        local d = (worldPos - destP).Magnitude
                        if d < maxRad and (not outP or d < (worldPos - outP).Magnitude) then
                            bestPriv, bestDist = placeF, d
                        end
                    end
                end
            end
        end
        if bestPriv then return bestPriv end
    end
    -- Fallback 2: interiores que usam QuestZones Leave_* (ex: Leave_Lighthouse_FI, Leave_YetiCave_FI, Leave_Cave_SP)
    local dataF = ign and ign:FindFirstChild("Data")
    local questsF = dataF and dataF:FindFirstChild("Quests")
    local zonesF = questsF and questsF:FindFirstChild("Zones")
    if zonesF then
        local bestZone, bestZD = nil, 650
        for _, isl in ipairs(zonesF:GetChildren()) do
            for _, z in ipairs(isl:GetChildren()) do
                if z.Name:sub(1, 6) == "Leave_" then
                    local zp = extractVec3(z)
                    if zp and math.abs(worldPos.Y - zp.Y) < 180 then
                        local d = (worldPos - zp).Magnitude
                        if d < bestZD then bestZone, bestZD = z, d end
                    end
                end
            end
        end
        if bestZone then
            local zoneToInt = {
                ["Leave_Lighthouse_FI"] = { "Frost Island", "Lighthouse Interior" },
                ["Leave_YetiCave_FI"] = { "Frost Island", "Yeti Cave" },
                ["Leave_Lab_SL"] = { "Skull Island", "Abandoned Laboratory" },
                ["Leave_IronLotus_SL"] = { "Skull Island", "Iron Lotus Chamber" },
                ["Leave_Tablet_SL"] = { "Golden Dunes", "Tablatura" },
                ["Leave_Archive_SL"] = { "Golden Dunes", "Upper Archive" },
                ["Leave_KeeperHouse_FS"] = { "Forbidden Island", "Storm Keeper's House" },
                ["Leave_Cave_SP"] = { "Shark Park", "Submerged Cavern" },
                ["Leave_Well_SP"] = { "Shark Park", "Submerged Cavern" },
                ["Leave_AncientStructure_SU"] = { "Windhaven", "Ancient Structure" },
