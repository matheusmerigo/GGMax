-- Tween
local function cancelTween()
    Movement.activeTweenDone = true
    local conn = Movement.activeTweenConn
    Movement.activeTweenConn = nil
    if conn then pcall(function() conn:Disconnect() end) end
    local tw = Movement.activeTween
    Movement.activeTween = nil
    Movement.activeTweenPart = nil
    Movement.activeTweenGoal = nil
    if tw then
        pcall(function() tw:Cancel(); tw:Destroy() end)
    end
end
Movement.CancelTween = cancelTween

function Movement.TweenSegment(targetCF, abortIf, opts)
    if isDeadOrRespawning() then cancelTween(); return false end
    local _, hrp = getChar()
    if not hrp then return false end
    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist < 0.5 then
        hrp.CFrame = targetCF
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        return true
    end
    local eps = (opts and opts.targetEpsilon) or Movement.TargetEpsilon
    local existingTw = Movement.activeTween
    if existingTw and not Movement.activeTweenDone and Movement.activeTweenPart == hrp
        and Movement.activeTweenGoal and (Movement.activeTweenGoal.Position - targetCF.Position).Magnitude <= eps
    then
        while not Movement.activeTweenDone and Movement.activeTween == existingTw do
            if isDeadOrRespawning() or (abortIf and abortIf()) then
                cancelTween()
                return false
            end
            local _, h = getChar()
            if not h then
                if Movement.activeTween == existingTw then cancelTween() end
                return false
            end
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
            RunService.Heartbeat:Wait()
        end
        return Movement.activeTweenDone
    end

    local t = math.max(dist / CFG.TweenSpeed, 0.05)
    cancelTween()
    local tw = Services.TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = targetCF })
    local done = false
    Movement.activeTween = tw
    Movement.activeTweenPart = hrp
    Movement.activeTweenGoal = targetCF
    Movement.activeTweenDone = false
    Movement.activeTweenConn = tw.Completed:Once(function()
        done = true
        if Movement.activeTween == tw then
            Movement.activeTweenDone = true
            Movement.activeTween = nil
            Movement.activeTweenPart = nil
            Movement.activeTweenGoal = nil
            Movement.activeTweenConn = nil
        end
        pcall(function() tw:Destroy() end)
    end)
    tw:Play()
    while not done and Movement.activeTween == tw do
        if isDeadOrRespawning() or (abortIf and abortIf()) then break end
        local _, h = getChar()
        if not h then break end
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
        RunService.Heartbeat:Wait()
    end
    if Movement.activeTween == tw then
        cancelTween()
    end
    return done
end

local function tweenTo(cf, abortIf)
    if isDeadOrRespawning() then cancelTween(); return false end
    local _, hrp = getChar()
    if not hrp then return false end

    local startPos = hrp.Position
    local destPos = cf.Position
    -- Apenas na superfície/oceano (Y > -200); interiores subterrâneos (Y <= -200) usam trajeto direto
    local onSurface = (startPos.Y > -200 and destPos.Y > -200)
    local horiz = Vector3.new(destPos.X - startPos.X, 0, destPos.Z - startPos.Z)
    local horizDist = horiz.Magnitude

    -- Na superfície: ao sair já sobe/alinha a altura segura (fora da água) e viaja reto na horizontal
    -- olhando para o destino antes de descer no ponto final.
    if onSurface and horizDist > 12 and (
        startPos.Y < Movement.SAFE_WATER_Y
        or destPos.Y < Movement.SAFE_WATER_Y
        or math.abs(destPos.Y - startPos.Y) > 12
        or horizDist > 120
    ) then
        local minCruise = horizDist > 300 and 45 or Movement.SAFE_WATER_Y
        local cruiseY = math.max(startPos.Y, destPos.Y, minCruise)
        local function faceCF(p)
            if horizDist > 1 then
                return CFrame.lookAt(p, p + horiz.Unit)
            end
            return CFrame.new(p)
        end

        -- Fase 1: sai imediatamente da água / alinha altura de cruzeiro já ao sair
        if cruiseY - startPos.Y > 2 then
            if not Movement.TweenSegment(faceCF(Vector3.new(startPos.X, cruiseY, startPos.Z)), abortIf) then
                return false
            end
        end

        -- Fase 2: deslocamento horizontal limpo acima da água, em pé e alinhado com o destino
        if horizDist > 2 then
            if not Movement.TweenSegment(faceCF(Vector3.new(destPos.X, cruiseY, destPos.Z)), abortIf) then
                return false
            end
        end

        -- Fase 3: desce verticalmente e aplica o CFrame exato do destino
        return Movement.TweenSegment(cf, abortIf)
    end

    return Movement.TweenSegment(cf, abortIf)
end

-- Inimigos
local function baseName(model)
    local n = model:GetAttribute("OriginalName")
    if type(n) == "string" and n ~= "" then return n end
    return (model.Name:gsub("_%d+$", ""))
end

function Combat.MobLevel(model)
    local a = model:GetAttribute("Level")
    if type(a) == "number" then return a end
    local lv = tonumber(string.match(model.Name, "%[Lv%.?%s*(%d+)%]"))
    if lv then return lv end
    return State.Mobs.Levels[baseName(model)]
end

local GameClient = { QuestSystem = nil, InteractionSystem = nil }

local function mobHP(m)
    local h = m and m:FindFirstChildOfClass("Humanoid")
    if not h then return 0, 0 end
    local hh = h:GetAttribute("HandlerHealth")
    if hh ~= nil then
        return tonumber(hh) or 0, tonumber(h:GetAttribute("HandlerMaxHealth")) or h.MaxHealth
    end
    return h.Health, h.MaxHealth
end

local function mobAlive(m)
    if not m or not m.Parent then return false end
    if m:GetAttribute("Dead") == true or m:GetAttribute("Render") == false or m:GetAttribute("Ready") == false then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    local r = m:FindFirstChild("HumanoidRootPart")
    if not (h and r) or h:GetState() == Enum.HumanoidStateType.Dead then return false end
    local hp = mobHP(m)
    if hp <= 0 then return false end
    return r.CanQuery ~= false
end

-- Inimigos do Marine Fort podem alternar Render/CanQuery durante ataques e
-- transicoes de onda sem estarem mortos. O combate da raid deve acompanhar o
-- HP real, em vez de abandonar o alvo por esses estados visuais temporarios.
function GameClient.FortRaidEnemyAlive(m)
    if not m or not m.Parent or m:GetAttribute("Dead") == true then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
    if not (h and r) or h:GetState() == Enum.HumanoidStateType.Dead then return false end
    local hp = mobHP(m)
    return hp > 0
end

function Combat.PickTarget(myLevel, myPos, nameSet)
    local folder = playability("Enemys")
    if not folder then return end
    local best, bestScore
    local fallback, fallbackScore
    local now = os.clock()
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and mobAlive(m) then
            local ok, score = false, 0
            local d = (m.HumanoidRootPart.Position - myPos).Magnitude
            if nameSet then
                -- modo quest: só os inimigos que a quest pede (prioriza menor HP e menor distância)
                if nameSet[baseName(m)] then
                    local hp, maxHp = mobHP(m)
                    local hpBonus = (maxHp > 0) and ((1 - hp / maxHp) * 40) or 0
                    ok, score = true, hpBonus - d
                end
            else
                local lv = Combat.MobLevel(m)
                local minLv = math.min(myLevel - CFG.LevelsBelow, 440)
                if lv and lv <= myLevel + CFG.LevelsAbove and lv >= minLv then
                    local hp, maxHp = mobHP(m)
                    local hpBonus = (maxHp > 0) and ((1 - hp / maxHp) * 40) or 0
                    ok, score = true, lv * 1000 + hpBonus - d -- maior nível permitido; desempata por menor HP e distância
                end
            end
            if ok then
                if not State.BadTargets[m] or now >= State.BadTargets[m] then
                    if not bestScore or score > bestScore then best, bestScore = m, score end
                else
                    if not fallbackScore or score > fallbackScore then fallback, fallbackScore = m, score end
                end
            end
        end
    end
    return best or fallback
end

-- pontos de spawn (IgnoreList.Data.EnemyGroups, mesmo marcador que a quest do jogo usa)
function Combat.SpawnMarker(mobName, fromPos)
    local il = workspace:FindFirstChild("IgnoreList")
    local data = il and il:FindFirstChild("Data")
    local groups = data and data:FindFirstChild("EnemyGroups")
    if not groups then return end
    local needle = "," .. mobName .. ","
    local best, bd
    for _, d in ipairs(groups:GetDescendants()) do
        local a = d:GetAttribute("Enemies")
        if d:IsA("BasePart") and type(a) == "string" and string.find(a, needle, 1, true) and not d:GetAttribute("Wide") then
            local dist = (d.Position - fromPos).Magnitude
            if not bd or dist < bd then best, bd = d, dist end
        end
    end
    return best
end

-- nomes de inimigos (da tabela de níveis) dentro da faixa, do maior para o menor nível
function Combat.MobNamesInRange(lvl)
    local list = {}
    local minLv = math.min(lvl - CFG.LevelsBelow, 440)
    for name, lv in pairs(State.Mobs.Levels) do
        if lv <= lvl + CFG.LevelsAbove and lv >= minLv then list[#list + 1] = { name, lv } end
    end
    table.sort(list, function(a, b) return a[2] > b[2] end)
    return list
end

