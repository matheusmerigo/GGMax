end
local StoreBlacklist = setmetatable({}, { __mode = "k" })  -- [Tool] = true (frutas na mochila que o servidor recusou guardar)

-- Verifica no DataStore do jogo se ainda há espaço guardado para armazenar mais uma unidade dessa fruta.
-- Soma apenas o cofre/anúncios (Bank + Market) sem incluir Unequiped (a própria mochila do jogador).
local function canStoreFruit(fruitName)
    local data = getData()
    if not data or not data.Tools then return true end

    local extra = 0
    pcall(function()
        if MainModules and MainModules.CrewSettings and MainModules.CrewSettings.GetExtraFruitSlots then
            extra = MainModules.CrewSettings.GetExtraFruitSlots(LP) or 0
        end
    end)
    local maxStored = (data.Tools.MaxStoredFruits or 1) + extra

    local storedCount = 0
    for _, list in ipairs({ data.Tools.Bank, data.Tools.Market }) do
        if type(list) == "table" then
            for _, item in pairs(list) do
                if type(item) == "table" and (item.Name or item.ToolName) == fruitName then
                    storedCount += (item.Quantity or 1)
                end
            end
        end
    end

    return storedCount < maxStored
end

local function hasHeldFruit(fruitName)
    local char = LP.Character
    local bp = LP:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({ char, bp }) do
        if holder then
            local t = holder:FindFirstChild(fruitName)
            if t and t:IsA("Tool") then return true end
        end
    end
    return false
end

local function nearestFruit(pos, forCollect)
    local best, bd
    local now = os.clock()
    for f, d in pairs(Fruits) do
        local p = f.Parent and fruitPart(f)
        if p then
            local skip = false
            if forCollect then
                if not GameClient.FruitMatchesRarityFilter(f) then
                    skip = true
                elseif SkipFruits[f] and now < SkipFruits[f] then
                    skip = true
                elseif hasHeldFruit(f.Name) or (CFG.AutoStoreFruit and not canStoreFruit(f.Name)) then
                    skip = true
                end
            end
            if not skip then
                local dist = (p.Position - pos).Magnitude
                if not bd or dist < bd then best, bd = f, dist end
            end
        end
    end
    return best, bd
end

-- atualiza distância no ESP (10Hz para texto + early return quando inativo)
local lastFruitDistUpdate = 0
track(SafeRuntime.Connect(RunService.Heartbeat, "FruitESP", function()
    if not CFG.FruitDetector and not CFG.FruitESP and next(Fruits) == nil then
        return
    end
    if CFG.FruitDetector and (not hookedDroppedTools or not hookedDroppedTools.Parent) then
        scanFruits()
    end
    local now = os.clock()
    local updateDist = (now - lastFruitDistUpdate) >= 0.1
    if updateDist then lastFruitDistUpdate = now end
    local _, hrp = getChar()
    for f, d in pairs(Fruits) do
        if not f.Parent then
            clearFruitESP(nil, d)
            Fruits[f] = nil
        elseif not CFG.FruitESP then
            if d.hl or d.bb then
                clearFruitESP(f, d)
            end
        else
            local p = fruitPart(f)
            if p then
                if not d.hl or not d.hl.Parent or not d.bb or not d.bb.Parent then
                    attachFruitESP(f, d)
                end
                if d.hl then pcall(function() d.hl.Enabled = true end) end
                if d.bb then pcall(function() d.bb.Enabled = true; d.bb.Adornee = p end) end
                if updateDist and hrp and d.lbl then
                    pcall(function()
                        d.lbl.Text = ("[%s] %s\n%d studs"):format(d.rarityLabel or "?", f.Name, (p.Position - hrp.Position).Magnitude)
                    end)
                end
            end
        end
    end
end))

-- guarda as frutas que estiverem na mão/mochila.
-- O jogo faz: Network:FireServer("ToolsData", "Store") com a fruta EQUIPADA (OptionsMenu da fruta).
local function heldFruits()
    local list = {}
    local char = LP.Character
    local bp = LP:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({ char, bp }) do
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if t:IsA("Tool") and isFruit(t) and GameClient.FruitMatchesRarityFilter(t) and not StoreBlacklist[t] and canStoreFruit(t.Name) then
                    list[#list + 1] = t
                end
            end
        end
    end
    return list
end

local function storeFruits()
    if State.storing or not GameModules then return 0 end
    State.storing = true
    local stored = 0
    for _ = 1, 6 do -- até 6 frutas por vez
        local list = heldFruits()
        local tool = list[1]
        if not tool then break end
        local c, _, hum = getChar()
        if not c or not hum then break end
        if tool.Parent ~= c then hum:EquipTool(tool); task.wait(0.25) end
        if tool.Parent ~= c then break end
        Status = "Guardando: " .. tool.Name
        pcall(function() GameModules.Network:FireServer("ToolsData", "Store") end)
        local t0 = os.clock()
        while tool.Parent and (tool.Parent == c or tool.Parent == LP:FindFirstChildOfClass("Backpack")) and os.clock() - t0 < 2 do
            task.wait(0.1)
        end
        if tool.Parent == c or (tool.Parent and tool.Parent == LP:FindFirstChildOfClass("Backpack")) then
            StoreBlacklist[tool] = true
            if CFG.FruitNotify then notify("⚠️ Storage cheio", tool.Name .. " já está no limite") end
            break
        end
        stored += 1
        if CFG.FruitNotify then notify("🍎 Fruta guardada", tool.Name) end
    end
    State.storing = false
    local c, _, hum = getChar()
    if c and hum then
        if CFG.AutoFarm or attackGoal ~= nil then
            Combat.EquipWeapon(c, hum)
        else
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and isFruit(t) then hum:UnequipTools(); break end
            end
        end
    end
    return stored
end

-- coleta automática (opcional, iniciada sob demanda)
function GameClient.EnsureFruitCollectLoop()
    if not (CFG.AutoCollectFruit and CFG.FruitDetector) then
        State.Tokens.FruitCollect += 1
        return
    end
    State.Tokens.FruitCollect += 1
    local myTok = State.Tokens.FruitCollect
    task.spawn(function()
        SafeRuntime.RunResilientLoop("FruitCollect", function() return CFG.AutoCollectFruit and CFG.FruitDetector and State.Tokens.FruitCollect == myTok end, function()
        while CFG.AutoCollectFruit and CFG.FruitDetector and State.Tokens.FruitCollect == myTok do
            task.wait(0.5)
            if not (CFG.AutoCollectFruit and CFG.FruitDetector and State.Tokens.FruitCollect == myTok) then
                break
            end
            if not collecting and not isDeadOrRespawning() and not State.seaBeastBusy and not State.fortRaidBusy and not State.bossBusy and not State.islandBossBusy and not State.raidInArena and not GameClient.CampfireActive and not (GameClient.BossRoomsFight and GameClient.BossRoomsFight.Payload ~= nil) then
                local char, hrp = getChar()
                if hrp and not (char and (char:GetAttribute("BossTether") ~= nil or char:GetAttribute("BossArenaLock") ~= nil)) then
                    local f = nearestFruit(hrp.Position, true)
                    if f then
                        collecting = true
                        local snap = Features.PauseForInterrupt and Features.PauseForInterrupt() or { farm = CFG.AutoFarm }
                        pcall(function()
                            local p = fruitPart(f)
                            if p then
                                Status = "Coletando: " .. f.Name
                                if not Features.PauseForInterrupt then
                                    State.farmToken += 1
                                    attackGoal = nil
                                    currentTarget = nil
                                end
                                local abortFruit = function()
                                    return State.Tokens.FruitCollect ~= myTok or not f.Parent or not CFG.AutoCollectFruit or not CFG.FruitDetector or State.seaBeastBusy or State.fortRaidBusy or State.bossBusy or State.islandBossBusy or State.raidInArena or GameClient.CampfireActive or (GameClient.BossRoomsFight and GameClient.BossRoomsFight.Payload ~= nil)
                                end
                                goNear(p.Position, abortFruit)
                                if f.Parent and CFG.AutoCollectFruit and CFG.FruitDetector then
                                    for _, o in ipairs(f:GetDescendants()) do
                                        if o:IsA("ProximityPrompt") then pcall(fireproximityprompt, o) end
                                        if o:IsA("ClickDetector") then pcall(fireclickdetector, o) end
                                    end
                                    if p:IsA("BasePart") and firetouchinterest then
                                        local _, h = getChar()
                                        if h then pcall(function() firetouchinterest(h, p, 0); firetouchinterest(h, p, 1) end) end
                                    end
                                    task.wait(0.6)
                                end
                            end
                            if f.Parent and CFG.AutoCollectFruit and CFG.FruitDetector then
                                -- não conseguiu pegar do chão (ex.: já tem na mochila/limite): ignora por 30s para não travar o farm
                                SkipFruits[f] = os.clock() + 30
                            end
                            if CFG.AutoStoreFruit and CFG.AutoCollectFruit then
                                task.wait(0.4) -- dá tempo da fruta chegar na mochila
                                storeFruits()
                            end
                        end)
                        collecting = false
                        if Features.ResumeAfterInterrupt then
                            Features.ResumeAfterInterrupt(snap)
                        else
                            if not CFG.AutoCollectFruit and not CFG.AutoFarm then Status = "Parado" end
                            if snap.farm and CFG.AutoFarm then Combat.FarmLoop() end
                        end
                    end
                end
            end
        end
        end, function(err) collecting = false; cancelTween() end)
    end)
end

