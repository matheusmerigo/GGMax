    for _, cp in ipairs(cps:GetChildren()) do
        if cp:IsA("Model") and cp.Name ~= lastCheckpoint then
            local ok, pos = pcall(function() return cp:GetPivot().Position end)
            if ok and (pos - hrp.Position).Magnitude <= 12 then
                lastCheckpoint = cp.Name
                pcall(function() GameModules.Network:FireServer("SpawnCheckpoints", "SetSpawn", cp.Name) end)
                notify("📍 Checkpoint salvo", cp.Name)
                break
            end
        end
    end
end

local function wantsUtilityLoop()
    return CFG.AutoStats or CFG.AutoMilestones or CFG.AutoGacha or CFG.AutoVoxArmor or CFG.AutoVoxSense or CFG.AutoStoreFruit or CFG.AutoFarm or CFG.AutoHistory or attackGoal ~= nil
end

function GameClient.EnsureUtilityLoop()
    if not wantsUtilityLoop() then
        State.Tokens.Utility += 1
        return
    end
    State.Tokens.Utility += 1
    local myTok = State.Tokens.Utility
    task.spawn(function()
        while wantsUtilityLoop() and State.Tokens.Utility == myTok do
            task.wait(2)
            if not (wantsUtilityLoop() and State.Tokens.Utility == myTok) then
                break
            end
            pcall(autoStats)
            pcall(autoMilestones)
            pcall(autoGacha)
            pcall(autoHaki)
            if CFG.AutoFarm or CFG.AutoHistory or attackGoal ~= nil then
                pcall(autoCheckpoint)
            end
            if CFG.AutoStoreFruit and not collecting and #Features.Fruit.Held() > 0 then
                pcall(Features.Fruit.Store)
            end
        end
    end)
end

-- Auto Orbs (Rewards Client Orbs)
local orbsModule
local function getOrbsModule()
    if orbsModule then return orbsModule end
    pcall(function()
        local m = ReplicatedStorage:FindFirstChild("Modules")
        local ess = m and m:FindFirstChild("Essentials")
        local rew = ess and ess:FindFirstChild("Rewards")
        local cli = rew and rew:FindFirstChild("Rewards Client")
        local orbs = cli and cli:FindFirstChild("Orbs")
        if orbs then orbsModule = require(orbs) end
    end)
    return orbsModule
end

local function autoOrbs()
    if not (CFG.AutoOrbs and GameModules and GameModules.Network) then return end
    local mod = getOrbsModule()
    if not (mod and type(mod.Active) == "table" and #mod.Active > 0) then return end
    for i = #mod.Active, 1, -1 do
        local orb = mod.Active[i]
        if orb and not orb.Collected and orb.Id and orb.Index then
            orb.Collected = true
            pcall(function()
                GameModules.Network:FireServer("Rewards", "Collect", orb.Id, orb.Index)
            end)
            if orb.Part and orb.Part.Parent then
                pcall(function() orb.Part.Transparency = 1 end)
            end
            table.remove(mod.Active, i)
        end
    end
end

