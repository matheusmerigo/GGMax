local function pressInteract(holdTime, contextHint)
    holdTime = holdTime or 0.35
    local ic = getInteractionClient()
    local curCtx = ic and ic.Interaction and ic.Interaction.CurrentContext
    -- Evita apertar E se estivermos em cima de uma porta ("Enter Area") ou carregando baú ("Drop Chest") sem querer soltar!
    if (contextHint ~= "Enter Area" and curCtx == "Enter Area")
        or (contextHint ~= "Drop Chest" and curCtx == "Drop Chest") then
        return fireInteractionContext(contextHint)
    end
    -- Para portas ("Enter Area"): dispara Interaction.Interacted ONCE antes do check de Hold=0.3!
    -- Caso contrário, segurar E por 0.75s sai da sala e reentra imediatamente pela porta de entrada logo atrás!
    if contextHint == "Enter Area" and fireInteractionContext("Enter Area") then
        return true
    end
    local contexts = ic and ic.Interaction and ic.Interaction.Contexts
    local ctxObj = contexts and ((contextHint and contexts[contextHint]) or (curCtx and contexts[curCtx]))
    local reqHold = (ctxObj and type(ctxObj.Hold) == "number" and ctxObj.Hold > 0) and ctxObj.Hold or nil
    local pressed = false
    if reqHold then
        -- Contexto exige segurar E (ex: Find_TreasureX / Dig): segura pelo tempo real de Hold antes de disparar Interacted!
        holdTime = math.max(holdTime, reqHold + 0.45)
        if VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(holdTime)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end)
            pressed = true
        end
        return pressed
    end
    pressed = fireInteractionContext(contextHint)
    -- Para portas ("Enter Area"): se já disparou via Interaction.Interacted, NÃO apertar E em seguida
    -- (pois Leave.Dest fica em cima de Enter.Entrance e apertar E reentraria na mesma sala!).
    if pressed and contextHint == "Enter Area" then
        return true
    end
    if VirtualInputManager then
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(holdTime)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
        pressed = true
    end
    if not pressed then
        local hud = getInteractionHUD()
        if hud then
            local btn = hud:FindFirstChild("InteractionButton")
            if btn and btn.Visible and getconnections then
                for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
                    pcall(function() conn:Fire() end)
                    pressed = true
                end
            end
        end
    end
    return pressed
end

